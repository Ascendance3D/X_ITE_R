#VRML V2.0 utf8
# Browser Preview test world (newly authored for X_ITE_R): an orange box under an Anchor to the viewpoint "Side" of
# this world. tests/preview/touch.mjs taps it and reads the viewer position.
DEF Front Viewpoint { position 0 0 10 description "Front" }
DEF Side Viewpoint { position 10 0 0 orientation 0 1 0 1.5708 description "Side" }
DEF Viewer ProximitySensor { size 1000 1000 1000 }
Anchor {
  url "#Side"
  description "To Side"
  children Shape {
    appearance Appearance { material Material { diffuseColor 0.9 0.6 0.1 } }
    geometry Box { size 4 3 1 }
  }
}
