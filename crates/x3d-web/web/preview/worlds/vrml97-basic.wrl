#VRML V2.0 utf8
# X_ITE_R Browser Preview test world (VRML97 classic encoding). Newly authored for the preview; MIT, like the repository.
#
# Left:   a red box with a TouchSensor ("Touch"); its Material is "ColorTarget" (the page sets diffuseColor).
# Right:  a blue box with a PlaneSensor ("Drag"); drag it in its plane.
# Top:    a green cone turned by a TimeSensor ("Clock") through an OrientationInterpolator.
# A ProximitySensor ("Viewer") reports the viewer's position and orientation for the navigation tests.

NavigationInfo { type [ "EXAMINE" "ANY" ] headlight TRUE }
Background { skyColor 0.15 0.15 0.2 }
DEF Front Viewpoint { position 0 0 10 description "Front" }
DEF Side Viewpoint { position 10 0 0 orientation 0 1 0 1.5708 description "Side" }

DEF Viewer ProximitySensor { size 1000 1000 1000 }

Transform {
  translation -2.5 0 0
  children [
    DEF Touch TouchSensor { description "Press the red box" }
    Shape {
      appearance Appearance { material DEF ColorTarget Material { diffuseColor 0.9 0.15 0.15 } }
      geometry Box { size 1.6 1.6 1.6 }
    }
  ]
}

Transform {
  translation 2.5 0 0
  children [
    DEF Drag PlaneSensor { }
    DEF DragBox Transform {
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.2 0.35 0.95 } }
        geometry Box { size 1.6 1.6 1.6 }
      }
    }
  ]
}
ROUTE Drag.translation_changed TO DragBox.set_translation

DEF Spinner Transform {
  translation 0 2.4 0
  children Shape {
    appearance Appearance { material Material { diffuseColor 0.2 0.85 0.3 } }
    geometry Cone { bottomRadius 0.6 height 1.2 }
  }
}
DEF Clock TimeSensor { cycleInterval 4 loop TRUE }
DEF Turn OrientationInterpolator {
  key [ 0 0.5 1 ]
  keyValue [ 0 0 1 0, 0 0 1 3.14159, 0 0 1 6.28318 ]
}
ROUTE Clock.fraction_changed TO Turn.set_fraction
ROUTE Turn.value_changed TO Spinner.set_rotation
