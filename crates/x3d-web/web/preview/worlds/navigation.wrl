#VRML V2.0 utf8
# X_ITE_R Browser Preview navigation world. Newly authored for the preview; MIT, like the repository.
# A floor with pillars. Three NavigationInfo nodes: "NavExamine" (bound first), "NavWalk" and "NavFly".
# The page binds one of them with set_bind (the "Viewer type" control). The ProximitySensor "Viewer" reports
# the viewer's position and orientation.

DEF NavExamine NavigationInfo { type [ "EXAMINE" "ANY" ] avatarSize [ 0.25 1.6 0.75 ] speed 2 }
DEF NavWalk NavigationInfo { type [ "WALK" "ANY" ] avatarSize [ 0.25 1.6 0.75 ] speed 2 }
DEF NavFly NavigationInfo { type [ "FLY" "ANY" ] avatarSize [ 0.25 1.6 0.75 ] speed 2 }
Background { skyColor 0.15 0.15 0.2 }
DEF Start Viewpoint { position 0 1.6 12 description "Start" }

DEF Viewer ProximitySensor { size 1000 1000 1000 }

# Floor
Shape {
  appearance Appearance { material Material { diffuseColor 0.35 0.35 0.38 } }
  geometry IndexedFaceSet {
    coord Coordinate { point [ -20 0 -20, 20 0 -20, 20 0 20, -20 0 20 ] }
    coordIndex [ 0 3 2 1 -1 ]
  }
}

# Pillars in two rows
DEF Pillar Shape {
  appearance Appearance { material Material { diffuseColor 0.85 0.75 0.3 } }
  geometry Cylinder { radius 0.4 height 3 }
}
Transform { translation -3 1.5 0 children USE Pillar }
Transform { translation 3 1.5 0 children USE Pillar }
Transform { translation -3 1.5 -6 children USE Pillar }
Transform { translation 3 1.5 -6 children USE Pillar }
Transform { translation -3 1.5 -12 children USE Pillar }
Transform { translation 3 1.5 -12 children USE Pillar }

# A red marker at the far end
Transform {
  translation 0 1 -16
  children Shape {
    appearance Appearance { material Material { diffuseColor 0.9 0.15 0.15 } }
    geometry Box { size 2 2 2 }
  }
}
