#VRML V2.0 utf8
# The first X_ITE_R browser world: a Viewpoint, and a Box with a Material the page changes.

DEF Camera Viewpoint {
  position 0 0 6
  description "Front"
}

DEF BoxTransform Transform {
  rotation 1 1 0 0.6
  children Shape {
    appearance Appearance {
      material DEF BoxMaterial Material {
        diffuseColor 0.2 0.4 0.9
      }
    }
    geometry Box { size 2 2 2 }
  }
}
