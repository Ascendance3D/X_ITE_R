#VRML V2.0 utf8
# X_ITE_R web data URL compat 01 test world (synthetic, written for the tests).
# A glTF Inline with a data URL buffer one byte short (a tab in the scheme removes the raw tab of the body).

DEF Camera Viewpoint { position 0.5 0.5 3 description "Camera" }

Inline { url [ "gltf-scheme-tab-percent.gltf" ] }
