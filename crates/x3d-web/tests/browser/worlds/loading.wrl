# X_ITE_R browser runtime 02 test world (synthetic, written for the tests).
# An Inline and an ImageTexture with relative URLs (resolved against this file).

DEF Camera Viewpoint { position 0 0 8 description "Camera" }

Transform {
  translation -1.5 0 0
  children DEF InnerInline Inline { url "parts/inner.wrl" }
}

Transform {
  translation 1.5 0 0
  children Shape {
    appearance Appearance {
      material Material { }
      texture DEF Texture ImageTexture { url "tex/red.png" }
    }
    geometry Box { size 2 2 2 }
  }
}
