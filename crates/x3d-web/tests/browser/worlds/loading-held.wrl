#VRML V2.0 utf8
# X_ITE_R browser runtime 02 test world (synthetic, written for the tests).
# The same, with responses the test releases (holds "inline" and "texture").

DEF Camera Viewpoint { position 0 0 8 description "Camera" }

Transform {
  translation -1.5 0 0
  children DEF InnerInline Inline { url "/hold/inline/tests/browser/worlds/parts/inner.wrl" }
}

Transform {
  translation 1.5 0 0
  children Shape {
    appearance Appearance {
      material Material { }
      texture DEF Texture ImageTexture { url "/hold/texture/tests/browser/worlds/tex/red.png" }
    }
    geometry Box { size 2 2 2 }
  }
}
