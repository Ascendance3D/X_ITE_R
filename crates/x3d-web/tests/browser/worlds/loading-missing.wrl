  translation -1.5 0 0
  children DEF InnerInline Inline { url "parts/no-such-inner.wrl" }
}

Transform {
  translation 1.5 0 0
  children Shape {
    appearance Appearance {
      material Material { }
      texture DEF Texture ImageTexture { url "tex/no-such-texture.png" }
    }
    geometry Box { size 2 2 2 }
  }
}
