#VRML V2.0 utf8
# X_ITE_R browser runtime 02 test world (synthetic, written for the tests).
# The same, with responses that are no X3D and no image.

DEF Camera Viewpoint { position 0 0 8 description "Camera" }

Transform {
  translation -1.5 0 0
  children DEF InnerInline Inline { url "/garbage/inner.wrl" }
}

Transform {
  translation 1.5 0 0
  children Shape {
    appearance Appearance {
      material Material { }
      texture DEF Texture ImageTexture { url "/garbage/texture.png" }
    }
    geometry Box { size 2 2 2 }
  }
}
