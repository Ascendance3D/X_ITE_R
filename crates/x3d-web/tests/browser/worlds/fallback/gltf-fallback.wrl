#VRML V2.0 utf8
# X_ITE_R web resource fallback 01 test world (synthetic, written for the tests).
# A glTF file whose external buffer is missing, then one whose buffer loads. A buffer resolves against its glTF
# file (models/).

DEF Camera Viewpoint { position 0.5 0.5 3 description "Camera" }

Inline { url [ "models/missing-buffer.gltf" "models/triangle.gltf" ] }
