# X_ITE_R browser runtime 02 test world (synthetic, written for the tests).
# The PROTO file of extern.wrl.

PROTO ColorBox [ exposedField SFColor color 0.9 0.5 0.1 ] {
  Shape {
    appearance Appearance { material Material { diffuseColor IS color } }
    geometry Box { size 2 2 2 }
  }
}
