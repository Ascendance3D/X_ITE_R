#X3D V4.0 utf8
PROFILE Full
COMPONENT Sound:2
AudioDestination { children Gain { gain 0.2 children DEF O OscillatorSource { frequency 440 } } }
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF K Script { directOutput TRUE initializeOnly SFNode o USE O inputOnly SFTime set_time initializeOnly SFInt32 n 0 url "ecmascript:
function set_time (value) { ++ n;
   if (n === 4) { o.startTime = value; print ('play ' + value); }
   if (n === 8) { o.pauseTime = value; print ('pause ' + value); }
   if (n === 12) { o.resumeTime = value; print ('resume ' + value); }
}
" }
ROUTE T.cycleTime TO K.set_time
DEF PO Script { inputOnly SFBool a inputOnly SFBool p url "ecmascript:
function a (v, t) { print ('O isActive ' + v + ' ' + t); }
function p (v, t) { print ('O isPaused ' + v + ' ' + t); }
" }
ROUTE O.isActive TO PO.a
ROUTE O.isPaused TO PO.p
