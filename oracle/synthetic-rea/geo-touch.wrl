#X3D V3.3 utf8
PROFILE Interchange
COMPONENT Geospatial:2
COMPONENT PointingDeviceSensor:1
COMPONENT Navigation:2
COMPONENT Scripting:1
# Synthetic REA oracle world: GeoTouchSensor reports isOver, isActive, touchTime, hitPoint,
# hitNormal, hitTexCoord like TouchSensor, plus hitGeoCoord_changed (getGeoCoord of the hit point)
# in GD and UTM frames with and without a GeoOrigin. Authored.
Viewpoint { position 0 0 10 }
Transform {
  translation -1.5 0 0
  children [
    DEF GT1 GeoTouchSensor { description "gd" geoSystem [ "GD" "WE" ] }
    Shape { geometry Box { size 2 2 2 } }
  ]
}
Transform {
  translation 1.5 0 0
  children [
    DEF GT2 GeoTouchSensor {
      description "utm"
      geoSystem [ "UTM" "Z10" ]
      geoOrigin GeoOrigin { geoSystem [ "GD" ] geoCoords 37.4 -122.1 0 }
    }
    Shape { geometry Sphere { radius 1.2 } }
  ]
}
DEF LOG Script {
  inputOutput SFString hist ""
  inputOnly SFBool over1
  inputOnly SFBool active1
  inputOnly SFTime touch1
  inputOnly SFVec3f point1
  inputOnly SFVec3d geo1
  inputOnly SFBool over2
  inputOnly SFTime touch2
  inputOnly SFVec3f normal2
  inputOnly SFVec2f tex2
  inputOnly SFVec3d geo2
  url "ecmascript:
    function over1 (v) { hist = hist + ' o1=' + v; }
    function active1 (v) { hist = hist + ' a1=' + v; }
    function touch1 (v, t) { hist = hist + ' t1=' + (v - 946684800) .toFixed (4); }
    function point1 (v) { hist = hist + ' p1=' + v; }
    function geo1 (v) { hist = hist + ' g1=' + v; }
    function over2 (v) { hist = hist + ' o2=' + v; }
    function touch2 (v) { hist = hist + ' t2=' + (v - 946684800) .toFixed (4); }
    function normal2 (v) { hist = hist + ' n2=' + v; }
    function tex2 (v) { hist = hist + ' x2=' + v; }
    function geo2 (v) { hist = hist + ' g2=' + v; }
  "
}
ROUTE GT1.isOver TO LOG.over1
ROUTE GT1.isActive TO LOG.active1
ROUTE GT1.touchTime TO LOG.touch1
ROUTE GT1.hitPoint_changed TO LOG.point1
ROUTE GT1.hitGeoCoord_changed TO LOG.geo1
ROUTE GT2.isOver TO LOG.over2
ROUTE GT2.touchTime TO LOG.touch2
ROUTE GT2.hitNormal_changed TO LOG.normal2
ROUTE GT2.hitTexCoord_changed TO LOG.tex2
ROUTE GT2.hitGeoCoord_changed TO LOG.geo2
