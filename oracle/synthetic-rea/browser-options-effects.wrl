#X3D V4.0 utf8
PROFILE Interchange
COMPONENT Scripting:1
COMPONENT Navigation:2
# Synthetic REA oracle world: the effects of Browser.setBrowserOption. Gravity changes the WALK
# fall speed (X3DRenderObject.gravitate), LogarithmicDepthBuffer the far plane (1e5 -> 1e10, so
# the far box appears). Authored.
NavigationInfo { type [ "WALK" "ANY" ] headlight TRUE }
Viewpoint { position 0 8 10 orientation 0 0 1 0.2 description "walk" }
Background { skyColor 0.1 0.12 0.2 }
Transform { translation 0 -0.5 0 children Shape { appearance Appearance { material Material { diffuseColor 0.4 0.6 0.3 } } geometry Box { size 40 1 40 } } }
Transform { translation 2 1 -4 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.3 0.2 } } geometry Box { size 1 2 1 } } }
Transform { translation 0 0 -150000 children Shape { appearance Appearance { material UnlitMaterial { emissiveColor 1 1 0.2 } } geometry Box { size 60000 30000 10 } } }
DEF OUT Script {
  inputOutput SFString hist ""
  inputOutput SFInt32 step 0
  inputOnly SFTime cycle
  url "ecmascript:
    function initialize () {
      Browser .setBrowserOption ('Gravity', 2.5);
      hist = 'g=' + Browser .getBrowserOption ('Gravity');
    }
    function cycle (v) {
      step = step + 1;
      if (step == 2) {
        Browser .setBrowserOption ('LogarithmicDepthBuffer', true);
        Browser .setBrowserOption ('Gravity', 30);
      }
      if (step == 3)
        hist = hist + ' log=' + Browser .getRenderingProperty ('LogarithmicDepthBuffer');
    }
  "
}
DEF STEP TimeSensor { cycleInterval 0.5 loop TRUE }
ROUTE STEP.cycleTime TO OUT.cycle
