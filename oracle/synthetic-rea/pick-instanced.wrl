#X3D V4.0 utf8
PROFILE Interchange
COMPONENT PointingDeviceSensor:1
COMPONENT X_ITE:1
# Synthetic REA oracle world: pointing-buffer hits on InstancedShape (one candidate per instance
# matrix), under a rotated Transform, with a plain Shape drawn behind the instances.
Viewpoint { position 0 0 9 }
Transform {
  rotation 0.2 1 0 0.3
  children [
    TouchSensor { }
    InstancedShape {
      translations [ -2 1.5 0, 0 1.5 0, 2 1.5 0, -2 -0.5 0, 0 -0.5 0, 2 -0.5 0 ]
      rotations [ 0 0 1 0.3, 0 1 0 0.8, 1 0 0 1.2 ]
      scales [ 1 1 1, 1.4 0.6 1, 0.5 1.5 0.7 ]
      scaleOrientations [ 0 0 1 0, 0 1 0 0.4 ]
      geometry Box { size 1 1 1 }
    }
  ]
}
Transform {
  translation 0 -2.2 -1
  children [
    TouchSensor { }
    InstancedShape {
      translations [ -2.5 0 0, -0.8 0 0, 0.9 0 0, 2.6 0 0 ]
      rotations [ 1 0 0 0.5, 0 1 1 0.9 ]
      scales [ 1.2 1.2 1.2, 0.7 1.4 0.9 ]
      geometry Sphere { radius 0.6 }
    }
  ]
}
Transform { translation 0 0.2 -2 children [ TouchSensor { } Shape { geometry Box { size 9 6 0.2 } } ] }
