#X3D V4.0 utf8
PROFILE Interchange
COMPONENT Geospatial:2
# Synthetic REA oracle world: WALK with a GeoViewpoint in a GeoOrigin (rotateYUp FALSE) frame:
# gravity pulls along the geo up vector onto a ground slab, and the walk direction is kept
# perpendicular to it. Authored.
DEF ORIGIN GeoOrigin { geoSystem [ "GD" "WE" ] geoCoords 10 20 0 }
NavigationInfo { type [ "WALK" "ANY" ] avatarSize [ 0.25 1.6 0.75 ] }
GeoViewpoint {
  geoOrigin USE ORIGIN
  position 10 20 5
  orientation 0 1 0 0.3
}
GeoLocation {
  geoOrigin USE ORIGIN
  geoCoords 10 20 0
  children [
    Shape { appearance Appearance { material Material { diffuseColor 0.5 0.5 0.4 } } geometry Box { size 200 1 200 } }
    Transform { translation 2 1 -12 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.2 0.2 } } geometry Box { size 6 1.2 3 } } }
  ]
}
