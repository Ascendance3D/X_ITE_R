#X3D V3.3 utf8
PROFILE Interchange
COMPONENT CADGeometry:2
COMPONENT Navigation:2
# Synthetic REA render world: CADAssembly / CADLayer group their children, CADPart transforms
# like Transform, CADFace shows its shape only when it is a Shape, LOD or Transform (a Group
# shape is ignored). QuadSet and IndexedQuadSet inside. Authored.
NavigationInfo { headlight TRUE }
Viewpoint { position 0 0 12 }
CADLayer {
  name "layer"
  children [
    CADAssembly {
      name "assembly"
      children [
        CADPart {
          name "part-a"
          translation -3 1.5 0
          rotation 0 0 1 0.4
          scale 1.2 0.8 1
          children [
            CADFace { name "f-shape" shape Shape { appearance Appearance { material Material { diffuseColor 1 0 0 } } geometry Box { } } }
          ]
        }
        CADPart {
          name "part-b"
          translation 0 1.5 0
          center 0.5 0 0
          rotation 0 1 0 0.7
          children [
            CADFace { name "f-transform" shape Transform { translation 0 0.3 0 children Shape { appearance Appearance { material Material { diffuseColor 0 1 0 } } geometry Sphere { } } } }
          ]
        }
        CADPart {
          name "part-c"
          translation 3 1.5 0
          children [
            CADFace { name "f-lod" shape LOD { range [ 100 ] level [ Shape { appearance Appearance { material Material { diffuseColor 0 0 1 } } geometry Cone { } } Shape { geometry Box { } } ] } }
          ]
        }
        CADPart {
          name "part-d"
          translation -3 -2 0
          children [
            CADFace { name "f-group-ignored" shape Group { children Shape { geometry Box { } } } }
          ]
        }
        CADPart {
          name "part-e"
          translation 0 -2 0
          children [
            CADFace { shape Shape {
              appearance Appearance { material Material { diffuseColor 1 1 0 } }
              geometry QuadSet { coord Coordinate { point [ -1 -1 0, 1 -1 0, 1 1 0, -1 1 0 ] } }
            } }
          ]
        }
        CADPart {
          name "part-f"
          translation 3 -2 0
          children [
            CADFace { shape Shape {
              appearance Appearance { material Material { diffuseColor 1 0 1 } }
              geometry IndexedQuadSet { index [ 0 1 2 3 ] coord Coordinate { point [ -1 -0.5 0, 1 -0.5 0, 0.8 1 0, -0.8 1 0 ] } }
            } }
          ]
        }
      ]
    }
  ]
}
