#X3D V4.0 utf8
PROFILE Full
COMPONENT Layout:2
DEF V1 Viewpoint { position 0 0 8 description "one" }
Background { skyColor 0.12 0.14 0.2 }
NavigationInfo { type "EXAMINE" transitionType [ "TELEPORT" ] }
Transform { translation -1.5 0 0 children Shape { appearance Appearance { material Material { diffuseColor 0.3 0.5 0.9 } } geometry Box { size 1.5 1.5 1.5 } } }
Transform { translation 1.5 0 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.6 0.2 } } geometry Sphere { radius 0.9 } } }
Transform { translation 1 2 0 rotation 0 1 0 0.4 children ScreenGroup { children [ DEF VI1 Viewpoint { position 0 0 5 description "in1" }
Shape { appearance Appearance { material Material { emissiveColor 0.9 0.4 0.1 diffuseColor 0 0 0 } } geometry IndexedFaceSet { coord Coordinate { point [ -20 -20 0, 20 -20 0, 20 20 0, -20 20 0 ] } coordIndex [ 0 1 2 3 -1 ] } } ] } }
Transform { translation -1 -2 0 children ScreenGroup { children [ ScreenGroup { children [ DEF VI2 Viewpoint { position 1 1 3 orientation 0 1 0 0.5 description "in2" }
Shape { appearance Appearance { material Material { emissiveColor 0.2 0.4 0.9 diffuseColor 0 0 0 } } geometry IndexedFaceSet { coord Coordinate { point [ -20 -20 0, 20 -20 0, 20 20 0, -20 20 0 ] } coordIndex [ 0 1 2 3 -1 ] } } ] } ] } }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  inputOutput SFString log ""
  initializeOnly SFNode v1 USE V1
  initializeOnly SFNode vi1 USE VI1
  initializeOnly SFNode vi2 USE VI2

  url "javascript:
function on_key (k)
{
   log = log + 'K' + k + ' ';
   if (k == 'a') vi1 .set_bind = true;
   if (k == 'b') v1 .set_bind = true;
   if (k == 'c') vi2 .set_bind = true;
   if (k == 'd') vi1 .position = new SFVec3f (0, 0, 9);
   if (k == 'e') vi1 .set_bind = true;
}
"
}
ROUTE K.keyPress TO R.on_key
