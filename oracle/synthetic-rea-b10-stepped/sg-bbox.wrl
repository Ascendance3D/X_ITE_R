#X3D V4.0 utf8
PROFILE Full
COMPONENT Layout:2
DEF V1 Viewpoint { position 0 0 8 }
Background { skyColor 0.12 0.14 0.2 }
NavigationInfo { type "EXAMINE" transitionType [ "TELEPORT" ] }
Transform { translation -1.5 0 0 children Shape { appearance Appearance { material Material { diffuseColor 0.3 0.5 0.9 } } geometry Box { size 1.5 1.5 1.5 } } }
Transform { translation 1.5 0 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.6 0.2 } } geometry Sphere { radius 0.9 } } }
DEF T1 Transform { translation -2.5 1.5 0 children DEF SG1 ScreenGroup { children [ Shape { appearance Appearance { material Material { emissiveColor 1 0.4 0.1 diffuseColor 0 0 0 } } geometry IndexedFaceSet { coord Coordinate { point [ -60 -40 0, 60 -40 0, 60 40 0, -60 40 0 ] } coordIndex [ 0 1 2 3 -1 ] } } ] } }
DEF T2 Transform { translation 2.5 1.5 0 children DEF SG2 ScreenGroup { bboxDisplay TRUE children [ Shape { appearance Appearance { material Material { emissiveColor 0.2 0.9 0.4 diffuseColor 0 0 0 } } geometry IndexedFaceSet { coord Coordinate { point [ -50 -30 0, 50 -30 0, 50 30 0, -50 30 0 ] } coordIndex [ 0 1 2 3 -1 ] } } DEF SG3 ScreenGroup { children [ Transform { translation 20 10 0 children Shape { appearance Appearance { material Material { emissiveColor 0.9 0.2 0.9 diffuseColor 0 0 0 } } geometry IndexedFaceSet { coord Coordinate { point [ -12 -12 0, 12 -12 0, 12 12 0, -12 12 0 ] } coordIndex [ 0 1 2 3 -1 ] } } } ] } ] } }
DEF T3 Transform { translation -2.5 -2 0 children DEF SG4 ScreenGroup { children [ Shape { appearance Appearance { material Material { emissiveColor 1 1 1 diffuseColor 0 0 0 } } geometry Text { string [ "Box" "Text" ] fontStyle ScreenFontStyle { pointSize 20 } solid FALSE } } ] } }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  inputOutput SFString log ""
  initializeOnly SFNode t1 USE T1
  initializeOnly SFNode sg1 USE SG1
  initializeOnly SFNode sg2 USE SG2
  initializeOnly SFNode sg3 USE SG3
  initializeOnly SFNode sg4 USE SG4

  url "javascript:
function on_key (k)
{
   log = log + 'K' + k + ' ';
   if (k == 'a') sg1 .bboxDisplay = true;
   if (k == 'b') sg4 .bboxDisplay = true;
   if (k == 'c') sg3 .bboxDisplay = true;
   if (k == 'd') t1 .translation = new SFVec3f (-1, 1.5, 0);
   if (k == 'e') sg2 .bboxDisplay = false;
}
"
}
ROUTE K.keyPress TO R.on_key
