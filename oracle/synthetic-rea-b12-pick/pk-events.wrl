Transform { translation 0 1.2 0 children [ DEF L TouchSensor { description "lines" } Shape { geometry IndexedLineSet { coord Coordinate { point [ -0.8 -0.3 0, 0.8 0.3 0 ] } coordIndex [ 0 1 ] } } ] }
Transform { translation 2 1.2 0 rotation 0 1 0 0.5 children [ DEF S TouchSensor { description "stacked" } Shape { appearance Appearance { material Material { emissiveColor 0.6 0.2 0.2 } } geometry Box { size 1 1 1 } } Transform { translation 0 0 -1 children Shape { geometry Box { size 2 2 0.2 } } } ] }
Transform { translation 0 -1.4 0 rotation 1 0 0 -0.5 children [ Transform { translation 0 0 0 children [ DEF G TouchSensor { description "outer" } Transform { translation 0 0 0.3 children [ DEF H TouchSensor { description "inner" } Shape { appearance Appearance { material Material { emissiveColor 0.2 0.6 0.2 } } geometry Sphere { radius 0.6 } } ] }
Shape { appearance Appearance { material Material { emissiveColor 0.2 0.2 0.6 } } geometry Box { size 2.4 0.6 0.6 } } ] }
 ] }
DEF LOG Script {
  inputOutput SFString hist ""
  inputOutput SFInt32 frame 0
  inputOnly SFBool P0
  inputOnly SFBool P1
  inputOnly SFTime P2
  inputOnly SFVec3f P3
  inputOnly SFVec3f P4
  inputOnly SFVec2f P5
  inputOnly SFBool L0
  inputOnly SFBool L1
  inputOnly SFTime L2
  inputOnly SFVec3f L3
  inputOnly SFVec3f L4
  inputOnly SFVec2f L5
