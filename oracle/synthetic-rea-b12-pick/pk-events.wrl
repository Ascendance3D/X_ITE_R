  inputOnly SFTime H2
  inputOnly SFVec3f H3
  inputOnly SFVec3f H4
  inputOnly SFVec2f H5
  url "ecmascript:
    function P0 (v, t) { hist = hist + ' ' + frame + ':P.isOver=' + v; }
    function P1 (v, t) { hist = hist + ' ' + frame + ':P.isActive=' + v; }
    function P2 (v, t) { hist = hist + ' ' + frame + ':P.touchTime=' + (v - 946684800) .toFixed (4); }
    function P3 (v, t) { hist = hist + ' ' + frame + ':P.hitPoint_changed=' + v; }
    function P4 (v, t) { hist = hist + ' ' + frame + ':P.hitNormal_changed=' + v; }
    function P5 (v, t) { hist = hist + ' ' + frame + ':P.hitTexCoord_changed=' + v; }
    function L0 (v, t) { hist = hist + ' ' + frame + ':L.isOver=' + v; }
    function L1 (v, t) { hist = hist + ' ' + frame + ':L.isActive=' + v; }
    function L2 (v, t) { hist = hist + ' ' + frame + ':L.touchTime=' + (v - 946684800) .toFixed (4); }
    function L3 (v, t) { hist = hist + ' ' + frame + ':L.hitPoint_changed=' + v; }
    function L4 (v, t) { hist = hist + ' ' + frame + ':L.hitNormal_changed=' + v; }
    function L5 (v, t) { hist = hist + ' ' + frame + ':L.hitTexCoord_changed=' + v; }
    function S0 (v, t) { hist = hist + ' ' + frame + ':S.isOver=' + v; }
    function S1 (v, t) { hist = hist + ' ' + frame + ':S.isActive=' + v; }
    function S2 (v, t) { hist = hist + ' ' + frame + ':S.touchTime=' + (v - 946684800) .toFixed (4); }
    function S3 (v, t) { hist = hist + ' ' + frame + ':S.hitPoint_changed=' + v; }
    function S4 (v, t) { hist = hist + ' ' + frame + ':S.hitNormal_changed=' + v; }
    function S5 (v, t) { hist = hist + ' ' + frame + ':S.hitTexCoord_changed=' + v; }
    function G0 (v, t) { hist = hist + ' ' + frame + ':G.isOver=' + v; }
    function G1 (v, t) { hist = hist + ' ' + frame + ':G.isActive=' + v; }
    function G2 (v, t) { hist = hist + ' ' + frame + ':G.touchTime=' + (v - 946684800) .toFixed (4); }
    function G3 (v, t) { hist = hist + ' ' + frame + ':G.hitPoint_changed=' + v; }
    function G4 (v, t) { hist = hist + ' ' + frame + ':G.hitNormal_changed=' + v; }
    function G5 (v, t) { hist = hist + ' ' + frame + ':G.hitTexCoord_changed=' + v; }
    function H0 (v, t) { hist = hist + ' ' + frame + ':H.isOver=' + v; }
    function H1 (v, t) { hist = hist + ' ' + frame + ':H.isActive=' + v; }
    function H2 (v, t) { hist = hist + ' ' + frame + ':H.touchTime=' + (v - 946684800) .toFixed (4); }
    function H3 (v, t) { hist = hist + ' ' + frame + ':H.hitPoint_changed=' + v; }
    function H4 (v, t) { hist = hist + ' ' + frame + ':H.hitNormal_changed=' + v; }
    function H5 (v, t) { hist = hist + ' ' + frame + ':H.hitTexCoord_changed=' + v; }
    function prepareEvents () { frame = frame + 1; }
"
}
