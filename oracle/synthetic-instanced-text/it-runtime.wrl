#X3D V4.0 utf8
PROFILE Full
COMPONENT X_ITE:1
COMPONENT Scripting:1
# Instanced Text oracle world (generated by oracle/tools/gen_instanced_text.py).
DEF V1 Viewpoint { position 0 0 12 }
NavigationInfo { type "NONE" headlight TRUE }
Background { skyColor 0.12 0.14 0.2 }
DEF I InstancedShape { appearance Appearance { material Material { diffuseColor 0.95 0.6 0.3 emissiveColor 0.95 0.6 0.3 } } translations [ -3 1.5 0, 0 1.5 0, 3 1.5 0 ] geometry DEF TX Text { string [ "Ab" ] fontStyle DEF FS FontStyle { size 1 } solid FALSE } }
Transform { translation 0 -2 0 children [ Shape { appearance Appearance { material Material { diffuseColor 0.95 0.95 0.95 emissiveColor 0.95 0.95 0.95 } } geometry DEF TC Text { string [ "Ctl" ] fontStyle DEF FC FontStyle { size 1 } solid FALSE } } ] }
Transform { translation 0 -4 0 children [ DEF J InstancedShape { appearance Appearance { material Material { diffuseColor 0.5 0.8 0.9 emissiveColor 0.5 0.8 0.9 } } translations [ -2 0 0, 2 0 0 ] geometry Box { size 1 1 1 } } ] }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  inputOutput SFString log ""
  initializeOnly SFNode i USE I
  initializeOnly SFNode j USE J
  initializeOnly SFNode tx USE TX
  initializeOnly SFNode fs USE FS
  initializeOnly SFNode tc USE TC
  initializeOnly SFNode fc USE FC
  url "javascript:
function on_key (k)
{
   log = log + 'K' + k + ' ';
   if (k == 'a') { tx .string = new MFString ('Chg'); tc .string = new MFString ('Chg'); }
   if (k == 'b') { fs .size = 1.6; fc .size = 1.6; }
   if (k == 'c') i .scales = new MFVec3f (new SFVec3f (1, 1, 1), new SFVec3f (1.4, 0.5, 1), new SFVec3f (0.6, 1.5, 1));
   if (k == 'd') i .rotations = new MFRotation (new SFRotation (0, 0, 1, 0.4), new SFRotation (0, 0, 1, -0.4));
   if (k == 'e') { fs .justify = new MFString ('MIDDLE', 'MIDDLE'); fc .justify = new MFString ('MIDDLE', 'MIDDLE'); }
   if (k == 'f') i .translations = new MFVec3f (new SFVec3f (-3, 1.5, 0), new SFVec3f (3, 1.5, 0));
   if (k == 'g') j .geometry = tc;
   if (k == 'h') j .translations = new MFVec3f (new SFVec3f (0, 0, 0));
   if (k == 'i') { tx .string = new MFString ('One', 'Two'); tc .string = new MFString ('One', 'Two'); }
   if (k == 'j') i .geometry = null;
}
"
}
ROUTE K.keyPress TO R.on_key
