var step = 0;
function dump (t) { return 'tb ' + String (t .textBounds) + ' | lb ' + String (t .lineBounds) + ' | o ' + String (t .origin) + ' | len ' + String (t .length) + ' | max ' + t .maxExtent; }
function on_key (k)
{
   if (k == 'a') { var o = []; o .push ('A0 ' + dump (tA)); o .push ('B0 ' + dump (tB)); o .push ('C0 ' + dump (tC)); o .push ('D0 ' + dump (tD)); o .push ('E0 ' + dump (tE)); o .push ('F0 ' + dump (tF)); o .push ('G0 ' + dump (tG)); o .push ('H0 ' + dump (tH)); out = new MFString (... o); }
   if (k == 'b') { tB .string = new MFString ('Longer', 'Two'); fsC .size = 0.9; fsB .size = 1.4; }
   if (k == 'c') { var o = []; o .push ('A1 ' + dump (tA)); o .push ('B1 ' + dump (tB)); o .push ('C1 ' + dump (tC)); o .push ('D1 ' + dump (tD)); o .push ('E1 ' + dump (tE)); o .push ('F1 ' + dump (tF)); o .push ('G1 ' + dump (tG)); o .push ('H1 ' + dump (tH)); out = new MFString (... o); }
}
"
}
