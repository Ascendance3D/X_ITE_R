#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
# Synthetic REA oracle world (generated by oracle/tools/gen_file_loader.py): ff-text.
# Each URL list goes through Browser.createX3DFromURL, one after the other; `out` lists the scene head and printed scene or the rejection of each.
DEF OUT Script {
  inputOutput MFString out [ ]
  url "ecmascript:
    var CASES = [[\"text/plain.wrl\"], [\"text/classic.x3dv\"], [\"text/doc.x3d\"], [\"text/doc.x3dj\"], [\"text/doc.json\"], [\"text/xml-as-wrl.wrl\"], [\"text/vrml-as-x3d.x3d\"], [\"text/vrml-as-json.json\"], [\"text/vrml-as-txt.txt\"], [\"text/json-as-x3d.x3d\"], [\"text/classic-as-wrl.wrl\"], [\"text/vrml-no-extension\"], [\"text/upper.WRL\"], [\"text/bom.wrl\"], [\"text/bom.x3d\"], [\"text/bom.x3dj\"], [\"text/bom.x3dv\"], [\"text/utf16le-bom.wrl\"], [\"text/utf16be-bom.wrl\"], [\"text/utf16le-nobom.wrl\"], [\"text/latin1-title.wrl\"], [\"text/utf8-title.wrl\"], [\"text/utf8-bad-seq.wrl\"], [\"text/utf8-comment-latin1.wrl\"], [\"text/nul-in-string.wrl\"], [\"text/crlf.wrl\"], [\"text/cr-only.wrl\"], [\"text/blank-first.wrl\"], [\"text/space-first.wrl\"], [\"text/tab-first.wrl\"], [\"text/empty.wrl\"], [\"text/spaces.wrl\"], [\"text/header-only.wrl\"], [\"text/header-no-eol.wrl\"], [\"text/header-comment.wrl\"], [\"text/no-header.wrl\"], [\"text/v1.wrl\"], [\"text/v2-ascii.wrl\"], [\"text/v21.wrl\"], [\"text/v3.wrl\"], [\"text/lower.wrl\"], [\"text/x3d-v4.x3dv\"], [\"text/x3d-v40.x3dv\"], [\"text/x3d-no-profile.x3dv\"], [\"text/x3d-bad-profile.x3dv\"], [\"text/syntax-error.wrl\"], [\"text/unknown-node.wrl\"], [\"text/trailing-garbage.wrl\"], [\"text/xml-broken.x3d\"], [\"text/xml-not-x3d.x3d\"], [\"text/json-broken.x3dj\"], [\"text/json-not-x3d.x3dj\"], [\"text/html-doc.html\"], [\"text/plain-words.txt\"], [\"gz/plain.wrl\"], [\"gz/plain-noext\"], [\"gz/plain.wrl.gz\"], [\"gz/plain.bin\"], [\"gz/doc.x3d\"], [\"gz/doc.x3dj\"], [\"gz/classic.x3dv\"], [\"gz/bom.wrl\"], [\"gz/empty.wrl\"], [\"gz/twice.wrl\"], [\"gz/two-members.wrl\"], [\"gz/trailing-garbage.wrl\"], [\"gz/truncated.wrl\"], [\"gz/header-only.wrl\"], [\"gz/magic-only.wrl\"], [\"gz/magic-three.wrl\"], [\"gz/bad-crc.wrl\"], [\"gz/bad-size.wrl\"], [\"gz/name-field.wrl\"], [\"gz/zlib.wrl\"], [\"gz/rawdeflate.wrl\"], [\"gz/not-gzip-1f.wrl\"], [\"gz/not-gzip-8b.wrl\"]];
    var res = [];
    function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
    function put (i, v) { res [i] = i + ': ' + v; var o = []; for (var k = 0; k < CASES .length; ++ k) o .push (k in res ? res [k] : k + ': ...'); out = new MFString (... o); }
    function run (i) {
      if (i >= CASES .length) return;
      var p;
      try { p = Browser .createX3DFromURL (new MFString (... CASES [i])); } catch (e) { put (i, 'THROW ' + strip (e .message)); run (i + 1); return; }
      p .then (function (sc) {
        var head = [sc .encoding, sc .specificationVersion, sc .profile && sc .profile .name, sc .rootNodes .length, sc .protos .length, sc .externprotos .length, sc .routes .length, sc .importedNodes .length, sc .exportedNodes .length, strip (sc .worldURL)] .join ('/');
        var text; try { text = sc .toVRMLString (); } catch (e) { text = 'PRINT ERR ' + e .message; }
        put (i, 'RES ' + head + '\n' + text);
        run (i + 1);
      }, function (e) { put (i, 'REJ ' + strip (e && e .message)); run (i + 1); });
    }
    function initialize () { run (0); }
  "
}
