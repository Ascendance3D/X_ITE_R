#X3D V4.0 utf8
PROFILE Full
DEF V1 Viewpoint { position 2 1.5 14 orientation 0 1 0 0.12 }
Background { skyColor 0.12 0.14 0.2 }
NavigationInfo { type "EXAMINE" transitionType [ "TELEPORT" ] }
DEF P1 Transform { translation -3 1 0 children DEF B1 Billboard { bboxDisplay TRUE children [ Transform { translation 0.6 0 0 children Shape { appearance Appearance { material Material { diffuseColor 0.3 0.5 0.9 } } geometry Box { size 1.6 0.8 0.2 } } } ] } }
Transform { translation 2 1 0 children DEF B2 Billboard { bboxDisplay TRUE } }
Transform { translation 0 -2 0 children DEF B3 Billboard { children [ Transform { translation 0.6 0 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.6 0.2 } } geometry Box { size 1.6 0.8 0.2 } } } ] } }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  inputOutput SFString log ""
  initializeOnly SFNode b1 USE B1
  initializeOnly SFNode b2 USE B2
  initializeOnly SFNode b3 USE B3
  initializeOnly SFNode p1 USE P1
  url "javascript:
function on_key (k)
{
   log = log + 'K' + k + ' ';
   if (k == 'a') b1 .axisOfRotation = new SFVec3f (0, 0, 0);
   if (k == 'b') b2 .children = new MFNode (b3 .children [0]);
   if (k == 'c') b3 .bboxDisplay = true;
   if (k == 'd') p1 .rotation = new SFRotation (0, 0, 1, 0.6);
   if (k == 'e') b1 .axisOfRotation = new SFVec3f (1, 1, 0);
   if (k == 'f') b2 .bboxDisplay = false;
}
"
}
ROUTE K.keyPress TO R.on_key
