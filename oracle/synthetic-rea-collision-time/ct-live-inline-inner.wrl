#X3D V4.0 utf8
PROFILE Full
COMPONENT Scripting:1
# REA collision / billboard oracle world (generated by oracle/tools/gen_rea_collision_time.py).
DEF T1 Transform { translation 0 1.5 4 children [ DEF C1 Collision { children [
Shape { appearance Appearance { material Material { diffuseColor 0.8 0.3 0.3 } } geometry Box { size 8 3 0.4 } }
] } ] }
DEF LOGI Script {
  inputOnly SFBool a
  inputOnly SFTime t
  url "ecmascript:
    function a (v, ts) { print ('inner C1.isActive=' + v + '@' + (ts - 946684800) .toFixed (6)); }
    function t (v, ts) { print ('inner C1.collideTime=' + (v - 946684800) .toFixed (6)); }
"
}
ROUTE C1.isActive TO LOGI.a
ROUTE C1.collideTime TO LOGI.t
EXPORT C1
