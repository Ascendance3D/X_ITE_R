#X3D V4.0 utf8
PROFILE Full
COMPONENT Scripting:1
# REA collision / billboard oracle world (generated by oracle/tools/gen_rea_collision_time.py).
NavigationInfo { type [ "WALK" ] avatarSize [ 0.25 1.6 0.75 ] speed 4 transitionType [ "TELEPORT" ] }
Viewpoint { position 0 1.6 12  description "start" }
Transform { translation 0 -0.1 0 children Shape { appearance Appearance { material Material { diffuseColor 0.4 0.4 0.4 } } geometry Box { size 60 0.2 60 } } }
DEF INL Inline { url "ct-live-inline-inner.wrl" }
IMPORT INL.C1 AS C1
Transform { translation 5 0.5 6 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.9 0.2 } } geometry Box { size 1 1 1 } } }
Transform { translation -6 1.0 9 children Shape { appearance Appearance { material Material { diffuseColor 0.2 0.9 0.9 } } geometry Box { size 1 2 1 } } }
Transform { translation 0 2.5 -9 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.2 0.9 } } geometry Box { size 6 0.4 0.4 } } }
DEF LOG Script {
  inputOutput SFString hist ""
  field SFInt32 step 0
  outputOnly SFBool load_out
  inputOnly SFBool C1_a
  inputOnly SFTime C1_t
  url "ecmascript:
    function C1_a (v, t) { hist = hist + ' ' + 'C1.isActive=' + v + '@' + (t - 946684800) .toFixed (6); }
    function C1_t (v, t) { hist = hist + ' ' + 'C1.collideTime=' + (v - 946684800) .toFixed (6); }
    function prepareEvents (t) { var e = t - 946684800;
      if (step == 0 && e >= 2.6) { step = 1; hist = hist + ' ' + 'load=FALSE@' + e .toFixed (6); load_out = false; }
      else if (step == 1 && e >= 4.3) { step = 2; hist = hist + ' ' + 'load=TRUE@' + e .toFixed (6); load_out = true; } }
"
}
ROUTE C1.isActive TO LOG.C1_a
ROUTE C1.collideTime TO LOG.C1_t
ROUTE LOG.load_out TO INL.set_load
