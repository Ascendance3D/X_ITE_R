#VRML V2.0 utf8
# Synthetic, newly authored for the Rust port R0.3-D (no archive content).
# A world with one Script of its own and an Inline whose scene holds Scripts with shutdown ().
DEF Outer Script {
  url "javascript:
    function initialize () { print ('Outer initialize'); }
    function shutdown () { print ('Outer shutdown'); }
  "
}
DEF Holder Group { children [ DEF Inl Inline { url "content-shutdown.wrl" } ] }
