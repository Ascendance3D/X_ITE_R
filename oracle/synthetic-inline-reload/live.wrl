#VRML V2.0 utf8
# Synthetic, newly authored for the Rust port R0.3-C (no archive content).
# Scene L: a looping clock, a script that reports every tenth of the cycle and a mover.
DEF ClockL TimeSensor { cycleInterval 1 loop TRUE }
DEF ReportL Script {
  eventIn SFFloat set_fraction
  eventOut SFVec3f pos
  field SFInt32 last -1
  url "javascript:
    function initialize () { print ('L initialize'); }
    function set_fraction (f) {
      pos = new SFVec3f (f * 2, 0, 0);
      var q = Math.floor (f * 10);
      if (q != last) { last = q; print ('L fraction ' + q); }
    }
    function shutdown () { print ('L shutdown'); }
  "
}
DEF MoverL Transform { children Shape { geometry Box { size 1 1 1 } } }
ROUTE ClockL.fraction_changed TO ReportL.set_fraction
ROUTE ReportL.pos TO MoverL.set_translation
