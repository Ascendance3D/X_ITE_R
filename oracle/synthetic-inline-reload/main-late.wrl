#VRML V2.0 utf8
# Synthetic, newly authored for the Rust port R0.3-C (no archive content).
# The Inline starts with a file that is published later (see the scenario).
DEF Holder Group { children [ DEF Inl Inline { url "late.wrl" } ] }
DEF ParentClock TimeSensor { cycleInterval 0.5 loop TRUE }
DEF ParentScript Script {
  eventIn SFTime tick
  field SFInt32 n 0
  url "javascript:
    function tick (t) { n = n + 1; print ('parent tick ' + n); }
  "
}
ROUTE ParentClock.cycleTime TO ParentScript.tick
