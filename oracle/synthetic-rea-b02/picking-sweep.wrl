ROUTE BC.isActive TO R.on_BC_a
ROUTE BC.pickedGeometry TO R.on_BC_g
ROUTE BA.isActive TO R.on_BA_a
ROUTE BA.pickedGeometry TO R.on_BA_g
ROUTE BS.isActive TO R.on_BS_a
ROUTE BS.pickedGeometry TO R.on_BS_g
ROUTE BN.isActive TO R.on_BN_a
ROUTE BN.pickedGeometry TO R.on_BN_g
ROUTE GC.isActive TO R.on_GC_a
ROUTE GC.pickedGeometry TO R.on_GC_g
ROUTE GC.pickedPoint TO R.on_GC_p
ROUTE GC.pickedNormal TO R.on_GC_n
ROUTE GC.pickedTextureCoordinate TO R.on_GC_t
ROUTE GA.isActive TO R.on_GA_a
