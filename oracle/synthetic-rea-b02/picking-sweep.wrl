  inputOnly MFVec3f on_GS_t
  inputOutput MFVec3f GS_t [ ]
  inputOutput SFInt32 GS_t_count 0
  inputOutput SFString log ""
  url "javascript:
function on_BC_a (value) { BC_a = value; BC_a_count = BC_a_count + 1; log = log + 'BC_a' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
