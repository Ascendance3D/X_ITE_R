#X3D V4.0 utf8
PROFILE Interchange
COMPONENT Picking:3
COMPONENT Scripting:1
COMPONENT KeyDeviceSensor:1
COMPONENT Geometry2D:1
Viewpoint { position 0 0 16 }
NavigationInfo { headlight TRUE }
DEF T1 Transform { translation -3 0 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.3 0.2 transparency 0.3 } } geometry Box { size 2 2 2 } } }
DEF T2 Transform { translation -1.5 0.3 0 children Shape { appearance Appearance { material Material { diffuseColor 0.2 0.8 0.3 transparency 0.3 } } geometry Sphere { radius 1 } } }
DEF T3 Transform { translation 3 0 0 rotation 0 0 1 0.5 children Shape { appearance Appearance { material Material { diffuseColor 0.2 0.3 0.9 transparency 0.3 } } geometry Cone { bottomRadius 1 height 2 } } }
DEF T4 Transform { translation 1 -2.5 0 children Shape { appearance Appearance { material Material { diffuseColor 0.6 0.6 0.6 transparency 0.3 } } geometry Box { size 1 1 1 } } }
DEF T5 Transform { translation 5.5 1.4 0 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.8 0.2 transparency 0.3 } } geometry Box { size 1 1 1 } } }
DEF T6 Transform { translation 5.5 -1.4 0 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.2 0.8 transparency 0.3 } } geometry Box { size 1 1 1 } } }
DEF MOVER Transform { translation -7 0 0 children [
  Shape { appearance Appearance { material Material { emissiveColor 1 1 1 } } geometry DEF LINE IndexedLineSet { coord Coordinate { point [ -1 0 0, 1 0 0, 0 -1 0.2, 0 1 0.2 ] } coordIndex [ 0 1 -1 2 3 -1 ] } }
  DEF BC LinePickSensor { intersectionType "BOUNDS" sortOrder "CLOSEST" pickingGeometry USE LINE pickTarget [ USE T1 USE T2 USE T3 USE T5 USE T6 ] }
  DEF BA LinePickSensor { intersectionType "BOUNDS" sortOrder "ALL" pickingGeometry USE LINE pickTarget [ USE T1 USE T2 USE T3 USE T5 USE T6 ] }
  DEF BS LinePickSensor { intersectionType "BOUNDS" sortOrder "ALL_SORTED" pickingGeometry USE LINE pickTarget [ USE T1 USE T2 USE T3 USE T5 USE T6 ] }
  DEF BN LinePickSensor { intersectionType "BOUNDS" sortOrder "ANY" pickingGeometry USE LINE pickTarget [ USE T1 USE T2 USE T3 USE T5 USE T6 ] }
  DEF GC LinePickSensor { intersectionType "GEOMETRY" sortOrder "CLOSEST" pickingGeometry USE LINE pickTarget [ USE T1 USE T2 USE T3 USE T5 USE T6 ] }
  DEF GA LinePickSensor { intersectionType "GEOMETRY" sortOrder "ALL" pickingGeometry USE LINE pickTarget [ USE T1 USE T2 USE T3 USE T5 USE T6 ] }
  DEF GS LinePickSensor { intersectionType "GEOMETRY" sortOrder "ALL_SORTED" pickingGeometry USE LINE pickTarget [ USE T1 USE T2 USE T3 USE T5 USE T6 ] }
] }
DEF CLOCK TimeSensor { cycleInterval 4 loop TRUE }
DEF PATH PositionInterpolator { key [ 0 1 ] keyValue [ -7 0 0, 7 0 0 ] }
ROUTE CLOCK.fraction_changed TO PATH.set_fraction
ROUTE PATH.value_changed TO MOVER.set_translation
DEF R Script {
  directOutput TRUE
  inputOnly SFBool on_BC_a
  inputOutput SFBool BC_a FALSE
  inputOutput SFInt32 BC_a_count 0
  inputOnly MFNode on_BC_g
  inputOutput MFNode BC_g [ ]
