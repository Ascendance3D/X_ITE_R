DEF L_good LoadSensor { children USE M_good }
DEF K KeySensor { }
DEF S Script {
  directOutput TRUE
  inputOnly SFString press
  inputOnly SFBool static_loaded
  inputOnly SFInt32 static_width
  inputOnly SFInt32 static_height
  inputOnly SFTime static_duration
  inputOnly SFBool notpng_loaded
  inputOnly SFInt32 notpng_width
  inputOnly SFInt32 notpng_height
  inputOnly SFTime notpng_duration
  inputOnly SFBool noframes_loaded
  inputOnly SFInt32 noframes_width
  inputOnly SFInt32 noframes_height
  inputOnly SFTime noframes_duration
  inputOnly SFBool trunchead_loaded
  inputOnly SFInt32 trunchead_width
  inputOnly SFInt32 trunchead_height
  inputOnly SFTime trunchead_duration
  inputOnly SFBool fallback_loaded
  inputOnly SFInt32 fallback_width
  inputOnly SFInt32 fallback_height
  inputOnly SFTime fallback_duration
  inputOnly SFBool truncanim_loaded
  inputOnly SFInt32 truncanim_width
  inputOnly SFInt32 truncanim_height
  inputOnly SFTime truncanim_duration
  inputOnly SFBool baddata_loaded
  inputOnly SFInt32 baddata_width
  inputOnly SFInt32 baddata_height
  inputOnly SFTime baddata_duration
  inputOnly SFBool good_loaded
  inputOnly SFInt32 good_width
  inputOnly SFInt32 good_height
  inputOnly SFTime good_duration
  initializeOnly MFNode movies [ USE M_static USE M_notpng USE M_noframes USE M_trunchead USE M_fallback USE M_truncanim USE M_baddata USE M_good ]
  url "javascript:
var next = 0;

function press (value, time)
{
   switch (next ++)
   {
      case 0: movies [0] .url = new MFString ('media/static.png'); print ('static url'); break;
      case 1: movies [1] .url = new MFString ('media/notpng.png'); print ('notpng url'); break;
      case 2: movies [2] .url = new MFString ('media/noframes.png'); print ('noframes url'); break;
      case 3: movies [3] .url = new MFString ('media/trunc-head.png'); print ('trunchead url'); break;
      case 4: movies [4] .url = new MFString ('media/trunc-head.png', 'media/good.png'); print ('fallback url'); break;
      case 5: movies [5] .url = new MFString ('media/trunc-anim.png'); print ('truncanim url'); break;
      case 6: movies [6] .url = new MFString ('media/bad-data.png'); print ('baddata url'); break;
      case 7: movies [7] .url = new MFString ('media/good.png'); print ('good url'); break;
   }
}

