DEF L_fallback LoadSensor { children USE M_fallback }
Transform { translation -1.1 -1.1 0 children Shape { appearance Appearance { texture DEF M_truncanim MovieTexture { } } geometry IndexedFaceSet { solid FALSE coord Coordinate { point [ -0.9 -0.9 0, 0.9 -0.9 0, 0.9 0.9 0, -0.9 0.9 0 ] } coordIndex [ 0 1 2 3 -1 ] texCoord TextureCoordinate { point [ 0 0, 1 0, 1 1, 0 1 ] } } } }
