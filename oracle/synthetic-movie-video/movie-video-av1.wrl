DEF K KeySensor { }
DEF S Script {
  directOutput TRUE
  inputOnly SFString press
  initializeOnly MFNode movies [ USE M0 USE M1 USE M2 USE M3 USE M4 USE M5 ]
  url "javascript:
function press (value, time)
{
   for (var i = 0; i < movies .length; ++ i)
   {
      movies [i] .loop = true;
      movies [i] .startTime = time;
   }
}
"
}
ROUTE K.keyPress TO S.press
