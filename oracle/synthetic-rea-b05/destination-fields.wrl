#X3D V4.0 utf8
PROFILE Full
COMPONENT Sound:2
DEF D AudioDestination { gain 0.5 channelCount 1 channelCountMode "EXPLICIT" children DEF O OscillatorSource { frequency 220 periodicWave PeriodicWave { type "SAWTOOTH" } } } DEF P Script { inputOnly SFBool a inputOnly SFTime e inputOnly SFInt32 m url "ecmascript:
function a (v, t) { print ('active ' + v + ' ' + t); }
function e (v, t) { print ('elapsed ' + v.toFixed (6)); }
function m (v, t) { print ('max ' + v); }
" } ROUTE D.isActive TO P.a ROUTE D.maxChannelCount TO P.m
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  inputOnly SFTime set_time
  outputOnly SFTime start
  initializeOnly SFInt32 n 0
  url "ecmascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
