#VRML V2.0 utf8
Viewpoint { position 0 0 0 }
Sound { minFront 20 minBack 20 maxFront 40 maxBack 40 location 0 0 -5 intensity 0.25 source DEF O AudioClip { url "media/tone48k-stereo.wav" loop TRUE } }
Sound { minFront 20 minBack 20 maxFront 40 maxBack 40 location 3 0 0 intensity 2 source DEF O2 AudioClip { url "media/tone48k-stereo.wav" loop TRUE } }
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  eventIn SFTime set_time
  eventOut SFTime start
  field SFInt32 n 0
  url "javascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
ROUTE S.start TO O2.startTime
