#X3D V4.0 utf8
PROFILE Full
COMPONENT Sound:2
AudioDestination { children ChannelMerger { children [ DEF O OscillatorSource { frequency 220 periodicWave PeriodicWave { type "SAWTOOTH" } } OscillatorSource { frequency 330 } ] } }
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  inputOnly SFTime set_time
  outputOnly SFTime start
  initializeOnly SFInt32 n 0
  url "ecmascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
