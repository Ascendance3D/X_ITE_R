#X3D V4.0 utf8
PROFILE Full
COMPONENT Sound:2
Transform { translation 2 0 -1 children DEF Z SpatialSound { children DEF O OscillatorSource { frequency 220 periodicWave PeriodicWave { type "SAWTOOTH" } } } }
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  inputOnly SFTime set_time
  outputOnly SFTime start
  initializeOnly SFInt32 n 0
  url "ecmascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
DEF K Script { directOutput TRUE initializeOnly SFNode z USE Z inputOnly SFTime set_time initializeOnly SFInt32 n 0 url "ecmascript:
function set_time (value) { ++ n;
   if (n === 18) { z.location = new SFVec3f (1, 0, 0); z.direction = new SFVec3f (1, 0, 0); z.coneInnerAngle = 0.4; z.coneOuterAngle = 1; z.coneOuterGain = 0.1; }
   if (n === 24) { z.distanceModel = 'LINEAR'; z.maxDistance = 6; }
   if (n === 30) { z.gain = 0.4; z.intensity = 0.5; }
}
" }
ROUTE T.time TO K.set_time
