#X3D V4.0 utf8
PROFILE Full
COMPONENT Sound:2
Viewpoint { position 0 0 0 }
Sound { minFront 20 minBack 20 maxFront 40 maxBack 40 location 0 0 -5 source DEF O AudioClip { url [ "media/bad.mid" "media/bad2.mid" ] loop TRUE stopTime 1 } }
DEF L LoadSensor { children USE O }
DEF PL Script { inputOnly SFBool a inputOnly SFBool l inputOnly SFFloat p inputOnly SFTime t url "ecmascript:
function a (v, t) { print ('L isActive ' + v + ' ' + t); }
function l (v, t) { print ('L isLoaded ' + v + ' ' + t); }
function p (v, t) { print ('L progress ' + v + ' ' + t); }
function t (v, t) { print ('L loadTime ' + v + ' ' + t); }
" }
ROUTE L.isActive TO PL.a
ROUTE L.isLoaded TO PL.l
ROUTE L.progress TO PL.p
ROUTE L.loadTime TO PL.t
DEF PO Script { inputOnly SFBool a inputOnly SFTime d url "javascript:
function a (v, t) { print ('O active ' + v + ' ' + t); }
function d (v, t) { print ('O duration ' + v + ' ' + t); }
" }
ROUTE O.isActive TO PO.a
ROUTE O.duration_changed TO PO.d
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  inputOnly SFTime set_time
  outputOnly SFTime start
  initializeOnly SFInt32 n 0
  url "javascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
