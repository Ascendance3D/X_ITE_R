#X3D V4.0 utf8
PROFILE Full
COMPONENT Sound:2
AudioDestination { children DEF A Analyser { fftSize 1000 smoothingTimeConstant 0 children ChannelMerger { children [ DEF O OscillatorSource { frequency 220 periodicWave PeriodicWave { type "SAWTOOTH" } } OscillatorSource { frequency 330 } ] } } } DEF P Script { inputOnly MFFloat ff inputOnly MFFloat ft inputOnly MFInt32 bf inputOnly MFInt32 bt url "ecmascript:
function j (v) { var s = v.length + ':'; for (var i = 0; i < v.length; ++ i) s += ' ' + v [i]; return s; }
function ff (v) { print ('ff ' + j (v)); }
function ft (v) { print ('ft ' + j (v)); }
function bf (v) { print ('bf ' + j (v)); }
function bt (v) { print ('bt ' + j (v)); }
" } ROUTE A.floatFrequencyData TO P.ff ROUTE A.floatTimeDomainData TO P.ft ROUTE A.byteFrequencyData TO P.bf ROUTE A.byteTimeDomainData TO P.bt
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  inputOnly SFTime set_time
  outputOnly SFTime start
  initializeOnly SFInt32 n 0
  url "ecmascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
ROUTE S.start TO A.startTime
