#X3D V4.0 utf8
PROFILE Full
COMPONENT Sound:2
Viewpoint { position 1 0 5 orientation 0 1 0 0.4 } ListenerPointSource { trackCurrentView TRUE } Transform { translation 2 0 -2 children SpatialSound { children DEF O OscillatorSource { frequency 220 periodicWave PeriodicWave { type "SAWTOOTH" } } } }
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  inputOnly SFTime set_time
  outputOnly SFTime start
  initializeOnly SFInt32 n 0
  url "ecmascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
