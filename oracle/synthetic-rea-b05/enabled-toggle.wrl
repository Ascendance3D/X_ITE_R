#X3D V4.0 utf8
PROFILE Full
COMPONENT Sound:2
AudioDestination { children DEF G Gain { children [ DEF O OscillatorSource { frequency 220 periodicWave PeriodicWave { type "SAWTOOTH" } } DEF O2 OscillatorSource { frequency 330 periodicWave PeriodicWave { type "SQUARE" } gain 0.5 } ] } }
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  inputOnly SFTime set_time
  outputOnly SFTime start
  initializeOnly SFInt32 n 0
  url "ecmascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
ROUTE S.start TO O2.startTime
DEF K Script { directOutput TRUE initializeOnly SFNode g USE G inputOnly SFTime set_time initializeOnly SFInt32 n 0 url "ecmascript:
function set_time (value) { ++ n;
   if (n === 20) { g.enabled = false; }
   if (n === 26) { g.enabled = true; }
}
" }
ROUTE T.time TO K.set_time
