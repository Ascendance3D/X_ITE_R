#X3D V4.0 utf8
PROFILE Full
COMPONENT Sound:2
Viewpoint { position 0 0 0 }
DEF SND Sound { minFront 20 minBack 20 maxFront 40 maxBack 40 location 0 0 -5 source DEF O AudioClip { url "media/tone48k-stereo.wav" loop TRUE } }
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  inputOnly SFTime set_time
  outputOnly SFTime start
  initializeOnly SFInt32 n 0
  url "javascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
DEF K Script { directOutput TRUE initializeOnly SFNode o USE SND inputOnly SFTime set_time initializeOnly SFInt32 n 0 url "ecmascript:
function set_time (value) { ++ n;
   if (n === 20) { o.enabled = false; }
   if (n === 28) { o.enabled = true; }
}
" }
ROUTE T.time TO K.set_time
