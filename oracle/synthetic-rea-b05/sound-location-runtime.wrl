#VRML V2.0 utf8
Viewpoint { position 0 0 0 }
DEF SND Sound { minFront 20 minBack 20 maxFront 40 maxBack 40 location 3 0 0 source DEF O AudioClip { url "media/tone48k-stereo.wav" loop TRUE } }
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  eventIn SFTime set_time
  eventOut SFTime start
  field SFInt32 n 0
  url "javascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
DEF K Script { directOutput TRUE field SFNode o USE SND eventIn SFTime set_time field SFInt32 n 0 url "javascript:
function set_time (value) { ++ n;
   if (n === 20) { o.location = new SFVec3f (-3, 0, 0); }
   if (n === 28) { o.direction = new SFVec3f (1, 0, 0); }
   if (n === 36) { o.maxFront = 6; o.minFront = 2; }
   if (n === 44) { o.location = new SFVec3f (0, 0, -30); }
}
" }
ROUTE T.time TO K.set_time
