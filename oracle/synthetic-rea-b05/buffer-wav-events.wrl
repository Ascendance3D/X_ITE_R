#X3D V4.0 utf8
PROFILE Full
COMPONENT Sound:2
AudioDestination { children DEF O BufferAudioSource { url "media/tone48k-stereo.wav" } } DEF P Script { inputOnly SFBool a inputOnly SFTime e inputOnly SFInt32 nc url "ecmascript:
function a (v, t) { print ('active ' + v + ' ' + t); }
function nc (v, t) { print ('channels ' + v + ' ' + t); }
function bd (v, t) { print ('duration ' + v + ' ' + t); }
" inputOnly SFTime bd } ROUTE O.isActive TO P.a ROUTE O.numberOfChannels TO P.nc ROUTE O.bufferDuration TO P.bd
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  inputOnly SFTime set_time
  outputOnly SFTime start
  initializeOnly SFInt32 n 0
  url "ecmascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
