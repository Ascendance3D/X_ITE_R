#X3D V4.0 utf8
PROFILE Full
COMPONENT Sound:2
DEF L Transform { translation 1 0 2 rotation 0 1 0 0.7 children ListenerPointSource { } } Transform { translation -2 1 -3 children SpatialSound { children DEF O OscillatorSource { frequency 220 periodicWave PeriodicWave { type "SAWTOOTH" } } } }
DEF T TimeSensor { loop TRUE cycleInterval 0.5 }
DEF S Script {
  inputOnly SFTime set_time
  outputOnly SFTime start
  initializeOnly SFInt32 n 0
  url "ecmascript:
function set_time (value) { if (++ n === 12) start = value; }
"
}
ROUTE T.time TO S.set_time
ROUTE S.start TO O.startTime
