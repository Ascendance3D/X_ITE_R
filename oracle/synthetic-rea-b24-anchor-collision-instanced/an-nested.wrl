#X3D V4.0 utf8
PROFILE Full
COMPONENT X_ITE:1
# REA batch 24 oracle world (generated by oracle/tools/gen_rea_b24_anchor_collision_instanced.py).
COMPONENT PointingDeviceSensor:1
COMPONENT Scripting:1
COMPONENT KeyDeviceSensor:1
DEF V1 Viewpoint { position 0 0 10 description "v1" }
NavigationInfo { type "NONE" headlight TRUE transitionType [ "TELEPORT" ] }
Background { skyColor 0.1 0.1 0.15 }
DEF V2 Viewpoint { position 2 0 10 description "v2" }
DEF V3 Viewpoint { position -2 0 10 description "v3" }
DEF V4 Viewpoint { position 0 2 10 description "v4" }
Transform { translation -2.4 1.4 0 children [ DEF AO Anchor { url [ "#V2" ] description "outer" children [ DEF AI Anchor { url [ "#V3" ] description "inner" children [ Shape { appearance Appearance { material Material { diffuseColor 0.8 0.3 0.3 emissiveColor 0.8 0.3 0.3 } } geometry Box { size 1 1 1 } } ] } Transform { translation 0 -1.1 0 children [ Shape { appearance Appearance { material Material { diffuseColor 0.8 0.6 0.6 emissiveColor 0.8 0.6 0.6 } } geometry Box { size 0.8 0.4 0.8 } } ] } ] } ] }
Transform { translation 0.4 1.4 0 children [ DEF AT Anchor { url [ "#V4" ] description "with sensor" children [ DEF TS TouchSensor { description "child sensor" } Shape { appearance Appearance { material Material { diffuseColor 0.3 0.8 0.3 emissiveColor 0.3 0.8 0.3 } } geometry Box { size 1 1 1 } } ] } ] }
Transform { translation 2.6 1.4 0 children [ DEF AI2 Anchor { url [ "#V3" ] description "instanced" children [ InstancedShape { appearance Appearance { material Material { diffuseColor 0.3 0.3 0.8 emissiveColor 0.3 0.3 0.8 } } translations [ -0.5 0 0, 0.5 0.2 0.1 ] rotations [ 0 0 1 0.5 ] geometry Box { size 0.7 0.7 0.7 } } ] } ] }
Transform { translation 0 -1.8 0 children [ DEF AE Anchor { url [ ] description "empty" children [ DEF TE TouchSensor { } Shape { appearance Appearance { material Material { diffuseColor 0.8 0.8 0.3 emissiveColor 0.8 0.8 0.3 } } geometry Box { size 1 1 1 } } ] }
DEF AF Anchor { url [ "#nosuch", "#V2" ] description "fallback" load TRUE children [ Transform { translation 1.6 0 0 children [ Shape { appearance Appearance { material Material { diffuseColor 0.3 0.8 0.8 emissiveColor 0.3 0.8 0.8 } } geometry Box { size 1 1 1 } } ] } ] } ] }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  inputOutput SFString log ""
  initializeOnly SFNode v1 USE V1
  inputOnly SFBool on_1
  inputOnly SFBool on_2
  inputOnly SFBool on_3
  inputOnly SFBool on_4
  inputOnly SFBool on_ov
  inputOnly SFTime on_tt
  inputOnly SFBool on_ov2
  inputOnly SFBool on_ov3
  url "ecmascript:
function on_1 (v) { log = log + 'V1:' + v + ' '; }
function on_2 (v) { log = log + 'V2:' + v + ' '; }
function on_3 (v) { log = log + 'V3:' + v + ' '; }
function on_4 (v) { log = log + 'V4:' + v + ' '; }
function on_ov (v) { log = log + 'TS.over:' + v + ' '; }
function on_ov2 (v) { log = log + 'TE.over:' + v + ' '; }
function on_ov3 (v) { log = log + 'AO.over:' + v + ' '; }
function on_tt (v) { log = log + 'TS.touch '; }
function on_key (k) { log = log + 'K' + k + ' '; if (k == 'z') v1 .set_bind = true; }
"
}
ROUTE K.keyPress TO R.on_key
ROUTE V1.isBound TO R.on_1
ROUTE V2.isBound TO R.on_2
ROUTE V3.isBound TO R.on_3
ROUTE V4.isBound TO R.on_4
ROUTE TS.isOver TO R.on_ov
ROUTE TS.touchTime TO R.on_tt
ROUTE TE.isOver TO R.on_ov2
