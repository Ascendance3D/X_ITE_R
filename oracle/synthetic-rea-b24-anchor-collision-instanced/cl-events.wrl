#X3D V4.0 utf8
PROFILE Full
COMPONENT X_ITE:1
# REA batch 24 oracle world (generated by oracle/tools/gen_rea_b24_anchor_collision_instanced.py).
COMPONENT PointingDeviceSensor:1
COMPONENT Scripting:1
COMPONENT KeyDeviceSensor:1
DEF V1 Viewpoint { position 0 0 10 description "v1" }
NavigationInfo { type "NONE" headlight TRUE transitionType [ "TELEPORT" ] }
Background { skyColor 0.1 0.1 0.15 }
Transform { translation -2.4 1.2 0 children [ DEF C1 Collision { children [ DEF A TouchSensor { } Shape { appearance Appearance { material Material { diffuseColor 0.8 0.3 0.3 emissiveColor 0.8 0.3 0.3 } } geometry Box { size 1 1 1 } } ] } ] }
Transform { translation 0 1.2 0 children [ DEF C2 Collision { children [ DEF B TouchSensor { } Shape { appearance Appearance { material Material { diffuseColor 0.3 0.8 0.3 emissiveColor 0.3 0.8 0.3 } } geometry Box { size 1 1 1 } } ] } ] }
Transform { translation 2.4 1.2 0 children [ DEF C3 Collision { proxy Shape { geometry Box { size 2 2 2 } } children [ DEF C TouchSensor { } Shape { appearance Appearance { material Material { diffuseColor 0.3 0.3 0.8 emissiveColor 0.3 0.3 0.8 } } geometry Box { size 1 1 1 } } ] } ] }
Transform { translation -1.2 -1.4 0 children [ DEF C4 Collision { children [ DEF D TouchSensor { } Shape { appearance Appearance { material Material { diffuseColor 0.8 0.8 0.3 emissiveColor 0.8 0.8 0.3 } } geometry Box { size 1 1 1 } } DEF C5 Collision { children [ DEF E TouchSensor { } Transform { translation 0 0 0.8 children [ Shape { appearance Appearance { material Material { diffuseColor 0.3 0.8 0.8 emissiveColor 0.3 0.8 0.8 } } geometry Box { size 0.5 0.5 0.5 } } ] } ] } ] } ] }
DEF K KeySensor { }
DEF KS Script {
  directOutput TRUE
  inputOnly SFString on_key
  initializeOnly SFNode c1 USE C1
  initializeOnly SFNode c2 USE C2
  initializeOnly SFNode c3 USE C3
  initializeOnly SFNode c4 USE C4
  initializeOnly SFNode c5 USE C5
  url "ecmascript:
function on_key (k)
{
   if (k == 'a') c1 .enabled = false;
   if (k == 'b') c1 .enabled = true;
   if (k == 'c') c2 .visible = false;
   if (k == 'd') c2 .visible = true;
   if (k == 'e') c3 .enabled = false;
   if (k == 'f') c4 .visible = false;
   if (k == 'g') c5 .visible = false;
   if (k == 'h') { c4 .visible = true; c5 .visible = true; }
}
"
}
ROUTE K.keyPress TO KS.on_key
DEF LOG Script {
  inputOutput SFString hist ""
  inputOutput SFInt32 frame 0
  inputOnly SFBool A0
  inputOnly SFBool A1
  inputOnly SFTime A2
  inputOnly SFVec3f A3
  inputOnly SFVec3f A4
  inputOnly SFBool B0
  inputOnly SFBool B1
  inputOnly SFTime B2
  inputOnly SFVec3f B3
  inputOnly SFVec3f B4
  inputOnly SFBool C0
  inputOnly SFBool C1
  inputOnly SFTime C2
  inputOnly SFVec3f C3
  inputOnly SFVec3f C4
  inputOnly SFBool D0
  inputOnly SFBool D1
  inputOnly SFTime D2
  inputOnly SFVec3f D3
  inputOnly SFVec3f D4
  inputOnly SFBool E0
  inputOnly SFBool E1
  inputOnly SFTime E2
  inputOnly SFVec3f E3
  inputOnly SFVec3f E4
  url "ecmascript:
    function A0 (v, t) { hist = hist + ' ' + frame + ':A.isOver=' + v; }
    function A1 (v, t) { hist = hist + ' ' + frame + ':A.isActive=' + v; }
    function A2 (v, t) { hist = hist + ' ' + frame + ':A.touchTime=' + (v - 946684800) .toFixed (4); }
    function A3 (v, t) { hist = hist + ' ' + frame + ':A.hitPoint_changed=' + v; }
    function A4 (v, t) { hist = hist + ' ' + frame + ':A.hitNormal_changed=' + v; }
    function B0 (v, t) { hist = hist + ' ' + frame + ':B.isOver=' + v; }
    function B1 (v, t) { hist = hist + ' ' + frame + ':B.isActive=' + v; }
    function B2 (v, t) { hist = hist + ' ' + frame + ':B.touchTime=' + (v - 946684800) .toFixed (4); }
    function B3 (v, t) { hist = hist + ' ' + frame + ':B.hitPoint_changed=' + v; }
    function B4 (v, t) { hist = hist + ' ' + frame + ':B.hitNormal_changed=' + v; }
    function C0 (v, t) { hist = hist + ' ' + frame + ':C.isOver=' + v; }
    function C1 (v, t) { hist = hist + ' ' + frame + ':C.isActive=' + v; }
    function C2 (v, t) { hist = hist + ' ' + frame + ':C.touchTime=' + (v - 946684800) .toFixed (4); }
    function C3 (v, t) { hist = hist + ' ' + frame + ':C.hitPoint_changed=' + v; }
    function C4 (v, t) { hist = hist + ' ' + frame + ':C.hitNormal_changed=' + v; }
    function D0 (v, t) { hist = hist + ' ' + frame + ':D.isOver=' + v; }
    function D1 (v, t) { hist = hist + ' ' + frame + ':D.isActive=' + v; }
    function D2 (v, t) { hist = hist + ' ' + frame + ':D.touchTime=' + (v - 946684800) .toFixed (4); }
    function D3 (v, t) { hist = hist + ' ' + frame + ':D.hitPoint_changed=' + v; }
    function D4 (v, t) { hist = hist + ' ' + frame + ':D.hitNormal_changed=' + v; }
    function E0 (v, t) { hist = hist + ' ' + frame + ':E.isOver=' + v; }
    function E1 (v, t) { hist = hist + ' ' + frame + ':E.isActive=' + v; }
    function E2 (v, t) { hist = hist + ' ' + frame + ':E.touchTime=' + (v - 946684800) .toFixed (4); }
    function E3 (v, t) { hist = hist + ' ' + frame + ':E.hitPoint_changed=' + v; }
    function E4 (v, t) { hist = hist + ' ' + frame + ':E.hitNormal_changed=' + v; }
    function prepareEvents () { frame = frame + 1; }
"
}
ROUTE A.isOver TO LOG.A0
ROUTE A.isActive TO LOG.A1
ROUTE A.touchTime TO LOG.A2
ROUTE A.hitPoint_changed TO LOG.A3
ROUTE A.hitNormal_changed TO LOG.A4
