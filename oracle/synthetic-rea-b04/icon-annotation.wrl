#X3D V4.0 utf8
# IconAnnotation image loading, an enhancement beyond X_ITE 16.5.0 (owner decision 2026-11-12, ADR 0002).
# X_ITE's dormant IconAnnotation cannot initialize (X3DUrlObject.initialize reads _load, which it does
# not define), and its requestImmediateLoad is empty. The port fetches the url like an ImageTexture, so
# the reference is icon-annotation-ref.wrl: the same world with an ImageTexture, X_ITE's X3DUrlObject
# that fetches an image, in its place (oracle/rea-b04-baseline/standins.json). No url fails: a failure
# message names the node type, and only the scene text is substituted. The url starts empty: the first
# load of a url object that a LoadSensor watches is timed differently from X_ITE here for ImageTexture
# as well (see the lane report), and this case compares the IconAnnotation load, not that timing.
PROFILE Interchange
COMPONENT Annotation:1
COMPONENT Networking:3
COMPONENT KeyDeviceSensor:1
COMPONENT Scripting:1
Viewpoint { position 0 0 6 }
DEF IA IconAnnotation { }
Shape { appearance Appearance { material Material { diffuseColor 0.3 0.6 0.9 } } geometry Sphere { radius 0.5 } }
DEF LS LoadSensor { children USE IA }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  inputOnly MFString on_url
  inputOnly SFTime on_refresh
  inputOnly SFBool on_loaded
  inputOnly SFBool on_active
  inputOnly SFFloat on_progress
  inputOutput SFString log ""
  initializeOnly SFNode ia USE IA
  url "javascript:
function initialize () { log = 'I ' + ia .url + ' ' + ia .autoRefresh + ' ' + ia .autoRefreshTimeLimit + ' '; }
function on_url (v) { log = log + 'U' + v + ' '; }
function on_refresh (v) { log = log + 'R' + v + ' '; }
function on_loaded (v) { log = log + 'L' + v + ' '; }
function on_active (v) { log = log + 'A' + v + ' '; }
function on_progress (v) { log = log + 'P' + v + ' '; }
function on_key (k)
{
   log = log + 'K' + k + ' ';
   if (k == 'a') ia .url = new MFString ('checker.png');
   if (k == 'b') { ia .autoRefresh = 1; ia .autoRefreshTimeLimit = 2; }
   if (k == 'c') ia .url = new MFString ();
}
"
}
ROUTE K.keyPress TO R.on_key
ROUTE IA.url_changed TO R.on_url
ROUTE IA.autoRefresh_changed TO R.on_refresh
ROUTE LS.isLoaded TO R.on_loaded
ROUTE LS.isActive TO R.on_active
ROUTE LS.progress TO R.on_progress
