#VRML V2.0 utf8
# E18 synthetic stress world (generated by oracle/tools/gen_rea_x10_synthetic.py). Clean-room: written for this test.
NavigationInfo { type [ "EXAMINE" ] }
Viewpoint { position 0 3 18 orientation 1 0 0 -0.12 fieldOfView 0.785 description "stress front" }
DirectionalLight { direction -0.3 -1 -0.5 intensity 0.9 }
# A ground plane and a wall: large flat shapes that the camera can cut through when it zooms in.
Transform { translation 0 -4 0 children Shape { appearance Appearance { material Material { diffuseColor 0.45 0.5 0.45 } } geometry Box { size 14 0.2 14 } } }
Transform { translation 0 3 -7 children Shape { appearance Appearance { material Material { diffuseColor 0.6 0.55 0.5 } } geometry Box { size 9 6 0.3 } } }
# A thin ring of boxes and posts near the middle: small shapes right at the center of rotation.
Transform { translation 0 0 0 children [
  Shape { appearance Appearance { material Material { diffuseColor 0.9 0.75 0.2 } } geometry Sphere { radius 1.6 } }
  Transform { translation 2.5 0 0 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.2 0.2 } } geometry Box { size 0.2 3 0.2 } } }
  Transform { translation -2.5 0 0 children Shape { appearance Appearance { material Material { diffuseColor 0.2 0.2 0.8 } } geometry Box { size 0.2 3 0.2 } } }
] }
# The orrery-like chain: arm -> planet -> moon, each level a Transform that an interpolator turns.
DEF X_A Transform { children [
  Transform { translation 6 0 0 children [
    Shape { appearance Appearance { material Material { diffuseColor 0.2 0.6 0.9 } } geometry Sphere { radius 0.9 } }
    Transform { translation 0 -0.3 0 children Shape { appearance Appearance { material Material { diffuseColor 0.7 0.7 0.7 } } geometry Cylinder { radius 1.6 height 0.04 } } }
    DEF X_B Transform { children [
      Transform { translation 2.2 0 0 children [
        Shape { appearance Appearance { material Material { diffuseColor 0.9 0.9 0.9 } } geometry Sphere { radius 0.4 } }
        DEF X_C Transform { children Transform { translation 0 0.9 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.4 0.1 } } geometry Cone { bottomRadius 0.15 height 0.5 } } } }
      ] }
    ] }
  ] }
] }
DEF T_A TimeSensor { cycleInterval 8 loop TRUE }
DEF O_A OrientationInterpolator { key [ 0 0.25 0.5 0.75 1 ] keyValue [ 0 1 0 0.000000, 0 1 0 1.570796, 0 1 0 3.141593, 0 1 0 4.712389, 0 1 0 6.283185 ] }
ROUTE T_A.fraction_changed TO O_A.set_fraction
ROUTE O_A.value_changed TO X_A.set_rotation
DEF T_B TimeSensor { cycleInterval 5 loop TRUE }
DEF O_B OrientationInterpolator { key [ 0 0.25 0.5 0.75 1 ] keyValue [ 0 1 0 0.000000, 0 1 0 1.570796, 0 1 0 3.141593, 0 1 0 4.712389, 0 1 0 6.283185 ] }
ROUTE T_B.fraction_changed TO O_B.set_fraction
ROUTE O_B.value_changed TO X_B.set_rotation
DEF T_C TimeSensor { cycleInterval 2 loop TRUE }
DEF O_C OrientationInterpolator { key [ 0 0.25 0.5 0.75 1 ] keyValue [ 0 1 0 0.000000, 0 1 0 1.570796, 0 1 0 3.141593, 0 1 0 4.712389, 0 1 0 6.283185 ] }
ROUTE T_C.fraction_changed TO O_C.set_fraction
ROUTE O_C.value_changed TO X_C.set_rotation
