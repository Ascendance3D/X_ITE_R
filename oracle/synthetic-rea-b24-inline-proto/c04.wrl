#X3D V3.3 utf8
PROFILE Interchange
COMPONENT Networking:3
COMPONENT Scripting:1
# Synthetic, newly authored for the Rust port REA batch 24, issue #52 (no archive content).
# The instance is removed from its parent: its body, with the loaded Inline, goes away.
PROTO Hold [ initializeOnly SFString tag "a" inputOnly SFTime probe ]
{
  Group { children [
    DEF In Inline { url "leaf.wrl" }
    DEF LS LoadSensor { watchList [ USE In ] }
    DEF Obs Script {
      initializeOnly SFNode inl USE In
      inputOnly SFTime probe IS probe
      inputOnly SFBool active
      inputOnly SFBool loaded
      inputOnly SFFloat progress
      url "javascript:
function show (label)
{
   print ('obs ' + label + ' load=' + inl .load);
}
function initialize () { show ('initialize'); }
function probe (t) { show ('probe'); }
function active (v) { print ('obs isActive ' + v); }
function loaded (v) { print ('obs isLoaded ' + v); }
function progress (v) { print ('obs progress ' + v); }
function shutdown () { show ('shutdown'); }
"
    }
    ROUTE LS.isActive TO Obs.active
    ROUTE LS.isLoaded TO Obs.loaded
    ROUTE LS.progress TO Obs.progress
  ] }
}
DEF G Group { children [ DEF H Hold { } ] }
DEF Clock TimeSensor { cycleInterval 0.1 loop TRUE }
DEF Driver Script {
  inputOnly SFTime tick
  outputOnly SFTime probe_out
  url "javascript:
let n = 0;
function tick (t)
{
   n = n + 1;
   print ('driver tick ' + n);
   if (n == 2) probe_out = t;
   if (n == 3) { Browser .currentScene .getNamedNode ('G') .children = new MFNode (); print ('removed'); }
}
"
}
ROUTE Clock.cycleTime TO Driver.tick
ROUTE Driver.probe_out TO H.probe
