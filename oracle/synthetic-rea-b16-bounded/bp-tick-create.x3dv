#X3D V3.3 utf8
PROFILE Full
COMPONENT ParticleSystems:2

DEF PS ParticleSystem {
  geometryType "POINT"
  maxParticles 4
  particleLifetime 2
  lifetimeVariation 0
  emitter PointEmitter { position 0.3 2 -0.2 direction 0 -1 0 speed 3 variation 0 }
  physics [ DEF BM BoundedPhysicsModel { damping 0.5 geometry IndexedFaceSet { solid FALSE coord Coordinate { point [ -1.0 0 -1.0, 1.0 0 -1.0, 1.0 0 1.0, -1.0 0 1.0 ] } coordIndex [ 0 3 2 1 -1 ] } } ]
}
DEF TS TimeSensor { loop TRUE startTime 1 }
DEF SW Script {
  inputOnly SFTime tick
  initializeOnly SFInt32 n 0
  initializeOnly SFBool done FALSE
  inputOutput SFNode model USE BM
  directOutput TRUE
  url "ecmascript: function tick (value) { n = n + 1; if (!done && value >= 946684800.6833333) { done = true; model .geometry = Browser .createVrmlFromString ('#VRML V2.0 utf8' + String .fromCharCode (10) + 'Shape { geometry Box { size 3 0.2 3 } }') [0] .geometry; } }"
}
ROUTE TS.time TO SW.tick
