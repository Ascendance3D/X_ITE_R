#X3D V3.3 utf8
PROFILE Full
COMPONENT ParticleSystems:2

DEF PS ParticleSystem {
  geometryType "POINT"
  maxParticles 4
  particleLifetime 2
  lifetimeVariation 0
  emitter PointEmitter { position 0.3 2 -0.2 direction 0 -1 0 speed 3 variation 0 }
  physics [ DEF BM BoundedPhysicsModel { damping 0.5 geometry IndexedFaceSet { solid FALSE coord DEF CO Coordinate { point [ -1 0 -1, 1 0 -1, 1 0 1, -1 0 1 ] } coordIndex [ 0 3 2 1 -1 ] } } ]
}
DEF TS TimeSensor { loop TRUE startTime 1 }
DEF SW Script {
  inputOnly SFTime tick
  initializeOnly SFInt32 n 0
  initializeOnly SFBool done FALSE
  inputOutput SFNode co USE CO
  directOutput TRUE
  url "ecmascript: function tick (value) { n = n + 1; if (!done && value >= 946684800.7833333) { done = true; co .point = new MFVec3f (new SFVec3f (-1, 1.45, -1), new SFVec3f (1, 1.45, -1), new SFVec3f (1, 1.45, 1), new SFVec3f (-1, 1.45, 1)); } }"
}
ROUTE TS.time TO SW.tick
