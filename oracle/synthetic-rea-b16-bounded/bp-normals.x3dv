#X3D V3.3 utf8
PROFILE Full
COMPONENT ParticleSystems:2

DEF PS ParticleSystem {
  geometryType "POINT"
  maxParticles 4
  particleLifetime 2
  lifetimeVariation 0
  emitter PointEmitter { position 0.3 2 -0.2 direction 0 -1 0 speed 3 variation 0 }
  physics [ DEF BM BoundedPhysicsModel { damping 0.8 geometry IndexedFaceSet { solid FALSE normalPerVertex TRUE coord Coordinate { point [ -1 0 -1, 1 0 -1, 1 0 1, -1 0 1 ] } normal Normal { vector [ 0.4 1 0, 0 1 0.3, -0.2 1 -0.5, 0.6 1 0.6 ] } coordIndex [ 0 3 2 1 -1 ] } } ]
}
