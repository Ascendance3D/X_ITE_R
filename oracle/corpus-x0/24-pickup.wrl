startTime  -1
}
DEF a7 a { v [ 0 -1 0 0 0 -1 0 1.307 ] }
DEF a8 a { v [ 0 1 0 0 0 1 0 1.004 ] }
DEF a9
TimeSensor {
cycleInterval 15.000
startTime  -1
}
DEF ba
a { k [ 0 .75 .812 .875 .937 1 ] v [ 0 -1 0 1.307 0 -1 0 1.307 0 -1 0 .937
0 -1 0 .728 0 -1 0 .148 0 -1 0 0 ] }
DEF bb
a { k [ 0 .75 .812 .875 .937 1 ] v [ 0 1 0 1.004 0 1 0 1.004 0 1 0 .606 0
1 0 .526 0 1 0 .303 0 1 0 0 ] }
DEF bc
Script {
field    SFNode      tproc
USE a6
field    SFBool state     FALSE
field    SFTime pause     0
eventIn  SFTime toggle
eventOut SFTime triggerStart
eventOut SFTime triggerStop
eventOut SFTime triggerStartInt
eventIn  SFBool activated
eventIn  SFTime cycle
directOutput TRUE
url "vrmlscript:
function activated( active, curtime ) {
if( active ) {
triggerStart = curtime;
state = TRUE;
}
else {
triggerStop = curtime;
state = FALSE;
}
}
function cycle( curtime ) {
triggerStartInt = curtime;
}
function toggle( stime ) {
if( state )
{
state = FALSE;
pause = stime - tproc.startTime_changed;
tproc.enabled = FALSE;
}
else
{
state = TRUE;
tproc.set_startTime = stime - pause;
tproc.enabled = TRUE;
pause = 0;
}
}
"
}
DEF bd
Script {
field    SFNode      tproc
USE a9
field    SFBool state     FALSE
field    SFTime pause     0
eventIn  SFTime startAt0
eventOut SFTime triggerStart
eventOut SFTime triggerStop
eventOut SFTime triggerStartInt
eventIn  SFBool activated
eventIn  SFTime cycle
directOutput TRUE
url "vrmlscript:
function activated( active, curtime ) {
if( active ) {
triggerStart = curtime;
state = TRUE;
}
else {
triggerStop = curtime;
state = FALSE;
}
}
function cycle( curtime ) {
triggerStartInt = curtime;
}
function startAt0( stime ) {
state = TRUE;
tproc.set_startTime = stime;
tproc.enabled = TRUE;
pause = 0;
}
"
}
ROUTE a5.touchTime TO bc.toggle
ROUTE a6.fraction_changed TO a7.i
ROUTE a7.o TO f.set_rotation
ROUTE a6.fraction_changed TO a8.i
ROUTE a8.o TO l.set_rotation
ROUTE a6.isActive TO bc.activated
ROUTE a6.cycleTime TO bc.cycle
ROUTE bc.triggerStop TO bd.startAt0
ROUTE a9.fraction_changed TO ba.i
ROUTE ba.o TO f.set_rotation
ROUTE a9.fraction_changed TO bb.i
ROUTE bb.o TO l.set_rotation
ROUTE a9.isActive TO bd.activated
ROUTE a9.cycleTime TO bd.cycle
