#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
# Synthetic REA oracle world (generated by oracle/tools/gen_golden_gate_binary.py): gg-dispatch.
# Each URL list goes through Browser.createX3DFromURL, one after the other; `out` lists the scene head and printed scene or the rejection of each.
DEF OUT Script {
  inputOutput MFString out [ ]
  url "ecmascript:
    var CASES = [[\"dispatch/stl-as-wrl.wrl\"], [\"dispatch/stl-as-txt.txt\"], [\"dispatch/stl-as-json.json\"], [\"dispatch/stl-no-extension\"], [\"dispatch/ply-as-wrl.wrl\"], [\"dispatch/ply-as-stl.stl\"], [\"dispatch/glb-as-wrl.wrl\"], [\"dispatch/glb-as-gltf.gltf\"], [\"dispatch/glb-as-stl.stl\"], [\"dispatch/stl-as-glb.glb\"], [\"dispatch/stl-gz.stl\"], [\"dispatch/glb-gz.glb\"], [\"dispatch/ply-gz.ply\"], [\"dispatch/unknown-high.bin\"], [\"dispatch/unknown-nul.bin\"], [\"dispatch/unknown-ff.bin\"], [\"dispatch/unknown-ascii.bin\"], [\"dispatch/empty.bin\"], [\"dispatch/one-byte.bin\"], [\"dispatch/stl-valid-size-but-text.bin\"], [\"dispatch/magic-ply-text-header.bin\"], [\"dispatch/glb-magic-only.bin\"], [\"dispatch/unknown-high.bin\", \"stl/tri.stl\"], [\"dispatch/unknown-high.bin\", \"dispatch/missing.glb\"], [\"dispatch/unknown-high.bin\", \"dispatch/unknown-ff.bin\", \"glb/tri.glb\"], [\"glb/bad-version.glb\", \"ply/tri-le.ply\"], [\"stl/bad-count.stl\", \"stl/tri.stl\", \"ply/tri-le.ply\"]];
    var res = [];
    function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
    function put (i, v) { res [i] = i + ': ' + v; var o = []; for (var k = 0; k < CASES .length; ++ k) o .push (k in res ? res [k] : k + ': ...'); out = new MFString (... o); }
    function run (i) {
      if (i >= CASES .length) return;
      var p;
      try { p = Browser .createX3DFromURL (new MFString (... CASES [i])); } catch (e) { put (i, 'THROW ' + strip (e .message)); run (i + 1); return; }
      p .then (function (sc) {
        var head = [sc .encoding, sc .specificationVersion, sc .profile && sc .profile .name, sc .rootNodes .length, sc .protos .length, sc .externprotos .length, sc .routes .length, sc .importedNodes .length, sc .exportedNodes .length, strip (sc .worldURL)] .join ('/');
        var text; try { text = sc .toVRMLString (); } catch (e) { text = 'PRINT ERR ' + e .message; }
        put (i, 'RES ' + head + '\n' + text);
        run (i + 1);
      }, function (e) { put (i, 'REJ ' + strip (e && e .message)); run (i + 1); });
    }
    function initialize () { run (0); }
  "
}
