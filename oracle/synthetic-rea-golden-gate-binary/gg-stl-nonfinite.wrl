#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
# Synthetic REA oracle world (generated by oracle/tools/gen_golden_gate_binary.py): gg-stl-nonfinite.
# Each URL list goes through Browser.createX3DFromURL, one after the other; `out` lists the scene head and printed scene or the rejection of each.
DEF OUT Script {
  inputOutput MFString out [ ]
  url "ecmascript:
    var CASES = [[\"stl/nonfinite-coord-nan.stl\"], [\"stl/nonfinite-coord-inf.stl\"], [\"stl/nonfinite-coord-ninf.stl\"], [\"stl/nonfinite-normal-nan.stl\"], [\"stl/nonfinite-normal-inf.stl\"], [\"stl/nonfinite-normal-ninf.stl\"], [\"stl/nonfinite-all-nan.stl\"], [\"stl/nonfinite-all-inf.stl\"], [\"stl/nonfinite-all-ninf.stl\"], [\"stl/nonfinite-mixed.stl\"], [\"stl/ascii-tri.stl\"], [\"stl/ascii-coord-nan.stl\"], [\"stl/ascii-coord-inf.stl\"], [\"stl/ascii-coord-ninf.stl\"], [\"stl/ascii-coord-infshort.stl\"], [\"stl/ascii-coord-nanlow.stl\"], [\"stl/ascii-coord-pnan.stl\"], [\"stl/ascii-coord-mnan.stl\"], [\"stl/ascii-coord-pinf.stl\"], [\"stl/ascii-coord-minf.stl\"], [\"stl/ascii-coord-minfu.stl\"], [\"stl/ascii-coord-pinfinity.stl\"], [\"stl/ascii-normal-nan.stl\"], [\"stl/ascii-normal-inf.stl\"], [\"stl/ascii-normal-ninf.stl\"], [\"stl/ascii-normal-infshort.stl\"], [\"stl/ascii-normal-nanlow.stl\"], [\"stl/ascii-normal-pnan.stl\"], [\"stl/ascii-normal-mnan.stl\"], [\"stl/ascii-normal-pinf.stl\"], [\"stl/ascii-normal-minf.stl\"], [\"stl/ascii-normal-minfu.stl\"], [\"stl/ascii-normal-pinfinity.stl\"], [\"stl/tri.stl\"]];
    var res = [];
    function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
    function put (i, v) { res [i] = i + ': ' + v; var o = []; for (var k = 0; k < CASES .length; ++ k) o .push (k in res ? res [k] : k + ': ...'); out = new MFString (... o); }
    function run (i) {
      if (i >= CASES .length) return;
      var p;
      try { p = Browser .createX3DFromURL (new MFString (... CASES [i])); } catch (e) { put (i, 'THROW ' + strip (e .message)); run (i + 1); return; }
      p .then (function (sc) {
        var head = [sc .encoding, sc .specificationVersion, sc .profile && sc .profile .name, sc .rootNodes .length, sc .protos .length, sc .externprotos .length, sc .routes .length, sc .importedNodes .length, sc .exportedNodes .length, strip (sc .worldURL)] .join ('/');
        var text; try { text = sc .toVRMLString (); } catch (e) { text = 'PRINT ERR ' + e .message; }
        put (i, 'RES ' + head + '\n' + text);
        run (i + 1);
      }, function (e) { put (i, 'REJ ' + strip (e && e .message)); run (i + 1); });
    }
    function initialize () { run (0); }
  "
}
