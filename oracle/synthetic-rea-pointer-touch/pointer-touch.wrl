#VRML V2.0 utf8
# Synthetic world (generated by oracle/tools/gen_rea_pointer_touch.py). Touch input into the pointing device sensors.
NavigationInfo { type [ "EXAMINE" ] }
Viewpoint { position 0 0 10 description "front" }
DEF V2 Viewpoint { position 1 1 10 orientation 0 0 1 0.2 description "anchored" }
Transform { translation -2.5 2 0 children [ DEF TS TouchSensor { description "touch" } Shape { geometry Box { size 1.6 1.6 1.6 } } ] }
Transform { translation 2.5 2 0 children [ DEF PS PlaneSensor { minPosition -3 -3 maxPosition 3 3 } Shape { geometry Box { size 1.6 1.6 1.6 } } ] }
Transform { translation -2.5 -2 0 children [ DEF CS CylinderSensor { } Shape { geometry Box { size 1.6 1.6 1.6 } } ] }
Transform { translation 2.5 -2 0 children [ DEF SS SphereSensor { } Shape { geometry Box { size 1.6 1.6 1.6 } } ] }
Anchor { url "#V2" description "go" children Shape { geometry Box { size 1.2 1.2 1.2 } } }
DEF LOG Script {
  inputOutput SFString hist ""
  inputOnly SFBool TS_isOver
  inputOnly SFBool TS_isActive
  inputOnly SFTime TS_touchTime
  inputOnly SFVec3f TS_hitPoint
  inputOnly SFVec3f TS_hitNormal
  inputOnly SFVec2f TS_hitTexCoord
  inputOnly SFBool PS_isOver
  inputOnly SFBool PS_isActive
  inputOnly SFVec3f PS_trackPoint
  inputOnly SFVec3f PS_translation
  inputOnly SFBool CS_isOver
  inputOnly SFBool CS_isActive
  inputOnly SFVec3f CS_trackPoint
  inputOnly SFRotation CS_rotation
  inputOnly SFBool SS_isOver
  inputOnly SFBool SS_isActive
  inputOnly SFVec3f SS_trackPoint
  inputOnly SFRotation SS_rotation
  url "ecmascript:
    function TS_isOver (v) { hist = hist + ' TS_isOver=' + v; }
    function TS_isActive (v) { hist = hist + ' TS_isActive=' + v; }
    function TS_touchTime (v) { hist = hist + ' TS_touchTime=' + (v - 946684800) .toFixed (4); }
    function TS_hitPoint (v) { hist = hist + ' TS_hitPoint=' + v; }
    function TS_hitNormal (v) { hist = hist + ' TS_hitNormal=' + v; }
    function TS_hitTexCoord (v) { hist = hist + ' TS_hitTexCoord=' + v; }
    function PS_isOver (v) { hist = hist + ' PS_isOver=' + v; }
    function PS_isActive (v) { hist = hist + ' PS_isActive=' + v; }
    function PS_trackPoint (v) { hist = hist + ' PS_trackPoint=' + v; }
    function PS_translation (v) { hist = hist + ' PS_translation=' + v; }
    function CS_isOver (v) { hist = hist + ' CS_isOver=' + v; }
    function CS_isActive (v) { hist = hist + ' CS_isActive=' + v; }
    function CS_trackPoint (v) { hist = hist + ' CS_trackPoint=' + v; }
    function CS_rotation (v) { hist = hist + ' CS_rotation=' + v; }
    function SS_isOver (v) { hist = hist + ' SS_isOver=' + v; }
    function SS_isActive (v) { hist = hist + ' SS_isActive=' + v; }
    function SS_trackPoint (v) { hist = hist + ' SS_trackPoint=' + v; }
    function SS_rotation (v) { hist = hist + ' SS_rotation=' + v; }
  "
}
ROUTE TS.isOver TO LOG.TS_isOver
ROUTE TS.isActive TO LOG.TS_isActive
ROUTE TS.touchTime TO LOG.TS_touchTime
ROUTE TS.hitPoint_changed TO LOG.TS_hitPoint
ROUTE TS.hitNormal_changed TO LOG.TS_hitNormal
ROUTE TS.hitTexCoord_changed TO LOG.TS_hitTexCoord
ROUTE PS.isOver TO LOG.PS_isOver
ROUTE PS.isActive TO LOG.PS_isActive
ROUTE PS.trackPoint_changed TO LOG.PS_trackPoint
ROUTE PS.translation_changed TO LOG.PS_translation
ROUTE CS.isOver TO LOG.CS_isOver
ROUTE CS.isActive TO LOG.CS_isActive
ROUTE CS.trackPoint_changed TO LOG.CS_trackPoint
ROUTE CS.rotation_changed TO LOG.CS_rotation
ROUTE SS.isOver TO LOG.SS_isOver
ROUTE SS.isActive TO LOG.SS_isActive
ROUTE SS.trackPoint_changed TO LOG.SS_trackPoint
ROUTE SS.rotation_changed TO LOG.SS_rotation
