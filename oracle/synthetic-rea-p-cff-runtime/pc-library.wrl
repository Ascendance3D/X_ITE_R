Shape { geometry DEF T1 Text { string [ "ABAB BA OS" "AB" ]  fontStyle FontStyle { family "CffLib"  } } }
Shape { geometry DEF T2 Text { string [ "WVWV" "AWV V" ]  fontStyle FontStyle { family "cfflib"  } } }
Shape { geometry DEF T3 Text { string [ "AB OS" "HiF" "QÉ" ]  fontStyle FontStyle { family "CffLib" justify [ "MIDDLE" "MIDDLE" ] } } }
Shape { geometry DEF T4 Text { string [ "ABO" "SiH" ]  fontStyle FontStyle { family "CffLib" size 1.5 spacing 0.7 } } }
Shape { geometry DEF T5 Text { string [ "ABO" "SiH" ]  fontStyle FontStyle { family "CffLib" horizontal FALSE size 0.9 } } }
Shape { geometry DEF T6 Text { string [ "ABO" "SiHW" ]  fontStyle FontStyle { family "CffLib" leftToRight FALSE } } }
Shape { geometry DEF T7 Text { string [ "ABOS" "WV" ] length [ 3 1 ] fontStyle FontStyle { family "CffLib"  } } }
