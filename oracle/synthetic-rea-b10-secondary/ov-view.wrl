#X3D V4.0 utf8
PROFILE Full
COMPONENT Layout:2
DEF O1 OrthoViewpoint { position 0 0 10 fieldOfView [ -2 -2 2 2 ] }
DEF O2 OrthoViewpoint { position 3 2 10 orientation 0 1 0 0.3 fieldOfView [ -3 -3 3 3 ] }
Background { skyColor 0.12 0.14 0.2 }
NavigationInfo { type "EXAMINE" transitionType [ "TELEPORT" ] }
Transform { translation -1.5 0 0 children Shape { appearance Appearance { material Material { diffuseColor 0.3 0.5 0.9 } } geometry Box { size 1.5 1.5 1.5 } } }
Transform { translation 1.5 0 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.6 0.2 } } geometry Sphere { radius 0.9 } } }
Transform { translation 0 2.5 -2 children Shape { appearance Appearance { material Material { diffuseColor 0.4 0.9 0.4 } } geometry Box { size 1 1 1 } } }
DEF FAR Transform { translation -4 -2 -3 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.4 0.4 } } geometry Sphere { radius 0.6 } } }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  inputOutput SFString log ""
  initializeOnly SFNode o1 USE O1
  initializeOnly SFNode o2 USE O2
  initializeOnly SFNode far USE FAR
  url "javascript:
function on_key (k)
{
   log = log + 'K' + k + ' ';
   if (k == 'a') o1 .viewAll = true;
   if (k == 'b') far .translation = new SFVec3f (-8, -2, -3);
   if (k == 'c') o1 .viewAll = true;
   if (k == 'd') o2 .set_bind = true;
   if (k == 'e') o2 .viewAll = true;
   if (k == 'f') o2 .fieldOfView = new MFFloat (-1, -1, 1, 1);
   if (k == 'g') o1 .set_bind = true;
}
"
}
ROUTE K.keyPress TO R.on_key
