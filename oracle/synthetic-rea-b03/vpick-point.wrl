#X3D V4.0 utf8
PROFILE Interchange
COMPONENT Picking:3
COMPONENT Scripting:1
COMPONENT KeyDeviceSensor:1
COMPONENT Geometry2D:1
Viewpoint { position 1 0 26 }
NavigationInfo { headlight TRUE }
DEF TBOX Transform { translation -9 0 0 rotation 0 0 1 0.3 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.3 0.2 transparency 0.3 } } geometry Box { size 2 2 2 } } }
DEF TSPH Transform { translation -6 0 0 rotation 0 0 1 0 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.2 0.8 0.3 transparency 0.3 } } geometry Sphere { radius 1 } } }
DEF TCON Transform { translation -3 0 0 rotation 1 0 0 0.4 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.2 0.3 0.9 transparency 0.3 } } geometry Cone { bottomRadius 1 height 2 } } }
DEF TCYL Transform { translation 0 0 0 rotation 0 0 1 0.6 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.8 0.2 transparency 0.3 } } geometry Cylinder { radius 1 height 2 } } }
DEF THUL Transform { translation 3 0 0 rotation 0 1 0 0.5 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.2 0.8 transparency 0.3 } } geometry IndexedFaceSet { coord Coordinate { point [ 1.2 0 0, -1.2 0 0, 0 1.2 0, 0 -1.2 0, 0 0 1.2, 0 0 -1.2 ] }
  coordIndex [ 0 2 4 -1 2 1 4 -1 1 3 4 -1 3 0 4 -1 2 0 5 -1 1 2 5 -1 3 1 5 -1 0 3 5 -1 ] } } }
DEF TPCY Transform { translation 6 0 0 rotation 0 0 1 0 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.3 0.8 0.8 transparency 0.3 } } geometry Cylinder { radius 1 height 2 top FALSE solid FALSE } } }
DEF TELE Transform { translation 8 -0.6 -1 rotation 0 0 1 0 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.6 0.6 0.6 transparency 0.3 } } geometry ElevationGrid { xDimension 4 zDimension 4 xSpacing 0.7 zSpacing 0.7 height [ 0 0.4 0.1 0, 0.3 1.2 0.8 0.2, 0 0.9 0.6 0.1, 0 0.2 0 0 ] solid FALSE } } }
DEF TREC Transform { translation 11.5 0 0 rotation 0 1 0 0.3 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.6 0.2 transparency 0.3 } } geometry Rectangle2D { size 2 2 } } }
DEF TLIN Transform { translation 14 0 0 rotation 0 0 1 0 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 1 1 1 transparency 0.3 } } geometry LineSet { vertexCount 2 coord Coordinate { point [ -1 0 0, 1 0 0 ] } } } }
DEF MOVER Transform { rotation 0 0 1 0.2 scale 1.3 0.9 1 children [
  Shape { appearance Appearance { material Material { emissiveColor 1 1 1 } } geometry DEF PTS PointSet { coord Coordinate { point [ 0 0 0, 0 0.7 0.2, 0 -0.95 0, 0.97 0 0, -1.02 0.33 0, 0.5 0.5 0.5, -0.6 -0.6 -0.2, 0 1.1 0, 0.3 -0.2 0.9, 1.15 0.9 0 ] } } }
  DEF PGS PointPickSensor { intersectionType "GEOMETRY" sortOrder "ALL_SORTED" pickingGeometry USE PTS pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] }
  DEF PGC PointPickSensor { intersectionType "GEOMETRY" sortOrder "CLOSEST" pickingGeometry USE PTS pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] }
  DEF PGN PointPickSensor { intersectionType "GEOMETRY" sortOrder "ANY" pickingGeometry USE PTS pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] }
  DEF PGA PointPickSensor { intersectionType "GEOMETRY" sortOrder "ALL" pickingGeometry USE PTS pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] }
  DEF PBA PointPickSensor { intersectionType "BOUNDS" sortOrder "ALL" pickingGeometry USE PTS pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] }
  DEF PBC PointPickSensor { intersectionType "BOUNDS" sortOrder "CLOSEST" pickingGeometry USE PTS pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] }
] }
DEF CLOCK TimeSensor { cycleInterval 6 loop TRUE }
DEF PATH PositionInterpolator { key [ 0 1 ] keyValue [ -12 0.05 0.1, 16 -0.25 -0.1 ] }
ROUTE CLOCK.fraction_changed TO PATH.set_fraction
ROUTE PATH.value_changed TO MOVER.set_translation
