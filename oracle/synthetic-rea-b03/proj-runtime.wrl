#X3D V4.1 utf8
PROFILE Interchange
COMPONENT TextureProjection:2
COMPONENT Layering:1
COMPONENT Shape:4
COMPONENT Lighting:3
COMPONENT Scripting:1
COMPONENT KeyDeviceSensor:1
COMPONENT CubeMapTexturing:3
Viewpoint { position 0.013 6.07 16.11 orientation 1 0 0 -0.3517 }
DEF P TextureProjector { location 0 5 6 direction 0 -0.7 -1 upVector 0 1 0 fieldOfView 0.9 texture DEF T1 ImageTexture { url "proj-checker.png" } }
Transform { translation 0 -1 0 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.8 0.8 }  } geometry Box { size 16 0.2 12 } } }
Transform { translation -3 1 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.6 0.5 }  } geometry Sphere { radius 1 } } }
Transform { translation 0 0.5 1 children Shape { appearance Appearance { material Material { diffuseColor 0.6 0.9 0.6 }  } geometry Box { size 1.5 1.5 1.5 } } }
Transform { translation 3 0.5 -1 children Shape { appearance Appearance { material Material { diffuseColor 0.6 0.7 0.9 }  } geometry Cone { bottomRadius 1 height 2 } } }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  inputOnly SFFloat on_aspect
  inputOutput SFString log ""
  initializeOnly SFNode p USE P
  url "javascript:
function on_aspect (value) { log = log + 'A' + value .toFixed (4) + ' '; }
function on_key (k)
{
   log = log + 'K' + k + ' ';
   if (k == 'a') p .location = new SFVec3f (2, 5, 5);
   if (k == 'b') p .on = false;
   if (k == 'c') p .on = true;
   if (k == 'd') p .intensity = 0.4;
   if (k == 'e') p .texture = Browser .currentScene .createNode ('PixelTexture');
   if (k == 'f') { var t = Browser .currentScene .createNode ('PixelTexture'); t .image = new SFImage (3, 1, 3, new MFInt32 (0xff0000, 0x00ff00, 0x0000ff)); p .texture = t; }
   if (k == 'g') p .fieldOfView = 0.5;
   if (k == 'h') p .global = false;
}
"
}
ROUTE K.keyPress TO R.on_key
ROUTE P.aspectRatio TO R.on_aspect
