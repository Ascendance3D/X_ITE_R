#X3D V4.0 utf8
PROFILE Interchange
COMPONENT Picking:3
COMPONENT Scripting:1
COMPONENT KeyDeviceSensor:1
COMPONENT Geometry2D:1
Viewpoint { position 1 0 30 }
NavigationInfo { headlight TRUE }
DEF TBOX Transform { translation -9 0 0 rotation 0 0 1 0.3 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.3 0.2 transparency 0.3 } } geometry Box { size 2 2 2 } } }
DEF TSPH Transform { translation -6 0 0 rotation 0 0 1 0 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.2 0.8 0.3 transparency 0.3 } } geometry Sphere { radius 1 } } }
DEF TCON Transform { translation -3 0 0 rotation 1 0 0 0.4 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.2 0.3 0.9 transparency 0.3 } } geometry Cone { bottomRadius 1 height 2 } } }
DEF TCYL Transform { translation 0 0 0 rotation 0 0 1 0.6 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.8 0.2 transparency 0.3 } } geometry Cylinder { radius 1 height 2 } } }
DEF THUL Transform { translation 3 0 0 rotation 0 1 0 0.5 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.2 0.8 transparency 0.3 } } geometry IndexedFaceSet { coord Coordinate { point [ 1.2 0 0, -1.2 0 0, 0 1.2 0, 0 -1.2 0, 0 0 1.2, 0 0 -1.2 ] }
  coordIndex [ 0 2 4 -1 2 1 4 -1 1 3 4 -1 3 0 4 -1 2 0 5 -1 1 2 5 -1 3 1 5 -1 0 3 5 -1 ] } } }
DEF TPCY Transform { translation 6 0 0 rotation 0 0 1 0 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.3 0.8 0.8 transparency 0.3 } } geometry Cylinder { radius 1 height 2 top FALSE solid FALSE } } }
DEF TELE Transform { translation 8 -0.6 -1 rotation 0 0 1 0 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.6 0.6 0.6 transparency 0.3 } } geometry ElevationGrid { xDimension 4 zDimension 4 xSpacing 0.7 zSpacing 0.7 height [ 0 0.4 0.1 0, 0.3 1.2 0.8 0.2, 0 0.9 0.6 0.1, 0 0.2 0 0 ] solid FALSE } } }
DEF TREC Transform { translation 11.5 0 0 rotation 0 1 0 0.3 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.6 0.2 transparency 0.3 } } geometry Rectangle2D { size 2 2 } } }
DEF TLIN Transform { translation 14 0 0 rotation 0 0 1 0 scale 1 1 1 children Shape { appearance Appearance { material Material { diffuseColor 1 1 1 transparency 0.3 } } geometry LineSet { vertexCount 2 coord Coordinate { point [ -1 0 0, 1 0 0 ] } } } }
DEF CLOCK TimeSensor { cycleInterval 7 loop TRUE }
DEF MQBOX Transform { translation -12 3.2 0 children [
  DEF RQBOX Transform { children [ Shape { appearance Appearance { material Material { emissiveColor 1 1 1 } } geometry DEF GQBOX Box { size 1.6 1 1.2 } }
    DEF QBOX PrimitivePickSensor { intersectionType "GEOMETRY" sortOrder "ALL" pickingGeometry USE GQBOX pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] }
    DEF BQBOX PrimitivePickSensor { sortOrder "ALL_SORTED" pickingGeometry USE GQBOX pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] } ] }
] }
DEF PQBOX PositionInterpolator { key [ 0 1 ] keyValue [ -12 6.2 0, 16 -0.2 0 ] }
DEF OQBOX OrientationInterpolator { key [ 0 0.5 1 ] keyValue [ 1 1 0 0, 1 1 0 3.1, 0 1 1 6 ] }
ROUTE CLOCK.fraction_changed TO PQBOX.set_fraction
ROUTE PQBOX.value_changed TO MQBOX.set_translation
ROUTE CLOCK.fraction_changed TO OQBOX.set_fraction
ROUTE OQBOX.value_changed TO RQBOX.set_rotation
DEF MQSPH Transform { translation -12 1.1 0 children [
  DEF RQSPH Transform { children [ Shape { appearance Appearance { material Material { emissiveColor 1 1 1 } } geometry DEF GQSPH Sphere { radius 0.7 } }
    DEF QSPH PrimitivePickSensor { intersectionType "GEOMETRY" sortOrder "ALL" pickingGeometry USE GQSPH pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] }
    DEF BQSPH PrimitivePickSensor { sortOrder "ALL_SORTED" pickingGeometry USE GQSPH pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] } ] }
] }
DEF PQSPH PositionInterpolator { key [ 0 1 ] keyValue [ -12 4.1000000000000005 0, 16 0.010000000000000009 0 ] }
DEF OQSPH OrientationInterpolator { key [ 0 0.5 1 ] keyValue [ 1 1 0 0, 1 1 0 3.1, 0 1 1 6 ] }
ROUTE CLOCK.fraction_changed TO PQSPH.set_fraction
ROUTE PQSPH.value_changed TO MQSPH.set_translation
ROUTE CLOCK.fraction_changed TO OQSPH.set_fraction
ROUTE OQSPH.value_changed TO RQSPH.set_rotation
DEF MQCON Transform { translation -12 -1.0 0 children [
  DEF RQCON Transform { children [ Shape { appearance Appearance { material Material { emissiveColor 1 1 1 } } geometry DEF GQCON Cone { bottomRadius 0.8 height 1.4 } }
    DEF QCON PrimitivePickSensor { intersectionType "GEOMETRY" sortOrder "ALL" pickingGeometry USE GQCON pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] }
    DEF BQCON PrimitivePickSensor { sortOrder "ALL_SORTED" pickingGeometry USE GQCON pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] } ] }
] }
DEF PQCON PositionInterpolator { key [ 0 1 ] keyValue [ -12 2.0 0, 16 0.22000000000000003 0 ] }
DEF OQCON OrientationInterpolator { key [ 0 0.5 1 ] keyValue [ 1 1 0 0, 1 1 0 3.1, 0 1 1 6 ] }
ROUTE CLOCK.fraction_changed TO PQCON.set_fraction
ROUTE PQCON.value_changed TO MQCON.set_translation
ROUTE CLOCK.fraction_changed TO OQCON.set_fraction
ROUTE OQCON.value_changed TO RQCON.set_rotation
DEF MQCYL Transform { translation -12 -3.1000000000000005 0 children [
  DEF RQCYL Transform { children [ Shape { appearance Appearance { material Material { emissiveColor 1 1 1 } } geometry DEF GQCYL Cylinder { radius 0.6 height 1.6 } }
    DEF QCYL PrimitivePickSensor { intersectionType "GEOMETRY" sortOrder "ALL" pickingGeometry USE GQCYL pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] }
    DEF BQCYL PrimitivePickSensor { sortOrder "ALL_SORTED" pickingGeometry USE GQCYL pickTarget [ USE TBOX USE TSPH USE TCON USE TCYL USE THUL USE TPCY USE TELE USE TREC USE TLIN ] } ] }
] }
DEF PQCYL PositionInterpolator { key [ 0 1 ] keyValue [ -12 -0.10000000000000037 0, 16 0.4300000000000001 0 ] }
DEF OQCYL OrientationInterpolator { key [ 0 0.5 1 ] keyValue [ 1 1 0 0, 1 1 0 3.1, 0 1 1 6 ] }
ROUTE CLOCK.fraction_changed TO PQCYL.set_fraction
ROUTE PQCYL.value_changed TO MQCYL.set_translation
ROUTE CLOCK.fraction_changed TO OQCYL.set_fraction
ROUTE OQCYL.value_changed TO RQCYL.set_rotation
DEF CSCALE PositionInterpolator { key [ 0 0.3 0.6 1 ] keyValue [ 1 1 1, 1.6 1 0.7, 0.8 1.2 1.4, 1 1 1 ] }
ROUTE CLOCK.fraction_changed TO CSCALE.set_fraction
ROUTE CSCALE.value_changed TO TCON.set_scale
DEF R Script {
  directOutput TRUE
  inputOnly SFBool on_QBOX_a
  inputOutput SFBool QBOX_a FALSE
  inputOutput SFInt32 QBOX_a_count 0
  inputOnly MFNode on_QBOX_g
