  inputOnly MFNode on_BQCON_g
  inputOutput MFNode BQCON_g [ ]
  inputOutput SFInt32 BQCON_g_count 0
  inputOnly SFBool on_BQCYL_a
  inputOutput SFBool BQCYL_a FALSE
  inputOutput SFInt32 BQCYL_a_count 0
  inputOnly MFNode on_BQCYL_g
  inputOutput MFNode BQCYL_g [ ]
  inputOutput SFInt32 BQCYL_g_count 0
  inputOutput SFString log ""
  url "javascript:
function on_QBOX_a (value) { QBOX_a = value; QBOX_a_count = QBOX_a_count + 1; log = log + 'QBOX_a' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
function on_QBOX_g (value) { QBOX_g = value; QBOX_g_count = QBOX_g_count + 1; log = log + 'QBOX_g' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
