function on_QCON_a (value) { QCON_a = value; QCON_a_count = QCON_a_count + 1; log = log + 'QCON_a' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
function on_QCON_g (value) { QCON_g = value; QCON_g_count = QCON_g_count + 1; log = log + 'QCON_g' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
