function on_QCYL_g (value) { QCYL_g = value; QCYL_g_count = QCYL_g_count + 1; log = log + 'QCYL_g' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
function on_BQBOX_a (value) { BQBOX_a = value; BQBOX_a_count = BQBOX_a_count + 1; log = log + 'BQBOX_a' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
function on_BQBOX_g (value) { BQBOX_g = value; BQBOX_g_count = BQBOX_g_count + 1; log = log + 'BQBOX_g' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
function on_BQSPH_a (value) { BQSPH_a = value; BQSPH_a_count = BQSPH_a_count + 1; log = log + 'BQSPH_a' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
function on_BQSPH_g (value) { BQSPH_g = value; BQSPH_g_count = BQSPH_g_count + 1; log = log + 'BQSPH_g' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
function on_BQCON_a (value) { BQCON_a = value; BQCON_a_count = BQCON_a_count + 1; log = log + 'BQCON_a' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
function on_BQCON_g (value) { BQCON_g = value; BQCON_g_count = BQCON_g_count + 1; log = log + 'BQCON_g' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
function on_BQCYL_a (value) { BQCYL_a = value; BQCYL_a_count = BQCYL_a_count + 1; log = log + 'BQCYL_a' + (value .length === undefined ? (value ? 1 : 0) : value .length) + ' '; }
