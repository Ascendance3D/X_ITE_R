DEF K KeySensor { }
DEF S Script {
  directOutput TRUE
  inputOnly SFString press
  initializeOnly MFNode movies [ USE M0 USE M1 USE M2 USE M3 USE M4 USE M5 USE M6 USE M7 USE M8 USE M9 USE M10 USE M11 ]
  initializeOnly MFNode looping [ USE M0 USE M3 USE M4 USE M5 USE M6 USE M8 USE M9 USE M11 ]
  initializeOnly SFNode stopped USE M5
  url "javascript:
function press (value, time)
{
   for (var i = 0; i < movies .length; ++ i)
      movies [i] .startTime = time;

   for (var i = 0; i < looping .length; ++ i)
      looping [i] .loop = true;

   stopped .stopTime = time + 0.6;
}
"
}
ROUTE K.keyPress TO S.press
