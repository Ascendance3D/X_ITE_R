    "190": "#X3D V4.1 utf8 X_ITE V16.5.0\n\nPROFILE Immersive\n\nCOMPONENT Layering : 1\nCOMPONENT Scripting : 1\n\nNavigationInfo {\n  type \"WALK\"\n  speed 4\n}\n\nViewpoint {\n  description \"layer 0\"\n  position 0 1 12\n}\n\nTransform {\n  translation 0 -0.1 0\n  children Shape {\n    appearance Appearance {\n      material Material {\n        diffuseColor 0.4 0.4 0.4\n      }\n    }\n    geometry Box {\n      size 40 0.2 40\n    }\n  }\n}\n\nDEF COL0 Collision {\n  children Transform {\n    translation 0.8 5 12\n    children Shape {\n      appearance Appearance {\n        material Material {\n          diffuseColor 0.8 0.3 0.3\n        }\n      }\n      geometry Box {\n        size 1 12 1\n      }\n    }\n  }\n}\n\nCollision {\n  children Transform {\n    translation 0 5 7\n    children Shape {\n      appearance Appearance {\n        material Material {\n          diffuseColor 0.8 0.3 0.3\n        }\n      }\n      geometry Box {\n        size 12 10 0.4\n      }\n    }\n  }\n}\n\nDEF LS LayerSet {\n  order [\n    0,\n    1,\n    2\n  ]\n  layers [\n    DEF L1 Layer {\n      children [\n        NavigationInfo {\n          type \"WALK\"\n          speed 4\n        }\n        Viewpoint {\n          description \"layer 1\"\n          position 0 6 12\n        }\n        Transform {\n          translation 0 1.9 0\n          children Shape {\n            appearance Appearance {\n              material Material {\n                diffuseColor 0.3 0.5 0.3\n              }\n            }\n            geometry Box {\n              size 40 0.2 40\n            }\n          }\n        }\n        DEF COL1 Collision {\n          children Transform {\n            translation 0.8 5 12\n            children Shape {\n              appearance Appearance {\n                material Material {\n                  diffuseColor 0.8 0.3 0.3\n                }\n              }\n              geometry Box {\n                size 1 12 1\n              }\n            }\n          }\n        }\n        Collision {\n          children Transform {\n            translation 0 5 2\n            children Shape {\n              appearance Appearance {\n                material Material {\n                  diffuseColor 0.8 0.3 0.3\n                }\n              }\n              geometry Box {\n                size 12 10 0.4\n              }\n            }\n          }\n        }\n      ]\n    }\n    DEF L2 Layer {\n      children [\n        NavigationInfo {\n          type \"WALK\"\n          avatarSize [\n            0.25,\n            3,\n            0.75\n          ]\n          speed 4\n        }\n        Viewpoint {\n          description \"layer 2\"\n          position 0 9 12\n        }\n        Transform {\n          translation 0 -1.1 0\n          children Shape {\n            appearance Appearance {\n              material Material {\n                diffuseColor 0.3 0.3 0.5\n              }\n            }\n            geometry Box {\n              size 40 0.2 40\n            }\n          }\n        }\n        DEF COL2 Collision {\n          children Transform {\n            translation 0.8 5 12\n            children Shape {\n              appearance Appearance {\n                material Material {\n                  diffuseColor 0.8 0.3 0.3\n                }\n              }\n              geometry Box {\n                size 1 12 1\n              }\n            }\n          }\n        }\n      ]\n    }\n  ]\n}\n\nDEF INFO WorldInfo {\n  title \"gravity layers\"\n  info \"s=011 n=211\"\n}\n\nDEF W Script {\n  inputOnly      SFTime tick\n  inputOnly      SFBool a0\n  inputOnly      SFBool a1\n  inputOnly      SFBool a2\n  initializeOnly SFNode ls USE LS\n  initializeOnly SFNode info USE INFO\n\n  url \"ecmascript:\nvar s = [ 0, 0, 0 ], n = [ 0, 0, 0 ], first = -1, next = 0, plan = [];\nfunction show () { info .info = new MFString ('s=' + s [0] + s [1] + s [2] + ' n=' + n [0] + n [1] + n [2]); }\nfunction a0 (v) { s [0] = v ? 1 : 0; n [0] += 1; show (); }\nfunction a1 (v) { s [1] = v ? 1 : 0; n [1] += 1; show (); }\nfunction a2 (v) { s [2] = v ? 1 : 0; n [2] += 1; show (); }\nfunction tick (value)\n{\n   if (first < 0) first = value;\n   var e = value - first;\n   while (next < plan .length && e >= plan [next][0] - 1e-6) { ls .activeLayer = plan [next][1]; ++ next; }\n}\n\"\n  directOutput TRUE\n}\n\nROUTE COL0.isActive TO W.a0\nROUTE COL1.isActive TO W.a1\nROUTE COL2.isActive TO W.a2\n"
