#X3D V4.0 utf8
PROFILE Full
Viewpoint { position 0 0 5 }
NavigationInfo { headlight FALSE }
Transform { children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.5 0.3 } shaders [ DEF CS ComposedShader { language "GLSL" parts [ ShaderPart { type "VERTEX" url "data:x-shader/x-vertex,
attribute vec4 x3d_Vertex;
attribute vec3 x3d_Normal;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform mat3 x3d_NormalMatrix;
varying vec3 vN;
void main()
{
   vN = normalize (x3d_NormalMatrix * x3d_Normal);
   gl_Position = x3d_ProjectionMatrix * x3d_ModelViewMatrix * x3d_Vertex;
}
" } DEF FP ShaderPart { type "FRAGMENT" url "data:x-shader/x-fragment,
precision mediump float;
varying vec3 vN;
void main() { gl_FragColor = vec4 (vec3 (1.0, 0.2, 0.2) * (0.4 + 0.6 * abs (vN.z)), 1.0); }
" } ] } ] } geometry Sphere { radius 1.2 } } }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  initializeOnly SFNode fp USE FP
  url "javascript:
function on_key (k)
{
   if (k == 'a') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avarying vec3 vN;%0Avoid main() { gl_FragColor = vec4 (vec3 (0.2, 0.4, 1.0) * (0.4 + 0.6 * abs (vN.z)), 1.0); }%0A');
   if (k == 'b') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { gl_FragColor = vec4 (1.0) oops; }%0A', 'data:x-shader/x-fragment,%0Aprecision mediump float;%0Avarying vec3 vN;%0Avoid main() { gl_FragColor = vec4 (vec3 (0.2, 1.0, 0.3) * (0.4 + 0.6 * abs (vN.z)), 1.0); }%0A');
   if (k == 'c') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { gl_FragColor = vec4 (1.0) oops; }%0A', 'data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { gl_FragColor = nothing (1.0); }%0A');
   if (k == 'd') fp .url = new MFString ();
   if (k == 'e') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avarying vec3 vN;%0Avoid main() { gl_FragColor = vec4 (vec3 (0.2, 1.0, 0.3) * (0.4 + 0.6 * abs (vN.z)), 1.0); }%0A');
   if (k == 'f') fp .url = new MFString ('missing-24-part.frag', 'data:x-shader/x-fragment,%0Aprecision mediump float;%0Avarying vec3 vN;%0Avoid main() { gl_FragColor = vec4 (vec3 (1.0, 0.2, 0.2) * (0.4 + 0.6 * abs (vN.z)), 1.0); }%0A');
   if (k == 'g') fp .url = new MFString ('missing-24-part.frag');
   if (k == 'h') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avarying vec3 vN;%0Avoid main() { gl_FragColor = vec4 (vec3 (1.0, 0.2, 0.2) * (0.4 + 0.6 * abs (vN.z)), 1.0); }%0A');
   if (k == 'i') fp .load = false;
   if (k == 'j') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avarying vec3 vN;%0Avoid main() { gl_FragColor = vec4 (vec3 (0.2, 0.4, 1.0) * (0.4 + 0.6 * abs (vN.z)), 1.0); }%0A');
   if (k == 'k') fp .load = true;
   if (k == 'l') fp .url = fp .url;
   if (k == 'm') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avarying vec3 vN;%0Avoid main() { gl_FragColor = vec4 (vec3 (0.2, 1.0, 0.3) * (0.4 + 0.6 * abs (vN.z)), 1.0); }%0A');
   if (k == 'n') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { gl_FragColor = vec4 (1.0) oops; }%0A');
   if (k == 'o') fp .load = false;
   if (k == 'p') fp .load = true;
}
"
}
ROUTE K.keyPress TO R.on_key
