#X3D V4.0 utf8
PROFILE Full
Viewpoint { position 0 0 5 }
NavigationInfo { headlight FALSE }
Transform { children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.5 0.3 } shaders [ ComposedShader { language "GLSL" parts [ ShaderPart { type "VERTEX" url "data:x-shader/x-vertex,%23version 300 es
in vec4 x3d_Vertex;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
void main()
{
   gl_Position = x3d_ProjectionMatrix * x3d_ModelViewMatrix * x3d_Vertex;
}
" } DEF FP ShaderPart { type "FRAGMENT" url "data:x-shader/x-fragment,%23version 300 es
precision mediump float;
out vec4 fragColor;
void main() { fragColor = vec4 (0.9, 0.7, 0.2, 1.0); }
" } ] } ] } geometry Sphere { radius 1.2 } } }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  initializeOnly SFNode fp USE FP
  url "javascript:
function on_key (k)
{
   if (k == 'a') fp .url = new MFString ('data:x-shader/x-fragment,%23version 300 es%0Aprecision highp int;%0Aprecision highp float;%0Aprecision highp sampler2D;%0Aprecision highp sampler3D;%0Aprecision highp samplerCube;%0A%23include <Stipple>%0Aout vec4 fragColor;%0Avoid main() { fragColor = vec4 (0.3, 0.7, 0.9, 1.0); }%0A');
   if (k == 'b') fp .url = new MFString ('data:x-shader/x-fragment,%23version 300 es%0Aprecision mediump float;%0Aout vec4 fragColor;%0Avoid main() { fragColor = vec4 (0.9, 0.7, 0.2, 1.0); }%0A');
}
"
}
ROUTE K.keyPress TO R.on_key
