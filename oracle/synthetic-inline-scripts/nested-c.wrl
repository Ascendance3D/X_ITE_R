#VRML V2.0 utf8
DEF ClockC TimeSensor { cycleInterval 1 loop TRUE enabled FALSE }
DEF SC Script {
  eventIn SFFloat set_fraction
  eventOut SFBool kick
  eventOut SFVec3f pos
  field SFFloat last -1
  field SFBool dirty FALSE
  field SFBool kicked FALSE
  url "javascript:
    function initialize () { print ('C initialize'); }
    function prepareEvents (t) { if (!kicked && t >= 946684800.1) { kicked = TRUE; print ('C prepare'); kick = TRUE; } }
    function set_fraction (f) { pos = new SFVec3f (f, 0, 0); var q = Math.floor (f * 4); if (q != last) { last = q; dirty = TRUE; print ('C fraction ' + q); } }
    function eventsProcessed () { if (dirty) { dirty = FALSE; print ('C eventsProcessed'); } }
    function shutdown () { print ('C shutdown'); }
  "
}
DEF BoxC Transform { children Shape { geometry Box { size 1 1 1 } } }
ROUTE SC.kick TO ClockC.set_enabled
ROUTE ClockC.fraction_changed TO SC.set_fraction
ROUTE SC.pos TO BoxC.set_translation
