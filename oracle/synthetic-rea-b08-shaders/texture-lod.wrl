#X3D V4.0 utf8
PROFILE Full
Viewpoint { position 0 0 4 }
NavigationInfo { headlight FALSE }
Shape { appearance Appearance { material Material { diffuseColor 1 0 0 } texture ImageTexture { url "../synthetic-rea-b03/proj-checker.png" }  shaders [ ComposedShader { language "GLSL"   parts [ ShaderPart { type "VERTEX"  url "data:x-shader/x-vertex,
attribute vec4 x3d_Vertex;
attribute vec3 x3d_Normal;
attribute vec4 x3d_TexCoord0;
attribute vec4 x3d_Color;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform mat3 x3d_NormalMatrix;
varying vec3 vN;
varying vec3 vP;
varying vec2 vT;
varying vec4 vC;
void main()
{
   vec4 p = x3d_ModelViewMatrix * x3d_Vertex;
   vP = p.xyz;
   vN = normalize (x3d_NormalMatrix * x3d_Normal);
   vT = x3d_TexCoord0.st;
   vC = x3d_Color;
   gl_Position = x3d_ProjectionMatrix * p;
}
" } ShaderPart { type "FRAGMENT"  url "data:x-shader/x-fragment,
precision mediump float;
varying vec3 vN;
varying vec3 vP;
varying vec2 vT;
varying vec4 vC;
uniform sampler2D x3d_Texture2D [x3d_MaxTextures];
void main()
{
gl_FragColor = texture2DProj (x3d_Texture2D [0], vec3 (vT, 1.0)) * 0.7 + 0.3 * texture2D (x3d_Texture2D [0], vT + 0.1);
}
" } ] } ] } geometry Box { size 2 2 2 } }
