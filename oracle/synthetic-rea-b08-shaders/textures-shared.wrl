#X3D V4.0 utf8
PROFILE Full
Viewpoint { position 0 0 7 }
NavigationInfo { headlight FALSE }
DEF G Group { children [
  Transform { translation -1.6 0 0 children Shape { appearance DEF AP1 Appearance { texture PixelTexture { image 2 1 3 0xff0000 0x00ff00 } shaders [ DEF CS ComposedShader { language "GLSL" field SFNode map PixelTexture { image 2 2 3 0x202020 0xe0e0e0 0xe0e0e0 0x202020 } field SFFloat mixer 0 parts [ DEF VP ShaderPart { type "VERTEX" url "data:x-shader/x-vertex,
attribute vec4 x3d_Vertex;
attribute vec4 x3d_TexCoord0;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
varying vec2 vT;
void main()
{
   vT = x3d_TexCoord0.st;
   gl_Position = x3d_ProjectionMatrix * (x3d_ModelViewMatrix * x3d_Vertex);
}
" } ShaderPart { type "FRAGMENT" url "data:x-shader/x-fragment,
precision mediump float;
varying vec2 vT;
uniform sampler2D map;
uniform sampler2D x3d_Texture2D [x3d_MaxTextures];
uniform float mixer;
void main() { gl_FragColor = mix (texture2D (map, vT), texture2D (x3d_Texture2D [0], vT * 2.0), mixer); }
" } ] } ] } geometry Box { size 2 2 2 } } }
  DEF T2 Transform { translation 1.6 0 0 children Shape { appearance DEF AP2 Appearance { texture PixelTexture { image 1 2 3 0x0000ff 0xffff00 } shaders [ USE CS ] } geometry Box { size 2 2 2 } } }
] }
DEF K KeySensor { }

DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  initializeOnly SFNode cs USE CS
  initializeOnly SFNode ap1 USE AP1
  initializeOnly SFNode ap2 USE AP2
  initializeOnly SFNode g USE G
  initializeOnly SFNode t2 USE T2
  initializeOnly SFNode vp USE VP
  url "javascript:
function on_key (k)
{
   if (k == 'a') cs .mixer = 0.5;
   if (k == 'b') cs .map = Browser .currentScene .createNode ('PixelTexture');
   if (k == 'c') cs .map .image = new SFImage (2, 2, 3, new MFInt32 (0xff0000, 0x00ff00, 0x0000ff, 0xffff00));
   if (k == 'd') cs .map = null;
   if (k == 'e') ap1 .texture = Browser .currentScene .createNode ('PixelTexture');
   if (k == 'f') g .removeChildren = new MFNode (t2);
   if (k == 'g') g .addChildren = new MFNode (t2);
   if (k == 'h') cs .map = ap2 .texture;
   if (k == 'i') vp .url = new MFString ('data:x-shader/x-vertex,\nattribute vec4 x3d_Vertex;\nattribute vec4 x3d_TexCoord0;\nuniform mat4 x3d_ProjectionMatrix;\nuniform mat4 x3d_ModelViewMatrix;\nvarying vec2 vT;\nvoid main()\n{\n   vT = x3d_TexCoord0.st * 1.0;\n   gl_Position = x3d_ProjectionMatrix * (x3d_ModelViewMatrix * x3d_Vertex);\n}\n');
   if (k == 'j') ap2 .texture = null;
   if (k == 'k') cs .mixer = 1;
}
"
}
ROUTE K.keyPress TO R.on_key
