#X3D V4.0 utf8
PROFILE Full
Viewpoint { position 0 0 5 }
NavigationInfo { headlight FALSE }
DEF F Fog { color 0.7 0.8 0.9 visibilityRange 12 fogType "LINEAR" }
DEF L1 DirectionalLight { direction -0.4 -0.6 -1 intensity 1 }
DEF L2 PointLight { location 2 2 2 color 0.3 0.5 1 radius 20 }
DEF TR Transform { children Shape { appearance DEF AP Appearance { material DEF M Material { diffuseColor 0.9 0.5 0.3 specularColor 0.4 0.4 0.4 shininess 0.3 } texture DEF TX ImageTexture { url "../synthetic-rea-b03/proj-checker.png" } shaders [ ComposedShader { language "GLSL" parts [ ShaderPart { type "VERTEX"  url "data:x-shader/x-vertex,%23version 300 es
%23define X3D_COLORSPACE_SRGB
%23define X3D_NORMALS
%23define X3D_NUM_TEXTURE_TRANSFORMS 1
%23define X3D_NUM_TEXTURE_COORDINATES 1
%23define X3D_GEOMETRY_3D
%23define X3D_PHONG_MATERIAL
%23define X3D_LIGHTING
%23define X3D_NUM_LIGHTS 2
%23define X3D_FOG
%23define X3D_FOG_LINEAR
%23define X3D_TEXTURE
%23define X3D_NUM_TEXTURES 1
%23define X3D_TEXTURE_0_2D

precision highp int;
precision highp float;
precision highp sampler2D;
precision highp sampler3D;
precision highp samplerCube;
%23undef X3D_GEOMETRY_0D
%23undef X3D_GEOMETRY_1D
%23undef X3D_GEOMETRY_2D
%23undef X3D_STYLE_PROPERTIES
%23undef X3D_UNLIT_MATERIAL
%23undef X3D_MULTI_TEXTURING
%23include <Vertex>
" } DEF FP ShaderPart { type "FRAGMENT"  url "data:x-shader/x-fragment,%23version 300 es
%23define X3D_COLORSPACE_SRGB
%23define X3D_NORMALS
%23define X3D_NUM_TEXTURE_TRANSFORMS 1
%23define X3D_NUM_TEXTURE_COORDINATES 1
%23define X3D_GEOMETRY_3D
%23define X3D_PHONG_MATERIAL
%23define X3D_LIGHTING
%23define X3D_NUM_LIGHTS 2
%23define X3D_FOG
%23define X3D_FOG_LINEAR
%23define X3D_TEXTURE
%23define X3D_NUM_TEXTURES 1
%23define X3D_TEXTURE_0_2D

precision highp int;
precision highp float;
precision highp sampler2D;
precision highp sampler3D;
precision highp samplerCube;
%23undef X3D_GEOMETRY_0D
%23undef X3D_GEOMETRY_1D
%23undef X3D_GEOMETRY_2D
%23undef X3D_STYLE_PROPERTIES
%23undef X3D_UNLIT_MATERIAL
%23undef X3D_MULTI_TEXTURING
%23include <Material>
" } ] } ] } geometry Sphere { radius 1.2 } } }
DEF K KeySensor { }

DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  initializeOnly SFNode m USE M
  initializeOnly SFNode l1 USE L1
  initializeOnly SFNode l2 USE L2
  initializeOnly SFNode f USE F
  initializeOnly SFNode ap USE AP
  initializeOnly SFNode fp USE FP
  initializeOnly SFNode tr USE TR
  url "javascript:
function on_key (k)
{
   if (k == 'a') m .diffuseColor = new SFColor (0.2, 0.7, 0.4);
   if (k == 'b') l1 .intensity = 0.2;
   if (k == 'c') f .visibilityRange = 7.5;
   if (k == 'd') l2 .on = false;
   if (k == 'e') ap .texture = Browser .currentScene .createNode ('PixelTexture');
   if (k == 'f') fp .url = new MFString ('data:x-shader/x-fragment,%23version 300 es%0A%23define X3D_COLORSPACE_SRGB%0A%23define X3D_NORMALS%0A%23define X3D_NUM_TEXTURE_TRANSFORMS 1%0A%23define X3D_NUM_TEXTURE_COORDINATES 1%0A%23define X3D_GEOMETRY_3D%0A%23define X3D_UNLIT_MATERIAL%0A%23define X3D_FOG%0A%23define X3D_FOG_LINEAR%0A%23define X3D_TEXTURE%0A%23define X3D_NUM_TEXTURES 1%0A%23define X3D_TEXTURE_0_2D%0A%0Aprecision highp int;%0Aprecision highp float;%0Aprecision highp sampler2D;%0Aprecision highp sampler3D;%0Aprecision highp samplerCube;%0A%23undef X3D_GEOMETRY_0D%0A%23undef X3D_GEOMETRY_1D%0A%23undef X3D_GEOMETRY_2D%0A%23undef X3D_STYLE_PROPERTIES%0A%23undef X3D_PHONG_MATERIAL%0A%23undef X3D_LIGHTING%0A%23undef X3D_MULTI_TEXTURING%0A%23include <Unlit>%0A');
   if (k == 'g') fp .url = new MFString ('data:x-shader/x-fragment,%23version 300 es%0A%23define X3D_COLORSPACE_SRGB%0A%23define X3D_NORMALS%0A%23define X3D_NUM_TEXTURE_TRANSFORMS 1%0A%23define X3D_NUM_TEXTURE_COORDINATES 1%0A%23define X3D_GEOMETRY_3D%0A%23define X3D_PHONG_MATERIAL%0A%23define X3D_LIGHTING%0A%23define X3D_NUM_LIGHTS 2%0A%23define X3D_FOG%0A%23define X3D_FOG_LINEAR%0A%23define X3D_TEXTURE%0A%23define X3D_NUM_TEXTURES 1%0A%23define X3D_TEXTURE_0_2D%0A%0Aprecision highp int;%0Aprecision highp float;%0Aprecision highp sampler2D;%0Aprecision highp sampler3D;%0Aprecision highp samplerCube;%0A%23undef X3D_GEOMETRY_0D%0A%23undef X3D_GEOMETRY_1D%0A%23undef X3D_GEOMETRY_2D%0A%23undef X3D_STYLE_PROPERTIES%0A%23undef X3D_UNLIT_MATERIAL%0A%23undef X3D_MULTI_TEXTURING%0A%23include <Material>%0A');
   if (k == 'h') tr .rotation = new SFRotation (0, 1, 0, 0.8);
   if (k == 'i') f .fogType = 'EXPONENTIAL';
}
"
}
ROUTE K.keyPress TO R.on_key
