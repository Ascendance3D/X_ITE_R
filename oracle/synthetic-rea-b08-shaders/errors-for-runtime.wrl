#X3D V4.0 utf8
PROFILE Full
Viewpoint { position 0 0 5 }
NavigationInfo { headlight FALSE }
DEF TR Transform { children Shape { appearance DEF AP Appearance { material Material { diffuseColor 0.9 0.5 0.3 } shaders [ ComposedShader { language "GLSL" parts [ ShaderPart { type "VERTEX"  url "data:x-shader/x-vertex,
attribute vec4 x3d_Vertex;
attribute vec3 x3d_Normal;
attribute vec4 x3d_TexCoord0;
attribute vec4 x3d_Color;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform mat3 x3d_NormalMatrix;
varying vec3 vN;
varying vec3 vP;
varying vec2 vT;
varying vec4 vC;
void main()
{
   vec4 p = x3d_ModelViewMatrix * x3d_Vertex;
   vP = p.xyz;
   vN = normalize (x3d_NormalMatrix * x3d_Normal);
   vT = x3d_TexCoord0.st;
   vC = x3d_Color;
   gl_Position = x3d_ProjectionMatrix * p;
}
" } DEF FP ShaderPart { type "FRAGMENT"  url "data:x-shader/x-fragment,
precision mediump float;
varying vec3 vN;
varying vec3 vP;
varying vec2 vT;
varying vec4 vC;
void main() { gl_FragColor = vec4 (0.2, 0.8, 0.4, 1.0); }
" } ] } ] } geometry Sphere { radius 1.2 } } }
DEF K KeySensor { }

DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  initializeOnly SFNode fp USE FP
  url "javascript:
function on_key (k)
{
   if (k == 'a') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Auniform float n;%0Avoid main() { float s = 0.0;%0A for (float i = 0.0; i < n; i += 1.0) { s += 0.1; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'b') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0;%0A for (int i = 0; i < 2; ++ i) { i = 3; s += 0.5; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'c') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0; int i;%0A for (i = 0; i < 2; ++ i) { s += 0.5; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'd') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0;%0A for (int i = 0; 2 > i; ++ i) { s += 0.5; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'e') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0;%0A for (int i = 1; i < 8; i *= 2) { s += 0.2; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'f') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0;%0A for (int i = 0; ; ++ i) { s += 0.5; break; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'g') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Auniform int k;%0Avoid main() { float s = 0.0;%0A for (int i = k; i < 2; ++ i) { s += 0.5; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'h') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Aconst int N = 3;%0Avoid main() { float s = 0.0;%0A for (int i = N; i >= 0; i -= 1) { s += 0.1; }%0A for (float f = 0.0; f != 1.0; f += 0.5) { s += 0.1; }%0A gl_FragColor = vec4 (s, 0.5, 0.2, 1.0); }%0A');
   if (k == 'i') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid bump (inout int j) { j += 1; }%0Avoid main() { float s = 0.0;%0A for (int i = 0; i < 2; ++ i) { bump (i); s += 0.5; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'j') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0;%0A for (int i = 0, j = 1; i < 2; ++ i) { s += 0.5; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'k') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0; int i = 0;%0A for (; i < 2; ++ i) { s += 0.5; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'l') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0;%0A for (int i = 0; i < 2;) { s += 0.5; break; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'm') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0A%23define N 2%0Aconst float H = 0.5;%0Avoid main() { float s = 0.0;%0A for (int i = 0; i < N * 2 + 1; i ++) { s += 0.1; }%0A for (float f = 0.0; f < H + float (N); f += H) { s += 0.1; }%0A for (int i = x3d_MaxLights; i > 0; i --) { s += 0.01; }%0A gl_FragColor = vec4 (s, 0.4, 0.7, 1.0); }%0A');
   if (k == 'n') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Auniform int k;%0Avoid main() { float s = 0.0;%0A for (int i = 0; i < 8; i += k) { s += 0.2; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'o') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0;%0A for (int i = 0; i < 2; ++ i) {%0A for (int j = 0; j < i; ++ j) { s += 0.5; } }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'p') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0;%0A for (int i; i < 2; ++ i) { s += 0.5; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'q') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0;%0A for (bool b = true; b == true; b = false) { s += 0.5; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 'r') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0;%0A for (int i = 0; i < 2 && s < 1.0; ++ i) { s += 0.5; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 's') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float s = 0.0;%0A for (int i = 0; i + 1; ++ i) { s += 0.5; }%0A gl_FragColor = vec4 (s); }%0A');
   if (k == 't') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Auniform float a [3];%0Avoid main() { float s = 0.0;%0A for (int i = 0; i < 3; ++ i) { float t = float (i); s += a [i] + t; int k = i; k += 1; }%0A gl_FragColor = vec4 (s, 0.3, 0.3, 1.0); }%0A');
}
"
}
ROUTE K.keyPress TO R.on_key
