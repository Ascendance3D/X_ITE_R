#X3D V4.0 utf8
PROFILE Full
Viewpoint { position 0 0 4 }
NavigationInfo { headlight FALSE }
Transform { children Shape { appearance DEF AP Appearance { texture DEF TX ImageTexture { url "../synthetic-rea-b03/proj-checker.png" } shaders [ DEF CS ComposedShader { language "GLSL" field SFNode map ImageTexture { url "../synthetic-rea-b03/proj-checker.png" } field SFFloat mixer 0 parts [ ShaderPart { type "VERTEX"  url "data:x-shader/x-vertex,
attribute vec4 x3d_Vertex;
attribute vec3 x3d_Normal;
attribute vec4 x3d_TexCoord0;
attribute vec4 x3d_Color;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform mat3 x3d_NormalMatrix;
varying vec3 vN;
varying vec3 vP;
varying vec2 vT;
varying vec4 vC;
void main()
{
   vec4 p = x3d_ModelViewMatrix * x3d_Vertex;
   vP = p.xyz;
   vN = normalize (x3d_NormalMatrix * x3d_Normal);
   vT = x3d_TexCoord0.st;
   vC = x3d_Color;
   gl_Position = x3d_ProjectionMatrix * p;
}
" } ShaderPart { type "FRAGMENT"  url "data:x-shader/x-fragment,
precision mediump float;
varying vec3 vN;
varying vec3 vP;
varying vec2 vT;
varying vec4 vC;
uniform sampler2D map;
uniform sampler2D x3d_Texture2D [x3d_MaxTextures];
uniform float mixer;
void main() { gl_FragColor = mix (texture2D (map, vT), texture2D (x3d_Texture2D [0], vT * 2.0), mixer); }
" } ] } ] } geometry Box { size 2 2 2 } } }
DEF K KeySensor { }

DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  initializeOnly SFNode cs USE CS
  initializeOnly SFNode ap USE AP
  url "javascript:
function on_key (k)
{
   if (k == 'a') cs .mixer = 0.5;
   if (k == 'b') cs .map = Browser .currentScene .createNode ('PixelTexture');
   if (k == 'c') cs .map .image = new SFImage (2, 2, 3, new MFInt32 (0xff0000, 0x00ff00, 0x0000ff, 0xffff00));
   if (k == 'd') ap .texture = Browser .currentScene .createNode ('PixelTexture');
   if (k == 'e') ap .texture .image = new SFImage (2, 1, 3, new MFInt32 (0xff00ff, 0x00ffff));
   if (k == 'f') cs .map = null;
   if (k == 'g') ap .texture = null;
   if (k == 'h') cs .mixer = 1;
}
"
}
ROUTE K.keyPress TO R.on_key
