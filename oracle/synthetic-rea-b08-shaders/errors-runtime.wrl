#X3D V4.0 utf8
PROFILE Full
Viewpoint { position 0 0 5 }
NavigationInfo { headlight FALSE }
DEF TR Transform { children Shape { appearance DEF AP Appearance { material Material { diffuseColor 0.9 0.5 0.3 } shaders [ ComposedShader { language "GLSL" parts [ ShaderPart { type "VERTEX"  url "data:x-shader/x-vertex,
attribute vec4 x3d_Vertex;
attribute vec3 x3d_Normal;
attribute vec4 x3d_TexCoord0;
attribute vec4 x3d_Color;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform mat3 x3d_NormalMatrix;
varying vec3 vN;
varying vec3 vP;
varying vec2 vT;
varying vec4 vC;
void main()
{
   vec4 p = x3d_ModelViewMatrix * x3d_Vertex;
   vP = p.xyz;
   vN = normalize (x3d_NormalMatrix * x3d_Normal);
   vT = x3d_TexCoord0.st;
   vC = x3d_Color;
   gl_Position = x3d_ProjectionMatrix * p;
}
" } DEF FP ShaderPart { type "FRAGMENT"  url "data:x-shader/x-fragment,
precision mediump float;
varying vec3 vN;
varying vec3 vP;
varying vec2 vT;
varying vec4 vC;
void main() { gl_FragColor = vec4 (0.2, 0.8, 0.4, 1.0); }
" } ] } ] } geometry Sphere { radius 1.2 } } }
DEF K KeySensor { }

DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  initializeOnly SFNode fp USE FP
  url "javascript:
function on_key (k)
{
   if (k == 'b') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { gl_FragColor = vec4 (1.0) }%0A');
   if (k == 'c') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { gl_FragColor = foo (1.0); }%0A');
   if (k == 'e') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Afloat f () { return 1.0; }%0A');
   if (k == 'f') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0A%23error custom failure%0Avoid main() { gl_FragColor = vec4 (1.0); }%0A');
   if (k == 'g') fp .url = new MFString ('data:x-shader/x-fragment,%0Avoid main() { gl_FragColor = vec4 (1.0); }%0A');
   if (k == 'i') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Afloat a;%0Afloat a;%0Avoid main() { gl_FragColor = vec4 (1.0); }%0A');
   if (k == 'j') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { gl_Position = vec4 (1.0); gl_FragColor = vec4 (1.0); }%0A');
   if (k == 'l') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Auniform float u;%0Avoid main() { u = 1.0; gl_FragColor = vec4 (u); }%0A');
   if (k == 'm') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { vec2 v = vec2 (1.0); gl_FragColor = vec4 (v.z); }%0A');
   if (k == 'n') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { float a [2]; a [3] = 1.0; gl_FragColor = vec4 (a [0]); }%0A');
   if (k == 'o') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { gl_FragColor = vec4 (sin (vec2 (1.0), 2.0)); }%0A');
   if (k == 'p') fp .url = new MFString ('data:x-shader/x-fragment,%0Aprecision mediump float;%0Avoid main() { gl_FragColor = vec4 (1.0); %0A');
}
"
}
ROUTE K.keyPress TO R.on_key
