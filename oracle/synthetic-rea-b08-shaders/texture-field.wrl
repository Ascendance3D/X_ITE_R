#X3D V4.0 utf8
PROFILE Full
Viewpoint { position 0 0 4 }
NavigationInfo { headlight FALSE }
Shape { appearance Appearance { material Material { diffuseColor 1 0 0 }   shaders [ ComposedShader { language "GLSL"  field SFNode map ImageTexture { url "../synthetic-rea-b03/proj-checker.png" }
      field SFNode map2 PixelTexture { image 2 2 3 0xff0000 0x00ff00 0x0000ff 0xffff00 } parts [ ShaderPart { type "VERTEX"  url "data:x-shader/x-vertex,
attribute vec4 x3d_Vertex;
attribute vec3 x3d_Normal;
attribute vec4 x3d_TexCoord0;
attribute vec4 x3d_Color;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform mat3 x3d_NormalMatrix;
varying vec3 vN;
varying vec3 vP;
varying vec2 vT;
varying vec4 vC;
void main()
{
   vec4 p = x3d_ModelViewMatrix * x3d_Vertex;
   vP = p.xyz;
   vN = normalize (x3d_NormalMatrix * x3d_Normal);
   vT = x3d_TexCoord0.st;
   vC = x3d_Color;
   gl_Position = x3d_ProjectionMatrix * p;
}
" } ShaderPart { type "FRAGMENT"  url "data:x-shader/x-fragment,
precision mediump float;
varying vec3 vN;
varying vec3 vP;
varying vec2 vT;
varying vec4 vC;
uniform sampler2D map;
uniform sampler2D map2;
void main()
{
gl_FragColor = texture2D (map, vT) * 0.6 + texture2D (map2, vT * 2.0) * 0.4;
}
" } ] } ] } geometry Box { size 2 2 2 } }
