  if (k == 175) aCoDz_set_destination = new MFVec3f (new SFVec3f (0.3, 0.4, 0.6), new SFVec3f (1.0, -0.55, 0.6), new SFVec3f (1.7, 0.7, 0.6), new SFVec3f (2.4, -0.85, 0.6), new SFVec3f (3.1, 1.0, 0.6), new SFVec3f (3.8, -1.15, 0.6), new SFVec3f (4.5, 1.3, 0.6));
  if (k == 200) aCoDz_set_destination = new MFVec3f (new SFVec3f (0.6, 0.4, 0.7));
  if (k == 225) aCoDz_set_destination = new MFVec3f (new SFVec3f (0.9, 0.4, 0.8), new SFVec3f (1.6, -0.55, 0.8), new SFVec3f (2.3, 0.7, 0.8), new SFVec3f (3.0, -0.85, 0.8));
  if (k == 75) aCoDz_set_value = new MFVec3f (new SFVec3f (-1.2, 0.4, 0.1), new SFVec3f (-0.5, -0.55, 0.1), new SFVec3f (0.2, 0.7, 0.1), new SFVec3f (0.9, -0.85, 0.1), new SFVec3f (1.6, 1.0, 0.1));
  if (k == 150) aCoDz_set_value = new MFVec3f (new SFVec3f (-1.5, 0.4, 0.0), new SFVec3f (-0.8, -0.55, 0.0));
  if (k == 195) aCoDz_set_value = new MFVec3f ();
  if (k == 201) aCoDz_set_destination = new MFVec3f (new SFVec3f (-1.5, 0.4, 0.0), new SFVec3f (-0.8, -0.55, 0.0), new SFVec3f (-0.1, 0.7, 0.0));
}
  "
}
ROUTE TICK.time TO DRV.tick
ROUTE DRV.go1 TO CLOCK1.startTime
ROUTE DRV.aCoC_set_destination TO aCoC.set_destination
ROUTE DRV.aCoC_set_value TO aCoC.set_value
ROUTE DRV.aCoCi_set_destination TO aCoCi.set_destination
ROUTE DRV.aCoCi_set_value TO aCoCi.set_value
ROUTE DRV.aCoD_set_destination TO aCoD.set_destination
ROUTE DRV.aCoD_set_value TO aCoD.set_value
ROUTE DRV.aCoDz_set_destination TO aCoDz.set_destination
ROUTE DRV.aCoDz_set_value TO aCoDz.set_value
ROUTE DRV.aTC_set_destination TO aTC.set_destination
ROUTE DRV.aTC_set_value TO aTC.set_value
ROUTE DRV.aTD_set_destination TO aTD.set_destination
ROUTE DRV.aTD_set_value TO aTD.set_value
ROUTE aCoC.value_changed TO aCoC_X.point
ROUTE aCoC.value_changed TO aCoC_T.val
ROUTE aCoC.isActive TO aCoC_T.act
ROUTE aCoD.value_changed TO aCoD_X.point
ROUTE aCoD.value_changed TO aCoD_T.val
ROUTE aCoD.isActive TO aCoD_T.act
ROUTE aCoCi.value_changed TO aCoCi_X.point
ROUTE aCoCi.value_changed TO aCoCi_T.val
ROUTE aCoCi.isActive TO aCoCi_T.act
ROUTE CLOCK1.fraction_changed TO aCoCi_I.set_fraction
ROUTE aCoCi_I.value_changed TO aCoCi.set_destination
ROUTE aTC.value_changed TO aTC_X.point
ROUTE aTC.value_changed TO aTC_T.val
ROUTE aTC.isActive TO aTC_T.act
ROUTE aTD.value_changed TO aTD_X.point
ROUTE aTD.value_changed TO aTD_T.val
ROUTE aTD.isActive TO aTD_T.act
ROUTE aCoDz.value_changed TO aCoDz_X.point
ROUTE aCoDz.value_changed TO aCoDz_T.val
ROUTE aCoDz.isActive TO aCoDz_T.act
