DEF DRV Script {
  eventIn SFTime tick
  eventOut SFVec3f ePC_set_destination
  eventOut SFFloat eSC_set_value
  eventOut SFVec3f iPC_set_destination
  field SFInt32 lastK -1
  url "ecmascript:
function tick (value, ts) {
  var k = Math.round ((ts - 946684800) / 0.016666666666666666);
  if (k == lastK) return;
  lastK = k;
  if (k == 40) iPC_set_destination = new SFVec3f (-2.0, 0.0, 1.0);
  if (k == 90) ePC_set_destination = new SFVec3f (0.0, 3.0, 0.0);
  if (k == 100) eSC_set_value = 0.9;
}
  "
}
