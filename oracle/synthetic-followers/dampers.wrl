  if (k == 263) TD2_set_destination = new MFVec2f (new SFVec2f (0.2, 0.8), new SFVec2f (0.35, 0.6), new SFVec2f (0.5, 0.4), new SFVec2f (0.65, 0.2));
  if (k == 32) PDtau0_set_value = new SFVec3f (2.0, -1.0, 0.5);
  if (k == 48) PDtau0_set_destination = new SFVec3f (-2.5, 1.5, -0.5);
  if (k == 49) PDtau0_set_destination = new SFVec3f (2.0, -1.0, 0.5);
  if (k == 127) PDtau0_set_destination = new SFVec3f (0.0, 0.0, 0.0);
  if (k == 133) PDtau0_set_destination = new SFVec3f (-2.5, 1.5, -0.5);
  if (k == 152) PDtau0_set_value = new SFVec3f (-2.5, 1.5, -0.5);
  if (k == 237) PDtau0_set_value = new SFVec3f (0.0, 0.0, 0.0);
  if (k == 264) PDtau0_set_destination = new SFVec3f (0.0, 0.0, 0.0);
}
  "
}
