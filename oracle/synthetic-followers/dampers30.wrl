DEF D0_T Script {
  eventIn SFBool act
  eventIn SFVec3f val
  field SFInt32 n 0
  field SFInt32 len 0
  field SFDouble acc 0
  field SFString acts ""
  field SFString last ""
  url "ecmascript:
function act (v, ts) { acts = acts + Math.round ((ts - 946684800) / 0.03333333333333333) + (v ? '+' : '-') + ' '; }
function val (v, ts) { n = n + 1; acc = acc * 1.0000001 + v.x + 2 * v.y + 3 * v.z; last = v.x + ' ' + v.y + ' ' + v.z; }
  "
}
DEF D0_I PositionInterpolator { key [ 0 0.3 0.6 1 ] keyValue [ 0 0 0, 1.2 0.8 0, -1.2 0.8 0.5, 0 0 0 ] }
