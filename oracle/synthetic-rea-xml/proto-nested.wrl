#VRML V2.0 utf8
# A PROTO instance inside another PROTO body, and an instance of the outer PROTO.
PROTO Inner [ field SFColor c 1 0 0 ] {
  Material { diffuseColor IS c }
}
PROTO Outer [ field SFColor oc 0 1 0 ] {
  Group {
    children [
      Shape {
        appearance Appearance { material Inner { c IS oc } }
        geometry Sphere { radius 1 }
      }
    ]
  }
}
DEF O1 Outer { oc 0 0 1 }
Outer { }
