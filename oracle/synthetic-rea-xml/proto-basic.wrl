#VRML V2.0 utf8
# PROTO with interface fields of each access type, connected with IS.
PROTO Badge [
  field SFColor tint 1 0 0
  eventIn SFFloat setAlpha
  eventOut SFColor tintChanged
  exposedField SFVec3f size 2 2 2
  field MFString labels ["x" "y"]
]
{
  Transform {
    scale IS size
    children [
      Shape {
        appearance Appearance { material Material { diffuseColor IS tint } }
        geometry Box { size 1 1 1 }
      }
    ]
  }
}
DEF B1 Badge { tint 0 1 0 scale 3 }
DEF B2 Badge { }
ROUTE B1.tintChanged TO B2.tint
