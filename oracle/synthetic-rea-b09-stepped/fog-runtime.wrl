#X3D V4.0 utf8
PROFILE Full
Viewpoint { position 0 0 6 }
NavigationInfo { type "NONE" headlight FALSE }
DEF B Background { skyColor 0.2 0.25 0.3 }
DirectionalLight { direction -0.3 -0.4 -1 intensity 0.9 ambientIntensity 0.3 }
DEF F1 Fog { color 0.8 0.4 0.3 visibilityRange 14 }
DEF F2 Fog { color 0.2 0.8 0.5 fogType "EXPONENTIAL" visibilityRange 8 }
Transform { translation -3 0 -2 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.6 0.4 specularColor 0.4 0.3 0.2 shininess 0.3 } } geometry Sphere { radius 0.8 } } }
Transform { translation 3 0 -8 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.6 0.4 specularColor 0.4 0.3 0.2 shininess 0.3 } } geometry Sphere { radius 0.8 } } }
Transform { translation 0 1.5 -5 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.6 0.4 specularColor 0.4 0.3 0.2 shininess 0.3 } } geometry Sphere { radius 0.8 } } }
DEF G Transform { children [ DEF LF LocalFog { color 1 1 0.2 visibilityRange 9 }
Transform { translation -1.5 -1.5 -1 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.6 0.4 specularColor 0.4 0.3 0.2 shininess 0.3 } } geometry Sphere { radius 0.8 } } }
Transform { translation 1.5 -1.5 -6 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.6 0.4 specularColor 0.4 0.3 0.2 shininess 0.3 } } geometry Sphere { radius 0.8 } } }
] }
DEF H Group { }
DEF FS Transform { translation 4.5 0 -1 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.6 0.4 specularColor 0.4 0.3 0.2 shininess 0.3 } }
  geometry IndexedFaceSet { solid FALSE coord Coordinate { point [ -0.4 -1.5 0, 0.4 -1.5 0, 0.4 -0.5 0, -0.4 -0.5 0, 0.4 0.5 0, -0.4 0.5 0, 0.4 1.5 0, -0.4 1.5 0 ] }
    coordIndex [ 0 1 2 3 -1 3 2 4 5 -1 5 4 6 7 -1 ] fogCoord DEF FC FogCoordinate { depth [ 0 0 0.3 0.3 0.6 0.6 1 1 ] } } } }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  inputOutput SFString log ""
  initializeOnly SFNode f1 USE F1
  initializeOnly SFNode f2 USE F2
  initializeOnly SFNode lf USE LF
  initializeOnly SFNode g USE G
  initializeOnly SFNode fc USE FC
  initializeOnly SFNode b USE B
  initializeOnly SFNode h USE H
  inputOnly SFBool on_b1
  inputOnly SFBool on_b2
  inputOnly SFTime on_t1
  url "javascript:
var lf2 = null;
function on_b1 (v) { log = log + 'F1:' + v + ' '; }
function on_b2 (v) { log = log + 'F2:' + v + ' '; }
function on_t1 (v) { log = log + 'T1 '; }
function on_key (k)
{
   log = log + 'K' + k + ' ';
   if (k == 'a') f1 .color = new SFColor (0.2, 0.3, 0.9);
   if (k == 'b') f1 .visibilityRange = 6;
   if (k == 'c') f1 .fogType = 'EXPONENTIAL';
   if (k == 'd') f2 .set_bind = true;
   if (k == 'e') f1 .set_bind = true;
   if (k == 'f') lf .enabled = false;
   if (k == 'g') lf .enabled = true;
   if (k == 'h') lf .color = new SFColor (0.1, 1, 0.3);
   if (k == 'i') lf .visibilityRange = 0;
   if (k == 'j') lf .visibilityRange = 5;
   if (k == 'k') lf .fogType = 'EXPONENTIAL';
   if (k == 'l') lf .visibilityStart = 2;
   if (k == 'm') fc .depth = new MFFloat (1, 1, 0.5, 0.5, 0, 0, 0.5, 0.5);
   if (k == 'n') g .scale = new SFVec3f (2, 2, 2);
   if (k == 'o') g .removeChildren = new MFNode (lf);
   if (k == 'p') g .addChildren = new MFNode (lf);
   if (k == 'q') f2 .set_bind = false;
   if (k == 'r') f1 .visibilityRange = 0;
   if (k == 's') f1 .visibilityRange = 14;
   if (k == 't') { lf2 = Browser .currentScene .createNode ('LocalFog'); lf2 .color = new SFColor (1, 0.2, 0.2); lf2 .visibilityRange = 7; h .addChildren = new MFNode (lf2); }
   if (k == 'u') lf2 .enabled = false;
   if (k == 'v') fc .depth = new MFFloat ();
   if (k == 'w') g .translation = new SFVec3f (0, 1, 3);
}
"
}
ROUTE K.keyPress TO R.on_key
ROUTE F1.isBound TO R.on_b1
ROUTE F2.isBound TO R.on_b2
ROUTE F1.bindTime TO R.on_t1
