DEF spazz_init TimeSensor {
  cycleInterval 0.5
  loop TRUE
  startTime  0
}
DEF Script_spazz_init Script {
  field    SFNode      tproc     USE  spazz_init
  field    SFInt32     count  0
  eventOut SFTime      triggerStart
  eventIn  SFTime      cycle
  directOutput         TRUE
  url "vrmlscript:
   function cycle( curtime ) {
    if(count++ > 5) {
      triggerStart = curtime;
      tproc.enabled = FALSE;
   }}
   "
}
ROUTE spazz_init.cycleTime TO Script_spazz_init.cycle
ROUTE Script_spazz_init.triggerStart TO Script_Wizard0.startAt0
ROUTE Script_spazz_init.triggerStart TO Script_Wizard1.startAt0
ROUTE Script_spazz_init.triggerStart TO Script_Wizard2.startAt0
ROUTE Script_spazz_init.triggerStart TO Script_Wizard3.startAt0
ROUTE Script_spazz_init.triggerStart TO Script_Wizard4.startAt0
ROUTE Script_spazz_init.triggerStart TO Script_Wizard5.startAt0
ROUTE Script_spazz_init.triggerStart TO Script_Wizard6.startAt0
ROUTE Script_spazz_init.triggerStart TO Script_Wizard7.startAt0
ROUTE Script_spazz_init.triggerStart TO Script_Wizard.startAt0
ROUTE Wizard0.fraction_changed TO Wizard0_rot0.set_fraction
ROUTE Wizard0_rot0.value_changed TO dad_Cylinder3.set_rotation
ROUTE Wizard0.isActive TO Script_Wizard0.activated
ROUTE Wizard0.cycleTime TO Script_Wizard0.cycle
ROUTE Wizard1.fraction_changed TO Wizard1_pos0.set_fraction
ROUTE Wizard1_pos0.value_changed TO dad_Cylinder1.set_translation
ROUTE Wizard1.fraction_changed TO Wizard1_rot0.set_fraction
ROUTE Wizard1_rot0.value_changed TO dad_Cylinder1.set_rotation
ROUTE Wizard1.isActive TO Script_Wizard1.activated
ROUTE Wizard1.cycleTime TO Script_Wizard1.cycle
ROUTE Wizard2.fraction_changed TO Wizard2_pos0.set_fraction
ROUTE Wizard2_pos0.value_changed TO dad_Box3.set_translation
ROUTE Wizard2.isActive TO Script_Wizard2.activated
ROUTE Wizard2.cycleTime TO Script_Wizard2.cycle
ROUTE Wizard3.fraction_changed TO Wizard3_pos0.set_fraction
ROUTE Wizard3_pos0.value_changed TO dad_Box3.set_translation
ROUTE Wizard3.isActive TO Script_Wizard3.activated
ROUTE Wizard3.cycleTime TO Script_Wizard3.cycle
