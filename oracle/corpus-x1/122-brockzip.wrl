geometry Box { size 4 0.04 0.1}}
]}
Transform {translation 0 1.77 0 children USE Frame1}
]}

#frameS
Transform {children [
Transform { translation -2 0.02 0 children [
DEF Frame2 Shape { appearance Appearance { material Material {}
texture ImageTexture { url "brock.jpg"}
