0.005 -0.0175 -0.01, 0 -0.005 0, ]}
coordIndex [ 
0,16,8,-1, 0,8,7,-1, 0,7,1,-1, 1,7,2,-1, 2,7,6,-1, 2,6,3,-1, 3,6,5,-1, 3,5,4,-1, 
16,9,8,-1, 16,15,9,-1, 15,14,9,-1, 14,10,9,-1, 14,13,10,-1, 13,11,10,-1, 13,12,11,-1, ]
solid FALSE creaseAngle 1.6 }}
Transform { rotation 0 0 1 3.14 children [ USE TailFin ]} ]} ]}
#air bubble
DEF Bubble Transform { translation 0 0 0 scale 0 0 0 children [ 
Shape { appearance DEF water Appearance { 
material Material { diffuseColor 0.5 0.75 0.65 emissiveColor 0.05 0.075 0.065 
shininess 1 specularColor 0 0.7 0.8 transparency 0.6 }
texture PixelTexture { image 1 1 3 0x55cccc }}
geometry Sphere { radius 0.0075 }} ]}
]} ]}#end GoldFish transforms

#Bowl
Transform { scale 1.5 1.75 1.5 children [
DEF bowl_T TouchSensor {}
Shape { appearance Appearance { 
material Material { diffuseColor 0.5 0.5 0.5 emissiveColor 0.05 0.05 0.05 
shininess 1 specularColor 0 0.7 0.8 transparency 0.6 }
texture PixelTexture { image 1 1 3 
0x7799cc }}
geometry Extrusion {
crossSection [ -0.1 0, -0.09 0.04, -0.07 0.07, -0.04 0.09, 0 0.1, 0.04 0.09, 0.07 0.07, 0.09 0.04, 0.1 0, 
0.09 -0.04, 0.07 -0.07, 0.04 -0.09, 0 -0.1, -0.04 -0.09, -0.07 -0.07, -0.09 -0.04, -0.1 0, ]
spine [ 0 0 0, 0 0.02 0, 0 0.04 0, 0 0.06 0, 0 0.08 0, 0 0.10 0, 0 0.12 0, 0 0.14 0, 0 0.16 0, 0 0.18 0, 0 0.20 0, 
0 0.22 0, 0 0.24 0, 0 0.26 0, 0 0.28 0, 0 0.30 0, 0 0.32 0, 0 0.34 0, 0 0.36 0, 0 0.38 0, 0 0.40 0, ]
scale [ 2.5 2.5, 2.9 2.9, 3.1 3.1, 3.3 3.3, 3.42 3.42, 3.5 3.5, 3.55 3.55, 3.59 3.59, 3.62 3.62, 3.64 3.64, 
3.64 3.64, 3.62 3.62, 3.59 3.59, 3.55 3.55, 3.5 3.5, 3.42 3.42, 3.3 3.3, 3.1 3.1, 2.92 2.92, 2.98 2.98, 3.1 3.1, ]
solid FALSE creaseAngle 1.6 endCap FALSE }} 
#water surface
Shape { appearance Appearance { 
material Material { diffuseColor 0.5 0.75 0.65 emissiveColor 0.05 0.075 0.065 
shininess 1 specularColor 0 0.7 0.8 transparency 0.6 }
texture PixelTexture { image 1 1 3 0x55cccc }}
geometry IndexedFaceSet { coord Coordinate { point [
-0.34 0.3 0, -0.306 0.3 0.136, -0.238 0.3 0.238, -0.136 0.3 0.306, 0 0.3 0.34, 0.136 0.3 0.306, 
0.238 0.3 0.238, 0.306 0.3 0.136, 0.34 0.3 0, 0.306 0.3 -0.136, 0.238 0.3 -0.238, 0.136 0.3 -0.306, 
