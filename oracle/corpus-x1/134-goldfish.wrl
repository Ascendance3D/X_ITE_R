#VRML V2.0 utf8
WorldInfo { title "Animated Lonely Goldfish" info ["(C)2003 Char aka Fire-Valkyrie"]}

#world transform 
Transform { scale 0.5 0.5 0.5 translation 0 -1.75 0 children [
DEF Fish_VS1 VisibilitySensor {
center 0 2 0
size 2 4 2 }
DEF Fish_PS1 ProximitySensor {
center 0 2 0
size 10 4 10 
enabled FALSE }
#goldfish
DEF GoldFishSwim Transform { rotation 0 1 0 0 children [ 
DEF GoldFishGulp Transform { translation 0 0.3 0.35 rotation 0 1 0 1 children [
Shape { appearance Appearance { material DEF scale_gold Material {
diffuseColor 1 0.5 0 emissiveColor 0.1 0.05 0 shininess 1 specularColor 1 1 0 }
texture PixelTexture { image 2 20 3 
0xff7700 0xff9900 	0xff9900 0xff7700 	0xff7700 0xff9900 	0xff9900 0xff7700 
0xff7700 0xff9900 	0xff9900 0xff7700 	0xff9933 0xffcc99 	0xffcc99 0xff9933 
0xff9933 0xffcc99 	0xffcc99 0xff9933 	0xff9933 0xffcc99 	0xffcc99 0xff9933 
0xff9933 0xffcc99 	0xffcc99 0xff9933 	0xff7700 0xff9900 	0xff9900 0xff7700 
0xff7700 0xff9900 	0xff9900 0xff7700 	0xff7700 0xff9900 	0xff9900 0xff7700 }
textureTransform TextureTransform { scale 10 1 rotation 1.57 }}
geometry Extrusion { 
crossSection [ -0.1 0, -0.07 0.07, 0 0.1, 0.07 0.07, 0.1 0, 0.07 -0.07, 0 -0.1, -0.07 -0.07, -0.1 0, ]
spine [ 0 0.005 0, 0 0.0025 -0.01, 0 0 -0.025, 0 0 -0.035, 0 0 -0.045, 0 0 -0.055, 0 0 -0.065, 0 0 -0.075, 
0 0 -0.085, 0 0 -0.095, 0 0 -0.105, 0 0 -0.115, 0 0 -0.125, ]
scale [ 0 0, 0.15 0.15, 0.3 0.3, 0.38 0.38, 0.45 0.45, 0.48 0.48, 0.5 0.5, 0.48 0.48, 0.45 0.45, 0.38 0.38, 
0.25 0.1, 0.15 0.05, 0.1 0, ]
solid TRUE creaseAngle 1.6 }}
#eyes
Transform { translation 0.015 0.01 -0.015 rotation -0.5 1 0 0.75 children [
DEF Eye Group { children [
Transform { scale 1 1 0.5 children [
Shape { appearance Appearance { material Material {
diffuseColor 1 0.5 0 emissiveColor 0.1 0.05 0 shininess 1 specularColor 1 1 0 }}
geometry Sphere { radius 0.0075 }} ]}
Transform { translation 0 -0.0005 0.001 rotation 1 0 0 1.57 children [
Shape { appearance Appearance { material DEF shiny_black Material {
diffuseColor 0.1 0.05 0 shininess 1 specularColor 1 0.5 0 }
texture PixelTexture { image 1 7 3  
0x000000 0x000000 0x000000 0x000000 0xffcc99 0x000000 0x000000 }}
geometry Sphere { radius 0.005 }} ]}
]} ]}
Transform { translation -0.015 0.01 -0.015 rotation -0.5 -1 0 0.75 children [ USE Eye ]}
#fins
DEF RF_Fin Transform { translation 0.0345 -0.01 -0.035 rotation 0 -1 -1 0.8 children [
DEF Right_Fin Shape { appearance Appearance { material DEF fin_gold Material {
diffuseColor 0.9 0.4 0.2 emissiveColor 0.09 0.04 0.02 shininess 1 specularColor 1 0.5 0 transparency 0.2 }
texture DEF fin_ptx PixelTexture { image 2 5 3
0xffaa88 0xff7744
0xff9966 0xee6633
0xff8844 0xdd5522
0xff7722 0xcc4411
0xff6600 0xcc3300 }
textureTransform TextureTransform { rotation -1.1 scale 15 1 translation 0 -0.6 }}
geometry IndexedFaceSet { coord Coordinate { point [
0 0 0, 0.01 0 0.005, 0.02 -0.005 0.005, 0.03 -0.0125 0.002, 0.04 -0.02 -0.005, 0.045 -0.025 -0.01, 
0.04 -0.02 -0.02, 0.03 -0.0125 -0.03, 0.02 -0.005 -0.03, 0.01 0 -0.025, 0 0 -0.01, ]}
coordIndex [
0,1,9,10,-1, 1,2,8,9,-1, 2,3,7,8,-1, 3,4,6,7,-1, 4,5,6,-1, ]
solid FALSE creaseAngle 1.6 }} ]}
DEF RR_Fin Transform { translation 0.0375 -0.03 -0.065 rotation 0 0.35 -1 1 children [ USE Right_Fin ]}
DEF LF_Fin Transform { translation -0.0345 -0.01 -0.035 rotation 0 1 1 0.8 children [
DEF Left_Fin Shape { appearance Appearance {
material USE fin_gold 
texture USE fin_ptx
textureTransform TextureTransform { rotation 1.1 scale 15 1 translation 0 -0.4 }}
geometry IndexedFaceSet { coord Coordinate { point [
0 0 0, -0.01 0 0.005, -0.02 -0.005 0.005, -0.03 -0.0125 0.002, -0.04 -0.02 -0.005, -0.045 -0.025 -0.01, 
-0.04 -0.02 -0.02, -0.03 -0.0125 -0.03, -0.02 -0.005 -0.03, -0.01 0 -0.025, 0 0 -0.01, ]}
coordIndex [
0,1,9,10,-1, 1,2,8,9,-1, 2,3,7,8,-1, 3,4,6,7,-1, 4,5,6,-1, ]
solid FALSE creaseAngle 1.6 }} ]}
DEF LR_Fin Transform { translation -0.0375 -0.03 -0.065 rotation 0 -0.35 1 1 children [ USE Left_Fin ]}
DEF BackFin Shape { appearance Appearance {
material USE fin_gold 
texture USE fin_ptx
textureTransform TextureTransform { rotation 2.6 scale 15 1 translation 0 -0.4 }}
geometry IndexedFaceSet { coord DEF B_Fin_Coords Coordinate { point [
0 0.045 -0.045, 0 0.048 -0.055, 0 0.05 -0.065, 0 0.048 -0.075, 
0 0.045 -0.085, 0 0.038 -0.095, 0 0.025 -0.105, 
0.003 0.07 -0.06, -0.003 0.064 -0.0665, 0.003 0.061 -0.075, -0.003 0.058 -0.085, 
0.003 0.0535 -0.095, -0.003 0.044 -0.104, 0.003 0.033 -0.107, ]}
coordIndex [ 
0,1,7,-1, 1,8,7,-1, 1,2,8,-1, 2,9,8,-1, 2,3,9,-1, 3,10,9,-1, 3,4,10,-1, 4,11,10,-1, 4,5,11,-1, 5,12,11,-1, 
5,6,12,-1, 6,13,12,-1, ]
solid FALSE creaseAngle 1.6 }}
Transform { scale 2 2 2 translation 0 0 -0.125 children [
DEF Tail_Fin Transform { rotation 0 1 0 0 children [
DEF TailFin Shape { appearance Appearance {
material USE fin_gold 
texture USE fin_ptx
textureTransform TextureTransform { scale 25 1 }} 
geometry IndexedFaceSet { coord Coordinate { point [
0 0.005 0, 0.005 0.0175 -0.01, 0.009 0.0225 -0.0175, 0.011 0.027 -0.03, 0.012 0.027 -0.032, 
0.012 0.025 -0.035, 0.012 0.02 -0.032, 0.008 0.005 -0.025, 0.005 0 -0.023, 0.008 -0.005 -0.025, 
