#bottom gravel
Shape { appearance DEF gravel Appearance { material Material { 
diffuseColor 0.85 0.75 0.65 }
texture ImageTexture { url "goldfish_gravel.jpg" }
textureTransform TextureTransform { scale 10 10 }}
geometry Extrusion {
crossSection [ -0.1 0, -0.09 0.04, -0.07 0.07, -0.04 0.09, 0 0.1, 0.04 0.09, 0.07 0.07, 0.09 0.04, 0.1 0, 
0.09 -0.04, 0.07 -0.07, 0.04 -0.09, 0 -0.1, -0.04 -0.09, -0.07 -0.07, -0.09 -0.04, -0.1 0, ]
spine [ 0 0.01 0, 0 0.02 0, 0 0.04 0, ]
scale [ 2.5 2.5, 2.8 2.8, 3 3, ]
solid TRUE creaseAngle 1.6  }}
]}
Transform { translation 0 0.07 0.04 scale 1 0.5 1 children [
Shape { appearance USE gravel 
geometry DEF stone Sphere { radius 0.05 }} ]}
Transform { translation 0.05 0.07 -0.04 scale 1 0.5 2 rotation 0 1 0 0.6 children [
Shape { appearance USE gravel 
geometry USE stone } ]}
Transform { translation -0.09 0.08 0.07 scale 1 0.75 1.5 rotation 1 -0.5 1 1.2 children [
Shape { appearance USE gravel 
geometry USE stone } ]}

#plants
Transform { translation -0.03 0.07 -0.03 children [
DEF Plant1 Transform { rotation 1 0 0 0 children [
Shape { appearance DEF dark_green Appearance { material Material {
diffuseColor 0.2 0.4 0.2 specularColor 0.2 0.5 0.2 }}
geometry Extrusion { crossSection [ -0.01 0.005, 0 0, 0.01 0.005, ]
spine [ 0 0 0, 0 0.2 0.05, 0 0.28 0.075, 0 0.34 0.1, 0 0.38 0.13, 0 0.41 0.17, 0 0.43 0.22, 0 0.45 0.3, ]
scale [ 0 0, 0.5 0.5, 1 1, 1 1, 1 1, 1 1, 0.5 0.5, 0 0, ]
orientation [ 0 1 0 1.57 ]
solid FALSE creaseAngle 1.6 endCap FALSE beginCap FALSE }} ]} ]}
Transform { translation -0.025 0.07 -0.03 rotation 0 1 0 0.2 children [ USE Plant1 ]}
Transform { translation -0.02 0.07 -0.03 rotation 0 1 0 0.5 children [ USE Plant1 ]}
Transform { translation -0.035 0.07 -0.03 rotation 0 -1 0 0.25 children [ USE Plant1 ]}
Transform { translation -0.04 0.07 -0.03 rotation 0 -1 0 0.55 children [ USE Plant1 ]}
Transform { translation -0.045 0.07 -0.035 rotation 0 -1 0 1 children [ USE Plant1 ]}
Transform { translation -0.05 0.07 -0.04 rotation 0 -1 0 1.25 children [ USE Plant1 ]}
Transform { translation -0.01 0.07 -0.04 children [
