Shape { appearance USE dark_green 
geometry Extrusion { crossSection [ -0.01 0.0025, 0 0, 0.01 0.0025, ]
spine [ 0 0 0, 0 0.05 -0.02, 0 0.1 -0.05, 0 0.12 -0.08, 0 0.12 -0.13, 0 0.1 -0.17, 0 0.08 -0.2, ]
scale [ 0 0, 1 1, 2 2, 2.5 2.5, 2 2, 1 1, 0 0, ]
