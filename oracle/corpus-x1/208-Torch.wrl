ROUTE Animation1.fraction_changed TO Animation1_scl2.set_fraction
ROUTE Animation1_scl2.value_changed TO dad_Extrusion3.set_scale
ROUTE Animation1.fraction_changed TO Animation1_pos3.set_fraction
ROUTE Animation1_pos3.value_changed TO dad_Extrusion4.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot3.set_fraction
ROUTE Animation1_rot3.value_changed TO dad_Extrusion4.set_rotation
ROUTE Animation1.fraction_changed TO Animation1_scl3.set_fraction
ROUTE Animation1_scl3.value_changed TO dad_Extrusion4.set_scale
ROUTE Animation1.fraction_changed TO Animation1_pos4.set_fraction
ROUTE Animation1_pos4.value_changed TO dad_Extrusion5.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot4.set_fraction
ROUTE Animation1_rot4.value_changed TO dad_Extrusion5.set_rotation
ROUTE Animation1.fraction_changed TO Animation1_scl4.set_fraction
ROUTE Animation1_scl4.value_changed TO dad_Extrusion5.set_scale
ROUTE Animation1.fraction_changed TO Animation1_pos5.set_fraction
ROUTE Animation1_pos5.value_changed TO dad_Extrusion6.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot5.set_fraction
ROUTE Animation1_rot5.value_changed TO dad_Extrusion6.set_rotation
ROUTE Animation1.fraction_changed TO Animation1_scl5.set_fraction
ROUTE Animation1_scl5.value_changed TO dad_Extrusion6.set_scale
ROUTE Animation1.fraction_changed TO Animation1_pos6.set_fraction
ROUTE Animation1_pos6.value_changed TO dad_Extrusion7.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot6.set_fraction
ROUTE Animation1_rot6.value_changed TO dad_Extrusion7.set_rotation
ROUTE Animation1.fraction_changed TO Animation1_scl6.set_fraction
ROUTE Animation1_scl6.value_changed TO dad_Extrusion7.set_scale
ROUTE Animation1.fraction_changed TO Animation1_pos7.set_fraction
ROUTE Animation1_pos7.value_changed TO dad_Extrusion8.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot7.set_fraction
ROUTE Animation1_rot7.value_changed TO dad_Extrusion8.set_rotation
ROUTE Animation1.fraction_changed TO Animation1_scl7.set_fraction
ROUTE Animation1_scl7.value_changed TO dad_Extrusion8.set_scale
ROUTE Animation1.isActive TO Script_Animation1.activated
ROUTE Animation1.cycleTime TO Script_Animation1.cycle
ROUTE Script_Animation1.triggerStop TO Script_Animation2.startAt0
ROUTE Script_Animation1.triggerStart TO Script_Animation2.stop
ROUTE Script_Animation1.triggerStop TO Script_Light1.stop
ROUTE Script_Animation1.triggerStart TO Script_Light1.start
