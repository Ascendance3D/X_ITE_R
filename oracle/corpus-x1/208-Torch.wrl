DEF Script_Animation1 Script {
  field    SFNode      tproc     USE  Animation1
 field    SFBool state     FALSE
 field    SFTime pause     0
 eventIn  SFTime toggle
 eventOut SFTime triggerStart
 eventOut SFTime triggerStop
 eventOut SFTime triggerStartInt
 eventIn  SFBool activated
 eventIn  SFTime cycle
 directOutput TRUE
 url "vrmlscript:
 function activated( active, curtime ) {
  if( active ) {
   triggerStart = curtime;
   state = TRUE;
  }
  else {
   triggerStop = curtime;
   state = FALSE;
  }
 }
 function cycle( curtime ) {
  triggerStartInt = curtime;
 }
 function toggle( stime ) {
  if( state )
  {
   state = FALSE;
   pause = stime - tproc.startTime_changed;
   tproc.enabled = FALSE;
  }
  else
  {
   state = TRUE;
   tproc.set_startTime = stime - pause;
   tproc.enabled = TRUE;
   pause = 0;
  }
 }
 "
}
DEF Script_Animation2 Script {
  field    SFNode      tproc     USE  Animation2
 field    SFBool state     FALSE
 field    SFTime pause     0
 eventIn  SFTime startAt0
 eventIn  SFTime stop
 eventOut SFTime triggerStart
 eventOut SFTime triggerStop
 eventOut SFTime triggerStartInt
 eventIn  SFBool activated
 eventIn  SFTime cycle
 directOutput TRUE
 url "vrmlscript:
 function activated( active, curtime ) {
  if( active ) {
   triggerStart = curtime;
   state = TRUE;
  }
  else {
   triggerStop = curtime;
   state = FALSE;
  }
 }
 function cycle( curtime ) {
  triggerStartInt = curtime;
 }
 function startAt0( stime ) {
  state = TRUE;
  tproc.set_startTime = stime;
  tproc.enabled = TRUE;
  pause = 0;
 }
 function stop( stime ) {
  if( state )
  {
   state = FALSE;
   pause = stime - tproc.startTime_changed;
   tproc.enabled = FALSE;
  }
 }
 "
}
DEF Script_Light1 Script {
  field    SFNode      lght     USE  Light1
  field  SFBool  state FALSE  eventIn  SFTime      start
  eventIn  SFTime      stop
  directOutput         TRUE
  url "vrmlscript:
 function stop( ) {
  state = FALSE;
  lght.set_on = state;
 }
 function start( ) {
  state = TRUE;
  lght.set_on = state;
 }
 "
}

]}

ROUTE Sensor1.touchTime TO Script_Animation1.toggle
ROUTE Animation1.fraction_changed TO Animation1_pos0.set_fraction
ROUTE Animation1_pos0.value_changed TO dad_Extrusion1.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot0.set_fraction
ROUTE Animation1_rot0.value_changed TO dad_Extrusion1.set_rotation
ROUTE Animation1.fraction_changed TO Animation1_scl0.set_fraction
ROUTE Animation1_scl0.value_changed TO dad_Extrusion1.set_scale
ROUTE Animation1.fraction_changed TO Animation1_pos1.set_fraction
ROUTE Animation1_pos1.value_changed TO dad_Extrusion2.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot1.set_fraction
ROUTE Animation1_rot1.value_changed TO dad_Extrusion2.set_rotation
ROUTE Animation1.fraction_changed TO Animation1_scl1.set_fraction
ROUTE Animation1_scl1.value_changed TO dad_Extrusion2.set_scale
ROUTE Animation1.fraction_changed TO Animation1_pos2.set_fraction
