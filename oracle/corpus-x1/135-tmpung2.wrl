DEF cloudy1 TimeSensor {
cycleInterval 120
stopTime -1
loop TRUE
}

DEF smokey1 TimeSensor {
cycleInterval 5
stopTime -1
loop TRUE
}

DEF waves TimeSensor {
cycleInterval 20
stopTime -1
loop TRUE
}

DEF waves_move Script {
eventIn SFFloat fraction
eventOut SFVec2f translation
field SFVec2f tt 0 0
url "vrmlscript:
function fraction(value) {
tt[1] = value / -16;
tt[0] = value / -8;
translation = tt;
}"
}

DEF clouds_move1 Script {
eventIn SFFloat fraction
eventOut SFVec2f translation
field SFVec2f tt 0 0
url "vrmlscript:
function fraction(value) {
tt[1] = value / -2;
tt[0] = value / -2;
translation = tt;
}"
}

DEF smoke_rise1 Script {
eventIn SFFloat fraction
eventOut SFVec2f translation
field SFVec2f tt 0 0
url "vrmlscript:
function fraction(value) {
tt[1] = value / -0.1;
tt[0] = value / -0.1;
translation = tt;
}"
}

ROUTE  smokey1.fraction_changed   TO     smoke_rise1.fraction
ROUTE  smoke_rise1.translation     TO     Smoke1.set_translation

ROUTE  waves.fraction_changed   TO     waves_move.fraction
ROUTE  waves_move.translation     TO     Waves1.set_translation

ROUTE  cloudy1.fraction_changed   TO     clouds_move1.fraction
ROUTE  clouds_move1.translation     TO     Clouds1.set_translation
ROUTE  clouds_move1.translation     TO     Clouds2.set_translation
ROUTE  clouds_move1.translation     TO     Clouds3.set_translation
ROUTE  clouds_move1.translation     TO     Clouds4.set_translation
ROUTE  clouds_move1.translation     TO     Clouds5.set_translation

ROUTE ProxSensor01.enterTime TO Rectangle03-TIMER.startTime
ROUTE ProxSensor01.enterTime TO Rectangle01-TIMER.startTime
ROUTE ProxSensor02.enterTime TO Rectangle06-TIMER.startTime
ROUTE ProxSensor03.enterTime TO Rectangle07-TIMER.startTime
