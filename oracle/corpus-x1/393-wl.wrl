DEF wl Script{

eventIn SFString set_picture
eventIn SFString set_link
eventIn MFNode receive

field SFNode self USE wl
field SFNode testGroup USE testGroup
field SFNode Picture USE thisPic
field SFNode linkPop USE linkPop
field SFNode updatePop USE updatePop

eventOut MFString pic_changed

directOutput TRUE

url"vrmlscript:

function set_picture(v){
 //Picture.children[0].appearance.texture.url = new MFString(v);
 Picture.url = new MFString(v);
}

function set_link(v,t){
 return; // link updates handled in database
}

function receive(v){
 set_picture(v[0].picUrl);
}

function initialize(){

plane = 'Shape {'+
    'appearance Appearance {material Material{transparency 1}}'+
    'geometry IndexedFaceSet {solid FALSE coord Coordinate {point[-1000000 2000000 -1000000,-1000000 2000000 1000000,1000000 2000000 1000000,1000000 2000000 -1000000]}'+
    'coordIndex[ 0, 1, 2, 3, -1 ]'+
    '}}';

Plane = Browser.createVrmlFromString(plane)[0];

testGroup.addChildren = new MFNode(Plane);

start = new SFVec3f(0,3000000,0);
stop = new SFVec3f(0,1000000,0);

thisPath = Browser.computeRayHit(start,stop).hitPath;

testGroup.removeChildren = new MFNode(Plane);

//s = 'Transform{'+
//    'children Shape {'+
//    'appearance Appearance {texture ImageTexture {url \" \" }}'+
//    'geometry IndexedFaceSet {coord Coordinate {point[-0.5 -1.75 0,0.5 -1.75 0,0.5 -0.75 0,-0.5 -0.75 0]}coordIndex[ 0, 1, 2, 3, -1 ]texCoord  TextureCoordinate {point[0 0,1 0,1 1,0 1]}texCoordIndex[0, 1, 2, 3, -1]'+
//    '}}}';
    
//Picture = Browser.createVrmlFromString(s)[0];
//Picture.translation = thisPath[1].translation;
//Picture.rotation = thisPath[1].rotation;
//thisPath[0].addChildren = new MFNode(Picture);

//Browser.addRoute(thisPath[1],'translation_changed',Picture,'set_translation');
//Browser.addRoute(thisPath[1],'rotation_changed',Picture,'set_rotation');
//Browser.addRoute(self,'pic_changed',Picture.children[0].appearance.texture,'url');

s = 'DEF ls_'+thisPath[1].id+' Script{'+
    'eventIn SFString set_picture       eventIn SFString set_link '+
    'eventOut SFString picture_changed  eventOut SFString link_changed '+
    'url\"vrmlscript: '+
    'function set_picture(v,t){picture_changed = v;} '+
    'function set_link(v,t){link_changed = v;} '+
    '\"}';

LinkScript = Browser.createVrmlFromString(s)[0];
thisPath[0].addChildren = new MFNode(LinkScript);

Browser.addRoute(LinkScript,'picture_changed',self,'set_picture');
Browser.addRoute(LinkScript,'link_changed',self,'set_link');

linkPop.new_url = 'http://www.spyglassvr.com/cgi-bin/games/makelink.pl?id='+thisPath[1].id;
updatePop.new_url = 'http://www.spyglassvr.com/cgi-bin/games/linkform.pl?id='+thisPath[1].id;

query = new MFString('http://www.spyglassvr.com/cgi-bin/games/setpic.pl?id='+thisPath[1].id);
Browser.createVrmlFromURL(query,self,'receive');

}

"}



]}

]}
