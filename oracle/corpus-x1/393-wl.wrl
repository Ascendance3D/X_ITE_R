geometry IndexedFaceSet{coord Coordinate{point[0.575 -0.675 0,-0.575 -0.675 0,-0.55 -0.7 0.05,0.55 -0.7 0.05,-0.525 -0.725 0.05,0.525 -0.725 0.05,-0.5 -0.75 0,0.5 -0.75 0,-0.575 -1.83 0,-0.55 -1.8 0.05,-0.525 -1.77 0.05,-0.5 -1.75 0,0.55 -1.8 0.05,0.525 -1.77 0.05,0.575 -1.83 0,0.5 -1.75 0]}
