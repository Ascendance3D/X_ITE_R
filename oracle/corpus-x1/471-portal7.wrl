########   If Editing Portal World, stop here  ########
Inline{ url["/places/suburbs/gears.wrl"] }
NavigationInfo {	                                     
	avatarSize       [ 1, 1.75, 0.75 ] 
	headlight        TRUE                
	speed            2.0                 
	type             "WALK"            
	visibilityLimit  300.0                                        
}

Viewpoint {
fieldOfView    1.2
jump           TRUE      
orientation    0 0 1  0    
position       0 3.2 0    
description    "Portal 7 Entry"     
}

Background{
skyColor[
0 0 0
0 0 0
0 0 .25
]
skyAngle[
1.309 1.571
]
groundColor[
0 0 0
0 0 0
0 0 .25
]
groundAngle[
1.309 1.571
]
}


Transform {
children [
NavigationInfo {
headlight TRUE
}
DEF lights Transform{
rotation 0 0 0 0
children[
DEF InfLight DirectionalLight {
color 1 1 1
intensity 0.847
on TRUE
direction 0.577 -0.577 -0.577
}
DEF InfLight_1 DirectionalLight {
color 1 1 1
intensity 0.8
on TRUE
direction -0.577 -0.577 0.577
}
DEF InfLight_2 DirectionalLight {
color 1 1 1
intensity 0.6
on TRUE
direction 0 0.707 -0.707
}
DEF InfLight_3 DirectionalLight {
color 1 1 1
intensity 0.698
on TRUE
direction 0.707 3.09e-008 0.707
}
]
}#end lights

]
}

Transform{
children[
Inline {
	url [ "/places/suburbs/circle.wrl" ]
}
]
}