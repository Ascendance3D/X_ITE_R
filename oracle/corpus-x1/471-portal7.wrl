#VRML V2.0 utf8
EXTERNPROTO Portal[
field SFVec3f translation 
field SFRotation rotation 
field SFVec3f scale 
field SFString viewpointDescription 
field MFString directoryURL
]"/places/suburbs/Aportal.wrl"#Portal

Inline{url "../../wbginline.wrl"} #burbs menusensor navigation on pop-up qbertrocks & MrPhillip 11/02

####### If editing this portal, change only viewpoint Description and corresponding wrl file ######
