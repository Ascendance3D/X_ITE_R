DEF spark_clock TimeSensor {
cycleInterval 3
loop TRUE
}
DEF spark_script Script {
eventIn SFFloat set_fraction
field SFNode spark USE spark
field MFInt32 coords [
0 1 64 65 #0
32 67 66 33 #9
16 69 68 17 #5
35 71 70 34 #21
8 77 76 9 #19
39 79 78 38 #29
19 73 72 18 #3
37 75 74 36 #14
4 89 88 5 #18
45 91 90 44 #24
23 93 92 22 #31
47 95 94 46 #26
11 85 84 10 #16
43 87 86 42 #11
21 81 80 20 #2
41 83 82 40 #8
2 97 96 3 #1
49 99 98 48 #4
25 101 100 24 #7
51 103 102 50 #6
13 109 108 12 #10
55 111 110 54 #12
27 105 104 26 #15
53 107 106 52 #13
7 121 120 6 #30
61 123 122 60 #28
31 125 124 30 #25
63 127 126 62 #27
15 117 116 14 #23
59 119 118 58 #22
29 113 112 28 #17
57 115 114 56 #20
128 129 130 131 #32
132 133 134 135 #33
136 137 138 139 #34
140 141 142 143 #35
144 145 146 147 #36
148 149 150 151 #37
152 153 154 155 #38
156 157 158 159 #39
]
field SFInt32 lastIndex 0
directOutput TRUE
url "vrmlscript:
function set_fraction(v,t){
index = Math.floor(v * 100);
if(index > 39){
spark.coordIndex = new MFInt32();
return;
}
else{
if(index == lastIndex){return;}
i = index * 4;
spark.coordIndex = new MFInt32(coords[i],coords[i+1],coords[i+2],coords[i+3],-1);
//print(index + '  ' + spark.coord.point[coords[i]][0]);
lastIndex = index;
}
}
"
}
]
}
]
}
#end switch
ROUTE spark_clock.fraction_changed TO spark_script.set_fraction
ROUTE switch_script.choice_changed TO message_switch.set_whichChoice
ROUTE fade_clock.fraction_changed TO fade_interp.set_fraction
ROUTE fade_interp.value_changed TO mat.set_transparency
}
HUD {
children [
Transform {
translation 0 0 -.5
scale .1 .1 .1
children DEF TM TransportMessage {
}
}
]
}
#&#####################################################################
#End HUD
########################################################################
PROTO Transporter [
field SFBool enabled TRUE
field SFVec3f beamtranslation 0 0 0
field SFRotation beamrotation 0 1 0 0

field SFBool isPlace TRUE
field MFString action_url_string ""
#/cgi-bin/cybertown/place?ac=action&plc=<$place>&ID=<$ID>
field MFString action_param_string "target=action"
field MFString menu_url_string ""
#/cgi-bin/cybertown/place?ac=menu&plc=<$place>&ID=<$ID>&home=1
field MFString menu_param_string "target=menu"
field MFString bxx_url_string ""
#/cgi-bin/cybertown/place?plc=<$place>&ID=<$ID>&ac=3D&T_refresh=false&T_refresh=false&IE=x.bxx
field MFString bxx_param_string "target=CCpro"

eventOut SFTime touch_changed
]
{
Group {
children [
Transform {
#doors will open
translation 0 9.53674e-007 0
children [
DEF Touch TouchSensor {
enabled IS enabled
touchTime IS touch_changed
}
###insert door geometry here

DEF Door Transform {
translation 4.524 0 .02857
children [
Shape {
appearance Appearance {
#material USE chsl_1
texture ImageTexture {
url "door.jpg"
}
}
geometry
IndexedFaceSet {
coord
Coordinate {
point [ -1.998 2.466 13.27 -3.739 2.466 13.27 -1.998 0 13.27 -3.739 0 13.27 ] } texCoord
TextureCoordinate { point [ 1 1 0 1 1 0 0 0 ] } coordIndex [ 2 3 0 -1 3 1 0 -1 ] texCoordIndex
[ 2 3 0 -1 3 1 0 -1 ]
}
}
]
}
###end door geometry
]
}
#end translation
]
}
#end group
DEF Clock TimeSensor {}

DEF DoorSense ProximitySensor {
center IS beamtranslation
size 2 2 .02
}
Transform {
children [
DEF NewView Viewpoint {
position IS beamtranslation
orientation IS beamrotation
jump FALSE
}
]
}
DEF beam_script Script {
mustEvaluate TRUE
eventIn SFTime onEnterTime
field SFBool isPlace IS isPlace
field MFString action_url_string IS action_url_string
field MFString action_param_string IS action_param_string
field MFString menu_url_string IS menu_url_string
field MFString menu_param_string IS menu_param_string
field MFString bxx_url_string IS bxx_url_string
field MFString bxx_param_string IS bxx_param_string #exposedField SFVec3f translation IS translation 
#enter translation of the door
url "vrmlscript:
function onEnterTime(val,ts) {
Browser.setNavigationMode('NONE');
if(isPlace){
u = new MFString('javascript:changeFrames(\"' + menu_url_string + '\",\"' + action_url_string + '\")');
param = new MFString('target=action');
Browser.loadURL(u,param);     
Browser.loadURL(bxx_url_string,bxx_param_string); 
} 
else{
Browser.loadURL(bxx_url_string,bxx_param_string); 
}
}
"
}
ROUTE Touch.touchTime TO Clock.set_startTime
ROUTE Clock.isActive TO NewView.set_bind
ROUTE DoorSense.enterTime TO beam_script.onEnterTime
}
DEF blackmarket Transporter {
#replace urls for the actual blackmarket
beamtranslation 1.69 1.75 15.44 #set proximity viewpoint
beamrotation 0 -1 0 3.13 # set porximity viewpoint orientation

action_url_string "http://www.cybertown.com/cgi-bin/cybertown/place?ac=action&plc=cyberhood&ID=0108000000000000"
menu_url_string "http://www.cybertown.com/cgi-bin/cybertown/place?ac=menu&plc=cyberhood&ID=0108000000000000&home=1"
bxx_url_string "http://www.cybertown.com/cgi-bin/cybertown/place?plc=cyberhood&ID=0108000000000000&ac=3D&T_refresh=false&T_refresh=false&IE=x.bxx"
}
ROUTE blackmarket.touch_changed TO TM.startTime
#&###end Blackmarket door
###

