###
#!###Blackmarket door
PROTO TransportMessage [
eventIn SFTime startTime
]
{
DEF switch_script Script {
eventIn SFTime start IS startTime
eventOut SFInt32 choice_changed
url "vrmlscript:
function start(v,t){
choice_changed = 0;
}
"
}
DEF message_switch Switch {
choice [
Group {
children [
Transform {
children Shape {
appearance Appearance {
material DEF mat Material {
diffuseColor 0 0 0
transparency .5
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [
-6 -3 -.1, -6 3 -.1, 6 3 -.1, 6 -3 -.1,
]
}
coordIndex [
3 2 1 0 -1,
]
}
}
}
DEF fade_clock TimeSensor {
cycleInterval 2
startTime IS startTime
}
DEF fade_interp ScalarInterpolator {
key [
0 .25 1
]
keyValue [
.5 .25 0
]
}
