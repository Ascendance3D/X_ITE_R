DEF di
Script {
eventIn      SFTime bind
field        SFNode cam
USE b
url "vrmlscript:
function bind( ) {cam.set_bind = TRUE;}
"
directOutput TRUE
}
DEF dj
Script {
eventIn      SFTime bindz
field        SFNode viewp
USE a
url "vrmlscript:
function bindz( ) {viewp.set_bind = TRUE;}
"
directOutput TRUE
}
DEF dk
TimeSensor {
loop TRUE
}
DEF dl
Script {
eventIn      SFTime initialize
field        SFNode D
USE de
url "javascript:
function initialize() {
var now = new Date();
var minutes = new String(now.getMinutes());
var seconds = new String(now.getSeconds());
hours = now.getHours();
minutes = (minutes.length == 1? '0'+minutes : minutes);
seconds = (seconds.length == 1? '0'+seconds : seconds);  
newDate = new Date();
year = newDate.getYear();
day = newDate.getDay();
date = newDate.getDate();
// sa+
if(day == 0) dayString = 'Sunday';
else if(day == 1) dayString = 'Monday';
else if(day == 2) dayString = 'Tuesday';
else if(day == 3) dayString = 'Wednesday';
else if(day == 4) dayString = 'Thursday';
else if(day == 5) dayString = 'Friday';
else if(day == 6) dayString = 'Saturday';   
month = newDate.getMonth();
if(month == 0) monthString = 'January';
else if(month == 1) monthString = 'February';
else if(month == 2) monthString = 'March';
else if(month == 3) monthString = 'April';
else if(month == 4) monthString = 'May';
else if(month == 5) monthString = 'June';
else if(month == 6) monthString = 'July';
else if(month == 7) monthString = 'August';
else if(month == 8) monthString = 'September';
else if(month == 9) monthString = 'October';
else if(month == 10) monthString = 'November';
else if(month == 11) monthString = 'Desember';
yearString = (1900+year);
textString = new MFString();
textString[0] = ''+monthString+':'+date;
D.set_string = textString;

}
"
directOutput TRUE
}
Group {
}
DEF dm
Script {
eventIn      SFTime initialize
field        SFNode T
USE dd
url "javascript:
function initialize() {
var now = new Date();
var minutes = new String(now.getMinutes());
var seconds = new String(now.getSeconds());
hours = now.getHours();
// sa+
minutes = (minutes.length == 1? '0'+minutes : minutes);
seconds = (seconds.length == 1? '0'+seconds : seconds);        
newDate = new Date();
day = newDate.getDay();
date = newDate.getDate();
if(day == 0) dayString = 'Sunday';
else if(day == 1) dayString = 'Monday';
else if(day == 2) dayString = 'Tuesday';
else if(day == 3) dayString = 'Wednesday';
else if(day == 4) dayString = 'Thursday';
else if(day == 5) dayString = 'Friday';
else if(day == 6) dayString = 'Saturday';
textString = new MFString();
textString[0] = ''+hours+':'+minutes+':'+seconds;
T.set_string = textString;
}
"
directOutput TRUE
}
DEF dn
Script {
eventIn      SFTime touchTime
eventOut     SFInt32 output
field        SFInt32 number 2
url "javascript:
function initialize() {
output = 0;
}
function touchTime(value, time) {
if (output == number - 1) output = 0;
else ++output;
}
"
}
ROUTE y.touchTime TO r.set_startTime
ROUTE t.touchTime TO r.set_startTime
ROUTE w.value_changed TO s.set_rotation
ROUTE x.value_changed TO s.set_center
ROUTE r.fraction_changed TO u.set_fraction
ROUTE r.fraction_changed TO v.set_fraction
ROUTE r.fraction_changed TO w.set_fraction
ROUTE r.fraction_changed TO x.set_fraction
ROUTE u.value_changed TO n.set_rotation
ROUTE v.value_changed TO n.set_center
ROUTE dn.output TO c.set_whichChoice
ROUTE dh.enterTime TO di.bind
ROUTE dg.enterTime TO dj.bindz
ROUTE dk.time TO dl.initialize
ROUTE dk.time TO dm.initialize
ROUTE dh.enterTime TO dn.touchTime
ROUTE dg.enterTime TO dn.touchTime
