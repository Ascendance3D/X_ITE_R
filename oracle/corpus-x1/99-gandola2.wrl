-0.05 -0.999 -0.0 0.66
]
}
DEF Animation3 TimeSensor {
cycleInterval 5.000
loop TRUE
startTime  -1
}
DEF Animation3_pos0 PositionInterpolator {
key [
0.0 0.25 0.5 0.75 1.0
]
keyValue [
-0.3101 -0.00052 0.70561
-0.33669 0.13362 0.73142
-0.37432 0.28177 0.76635
-0.34258 0.10523 0.73489
-0.3101 -0.00052 0.70561
]
}
DEF Script_Animation1 Script {
field    SFNode      tproc     USE  Animation1
field    SFBool state     FALSE
field    SFTime pause     0
eventIn  SFTime startAt0
eventOut SFTime triggerStart
eventOut SFTime triggerStop
eventOut SFTime triggerStartInt
eventIn  SFBool activated
eventIn  SFTime cycle
directOutput TRUE
url "vrmlscript:
function activated( active, curtime ) {
if( active ) {
triggerStart = curtime;
state = TRUE;
}
else {
triggerStop = curtime;
state = FALSE;
}
}
function cycle( curtime ) {
triggerStartInt = curtime;
}
function startAt0( stime ) {
state = TRUE;
tproc.set_startTime = stime;
tproc.enabled = TRUE;
pause = 0;
}
"
}
DEF Script_Animation3 Script {
field    SFNode      tproc     USE  Animation3
field    SFBool state     FALSE
field    SFTime pause     0
eventIn  SFTime startAt0
eventOut SFTime triggerStart
eventOut SFTime triggerStop
eventOut SFTime triggerStartInt
eventIn  SFBool activated
eventIn  SFTime cycle
directOutput TRUE
url "vrmlscript:
function activated( active, curtime ) {
if( active ) {
triggerStart = curtime;
state = TRUE;
}
else {
triggerStop = curtime;
state = FALSE;
}
}
function cycle( curtime ) {
triggerStartInt = curtime;
}
function startAt0( stime ) {
state = TRUE;
tproc.set_startTime = stime;
tproc.enabled = TRUE;
pause = 0;
}
"
}
DEF spazz_init TimeSensor {
cycleInterval 0.1
loop TRUE
}
ROUTE spazz_init.cycleTime TO Script_Animation1.startAt0
ROUTE spazz_init.cycleTime TO Script_Animation3.startAt0
ROUTE spazz_init.cycleTime TO spazz_init.stopTime
ROUTE Animation1.fraction_changed TO Animation1_pos0.set_fraction
ROUTE Animation1_pos0.value_changed TO dad_Group1.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot0.set_fraction
ROUTE Animation1_rot0.value_changed TO dad_Group1.set_rotation
ROUTE Animation1.isActive TO Script_Animation1.activated

ROUTE Animation1.cycleTime TO Script_Animation1.cycle

ROUTE Animation3.fraction_changed TO Animation3_pos0.set_fraction
ROUTE Animation3_pos0.value_changed TO dad_Revolution2.set_translation
ROUTE Animation3.isActive TO Script_Animation3.activated

ROUTE Animation3.cycleTime TO Script_Animation3.cycle
