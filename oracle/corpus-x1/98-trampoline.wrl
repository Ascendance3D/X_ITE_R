ROUTE Trampoline.cycleTime TO Script_Trampoline.cycle

ROUTE Animation2.fraction_changed TO Animation2_rot0.set_fraction
ROUTE Animation2_rot0.value_changed TO dad_Spring1.set_rotation
ROUTE Animation2.isActive TO Script_Animation2.activated

ROUTE Animation2.cycleTime TO Script_Animation2.cycle

ROUTE Jump.fraction_changed TO Jump_pos0.set_fraction
ROUTE Jump_pos0.value_changed TO dad_ON_View.set_translation
ROUTE Jump.fraction_changed TO Jump_rot0.set_fraction
ROUTE Jump_rot0.value_changed TO dad_ON_View.set_rotation
