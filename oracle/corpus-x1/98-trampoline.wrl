DEF Script_On_Trampoline Script {
  field    SFNode      viewp     USE  On_Trampoline
  eventIn SFTime bindz
  eventIn SFTime unbindz
  directOutput TRUE
  url "vrmlscript:
 function bindz( ) {viewp.set_bind = TRUE;}
 function unbindz( ) {viewp.set_bind = FALSE;}
  "
}
ROUTE Sensor2.exitTime TO Script_Jump.stop
ROUTE Sensor2.exitTime TO Script_Trampoline.stop
ROUTE Sensor2.exitTime TO Script_Animation2.stop
ROUTE Sensor2.exitTime TO Script_On_Trampoline.unbindz
ROUTE ON_OFF.touchTime TO Script_Trampoline.startAt0
ROUTE ON_OFF.touchTime TO Script_Jump.startAt0
ROUTE ON_OFF.touchTime TO Script_Animation2.startAt0
ROUTE ON_OFF.touchTime TO Script_On_Trampoline.bindz
ROUTE Trampoline.fraction_changed TO Trampoline_pos0.set_fraction
ROUTE Trampoline_pos0.value_changed TO dad_SweptSurface1.set_translation
ROUTE Trampoline.fraction_changed TO Trampoline_pos0spn0.set_fraction

ROUTE Trampoline_pos0spn0.value_changed TO Script_Trampoline.fnpos0spn0

ROUTE Trampoline.fraction_changed TO Trampoline_pos0spn1.set_fraction

ROUTE Trampoline_pos0spn1.value_changed TO Script_Trampoline.fnpos0spn1

ROUTE Trampoline.fraction_changed TO Trampoline_pos0spn4.set_fraction

ROUTE Trampoline_pos0spn4.value_changed TO Script_Trampoline.fnpos0spn4

ROUTE Trampoline.fraction_changed TO Trampoline_pos0spn5.set_fraction

ROUTE Trampoline_pos0spn5.value_changed TO Script_Trampoline.fnpos0spn5

ROUTE Trampoline.fraction_changed TO Script_Trampoline.shapeIt

