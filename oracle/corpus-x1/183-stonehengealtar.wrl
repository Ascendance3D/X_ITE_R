#VRML V2.0 utf8

DEF	Altar Group	{
	children [
		Transform {
			translation	.5 -1.2 0
			children [
				DEF Leg Shape {
					appearance Appearance {
						material Material {
							diffuseColor .7 .7 .7
						}
						texture	ImageTexture {
							url	"stone.jpg"
							repeatS	TRUE
							repeatT	TRUE
						}
						textureTransform TextureTransform {
							scale 2 2
						}
					}
					geometry Box {
						size .5 1.1 .7
					}
				}
			]
		}
		Transform {
			translation	-.5 -1.2 0
			children [
				USE	Leg
			]
		}
		Transform {
			translation	0 -.5 0
			children [
				Shape {
					appearance Appearance {
						material Material {
							diffuseColor .7 .7 .7
						}
						texture	ImageTexture {
							url	"stone.jpg"
							repeatS	TRUE
							repeatT	TRUE
						}
						textureTransform TextureTransform {
							scale 2 2
						}
					}
					geometry Box {
						size 1.8 .5 1
					}
				}
			]
		}
	]
}


DEF Cup Group {
	children [
		Transform {
			translation	-.4 -.1 .1
    		rotation 1 0 0 3.14
			children [
				DEF Cone Shape {
					appearance Appearance {
						material Material {
							diffuseColor 0.9, 0.7, 0.1
							ambientIntensity 1
							specularColor 1 1 1
							shininess 3
							emissiveColor 0 0 0
							transparency 0.0
						}
					}
					geometry Cone {
						bottomRadius .15
						height .5
						bottom FALSE
						side TRUE
					}
				}
			]
		}
		Transform {
				translation	-.4 -.23 .1
				scale 1 .1 1 
				children [
					USE	Cone
				]
		}
	]
}


Transform {
	translation	.4 -.21 .2 
	rotation 1 1 0 -2.41 
	children [
		DEF	Wand Group {
			children [
				Shape {
					appearance Appearance {
						material Material {
							diffuseColor 1 1 1 
							ambientIntensity 1
							specularColor .6 .6 1 
							shininess 2
						}
					}
					geometry Cylinder {
						radius .02
						height .4
					}
				}
				Transform {
					translation	0 .23 0
					rotation 1 1 0 1.62
					children [
						Shape {
							appearance Appearance {
								material Material {	 
									diffuseColor .2 .2 1
									ambientIntensity 1
									specularColor 1 1 1
									shininess 1
									emissiveColor .5 .5 1
									transparency .1
								}
							}
							geometry Box {
								size .06 .06 .06 
							}
						}
					]
				}
			]
		}
	]
}


				