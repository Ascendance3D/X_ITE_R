#VRML V2.0 utf8

DEF Camera Viewpoint {
	position 0 0.5 -15  
	description "Entry"
	}


Background { 
	groundAngle  1.5707958 	groundColor  [ 0.5  0.0 0.9 , 0 0.0 1.0 ]
	skyAngle  1.5707958 skyColor  [ 0.46 0.38 0.88, 0.8 0.7 0.94 ] 
} 

NavigationInfo { 
	headlight TRUE 	
	type "WALK"  
##	avatarSize [1.5, 1.7, 0.75 ]
	avatarSize [0.25,0.5,0.1]
	visibilityLimit 15
	}

WorldInfo {
	title "Tile blaxxunCC3d EAI BspTree Demo"
}





#DEF ViewpointCoord CoordinateInterpolator {}
#DEF ViewpointOrient OrientationInterpolator {}
#DEF ViewpointTimer TimeSensor {enabled FALSE loop TRUE }
#ROUTE ViewpointTimer.fraction_changed TO ViewpointCoord.set_fraction
#ROUTE ViewpointTimer.fraction_changed TO ViewpointOrient.set_fraction


DEF Background Group {
children
	Shape {
	   appearance Appearance { material Material { 
	   diffuseColor 0.3 0.6 0.2 
	   specularColor 0.3 0.6 0.2 
	   emissiveColor 0.3 0.6 0.2 
	   }}

	   geometry IndexedFaceSet{
	    coord 
		DEF BackgroundCoord Coordinate { point

		   [ -32,0,-32, 32 0 -32, 32 0 32, -32 0 32 ] }

		coordIndex [0,1,2,3,-1]
		normalPerVertex FALSE
		ccw FALSE
	   }
}
}


DEF ROOT Group {
	bboxSize 32 6 32  ## blaxxunCC3d needs hint for size ==> for depth range
	bboxCenter 0 0 0
	
}



