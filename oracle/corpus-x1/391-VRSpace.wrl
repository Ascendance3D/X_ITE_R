#VRML V2.0 utf8

EXTERNPROTO Compass [
  eventIn SFRotation rotation
  eventIn SFVec3f    translation
  eventIn SFBool     displayPosition
] "compass.wrl"

EXTERNPROTO LoginManager [
  exposedField MFString string
  exposedField SFColor  color
  eventIn      SFVec2f  set_cursor
  eventIn      SFBool   set_hide
] "vrml/gui/LoginManager.wrl"

DEF VRSpace_Scene Group {
  children [
    DEF VRSpace_Viewpoint Viewpoint {
      # DO NOT set the orientation on this viewpoint.
      # This will cause major errors with the MovementManager.
      position 0 300 0
      description "Entrance"
    }

    # Exists solely to drive VRSpace_Movement
    DEF VRSpace_Light DirectionalLight {
      direction .5 -1 .5
      intensity .8
      ambientIntensity .2
    }

    DEF VRSpace_Background Background {
      skyAngle    [ 1.2, 1.3, 1.7, 3.14 ]
      skyColor    [ .7 .7 1, .5 .5 .7, .4 .4 .6, .3 .3 .5, .1 .1 .1 ]
      groundAngle [ 1.2, 1.57 ]
      groundColor [ .4 .6 .4, .3 .5 .3, .1 .2 .1 ]
      frontUrl    [ "maps/horizon_4_front.jpg", "../maps/horizon_4_front.jpg", "../../maps/horizon_4_front.jpg", "vrspace/maps/horizon_4_front.jpg" ]
      backUrl     [ "maps/horizon_4_back.jpg" ]
      leftUrl     [ "maps/horizon_4_left.jpg" ]
      rightUrl    [ "maps/horizon_4_right.jpg" ]
      topUrl      [ "maps/horizon_4_top.jpg" ]
      bottomUrl   [ "maps/horizon_4_bottom.jpg" ]
    }

    DEF VRSpace_NavigationInfo NavigationInfo {
      #visibilityLimit 300
      avatarSize [ .25, 1.6, 0.75 ]
      speed 1
      headlight FALSE
      type [ "WALK", "ANY" ]
    }

    DEF VRSpace_Fog Fog { color .8 .8 .8 visibilityRange 10000 }

    Collision {
      collide FALSE
      children [
        DEF VRSpace_HUD Transform {
          translation 0 0 0
          children [

            Transform {
                children [
                   PointLight {
                     location 0 0 5
                     radius 20
                   }
                ]
            }


            # This exists solely to have a large surface for the VRSpace_Light to hit, in
            # order to drive VRSpace_Movement
            Shape { geometry Box {} appearance Appearance { material Material { transparency 1 } } }

            # toolbar
            DEF VRSpace_Toolbar Transform {
              children [
                Transform {
                  #translation -.09 -.05 -.15
                  translation -.09 .05 -.15
                  scale .005 .005 .005
                  children [
                    DEF VRSpace_Login LoginManager { string [ "          Loading..." ] }
                  ]
                }
                # compass
                Transform {
                  scale .01 .01 .01
                  translation 0 -.05 -.165
                  children [
                    DEF VRSpace_Compass Compass{}
                  ]
                }
                # busy indicator
                Transform {
                  #translation 0.02 -.052 -.155
                  translation -.08 -.052 -.155
                  scale .005 .005 .005
                  children [
                    DEF BSwitch Switch {
                      #whichChoice 0
                      choice [
                        Transform {
                          children [
                            Shape {
                              geometry Text { string [ "    Loading..." ] }
                            }
                            Inline { url "Busy.wrl" }
                          ]
                        }
                      ]
                    }
                    DEF VRSpace_Busy Script {
                      eventIn SFTime start
                      eventIn SFTime stop
                      eventOut SFInt32 choice
                      url "javascript:
                        function start( v, t ) {
                          choice = 0;
                        }
                        function stop( v, t ) {
                          choice = 1;
                        }
                      "
                    }
                  ]
                }

                # start menu :)
                Transform {
                  scale .007 .007 .007
                  translation .06 -.05 -.15
                  children [

                    #Group {
                    #  children [
                    #    Transform {
                    #      rotation 0.3 0 1 -.8
                    #      translation 2 0 0
                    #      children [ Inline { url "wrench.wrl" } ]
                    #    }
                    #    DEF ShooterTouch TouchSensor {}
                    #  ]
                    #}

                    DEF ToolSwitch Switch {
                      choice [

                      ]
                    }

                    DEF ToolScript Script{
                      eventIn  SFTime  tool0TouchTime
                      eventIn  SFTime  tool1TouchTime
                      eventIn  SFInt32 choiceIn
                      eventOut SFInt32 choice
                      eventOut SFBool  displayPosition

                      url "javascript:

                        function initialize() {
                            choice = -1;
                        }

                        function choiceIn( ev, t ) {
                            toolSelected( ev );
                        }

                        function tool0TouchTime( ev, t ) {
                            toolSelected( 0 );
                        }

                        function tool1TouchTime( ev, t ) {
                            toolSelected( 1 );
                        }

                        function toolSelected( whichTool ) {
                          // print( 'Tool Selected: ' + whichTool );
                          displayPosition = true;

                          choice = whichTool;
                        }

                      "
                    }
                  ]
                }

                # help
                #Transform {
                #  scale .02 .02 .02
                #  translation -.09 -.052 -.15
                #  children [
                #    DEF A Anchor {
                #      url "javascript:alert('HELP! HEEELP! :)')"
                #      description "Click here for help"
                #      children [
                #        Shape {
                #          geometry Text {
                #            string [ "?" ]
                #            fontStyle FontStyle { style "BOLD" family "SERIF" }
                #          }
                #          appearance Appearance {
                #            material Material { emissiveColor .7 .4 .4 diffuseColor 0 0 0 }
                #          }
                #        }
                #      ]
                #    }
                #  ]
                #}

                # banner
                #DEF BannerRight Transform {
                #  scale .016 .004 .0001
                #  translation .028 -.05 -.15
                #  children [
                #    DEF Sponsor Anchor {
                #      url [ "http://www.purger.com/" ]
                #      description "Visit our sponsor!"
                #      children [
                #        Shape {
                #          geometry Box{}
                #          appearance Appearance {
                #            texture ImageTexture { url "purger_com.gif" }
                #          }
                #        }
                #      ]
                #    }
                #  ]
                #}

                # banner
                #DEF BannerLeft Transform {
                #  scale .016 .004 .0001
                #  translation -.028 -.05 -.15
                #  children [ USE Sponsor ]
                #}

                # slider
                #Group {
                #  children [
                #    Transform {
                      #scale .1 .01 .0001
                #      scale .1 .1 .1
                    #  #translation .09 -.05 -.15
                #      translation 0 -.05 -.15
                #      children [
                #        Transform {
                #          translation 0 -.05 -.15
                          #rotation 0 0 1 1.57
                #          scale 1 .01 .01
                #          children [
                #            Shape {
                              #geometry Cylinder { radius .01 }
                #              geometry Sphere{}
                #              appearance DEF HUDAPP Appearance {
                #                material Material {
                #                  emissiveColor .4 .4 .5
                #                  diffuseColor 0 0 0
                #                  transparency .7
                #                  shininess .5
                #                  specularColor .4 .6 .5
                #                }
                #                texture ImageTexture { url "maps/nesto.jpg" }
                #              }
                #            }
                #           ]
                #         }
                #        Transform {
                #          translation -1.05 -.05 -.15
                #          scale .01 .1 .01
                #          children [
                #            DEF HANDLE Shape {
                #              geometry Sphere {}
                #              appearance USE HUDAPP
                #             }
                #           ]
                #         }
                #        Transform {
                #          translation 1.05 -.05 -.15
                #          children [
                            #USE HANDLE
                #            Shape {
                #              geometry Sphere{ radius .01 }
                #              appearance USE HUDAPP
                #            }
                #          ]
                #         }
                #      ]
                #    }
                #    DEF SliderPlane PlaneSensor{}
                #  ]
                #}
              ]
            }
          ]
        }
      ]
    }

    DEF VRSpace_Movement ProximitySensor { size 1000000 1000000 1000000 }

    # Loader/unloader is used only to set Scene children
    # ie/cortona gives unspecified error for EAI addChildren eventIn,
    # but children passes
    DEF VRSpace_Loader Group{}
    DEF VRSpace_Unloader Group{}
    DEF VRSpace_HUDLoader Group{}

    DEF VRSpace_Dispatcher Script {
      eventOut SFFloat movement_sync    #sync time
      eventOut SFString clientMsg
      eventOut SFString userMsg
      eventIn SFString serverMsg

      directOutput TRUE
      eventIn SFString loadURL
      eventIn SFString loadVrml
      field SFNode scene USE VRSpace_Scene
      field SFNode hud USE VRSpace_HUD
      field SFNode dispatcher USE VRSpace_Dispatcher
      field SFNode viewpoint USE VRSpace_Viewpoint
      field SFNode movement USE VRSpace_Movement
      eventOut SFInt32 sceneSize
      eventOut SFInt32 initialSize
      eventOut SFInt32 hudSize
      eventIn MFNode sceneChildren
      eventIn MFNode hudChildren
      eventIn MFNode nodeLoaded
      eventIn SFString jump
      eventIn SFInt32 setEventTarget
      eventIn SFString setEventName
      eventIn SFString setEventValue
      field MFInt32 eventTarget [0]
      field MFString eventName [""]
      field MFString eventValue [""]
      field MFNode avatarNode [ USE VRSpace_Scene ]
      field MFNode avatarTransform [ USE VRSpace_Scene ]
      eventIn MFNode avatarLoaded
      field MFInt32 nodeIndex [ 0 ]
      eventIn MFString avatarEvents
      field SFString transformEventIns " x y z rotx roty rotz angle "
      field SFString userEventIns " xyzgo xyzrotate go transform say name loadURL isOver touchTime "
      field SFString avatarEventIns " gesture "
      eventIn SFVec3f userTranslation
      eventIn SFRotation userRotation
      eventIn SFString set_eai
      eventOut SFBool eai
      eventIn SFString set_ie
      eventOut SFBool ie
      eventOut SFBool contact
      url "javascript:
            function initialize() {
              //print( Browser.getName());
              contact = (Browser.getName().indexOf('ontact') > 0 || Browser.getName().indexOf('blaxxun') >= 0);
              eai = false;
              ie = true; // default: exploiter
              // sync time = .5 seconds
              movement_sync = .5;
              sceneSize = scene.children.length;
              initialSize = scene.children.length;
              hudSize = hud.children.length;
              print( 'VRSpace dispatcher initialized' );
            }
            function set_eai( v, t ) {
              print( 'EAI available: '+v );
              eai = ('true' == v );
            }
            function set_ie( v, t ) {
              print( 'Internerd Exploiter: '+v );
              ie = ('true' == v );
            }
            function setEventTarget( index, t ) {
              //print( 'Event sent to '+index );
              eventTarget[0] = index;
            }
            function setEventName( name, t ) {
              //print( 'Event name: '+name );
              eventName[0] = name;
            }
            function setEventValue( value, t ) {
              //print( 'Event value: '+value );
              //print( 'Processing event: target='+eventTarget[0]+' name='+eventName[0]+' value='+value );
              eventValue[0] = value;
              transform=scene.children[eventTarget[0]];
              if ( transform == null ) {
                print( 'ERROR - event sent to unknown node '+eventTarget[0] );
                return;
              } else if (transform.children.length > 0 ) {
                node = transform.children[0];
                nodeName = getNodeName( node );
              } else {
                print( 'ERROR - event sent but node not loaded (yet?) '+eventTarget[0] );
                return;
              }
              if ( nodeName == 'Avatar' ) {
                // some events go to avatar and some to it's control script
                if ( node.addScript.length == 0 ) {
                  print( 'This avatar didn\'t load control script yet' );
                  return;
                }
                script=node.addScript[0];
                if ( script == null ) {
                  print( 'This avatar needs to be processed with VRSpace Chisel' );
                  return;
                }
                //print( 'Avatar '+node.nickname+' got event '+eventName[0]+'='+value );
                lookup = ' '+eventName[0]+' ';
                event = eventName[0];
                if ( transformEventIns.indexOf( lookup ) > -1 ) {
                  // routed to parent transform
                  print( 'Avatar '+node.nickname+' got transform event '+event+'='+value );
                } else if ( avatarEventIns.indexOf( lookup ) > -1 ) {
                  //print( 'Avatar '+node.nickname+' got avatar event '+event+'='+value );
                  if ( event == 'gesture' ) {
                    node.set_gesture = parseInt( value );
                  }
                } else if ( userEventIns.indexOf( lookup ) > -1 ) {
                  print( 'Avatar '+node.nickname+' got user event '+event+'='+value );
                  if ( event == 'say' ) {
                    script.set_say = value;
                  } else if (event == 'xyzgo') {
                    script.set_xyzgo = value;
                  } else if (event == 'xyzrotate') {
                    script.set_xyzrotate = value;
                  } else if (event == 'go') {
                    script.set_go = value;
                  } else if (event == 'name') {
                    script.set_name = value;
                  } else if (event == 'transform') {
                    script.set_transform = parseInt(value);
                  } else if (event == 'loadURL') {
                    script.set_loadURL = value;
                  } else if (event == 'isOver') {
                    if ( value == 'true' ) {
                      script.set_isOver( true );
                    } else {
                      script.set_isOver( false );
                    }
                  } else if (event == 'touchTime') {
                    script.set_touchTime = parseInt(value);
                  }
                } else {
                  print( 'Avatar '+node.nickname+' got invalid event '+eventName[0]+'='+value );
                }
              } else if ( nodeName == 'Console' ) {
              } else if ( nodeName == 'Transform' ) {
              } else {
                print( 'Unsupported target node: '+nodeName );
              }
            }
            function jump( coord, t ) {
              //print( 'jump coord: '+coord );
              pos = coord.indexOf(',');
              x = parseFloat( coord.substring(0, pos) );
              pos = coord.indexOf(',', oldPos=pos+1);
              y = parseFloat( coord.substring(oldPos,pos) );
              pos = coord.indexOf(',', oldPos=pos+1);
              z = parseFloat( coord.substring(oldPos,pos) );
              pos = coord.indexOf(',', oldPos=pos+1);
              rotx = parseFloat( coord.substring(oldPos,pos) );
              pos = coord.indexOf(',', oldPos=pos+1);
              roty = parseFloat( coord.substring(oldPos,pos) );
              pos = coord.indexOf(',', oldPos=pos+1);
              rotz = parseFloat( coord.substring(oldPos,pos) );
              angle = parseFloat( coord.substring(pos+1) );
              tran = new SFVec3f( x, y, z );
              rot = new SFRotation( rotx, roty, rotz, angle );
              //print( 'jump: pos='+tran.x+','+tran.y+','+tran.z+' rot='+rot.x+','+rot.y+','+rot.z+','+rot.angle );
              viewpoint.position = tran;
              viewpoint.orientation = rot;
              viewpoint.set_bind = true;
              // start listening for user movements
              Browser.addRoute( movement, 'position_changed', dispatcher, 'userTranslation' );
              Browser.addRoute( movement, 'orientation_changed', dispatcher, 'userRotation' );
            }
            function userTranslation( e, t ) {
              arg = e.x+','+e.y+','+e.z;
              performCallback( 'userTranslation', arg );
            }
            function userRotation( e, t ) {
              arg = e.x+','+e.y+','+e.z+','+e.angle;
              performCallback( 'userRotation', arg );
            }
            // intended for call from html javascript - VRML plugin present but EAI not working
            function loadURL( url, t ) {
              print('createVrmlFromURL: '+url);
              Browser.createVrmlFromURL( new MFString( url ), scene.children[ scene.children.length-1 ], 'addChildren' );
            }
            function loadVrml( vrml, t ) {
              print('loadVrml: '+vrml );
              scene.addChildren = Browser.createVrmlFromString( vrml );
            }
            function sceneChildren( e, t ) {
              if ( sceneSize < e.length ) {
                // transform added
                t = e[e.length-1];
                //print( 'Transform added: '+e.length );
                if ( ! eai ) {
                  // CHECKME
                  Browser.addRoute( t, 'children_changed', dispatcher, 'nodeLoaded' );
                }
              } else if ( sceneSize > e.length ) {
                // transform removed
              } else {
                // equal: in contact means transform couldn't load
              }
              sceneSize = e.length;
            }
            // parameter is children field of a transform
            function nodeLoaded( e, t ) {
              if ( e.length > 0 ) {
                // find the transform
                i = 0;
                for ( i = sceneSize-1; i >= initialSize; i-- ) {
                  t=scene.children[i];
                  if ( t.children.length > 0 && t.children[0] == e[0] ) {
                    //print( 'Got it! Index '+i );
                    break;
                  }
                }
                // OK t is transform, e are nodes.
                node = e[e.length - 1];
                nodeName = getNodeName( node );
                //print( 'Node loaded to '+i+': '+nodeName+' url '+eventValue[0] );
                if ( nodeName == 'Avatar' ) {
                  // avatars require special handling:
                  // CHECKME: rewrite url
                  print('Loading control script /vrspace/'+node.jsUrl+' to avatar: '+node.nickname);
                  avatarNode[0] = node;
                  avatarTransform[0] = t;
                  nodeIndex[0] = i;
                  Browser.addRoute( node, 'scriptLoaded', dispatcher, 'avatarLoaded' );
                  Browser.createVrmlFromURL( '/vrspace/'+node.jsUrl, node, 'addScript' );
                } else {
                  listen( t, i );
                }
              } else {
                // could not load
                print( 'Error loading node' );
              }
            }
            function listen( t, i ) {
              // remove routes? Just in case...
              Browser.deleteRoute( t, 'children_changed', dispatcher, 'nodeLoaded' );
              // and send it to java via vbscript and javascript in html browser
              if ( ! eai ) {
                // vrspace client doesn't have access to EAI, liveconnect callback
                performCallback( 'nodeLoaded', i );
              } else {
                // callback implemented via EAI
              }
            }
            function avatarLoaded( e, t ) {
              node = avatarNode[ 0 ];
              Browser.deleteRoute( node, 'scriptLoaded', dispatcher, 'avatarLoaded' );
              if ( e.length > 0 ) {
                script = e[0];
                print( 'Control script loaded to avatar '+node.nickname );
                // setup routes for eventOuts
                Browser.addRoute( script, 'SystemOut', dispatcher, 'avatarEvents' );
                script.SystemIn = 'init';
                // CHECKME: start listening here or after script initializes?
                listen( avatarTransform[0], nodeIndex[0] );
              } else {
                print( 'Avatar '+node.nickname+' did not load control script!' );
                // CHECKME: listen() or just this?
                Browser.deleteRoute( t, 'children_changed', dispatcher, 'nodeLoaded' );
              }
            }
            function avatarEvents( events, t ) {
              if ( events.length == 0 ) {
                print( 'Avatar didn\'t declare eventOuts!' );
              } else if ( events[0] == 'declareEvents' ) {
                node = avatarNode[0].addScript[0];
                transform = avatarTransform[0];
                for ( i = 1; i < events.length; i++ ) {
                  event = events[i];
                  print( 'Listening eventOut: '+event );
                  if ( event.indexOf( 'log' ) == 0 ) {
                    //logDebug/Info/Warning/Error - ignored for now
                  } else if ( event == 'position_changed' ) {
                    // SFVec3f
                    // hey don't route it to transform but to avatar?
                    Browser.addRoute( node, event, avatarNode[0], 'set_position' );
                    Browser.addRoute( node, 'parentTranslation', transform, 'set_translation' );
                  } else if ( event == 'orientation_changed' ) {
                    // SFRotation
                    Browser.addRoute( node, event, avatarNode[0], 'rotation' );
                    Browser.addRoute( node, 'parentRotation', transform, 'set_rotation' );
                  } else if ( event == 'isOver' ) {
                    // SFBool, send to network
                    //Browser.addRoute( node, events[i], dispatcher, 'isOver' );
                  } else if ( event == 'touchTime' ) {
                    // SFTime, send to network
                    //Browser.addRoute( node, events[i], dispatcher, 'touchTime' );
                  }
                }
              } else {
                print( 'ERROR: Dunno how to handle avatar events!' );
              }
            }
            function hudChildren( e, t ) {
              hudSize = e.length;
            }
            // utilities
            function ltrim( string ) {
              for ( i = 0; i < string.length && string.charAt(i) <= ' '; i++ );
              return string.substring(i);
            }
            function rtrim( string ) {
              for ( i = string.length - 1; i > 0 && string.charAt( i ) <= ' '; i-- );
              return string.substring( 0, i+1 );
            }
            function trim( string ) {
              return ltrim( rtrim( string ));
            }
            function getNodeName( node ) {
              nodeName = node.toString();
              nodeName = trim(nodeName.substring(0, nodeName.indexOf('{')));
              return nodeName;
            }
            function performCallback(event, arg) {
              print( 'Calling '+event+'('+arg+')' );
              if ( ie && contact ) {
                // internerd exploiter iface (vbscript)
                call = new MFString('OnEvent('+event+', '+arg+')');
                param = new MFString(event, ''+arg);
                Browser.loadURL( call, param );
              } else {
                // other browsers iface (javascript)
                //print( 'Unsupported callback:'+event+' = '+arg );
                Browser.loadURL( 'javascript:'+event+'('+arg+');' );
              }
            }
          "
    }
  ]
  ROUTE VRSpace_Movement.position_changed    TO VRSpace_Movement.center
  ROUTE VRSpace_Movement.position_changed    TO VRSpace_HUD.translation
  ROUTE VRSpace_Movement.orientation_changed TO VRSpace_HUD.rotation

  # workaround route (cortona):
  ROUTE VRSpace_Loader.children_changed      TO VRSpace_Scene.addChildren
  ROUTE VRSpace_Unloader.children_changed    TO VRSpace_Scene.removeChildren
  ROUTE VRSpace_HUDLoader.children_changed   TO VRSpace_HUD.addChildren

  # Dispatcher routes
  ROUTE VRSpace_Scene.children_changed       TO VRSpace_Dispatcher.sceneChildren
  ROUTE VRSpace_HUD.children_changed         TO VRSpace_Dispatcher.hudChildren

  # HUD Elements:
  ROUTE VRSpace_Movement.orientation_changed TO VRSpace_Compass.rotation
  ROUTE VRSpace_Movement.position_changed    TO VRSpace_Compass.translation

  ROUTE ToolScript.choice                    TO ToolSwitch.whichChoice
  ROUTE ToolScript.displayPosition           TO VRSpace_Compass.displayPosition
  #ROUTE ShooterTouch.touchTime              TO ToolScript.tool1TouchTime

  #ROUTE SliderPlane.translation_changed     TO VRSpace_Toolbar.translation

  #Visibility:
  ROUTE VRSpace_Fog.visibilityRange_changed  TO VRSpace_NavigationInfo.set_visibilityLimit

  #Busy indicator
  ROUTE VRSpace_Busy.choice                  TO BSwitch.whichChoice
}
