DEF br
Script {
field    SFNode      lght
USE bi
field  SFBool  state FALSE  eventIn  SFTime      toggle
directOutput         TRUE
url "vrmlscript:
function toggle( ) {
state = !state;
lght.set_on = state;
}
"
}
ROUTE bj.touchTime TO br.toggle
