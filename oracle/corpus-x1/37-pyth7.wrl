#VRML V2.0 utf8
EXTERNPROTO WorldChanger [
field MFString WorldBuilderTitle
field MFString World1
field MFString url_string1
field MFString param_string1
field MFString World2
field MFString url_string2
field MFString param_string2
field MFString World3
field MFString url_string3
field MFString param_string3
field SFInt32 numberOfChoices 
field MFString World4
field MFString url_string4
field MFString param_string4
field MFString World5
field MFString url_string5 
field MFString param_string5
field MFString World6
field MFString url_string6
field MFString param_string6
field MFString World7
field MFString url_string7
field MFString param_string7
field MFString World8
field MFString url_string8
field MFString param_string8
field MFString World9
field MFString url_string9
field MFString param_string9
field MFString World10
field MFString url_string10 
field MFString param_string10
] "/places/suburbs/WorldChanger.wrl"


WorldChanger{

numberOfChoices 3 #number of worlds +1 for title

WorldBuilderTitle["Pyth7"]

World1["Tarot of 7 Emerald Tablets"]
url_string1 [ "/cgi-bin/cybertown/place?plc=suburbs&ac=place&T_SUB=The_Tarot_of_Seven_Emerald_Tablets&force=p" ] 
param_string1 [ "target=place" ] 

World2["Treasure Hunt Demo", "(Major revision 11/24/01)"]
url_string2 [ "/cgi-bin/cybertown/place?plc=suburbs&ac=place&T_SUB=Treasure_Hunt_Script_Test&force=p" ] 
param_string2 [ "target=place" ] 



}

