DEF l
Script {
field    SFNode      lght
USE j
field  SFBool  state FALSE  eventIn  SFTime      toggle
directOutput         TRUE
url "vrmlscript:
function toggle( ) {
state = !state;
lght.set_on = state;
}
"
}
ROUTE k.touchTime TO l.toggle
