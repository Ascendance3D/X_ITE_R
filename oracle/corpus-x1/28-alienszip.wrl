textureTransform TextureTransform {
scale 128 1 }}
geometry Cylinder { 
radius 1.9
height 0.09
top FALSE
side TRUE
bottom FALSE }} 
]}
DEF PS2 ProximitySensor { center 0 0.349 -2 size 30 10 30
enabled TRUE }, 
DEF Clock2 TimeSensor { 
cycleInterval 20
loop TRUE }, 
DEF BandPath2 OrientationInterpolator { 
key [ 0, 0.5, 1.0 ] 
keyValue [ 
0 1 0 0, 
0 1 0 -3.14,
0 1 0 -6.28 ]},
ROUTE PS2.enterTime TO Clock2.set_startTime
ROUTE PS2.exitTime TO Clock2.set_stopTime
ROUTE Clock2.fraction_changed TO BandPath2.set_fraction
ROUTE BandPath2.value_changed TO Band2.set_rotation

