#aliens
DEF Aliens4 Transform { translation 0 0.55 -2 children [
Shape { 
appearance Appearance { 
material Material {}
texture ImageTexture { url "aliens1.gif" }
textureTransform TextureTransform {
scale 10 1 }}
geometry Cylinder { 
radius 1.2
height 0.6
top FALSE
side TRUE
bottom FALSE }} 
]}
DEF PS4 ProximitySensor { center 0 0.55 -2 size 30 10 30
enabled TRUE }, 
DEF Clock4 TimeSensor { 
cycleInterval 80
loop TRUE }, 
DEF AliensPath4 OrientationInterpolator { 
key [ 0, 0.5, 1.0 ] 
keyValue [ 
0 1 0 0, 
0 1 0 -3.14,
0 1 0 -6.28 ]},
ROUTE PS4.enterTime TO Clock4.set_startTime
ROUTE PS4.exitTime TO Clock4.set_stopTime
ROUTE Clock4.fraction_changed TO AliensPath4.set_fraction
ROUTE AliensPath4.value_changed TO Aliens4.set_rotation

