#VRML V2.0 utf8
#Alien Cybernaut Builder Arrives by Morning.star Feb 18 2003  
#In Celebration of my new Apprentice Builder Title
Transform { translation 0 0.5 -2 children [
Shape { 
appearance Appearance { 
material Material { diffuseColor 0.05 0.1 0.1
shininess 1
emissiveColor 0.2 0.2 0.2
specularColor 0 0.35 0.5 }
texture PixelTexture { 
image 8 2 1 0xCC 0x99 0x66 0x99 0xCC 0x99 0x66 0x99
            0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF
}
textureTransform TextureTransform {
scale 16 4 }}
geometry Sphere { radius 1 }} 
]}

DEF Wing1 Transform { translation 0 -0.1 -2
rotation 0 1.75 0 1.57 children [
Shape { 
appearance Appearance { 
material Material { diffuseColor 0 0.35 0.5
emissiveColor 0.2 0.2 0.2
specularColor 0.01 0.01 0.01
shininess 1 }
texture PixelTexture { 
image 8 1 1 0xCC 0x99 0x66 0x99 0xCC 0x99 0x66 0x99 }
textureTransform TextureTransform {
scale 128 1 }}
geometry Extrusion { 
creaseAngle 1.57 
endCap TRUE 
solid TRUE 
crossSection [ 
1 0, 0.92 -0.38, 
0.71 -0.71, 0.38 -0.92, 
0 -1, -0.38 -0.92, 
-0.71 -0.71, -0.92 -0.38, 
-1 0, -0.92 0.38, 
-0.71 0.71, -0.38 0.92, 
0 1, 0.38 0.92, 
0.71 0.71, 0.92 0.38, 
1 0 ] 
spine [ 
0 0 0, 0 0.15 0, 
0 0.3 0, 0 0.45 0, 
0 0.6 0, 0 0.75 0,
0 0.9 0, 
] 
scale [ 
0.01 0.01, 0.5 0.5, 1.6 1.6, 2 2, 1.6 1.6, 0.5 0.5, 0.01 0.01 
]} 
}
]}
DEF PS1 ProximitySensor { center 0 -0.1 -2 size 30 10 30
enabled TRUE }, 
DEF Clock1 TimeSensor { 
cycleInterval 40
loop TRUE }, 
DEF WingPath1 OrientationInterpolator { 
key [ 0, 0.5, 1.0 ] 
keyValue [ 
0 1 0 0, 
0 1 0 -3.14,
0 1 0 -6.28 ]},
ROUTE PS1.enterTime TO Clock1.set_startTime
ROUTE PS1.exitTime TO Clock1.set_stopTime
ROUTE Clock1.fraction_changed TO WingPath1.set_fraction
ROUTE WingPath1.value_changed TO Wing1.set_rotation

DEF Band2 Transform { translation 0 0.349 -2 children [
