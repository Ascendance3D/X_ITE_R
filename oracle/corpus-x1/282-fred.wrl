  m5.setTransform(P[5],R[5]);m5=m5.multRight(m4);
  for(i=64;i<72;i++){W[i]=m5.multVecMatrix(V[i]);}
  m5.setTransform(P[6],R[6]);m5=m5.multRight(m4);
  for(i=72;i<80;i++){W[i]=m5.multVecMatrix(V[i]);}
