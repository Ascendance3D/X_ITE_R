 function VtxTransform(){
  var i;
  m0=new VrmlMatrix();
  m0.setTransform(P[0],R[0]);
  m1=new VrmlMatrix();
  m1.setTransform(P[1],R[1]);m1=m1.multRight(m0);
  m2=new VrmlMatrix();
  m2.setTransform(P[2],R[2]);m2=m2.multRight(m1);
  for(i=0;i<25;i++){W[i]=m2.multVecMatrix(V[i]);}
  m3=new VrmlMatrix();
