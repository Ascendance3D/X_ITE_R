DEF Script_Animation1 Script {
  field    SFNode      tproc     USE  Animation1
 field    SFBool state     FALSE
 field    SFTime pause     0
 eventIn  SFTime startAt0
 eventOut SFTime triggerStart
 eventOut SFTime triggerStop
 eventOut SFTime triggerStartInt
 eventIn  SFBool activated
 eventIn  SFTime cycle
 directOutput TRUE
 url "vrmlscript:
 function activated( active, curtime ) {
  if( active ) {
   triggerStart = curtime;
   state = TRUE;
  }
  else {
   triggerStop = curtime;
   state = FALSE;
  }
 }
 function cycle( curtime ) {
  triggerStartInt = curtime;
 }
 function startAt0( stime ) {
  state = TRUE;
  tproc.set_startTime = stime;
  tproc.enabled = TRUE;
  pause = 0;
 }
 "
}
DEF spazz_init TimeSensor {
  cycleInterval 0.5
  loop TRUE
  startTime  0
}
DEF Script_spazz_init Script {
  field    SFNode      tproc     USE  spazz_init
  field    SFInt32     count  0
  eventOut SFTime      triggerStart
  eventIn  SFTime      cycle
  directOutput         TRUE
  url "vrmlscript:
   function cycle( curtime ) {
    if(count++ > 5) {
      triggerStart = curtime;
      tproc.enabled = FALSE;
   }}
   "
}
ROUTE spazz_init.cycleTime TO Script_spazz_init.cycle
ROUTE Script_spazz_init.triggerStart TO Script_Animation1.startAt0
ROUTE Animation1.fraction_changed TO Animation1_pos0.set_fraction
ROUTE Animation1_pos0.value_changed TO dad_Sphere2.set_translation
ROUTE Animation1.fraction_changed TO Animation1_pos1.set_fraction
ROUTE Animation1_pos1.value_changed TO dad_Sphere4.set_translation
ROUTE Animation1.fraction_changed TO Animation1_pos2.set_fraction
ROUTE Animation1_pos2.value_changed TO dad_Sphere3.set_translation
ROUTE Animation1.isActive TO Script_Animation1.activated
ROUTE Animation1.cycleTime TO Script_Animation1.cycle
