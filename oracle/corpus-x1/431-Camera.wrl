 }
 function startAt0( stime ) {
  state = TRUE;
  tproc.set_startTime = stime;
  tproc.enabled = TRUE;
  pause = 0;
 }
 "
}
DEF spazz_init TimeSensor {
  cycleInterval 0.5
  loop TRUE
  startTime  0
}
DEF Script_spazz_init Script {
  field    SFNode      tproc     USE  spazz_init
  field    SFInt32     count  0
  eventOut SFTime      triggerStart
  eventIn  SFTime      cycle
  directOutput         TRUE
  url "vrmlscript:
   function cycle( curtime ) {
    if(count++ > 5) {
      triggerStart = curtime;
      tproc.enabled = FALSE;
   }}
   "
}
ROUTE spazz_init.cycleTime TO Script_spazz_init.cycle
ROUTE Script_spazz_init.triggerStart TO Script_MOVEMENT_SCAN_.startAt0
ROUTE Script_spazz_init.triggerStart TO Script_LIGHT_BEEP.startAt0
ROUTE LAZERBEAM.touchTime TO Script_LAZER_BEAM.startAt0
ROUTE MOVEMENT_SCAN_.fraction_changed TO MOVEMENT_SCAN__rot0.set_fraction
ROUTE MOVEMENT_SCAN__rot0.value_changed TO dad_Group2.set_rotation
ROUTE MOVEMENT_SCAN_.isActive TO Script_MOVEMENT_SCAN_.activated
ROUTE MOVEMENT_SCAN_.cycleTime TO Script_MOVEMENT_SCAN_.cycle
ROUTE LAZER_BEAM.fraction_changed TO LAZER_BEAM_pos0.set_fraction
ROUTE LAZER_BEAM_pos0.value_changed TO dad_Cylinder2.set_translation
ROUTE LAZER_BEAM.fraction_changed TO LAZER_BEAM_scl0.set_fraction
ROUTE LAZER_BEAM_scl0.value_changed TO dad_Cylinder2.set_scale
ROUTE LAZER_BEAM.isActive TO Script_LAZER_BEAM.activated
ROUTE LAZER_BEAM.cycleTime TO Script_LAZER_BEAM.cycle
ROUTE LIGHT_BEEP.fraction_changed TO LIGHT_BEEP_pos0.set_fraction
ROUTE LIGHT_BEEP_pos0.value_changed TO dad_BLUE.set_translation
ROUTE LIGHT_BEEP.fraction_changed TO LIGHT_BEEP_pos1.set_fraction
ROUTE LIGHT_BEEP_pos1.value_changed TO dad_RED.set_translation
ROUTE LIGHT_BEEP.isActive TO Script_LIGHT_BEEP.activated
ROUTE LIGHT_BEEP.cycleTime TO Script_LIGHT_BEEP.cycle
