DEF Script_Light1 Script {
  field    SFNode      lght     USE  Light1
  field  SFBool  state FALSE  eventIn  SFTime      toggle
  directOutput         TRUE
  url "vrmlscript:
 function toggle( ) {
  state = !state;
  lght.set_on = state;
 }
 "
}
ROUTE Sensor1.touchTime TO Script_Light1.toggle
