Script{

field SFNode sw USE thisSwitch

url"vrmlscript:

function initialize(){

 a = new SFVec3f(0,0,100);
 b = new SFVec3f(0,0,-100);
 scene = new SFNode();
 scene = Browser.computeRayHit(a,b).hitPath[0];
 
 for(i = 0; i < scene.children.length;i++){
  if(scene.children[i] == 'Script{ }'){dx_script = scene.children[i];}
 }

 Browser.addRoute( dx_script,'vDromeChoice_changed',sw,'set_whichChoice');
 
}

"}
