#VRML V2.0 utf8
Billboard {
	children Shape {
		appearance Appearance {texture ImageTexture {url "tree.gif"}}
		geometry IndexedFaceSet {
			coord Coordinate {point [-1 -1.75 0 ,-1 0.25 0 ,1 0.25 0,1 -1.75 0]}
			texCoord TextureCoordinate {point [0 0,0 1,1 1,1 0]}
			coordIndex [
				3,2,1,0,
				-1]
			normalPerVertex FALSE 
		}
	}
}
