DEF Script_Animation2 Script {
  field    SFNode      tproc     USE  Animation2
 field    SFBool state     FALSE
 field    SFTime pause     0
 eventIn  SFTime toggle
 eventOut SFTime triggerStart
 eventOut SFTime triggerStop
 eventOut SFTime triggerStartInt
 eventIn  SFBool activated
 eventIn  SFTime cycle
 directOutput TRUE
 url "vrmlscript:
 function activated( active, curtime ) {
  if( active ) {
   triggerStart = curtime;
   state = TRUE;
  }
  else {
   triggerStop = curtime;
   state = FALSE;
  }
 }
 function cycle( curtime ) {
  triggerStartInt = curtime;
 }
 function toggle( stime ) {
  if( state )
  {
   state = FALSE;
   pause = stime - tproc.startTime_changed;
   tproc.enabled = FALSE;
  }
  else
  {
   state = TRUE;
   tproc.set_startTime = stime - pause;
   tproc.enabled = TRUE;
   pause = 0;
  }
 }
 "
}
DEF Script_Animation1 Script {
  field    SFNode      tproc     USE  Animation1
 field    SFBool state     FALSE
 field    SFTime pause     0
 eventIn  SFTime toggle
 eventOut SFTime triggerStart
 eventOut SFTime triggerStop
 eventOut SFTime triggerStartInt
 eventIn  SFBool activated
 eventIn  SFTime cycle
 directOutput TRUE
 url "vrmlscript:
 function activated( active, curtime ) {
  if( active ) {
   triggerStart = curtime;
   state = TRUE;
  }
  else {
   triggerStop = curtime;
   state = FALSE;
  }
 }
 function cycle( curtime ) {
  triggerStartInt = curtime;
 }
 function toggle( stime ) {
  if( state )
  {
   state = FALSE;
   pause = stime - tproc.startTime_changed;
   tproc.enabled = FALSE;
  }
  else
  {
   state = TRUE;
   tproc.set_startTime = stime - pause;
   tproc.enabled = TRUE;
   pause = 0;
  }
 }
 "
}
ROUTE Sensor2.touchTime TO Script_Animation2.toggle
ROUTE Sensor1.touchTime TO Script_Animation1.toggle
ROUTE Animation2.fraction_changed TO Animation2_pos0.set_fraction
ROUTE Animation2_pos0.value_changed TO dad_LEFT_DOOR.set_translation
ROUTE Animation2.fraction_changed TO Animation2_rot0.set_fraction
ROUTE Animation2_rot0.value_changed TO dad_LEFT_DOOR.set_rotation
ROUTE Animation2.isActive TO Script_Animation2.activated
ROUTE Animation2.cycleTime TO Script_Animation2.cycle
ROUTE Animation1.fraction_changed TO Animation1_pos0.set_fraction
ROUTE Animation1_pos0.value_changed TO dad_RIGHT_DOOR.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot0.set_fraction
ROUTE Animation1_rot0.value_changed TO dad_RIGHT_DOOR.set_rotation
ROUTE Animation1.isActive TO Script_Animation1.activated
ROUTE Animation1.cycleTime TO Script_Animation1.cycle
