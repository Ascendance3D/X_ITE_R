DEF Script_Sound1 Script {
  field    SFNode      snd     USE  AClip_Sound1
field    SFBool      state     FALSE
field    SFTime      pause     0
eventIn  SFTime      startAt0
directOutput         TRUE
url "vrmlscript:
 function startAt0( stime ) {
 state = TRUE;
 snd.set_startTime = stime;
 snd.set_stopTime = 0;
 }
"
}
DEF spazz_init TimeSensor {
  cycleInterval 0.5
  loop TRUE
  startTime  0
}
DEF Script_spazz_init Script {
  field    SFNode      tproc     USE  spazz_init
  field    SFInt32     count  0
  eventOut SFTime      triggerStart
  eventIn  SFTime      cycle
  directOutput         TRUE
  url "vrmlscript:
   function cycle( curtime ) {
    if(count++ > 5) {
      triggerStart = curtime;
      tproc.enabled = FALSE;
   }}
   "
}
ROUTE spazz_init.cycleTime TO Script_spazz_init.cycle
ROUTE Script_spazz_init.triggerStart TO Script_Wizard1.startAt0
ROUTE Script_spazz_init.triggerStart TO Script_Wizard2.startAt0
ROUTE Sensor1.touchTime TO Script_Sound1.startAt0
ROUTE Sensor2.touchTime TO Script_Wizard0.startAt0
ROUTE Sensor5.touchTime TO Script_Wizard.startAt0
ROUTE Wizard0.fraction_changed TO Wizard0_scl0.set_fraction
ROUTE Wizard0_scl0.value_changed TO dad_Sphere3.set_scale
ROUTE Wizard0.isActive TO Script_Wizard0.activated
ROUTE Wizard0.cycleTime TO Script_Wizard0.cycle
