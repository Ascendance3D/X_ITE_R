DEF Animation1 TimeSensor {
 cycleInterval 10.000
 loop TRUE
 startTime  -1
}
DEF Animation1_pos0 PositionInterpolator {
 key [
  0.0 0.25 0.5 0.75 1.0
 ]
 keyValue [
  -0.566 -1.708 0.0
  -1.398 -0.759 0.158
  -1.16 -1.035 2.772
  -0.922 -1.708 0.0
  -0.685 -1.708 0.0
 ]
}
