  0.0 0.25 0.5 1.0 
 ]
 keyValue [
  0.0 0.028 1.0 0.0
  0.0 0.028 1.0 -0.518
  0.0 0.028 1.0 0.0
  0.0 0.028 1.0 0.0
 ]
}
