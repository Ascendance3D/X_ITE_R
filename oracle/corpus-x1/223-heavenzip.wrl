DEF waterTransform3 Transform { translation 0 -16.9 0
children [
DEF waterShape3 Shape {
appearance Appearance {
material Material { transparency 0.3 }
texture ImageTexture { url "pearl.jpg" }
textureTransform DEF waterTT3 TextureTransform {
scale 5 1 }}
geometry Extrusion {
creaseAngle 1.57 
beginCap FALSE 
endCap FALSE 
crossSection [ 
2 0, 1.92 -0.38, 
1.71 -0.71, 1.38 -0.92, 
1 -1, -1.38 -0.92, 
-1.71 -0.71, -1.92 -0.38, 
