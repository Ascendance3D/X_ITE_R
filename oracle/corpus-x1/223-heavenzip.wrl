#planets
Transform { translation -335 -70 -312
rotation 0.1 0 0 0.1 children [
Shape {
appearance Appearance {
material DEF Planet1 Material { diffuseColor 0 0.5 0.5
transparency 0.8 }}
geometry Sphere { radius 30 }}
]}
DEF Colour1 ColorInterpolator { 
key [ 0, 0.3, 0.65, 1 ] 
keyValue [ 0 1 1, 0 1 0.5, 0 0.5 1, 0 1 0.5 ]
}
DEF Clock1 TimeSensor { 
cycleInterval 50 
loop TRUE
}
ROUTE Clock1.fraction_changed TO Colour1.set_fraction 
ROUTE Colour1.value_changed TO Planet1.set_diffuseColor

