DEF spazz_init TimeSensor {
  cycleInterval 0.1
  loop TRUE
}
ROUTE spazz_init.cycleTime TO Script_Wizard0.startAt0
ROUTE spazz_init.cycleTime TO spazz_init.stopTime
ROUTE Sensor1.touchTime TO Script_Wizard1.startAt0
ROUTE Sensor4.touchTime TO Script_Wizard2.startAt0
ROUTE Sensor4.touchTime TO Script_Wizard3.startAt0
ROUTE Sensor4.touchTime TO Script_Wizard.startAt0
ROUTE Wizard0.fraction_changed TO Wizard0_pos0.set_fraction
ROUTE Wizard0_pos0.value_changed TO dad_lineoftext0.set_translation
ROUTE Wizard0.isActive TO Script_Wizard0.activated
ROUTE Wizard0.cycleTime TO Script_Wizard0.cycle
ROUTE Wizard1.fraction_changed TO Wizard1_pos0.set_fraction
ROUTE Wizard1_pos0.value_changed TO dad_Group1.set_translation
ROUTE Wizard1.isActive TO Script_Wizard1.activated
ROUTE Wizard1.cycleTime TO Script_Wizard1.cycle
