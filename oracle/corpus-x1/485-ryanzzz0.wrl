]
"/places/suburbs/WorldChanger.wrl"
WorldChanger {
	numberOfChoices 2 #number of worlds +1 for title
	WorldBuilderTitle [ "ryanzzz0" ]

	World1 [ "Farm_Quonsets" ]
	url_string1 
[ "/cgi-bin/cybertown/place?plc=suburbs&ac=place&T_SUB=Farm_Quonsets&force=p" ]
	param_string1 [ "target=place" ]
             }
