DEF Script_Animation1 Script {
  field    SFNode      tproc     USE  Animation1
 field    SFBool state     FALSE
 field    SFTime pause     0
 eventIn  SFTime startAt0
 eventOut SFTime triggerStart
 eventOut SFTime triggerStop
 eventOut SFTime triggerStartInt
 eventIn  SFBool activated
 eventIn  SFTime cycle
 directOutput TRUE
 url "vrmlscript:
 function activated( active, curtime ) {
  if( active ) {
   triggerStart = curtime;
   state = TRUE;
  }
  else {
   triggerStop = curtime;
   state = FALSE;
  }
 }
 function cycle( curtime ) {
  triggerStartInt = curtime;
 }
 function startAt0( stime ) {
  state = TRUE;
  tproc.set_startTime = stime;
  tproc.enabled = TRUE;
  pause = 0;
 }
 "
}
ROUTE Sensor1.touchTime TO Script_Animation1.startAt0
ROUTE Animation1.fraction_changed TO Animation1_pos0.set_fraction
ROUTE Animation1_pos0.value_changed TO dad_legs_front.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot0.set_fraction
ROUTE Animation1_rot0.value_changed TO dad_legs_front.set_rotation
ROUTE Animation1.fraction_changed TO Animation1_pos1.set_fraction
ROUTE Animation1_pos1.value_changed TO dad_legs_rear.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot1.set_fraction
ROUTE Animation1_rot1.value_changed TO dad_legs_rear.set_rotation
ROUTE Animation1.fraction_changed TO Animation1_pos2.set_fraction
ROUTE Animation1_pos2.value_changed TO dad_Ears.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot2.set_fraction
ROUTE Animation1_rot2.value_changed TO dad_Ears.set_rotation
ROUTE Animation1.fraction_changed TO Animation1_pos3.set_fraction
ROUTE Animation1_pos3.value_changed TO dad_Bunny.set_translation
ROUTE Animation1.fraction_changed TO Animation1_rot3.set_fraction
ROUTE Animation1_rot3.value_changed TO dad_Bunny.set_rotation
ROUTE Animation1.isActive TO Script_Animation1.activated
ROUTE Animation1.cycleTime TO Script_Animation1.cycle
