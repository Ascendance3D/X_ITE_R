#VRML V2.0 utf8

Transform {
	children [
		Transform {
			translation 0 -1.75 0
			children [
				Transform {
					children [
						Transform {
							translation 0 0.3 0
							scale       1.5 1 1
							children [
								Shape {
									appearance Appearance {
										material Material {
											ambientIntensity 0
											diffuseColor     0.2 0.2 0.2
										}
									}
									geometry Cylinder {
										radius 0.2
										height 0.6
										top    FALSE
										bottom FALSE
									}
								}
							]
						}
					]
				}
			]
		}
		Transform {
			translation 0 -1.75 0
			children [
				Transform {
					children [
						Transform {
							translation 0 0.6 0
							scale       1.5 .5 1
							children [
								Shape {
									appearance Appearance {
										texture ImageTexture {
											url "nastiness.jpg"
										}
									}
									geometry Sphere {
										radius 0.2
									}
								}
							]
						}
					]
				}
			]
		}
	]
}
