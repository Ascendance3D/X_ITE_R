ROUTE chickenTreeSensor.touchTime TO Script_chickenTreeClip.startAt0
ROUTE bunnyTreeSensor.touchTime TO Script_bunnyTreeClip.startAt0
ROUTE bearTreeSensor.touchTime TO Script_bearTreeClip.startAt0
ROUTE puppyTreeSensor.touchTime TO Script_puppyTreeClip.startAt0
ROUTE clipAnimation.fraction_changed TO clipAnimation_rot0.set_fraction
ROUTE clipAnimation_rot0.value_changed TO dad_blade2.set_rotation
ROUTE clipAnimation.fraction_changed TO clipAnimation_rot1.set_fraction
ROUTE clipAnimation_rot1.value_changed TO dad_blade.set_rotation
ROUTE clipAnimation.isActive TO Script_clipAnimation.activated

ROUTE clipAnimation.cycleTime TO Script_clipAnimation.cycle

ROUTE cliptree.fraction_changed TO cliptree_rot0.set_fraction
ROUTE cliptree_rot0.value_changed TO dad_leftShoulderJoint.set_rotation
ROUTE cliptree.fraction_changed TO cliptree_rot1.set_fraction
