ROUTE chickenTreeClip.fraction_changed TO chickenTreeClip_scl1.set_fraction
ROUTE chickenTreeClip_scl1.value_changed TO dad_chickenTreeBall.set_scale
ROUTE chickenTreeClip.isActive TO Script_chickenTreeClip.activated

ROUTE chickenTreeClip.cycleTime TO Script_chickenTreeClip.cycle

ROUTE Script_chickenTreeClip.triggerStart TO Script_cliptree.start
ROUTE Script_chickenTreeClip.triggerStop TO Script_cliptree.stop
ROUTE Script_chickenTreeClip.triggerStart TO Script_clipAnimation.start
ROUTE Script_chickenTreeClip.triggerStop TO Script_clipAnimation.stop
ROUTE bunnyTreeClip.fraction_changed TO bunnyTreeClip_pos0.set_fraction
ROUTE bunnyTreeClip_pos0.value_changed TO dad_cliptron.set_translation
ROUTE bunnyTreeClip.fraction_changed TO bunnyTreeClip_rot0.set_fraction
ROUTE bunnyTreeClip_rot0.value_changed TO dad_cliptron.set_rotation
ROUTE bunnyTreeClip.fraction_changed TO bunnyTreeClip_scl1.set_fraction
ROUTE bunnyTreeClip_scl1.value_changed TO dad_bunnyBall.set_scale
ROUTE bunnyTreeClip.isActive TO Script_bunnyTreeClip.activated

ROUTE bunnyTreeClip.cycleTime TO Script_bunnyTreeClip.cycle

ROUTE Script_bunnyTreeClip.triggerStart TO Script_clipAnimation.start
ROUTE Script_bunnyTreeClip.triggerStop TO Script_clipAnimation.stop
ROUTE Script_bunnyTreeClip.triggerStart TO Script_cliptree.start
ROUTE Script_bunnyTreeClip.triggerStop TO Script_cliptree.stop
ROUTE bearTreeClip.fraction_changed TO bearTreeClip_pos0.set_fraction
