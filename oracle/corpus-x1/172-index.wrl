#VRML V2.0 utf8

EXTERNPROTO	examine [
	eventOut SFBool right_click
	eventIn	SFBool on
	eventIn	SFBool reset_viewpoint
	eventOut SFVec3f examine-center
	exposedField SFFloat speed
    exposedField SFBool isActive 
	eventOut SFBool	ready
]

"../protos/navigation.wrl#examine"


EXTERNPROTO	venus []
"venus.wrl"


EXTERNPROTO Layer3D[
	exposedField SFVec3f bboxSize
	exposedField SFVec3f bboxCenter
	eventIn MFNode addChildrenLayer
	eventIn MFNode removeChildrenLayer
	exposedField MFNode childrenLayer
	exposedField SFVec2f translation
	exposedField SFInt32 depth
	exposedField SFVec2f size
	exposedField SFNode background
	exposedField SFNode fog
	exposedField SFNode navigationInfo
	exposedField SFNode viewpoint
	exposedField MFNode children
	eventIn MFNode addChildren
	eventIn MFNode removeChildren
	]
["urn:inet:blaxxun.com:node:Layer3D","http://www.blaxxun.com/vrml/protos/nodes.wrl#Layer3D","nodes.wrl#Layer3D"]

Layer3D 
{ 
   translation -.6 -.4
   size 1 1
   children [
   DEF BaseTransform Transform { 
		translation      0 0 0  
	
		rotation         0 1 0 0  
		children
		[
			Transform { 
			## translation      0.24 0 0  
			## rotation         0 1 0 0
			children         [
			
			Transform {
				scale .5 .5 .5
   		  children      Shape {
    				appearance  Appearance {
    				  material  Material {transparency .25 emissiveColor 1 1 1}
					  texture ImageTexture {url	"../media/images-menu/help_examine.jpg"}
								}

    				geometry IndexedFaceSet {
    				  coord     Coordinate {
        				point   [ -1 -1 0,
                				   1 -1 0,
                				  1 1 0,
                				  -1 1 0 ]
    				  }

    				  coordIndex        [ 0, 1, 2, 3]
    				  solid     FALSE
    				  texCoord TextureCoordinate {
								  point	[0 0,
									  1 0,
									  1 1,
									  0 1]
												  }
    				  texCoordIndex     [0 1 2 3]
    				}

				  }

				  translation   0 0 0
				}
			
			]
			}
		]
								} 
			]
} 


DEF navigationinfo NavigationInfo {}

DEF navigation examine{speed 12}

Transform {
	scale .2 .2 .2
	children
	venus{}
	}

Collision {
	collide	FALSE
	children
	DEF	ball Transform
	{
		translation	0 0 0
		scale 0.2 .2 .2
		children [
		Shape {
			appearance Appearance {
				material Material {diffuseColor	1 0 0}
			}
			geometry Sphere	{}
		}
	]
	}
}

ROUTE navigation.examine-center	TO ball.translation

DEF	control Script {
 eventIn SFBool	ready
 field SFNode navigation USE	navigation
 url "vrmlscript:
 
 function ready(value)
 {
  if (value) navigation.on=true;
 }
 "
}

ROUTE navigation.ready TO control.ready

PROTO fish [
	exposedField SFVec3f position 0 0 0
	exposedField SFFloat i 1
	exposedField SFColor emitColor 1 0 0
	exposedField SFColor fadeColor 0 0 1
]
{



DEF kugel Transform {
	children [
		#PointLight {radius 50 intensity 1}
		Billboard {
			children [
DEF star Transform {
  children 	Shape {
    appearance	Appearance {
      material	DEF star_mat Material {
      }

      texture 	ImageTexture {
	repeatS	FALSE
	repeatT	FALSE
	url	"../media/textures/flash.png"
      }
	   
    }

    geometry	DEF _0 IndexedFaceSet {
      coord	Coordinate {
	point	[ -1 -1 0,
		  -1 1 0,
		  1 1 0,
		  1 -1 0 ]
      }

      coordIndex	[ 0, 1, 2, 3, -1 ]
      solid	FALSE
      normalIndex	[  ]
      texCoordIndex	[  ]
    }

  }

  translation	0 20 0
}
]
}


DEF star2 Transform {
  children	Shape {
    appearance	Appearance {
      material	DEF star_mat2 Material {
      }

      texture 	ImageTexture {
	repeatS	FALSE
	repeatT	FALSE
	url	"../media/textures/flash.png"
      }
	   
    }

    geometry	 IndexedFaceSet {
      coord	Coordinate {
	point	[ -1 -1 0,
		  -1 1 0,
		  1 1 0,
		  1 -1 0 ]
      }

      coordIndex	[ 0, 1, 2, 3, -1 ]
      solid	FALSE
      normalIndex	[  ]
      texCoordIndex	[  ]
    }

  }

  translation	0 20 0
  scale	2 2 2
}

		DEF PS-T Transform {
		children Shape {
			appearance 	Appearance {
				##material Material { transparency 0.0  ##emissiveColor 1 0.5 0.5 }
				texture DEF PS-TEX ImageTexture { url [
						##"textures/particle.png"
						#"textures/part5g.png"
			    		#"textures/flarergba1.png"
						# "textures/grayspot.png"
						"../media/textures/part2gray.png" 

		        		#"textures/hgspikeballg.png" 
						#"textures/partikel.png" 
						## "textures/shine1.png" 
						##"textures/flare2.png"
					]
				}
			
			}
			geometry DEF PS Particles 
			{
				bboxSize -1 -1 -1 
				lodRange 0
				particleRadius 0.4  ## 0.3
				emitColor  IS emitColor
				fadeColor IS fadeColor
				sparkFadeColor .2 .2 1
				fadeRate .2
				fadeAlpha 0
				emitterPosition 0 20 0
				emitterRadius .5
				emitterSpread .2
				creationRate 120
				maxParticles 3500
				creationRateVariation 0.4
				maxLifeTime 4

				#emitVelocity 7 10 7 
				emitVelocity 6 6 6
				gravity	0 0 0	
				emitVelocityVariation 1	
				sparkGravity 0 7 0	
		
		
				numTrails 0
				numSparks 0
			}
		}
	}

	]
}







DEF	animator Script {

	eventIn	SFFloat	vector
	eventIn	SFFloat scale
	eventIn	SFFloat	speed
	eventOut SFVec3f scale_out
	eventOut SFFloat transparency
	
	field SFNode kugel USE kugel
	field SFNode PS USE	PS

	field SFVec3f current_vector .01 .01 .01
	field SFVec3f position .01 .01 .01
	field SFVec3f position2 0 0 0
	field SFRotation current_angle 0 1 0 0
	field SFFloat zufall 0

	url	"vrmlscript:

	function vector()
	{
		current_vector[0]+=(Math.random()-.5-position[0]/400-Math.pow(current_vector[0]/12,3)); //-Math.pow(current_vector[0],13)); 
		current_vector[1]+=(Math.random()-.5-position[1]/400-Math.pow(current_vector[1]/12,3));
		current_vector[2]+=(Math.random()-.5-position[2]/400-Math.pow(current_vector[2]/12,3));																					   
		position[0] += current_vector[0]/30;
	    position[1] += current_vector[1]/30;
		position[2] += current_vector[2]/30;

		position2[0]=2*position[0];
		position2[1]=2*position[1];
		position2[2]=2*position[2];
		kugel.translation=position2;

		PS.gravity[0]=-current_vector[0]*15;
		PS.gravity[1]=-current_vector[1]*15;
		PS.gravity[2]=-current_vector[2]*15;
	}

	function scale()
	{
		zufall=Math.random()*25;
		scale_out[0]=zufall;
		scale_out[1]=zufall;
		scale_out[2]=zufall;
		transparency=zufall/25/3;
	}

	


	"
}

DEF	TI_animator TimeSensor 
{
	cycleInterval 5
	loop TRUE
	startTime 0
}

ROUTE TI_animator.fraction_changed TO animator.vector
ROUTE TI_animator.fraction_changed TO animator.scale
ROUTE animator.scale_out TO	star.scale
ROUTE animator.transparency TO star_mat.transparency




}



