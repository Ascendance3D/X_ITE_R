DEF Animation5 TimeSensor {
 cycleInterval 2.000
 loop FALSE
 startTime  -1
}
DEF Animation5_rot0 OrientationInterpolator {
 key [ 0.0 0.12 0.229 0.339 0.459
 0.57 0.679 0.79 0.895 1.0]
 keyValue [
 0.0 0.0 1.0 0.708
 0.0 0.0 1.0 -0.708
