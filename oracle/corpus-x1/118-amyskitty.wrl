}

DEF Script_Animation5 Script {
  field    SFNode      tproc     USE  Animation5
 field    SFBool state     FALSE
 field    SFTime pause     0
 eventIn  SFTime startAt0
 eventOut SFTime triggerStart
 eventOut SFTime triggerStop
 eventOut SFTime triggerStartInt
 eventIn  SFBool activated
 eventIn  SFTime cycle
 directOutput TRUE
 url "vrmlscript:
 function activated( active, curtime ) {
  if( active ) {
   triggerStart = curtime;
   state = TRUE;
  }
  else {
   triggerStop = curtime;
   state = FALSE;
  }
 }
 function cycle( curtime ) {
  triggerStartInt = curtime;
 }
 function startAt0( stime ) {
  state = TRUE;
  tproc.set_startTime = stime;
  tproc.enabled = TRUE;
  pause = 0;
 }
 "
}
ROUTE Sensor3.touchTime TO Script_Animation5.startAt0
ROUTE Animation5.fraction_changed TO Animation5_rot0.set_fraction
ROUTE Animation5_rot0.value_changed TO dad_Group4.set_rotation
ROUTE Animation5.isActive TO Script_Animation5.activated
ROUTE Animation5.cycleTime TO Script_Animation5.cycle
