DEF co
Script {
field    SFNode      tproc
USE cg
field    SFBool state     FALSE
field    SFTime pause     0
eventIn  SFTime toggle
eventOut SFTime triggerStart
eventOut SFTime triggerStop
eventOut SFTime triggerStartInt
eventIn  SFBool activated
eventIn  SFTime cycle
directOutput TRUE
url "vrmlscript:
function activated( active, curtime ) {
if( active ) {
triggerStart = curtime;
state = TRUE;
}
else {
triggerStop = curtime;
state = FALSE;
}
}
function cycle( curtime ) {
triggerStartInt = curtime;
}
function toggle( stime ) {
if( state )
{
state = FALSE;
pause = stime - tproc.startTime_changed;
tproc.enabled = FALSE;
}
else
{
state = TRUE;
tproc.set_startTime = stime - pause;
tproc.enabled = TRUE;
pause = 0;
}
}
"
}
ROUTE cf.touchTime TO co.toggle
ROUTE cg.fraction_changed TO ch.set_fraction
ROUTE ch.value_changed TO a9.set_translation
ROUTE cg.fraction_changed TO ci.set_fraction
ROUTE ci.value_changed TO a9.set_rotation
ROUTE cg.fraction_changed TO cj.set_fraction
ROUTE cj.value_changed TO bz.set_rotation
ROUTE cg.fraction_changed TO ck.set_fraction
ROUTE ck.value_changed TO bz.set_scale
ROUTE cg.fraction_changed TO cl.set_fraction
ROUTE cl.value_changed TO b4.set_rotation
ROUTE cg.fraction_changed TO cm.set_fraction
ROUTE cm.value_changed TO b9.set_translation
ROUTE cg.fraction_changed TO cn.set_fraction
ROUTE cn.value_changed TO b9.set_rotation
ROUTE cg.isActive TO co.activated
ROUTE cg.cycleTime TO co.cycle
