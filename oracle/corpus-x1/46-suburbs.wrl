#VRML V2.0 utf8

EXTERNPROTO Portal[
field SFVec3f translation 
field SFRotation rotation 
field SFVec3f scale 
field SFString viewpointDescription 
field MFString directoryURL
]"/places/suburbs/Aportal.wrl"#Portal


DEF dad_Light1 Transform {
 translation 0.0 3.01 0.0
 children [
  DEF Light1 PointLight {
   ambientIntensity 0.000
   intensity 1.000
   radius 100.000
   attenuation 1.0 0.0 0.0
   color 1.0 1.0 1.0
   on TRUE
  }
 ]
}


