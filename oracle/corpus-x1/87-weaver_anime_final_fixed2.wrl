DEF cg
TimeSensor {
loop TRUE
}
DEF ch
Script {
eventIn SFFloat DisplayTime eventIn SFTime AddMinute eventIn SFBool Enable eventOut SFFloat HoursLERP eventOut SFFloat MinutesLERP eventOut SFFloat SecondsLERP field SFFloat btime_h 0 field SFFloat btime_m 0 field SFFloat btime_s 0 field SFInt32 btime 0 field SFNode Timer
USE cg
field SFBool Synched FALSE directOutput TRUE mustEvaluate TRUE url "javascript:
function Enable (val, ctime) {
if (!val) {
Synched = FALSE;
Timer.stopTime = ctime;
Timer.enabled = FALSE;
}
else {
Synched = FALSE;
Timer.startTime = ctime;
Timer.enabled = TRUE;
}
}
function AddMinute (val, ctime) {
btime += 1;
}
function DisplayTime (val, ctime) {
if (!Synched) {
now = new Date();
btime_h = ((now.getHours() > 12) ? now.getHours() - 12 : now.getHours());
btime_m = now.getMinutes();
btime_s = now.getSeconds();
btime = btime_s + (btime_m * 60) + (btime_h * 3600);
Synched = TRUE;
}
btime_h = ((btime + val) / 3600);
btime_m = ((btime + val) % 3600) / 60;
btime_s = (btime + val) % 60;
HoursLERP =  btime_h / 12;
MinutesLERP = btime_m / 60;
SecondsLERP = btime_s / 60;      
}
"
}
ROUTE a.isActive TO ch.Enable
ROUTE cg.cycleTime TO ch.AddMinute
ROUTE cg.fraction_changed TO ch.DisplayTime
ROUTE ch.HoursLERP TO cd.set_fraction
ROUTE cd.value_changed TO by.set_rotation
ROUTE ch.MinutesLERP TO ce.set_fraction
ROUTE ce.value_changed TO b3.set_rotation
ROUTE ch.SecondsLERP TO cf.set_fraction
ROUTE cf.value_changed TO b9.set_rotation
