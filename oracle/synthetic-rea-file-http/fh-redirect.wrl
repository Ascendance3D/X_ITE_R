#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
# Synthetic REA oracle world (generated by oracle/tools/gen_file_http.py): fh-redirect.
# Each URL list goes through Browser.createX3DFromURL, one after the other; `out` lists the scene head and printed scene or the rejection of each.
DEF OUT Script {
  inputOutput MFString out [ ]
  url "ecmascript:
    var CASES = [[\"/h/ok\"], [\"/h/r301\"], [\"/h/r302\"], [\"/h/r303\"], [\"/h/r307\"], [\"/h/r308\"], [\"/h/r-rel\"], [\"/h/r-rel-up\"], [\"/h/r-abs\"], [\"/h/r-protocol-relative\"], [\"/h/r-query\"], [\"/h/r-fragment-only\"], [\"/h/r-chain\"], [\"/h/loop-a\"], [\"/h/self\"], [\"/h/chain20/0\"], [\"/h/chain21/0\"], [\"/h/r-nolocation\"], [\"/h/r-empty-location\"], [\"/h/r300\"], [\"/h/r304\"], [\"/h/r-to-404\"], [\"/h/r-to-500\"], [\"/h/r-to-html\"], [\"/h/r-file\"], [\"/h/r-data\"], [\"/h/r-ftp\"], [\"/h/r-javascript\"], [\"/h/r-ecmascript\"], [\"/h/r-blob\"], [\"/h/r-about\"], [\"/h/r-ws\"], [\"/h/r-creds\"], [\"/h/r-creds-user\"], [\"/h/r-badurl\"], [\"/h/r-refused\"], [\"/h/r-cross-cors\"], [\"/h/r302#Frag\"], [\"/h/ok#Frag\"], [\"/h/ok?a=b\"], [\"/h/r302?x=1\"], [\"/h/r-query?y=2#G\"], [\"/h/r-file\", \"/h/ok\"], [\"/h/r-to-404\", \"/h/ok\"], [\"/h/loop-a\", \"/h/ok\"], [\"/h/chain21/0\", \"/h/r302\"], [\"/h/r-creds\", \"/h/r-data\", \"/h/r302\"]];
    var res = [];
    function strip (s) { s = String (s); var o = '', k, e; while ((k = s .indexOf ('http://')) >= 0 && (e = s .indexOf ('/', k + 7)) >= 0) { o += s .substring (0, k); s = s .substring (e + 1); } return o + s; }
    function put (i, v) { res [i] = i + ': ' + v; var o = []; for (var k = 0; k < CASES .length; ++ k) o .push (k in res ? res [k] : k + ': ...'); out = new MFString (... o); }
    function title (t) { var q = String .fromCharCode (34), m = t .indexOf ('title ' + q); return m < 0 ? 'no title' : t .substring (m + 7, t .indexOf (q, m + 7)); }
    function run (i) {
      if (i >= CASES .length) return;
      var p;
      try { p = Browser .createX3DFromURL (new MFString (... CASES [i])); } catch (e) { put (i, 'THROW ' + strip (e .message)); run (i + 1); return; }
      p .then (function (sc) {
        var head = [sc .encoding, sc .specificationVersion, sc .profile && sc .profile .name, sc .rootNodes .length, strip (sc .worldURL)] .join ('/');
        var text; try { text = sc .toVRMLString (); } catch (e) { text = 'PRINT ERR ' + e .message; }
        put (i, 'RES ' + head + String .fromCharCode (10) + text);
        run (i + 1);
      }, function (e) { put (i, 'REJ ' + strip (e && e .message)); run (i + 1); });
    }
    function initialize () { run (0); }
  "
}
