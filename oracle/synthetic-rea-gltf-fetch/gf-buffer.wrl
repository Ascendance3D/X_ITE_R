#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
# Synthetic REA oracle world (generated by oracle/tools/gen_gltf_fetch.py): gf-buffer.
# Each URL list goes through Browser.createX3DFromURL, one after the other; `out` lists the scene head and printed scene or the rejection of each.
# The loads start from the first event of a TimeSensor, after the world itself finished loading (the harness freezes time at 946684800 for the load; `go` waits for the first frame after 946684800.1): a glTF buffer that fails to load is never
# removed from the loading objects of the world in the pinned X_ITE, so the world's own loadURL would never settle (oracle/README.md).
DEF CLOCK TimeSensor { loop TRUE cycleInterval 1000 }
DEF OUT Script {
  eventIn SFTime go
  inputOutput MFString out [ ]
  url "ecmascript:
    var CASES = [[\"buf/bad-base64.gltf\"], [\"buf/data-empty.gltf\"], [\"buf/data-short.gltf\"], [\"buf/glb-data-bad.glb\"], [\"buf/glb-first-uri-missing.glb\"], [\"buf/glb-first-uri-ok.glb\"], [\"buf/glb-nobin-no-uri.glb\"], [\"buf/glb-nobin-uri-missing.glb\"], [\"buf/glb-nobin-uri-ok.glb\"], [\"buf/glb-ok.glb\"], [\"buf/glb-second-missing.glb\"], [\"buf/glb-second-ok.glb\"], [\"buf/missing-dotdot.gltf\"], [\"buf/missing-subdir.gltf\"], [\"buf/missing.gltf\"], [\"buf/not-a-bin-dir.gltf\"], [\"buf/ok-data.gltf\"], [\"buf/ok-encoded.gltf\"], [\"buf/ok-external.gltf\"], [\"buf/two-both-missing.gltf\"], [\"buf/two-first-missing.gltf\"], [\"buf/two-same-missing.gltf\"], [\"buf/two-second-missing.gltf\"], [\"buf/uri-empty.gltf\"], [\"buf/uri-invalid.gltf\"], [\"buf/uri-null.gltf\"], [\"buf/uri-number.gltf\"], [\"buf/view-of-missing.gltf\"], [\"buf/missing.gltf\", \"buf/ok-external.gltf\"], [\"buf/missing.gltf\", \"buf/missing-subdir.gltf\", \"buf/ok-data.gltf\"], [\"buf/glb-second-missing.glb\", \"buf/glb-ok.glb\"], [\"buf/ok-external.gltf\", \"buf/missing.gltf\"], [\"buf/missing.gltf\", \"buf/nonexistent.wrl\"], [\"buf/nonexistent.wrl\", \"buf/missing.gltf\"], [\"buf/missing.gltf\", \"buf/nonexistent.wrl\", \"buf/ok-external.gltf\"], [\"buf/nonexistent.wrl\", \"buf/missing.gltf\", \"buf/nonexistent-2.wrl\", \"buf/ok-external.gltf\"], [\"buf/missing.gltf\", \"buf/two-both-missing.gltf\"], [\"buf/uri-invalid.gltf\", \"buf/missing.gltf\", \"buf/ok-data.gltf\"]];
    var res = [], started = false;
    function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
    function put (i, v) { res [i] = i + ': ' + v; var o = []; for (var k = 0; k < CASES .length; ++ k) o .push (k in res ? res [k] : k + ': ...'); out = new MFString (... o); }
    function run (i) {
      if (i >= CASES .length) return;
      var p;
      try { p = Browser .createX3DFromURL (new MFString (... CASES [i])); } catch (e) { put (i, 'THROW ' + strip (e .message)); run (i + 1); return; }
      p .then (function (sc) {
        var head = [sc .encoding, sc .specificationVersion, sc .profile && sc .profile .name, sc .rootNodes .length, sc .protos .length, sc .externprotos .length, sc .routes .length, sc .importedNodes .length, sc .exportedNodes .length, strip (sc .worldURL)] .join ('/');
        var text; try { text = sc .toVRMLString (); } catch (e) { text = 'PRINT ERR ' + e .message; }
        put (i, 'RES ' + head + '\n' + text);
        run (i + 1);
      }, function (e) { put (i, 'REJ ' + strip (e && e .message)); run (i + 1); });
    }
    function go (t) { if (started || t < 946684800.1) return; started = true; run (0); }
  "
}
ROUTE CLOCK.time TO OUT.go
