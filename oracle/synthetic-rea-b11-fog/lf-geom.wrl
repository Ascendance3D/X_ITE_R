#X3D V4.0 utf8
PROFILE Full
COMPONENT VolumeRendering:2
Viewpoint { position 0 0 8 }
Background { skyColor 0.12 0.14 0.2 }
NavigationInfo { type "EXAMINE" transitionType [ "TELEPORT" ] }
Group { children [ DEF LF LocalFog { color 0.8 0.4 0.3 visibilityRange 16 }
Transform { translation -1.5 0 -1 children Shape { appearance Appearance { material Material { diffuseColor 0.3 0.5 0.9 } } geometry Sphere { radius 0.8 } } }
Transform { translation 1.5 0 -5 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.6 0.2 } } geometry Sphere { radius 0.8 } } }
Transform { translation 0 -2 -2 children Shape { appearance Appearance { material Material { diffuseColor 0.4 0.9 0.4 } } geometry Box { size 1.2 1.2 1.2 } } }
] }
Transform { translation 0 2.2 -3 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.9 0.9 } } geometry Sphere { radius 0.8 } } }
DEF K KeySensor { }
DEF R Script {
  directOutput TRUE
  inputOnly SFString on_key
  inputOutput SFString log ""
  initializeOnly SFNode lf USE LF
  url "javascript:
function on_key (k)
{
   log = log + 'K' + k + ' ';
   if (k == 'a') lf .color = new SFColor (0.2, 0.5, 0.9);
   if (k == 'b') lf .visibilityRange = 11;
   if (k == 'c') lf .fogType = 'EXPONENTIAL';
   if (k == 'd') lf .enabled = false;
   if (k == 'e') lf .enabled = true;
   if (k == 'f') lf .visibilityStart = 2;
}
"
}
ROUTE K.keyPress TO R.on_key
