      vertex 0 0 5
      vertex 1 0 5
      vertex 0 1 5
    endloop
  endfacet
  facet normal 0 0 0
    outer loop
      vertex 1 0 5
      vertex 1 1 5
      vertex 0 1 5
    endloop
  endfacet
endsolid second thing
solid
  facet normal 0 0 -1
    outer loop
      vertex -1 0 0
      vertex 0 -1 0
      vertex 0 0 0
    endloop
  endfacet
