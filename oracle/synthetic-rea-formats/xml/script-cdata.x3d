<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='3.3'>
  <Scene>
    <Transform DEF='Child'/>
    <Script DEF='S1' directOutput='false' mustEvaluate='false'>
      <field name='count' type='SFInt32' accessType='initializeOnly' value='3'/>
      <field name='label' type='SFString' accessType='inputOutput' value='hello'/>
      <field name='in1' type='SFFloat' accessType='inputOnly'/>
      <field name='out1' type='SFFloat' accessType='outputOnly'/>
      <field name='tgt' type='SFNode' accessType='inputOutput'>
        <Transform USE='Child'/>
      </field>
      <![CDATA[ // ecmascript: synthetic body
function initialize ()
{
   out1 = count * 2;
}

function in1 (value, time)
{
   out1 = value + count;
}
]]>
    </Script>
    <Script DEF='S2' url='"javascript:function initialize() { }"'/>
  </Scene>
</X3D>
