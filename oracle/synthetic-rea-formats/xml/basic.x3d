<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 3.3//EN" "http://www.web3d.org/specifications/x3d-3.3.dtd">
<X3D profile='Interchange' version='3.3'>
  <head>
    <meta name='title' content='basic synthetic scene'/>
    <meta name='description' content='newly authored synthetic fixture'/>
  </head>
  <Scene>
    <Transform DEF='Root' translation='1 2 3'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.2 0.4 0.8'/>
        </Appearance>
        <Box size='2 2 2'/>
      </Shape>
    </Transform>
    <Viewpoint description='front' position='0 0 10' orientation='0 1 0 0'/>
  </Scene>
</X3D>
