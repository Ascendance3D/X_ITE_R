#VRML V2.0 utf8
# Synthetic X10 sensor test world (authored for this lane, no historical content).
WorldInfo { title "x10 sensors" }
NavigationInfo { type [ "NONE" ] }
Viewpoint { position 0 0 12 description "front" }

# TouchSensor: hit values drive a marker and a TimeSensor start time.
Transform {
  translation -3 1.5 0
  children [
    DEF TOUCH_TS TouchSensor { description "touch me" }
    Shape { appearance Appearance { material Material { diffuseColor 0.8 0.2 0.2 } } geometry Box { size 1.6 1.6 1.6 } }
  ]
}
DEF MARKER Transform {
  translation 0 4 0
  children Shape { appearance Appearance { material DEF MARKER_MAT Material { diffuseColor 1 1 1 } } geometry Sphere { radius 0.15 } }
}
DEF TOUCH_CLOCK TimeSensor { cycleInterval 2 }
ROUTE TOUCH_TS.hitPoint_changed TO MARKER.set_translation
ROUTE TOUCH_TS.hitNormal_changed TO MARKER_MAT.set_diffuseColor
ROUTE TOUCH_TS.touchTime TO TOUCH_CLOCK.set_startTime

# PlaneSensor: translation_changed moves its own box.
DEF PLANE_BOX Transform {
  translation 0 0 0
  children [
    DEF PLANE_PS PlaneSensor { minPosition -2 -2 maxPosition 2 2 autoOffset TRUE }
    Shape { appearance Appearance { material Material { diffuseColor 0.2 0.8 0.2 } } geometry Box { size 1.4 1.4 0.6 } }
  ]
}
ROUTE PLANE_PS.translation_changed TO PLANE_BOX.set_translation

# CylinderSensor
DEF CYL_BOX Transform {
  translation 3 1.5 0
  children [
    DEF CYL_CS CylinderSensor { maxAngle 6 minAngle -6 }
    Shape { appearance Appearance { material Material { diffuseColor 0.2 0.3 0.9 } } geometry Cylinder { radius 0.9 height 1.6 } }
  ]
}
ROUTE CYL_CS.rotation_changed TO CYL_BOX.set_rotation

# SphereSensor
DEF SPH_BOX Transform {
  translation 3 -2.5 0
  children [
    DEF SPH_SS SphereSensor { }
    Shape { appearance Appearance { material Material { diffuseColor 0.9 0.8 0.2 } } geometry Sphere { radius 1 } }
  ]
}
ROUTE SPH_SS.rotation_changed TO SPH_BOX.set_rotation
