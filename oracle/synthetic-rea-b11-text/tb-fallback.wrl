#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "tb fallback"
Shape { geometry DEF T1 Text { string [ "ab", "c" ] } }
DEF P Script {
  inputOutput MFString out [ ]

  url "ecmascript:

var R_ = [];
function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
function show (v, d) {
  if (typeof v === 'number') return Object.is (v, -0) ? 'n:-0' : 'n:' + v;
  if (typeof v === 'string') return 's:' + JSON.stringify (strip (v));
  if (v === null || v === undefined) return String (v);
  if (typeof v === 'function') return 'fn';
  if (typeof v === 'boolean') return 'b:' + v;
  if (Array.isArray (v)) return 'A[' + v .map (function (x) { return show (x); }) .join (',') + ']';
  var c = v .constructor;
  return (c && c .name || '?') + ':' + String (v) + raw (v);
}
// The components of a field object at full double precision (String () rounds floats).
function raw (v) {
  if (typeof v .getTypeName !== 'function' || !v [Symbol .iterator] || v .getTypeName () .indexOf ('MF') === 0 && !v .length) return '';
  try { var a = Array .from (v, function (x) { return typeof x === 'object' && x && x [Symbol .iterator] ? '(' + Array .from (x, function (y) { return typeof y === 'object' && y && y [Symbol .iterator] ? '(' + Array .from (y) .join (' ') + ')' : y; }) .join (' ') + ')' : x; }); return ' raw=' + a .join (' '); } catch (e) { return ' raw=ERR'; }
}
function errText (e) {
  var n = e && e .name;
  if (n === 'TypeError' || n === 'ReferenceError' || n === 'SyntaxError') return 'ERR ' + n + ' (engine wording)';
  return 'ERR ' + n + ': ' + strip (e && e .message);
}
function T (n, f) {
  var r;
  try { r = show (f ()); } catch (e) { r = errText (e); }
  R_ .push ((R_ .length < 10 ? '00' : R_ .length < 100 ? '0' : '') + R_ .length + ' ' + n + ' = ' + r);
}
function flush_ () { out = new MFString (... R_); }

var SELF;

var F_ = 0, LOG = [];
function watch (name, n) {
  [\"origin\", \"textBounds\", \"lineBounds\", \"string\", \"length\", \"maxExtent\", \"fontStyle\"] .forEach (function (f) { n .addFieldCallback ('w', f, function (v) { LOG .push ('F' + F_ + ' ' + name + '.' + f + '=' + String (v) .replace (/\\\\s+/g, ' ')); }); });
}

function initialize () {
  SELF = this;

  flush_ ();
}
function prepareEvents () {
  ++ F_;
  if (F_ === 10) { watch ('T1', Browser .currentScene .getNamedNode ('T1')); }
  if (F_ === 12) { var t = Browser .currentScene .getNamedNode ('T1'); var f = Browser .currentScene .createNode ('FontStyle'); f .family = new MFString ('NOSUCH'); t .fontStyle = f; }
  if (F_ === 16) { var t = Browser .currentScene .getNamedNode ('T1'); t .fontStyle .family = new MFString ('NOSUCH', 'SANS'); }
  if (F_ === 20) { var t = Browser .currentScene .getNamedNode ('T1'); t .fontStyle .family = new MFString ('NOSUCH2', 'TYPEWRITER'); t .fontStyle .style = 'BOLD'; }
  if (F_ === 24) { var t = Browser .currentScene .getNamedNode ('T1'); t .fontStyle .family = new MFString (); }
  if (F_ === 28) { var t = Browser .currentScene .getNamedNode ('T1'); t .fontStyle .family = new MFString ('sans'); }
  if (F_ === 32) { var t = Browser .currentScene .getNamedNode ('T1'); t .fontStyle .family = new MFString ('NOSUCH', 'ALSO_MISSING'); t .fontStyle .style = 'NOSUCHSTYLE'; }
  if (F_ === 36) { var t = Browser .currentScene .getNamedNode ('T1'); t .fontStyle .style = 'ITALIC'; t .fontStyle .family = new MFString ('SERIF'); }
  if (F_ === 42) { T ('log', function () { return LOG; }); flush_ (); }
}

  "
}
