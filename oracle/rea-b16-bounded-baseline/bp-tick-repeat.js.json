 "vrmlLoad": "#X3D V4.1 utf8 X_ITE V16.5.0\n\nPROFILE Full\n\nCOMPONENT ParticleSystems : 2\n\nDEF PS ParticleSystem {\n  geometryType \"POINT\"\n  maxParticles 4\n  particleLifetime 2.5\n  lifetimeVariation 0\n  emitter PointEmitter {\n    position 0.3 2 -0.2\n    direction 0 -1 0\n    speed 3\n    variation 0\n  }\n  physics DEF BM BoundedPhysicsModel {\n    damping 0.5\n    geometry IndexedFaceSet {\n      solid FALSE\n      coordIndex [\n        0,\n        3,\n        2,\n        1,\n        -1\n      ]\n      coord DEF CO Coordinate {\n        point [\n          -1 0 -1,\n          1 0 -1,\n          1 0 1,\n          -1 0 1\n        ]\n      }\n    }\n  }\n}\n\nDEF TS TimeSensor {\n  loop TRUE\n  startTime 1\n}\n\nDEF SW Script {\n  inputOnly      SFTime  tick\n  initializeOnly SFInt32 n 9\n  initializeOnly SFBool  done FALSE\n  inputOutput    SFNode  co USE CO\n\n  url \"ecmascript: function tick (value) { n = n + 1; if (n % 12 == 0) { done = !done; y = done ? 0.5 : 0; co .point = new MFVec3f (new SFVec3f (-1, y, -1), new SFVec3f (1, y, -1), new SFVec3f (1, y, 1), new SFVec3f (-1, y, 1)); } }\"\n  directOutput TRUE\n}\n\nROUTE TS.time TO SW.tick\n",
