#X3D V4.0 utf8
PROFILE Immersive
COMPONENT Layering:1
COMPONENT Scripting:1
# REA gravity/layers oracle world (generated by oracle/tools/gen_rea_gravity_layers.py).
NavigationInfo { type [ "WALK" ] avatarSize [ 0.25 1.6 0.75 ] speed 4  }
Viewpoint { position 0 1 12 description "layer 0" }
Transform { translation 0 -0.1 0 children Shape { appearance Appearance { material Material { diffuseColor 0.4 0.4 0.4 } } geometry Box { size 40 0.2 40 } } }
DEF COL0 Collision { children [ Transform { translation 0.8 5 12 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.3 0.3 } } geometry Box { size 1 12 1 } } } ] }
Collision { children [ Transform { translation 0 5 7 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.3 0.3 } } geometry Box { size 12 10 0.4 } } } ] }
DEF LS LayerSet { activeLayer 1 order [ 0 1 2 ] layers [
  DEF L1 Layer { children [
    NavigationInfo { type [ "WALK" ] avatarSize [ 0.25 1.6 0.75 ] speed 4  }
    Viewpoint { position 0 6 12 description "layer 1" }
    Transform { translation 0 1.9 0 children Shape { appearance Appearance { material Material { diffuseColor 0.3 0.5 0.3 } } geometry Box { size 40 0.2 40 } } }
    DEF COL1 Collision { children [ Transform { translation 0.8 5 12 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.3 0.3 } } geometry Box { size 1 12 1 } } } ] }
    Collision { children [ Transform { translation 0 5 2 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.3 0.3 } } geometry Box { size 12 10 0.4 } } } ] }
  ] }
  DEF L2 Layer { children [
    NavigationInfo { type [ "WALK" ] avatarSize [ 0.25 3 0.75 ] speed 4  }
    Viewpoint { position 0 9 12 description "layer 2" }
    Transform { translation 0 -1.1 0 children Shape { appearance Appearance { material Material { diffuseColor 0.3 0.3 0.5 } } geometry Box { size 40 0.2 40 } } }
    DEF COL2 Collision { children [ Transform { translation 0.8 5 12 children Shape { appearance Appearance { material Material { diffuseColor 0.8 0.3 0.3 } } geometry Box { size 1 12 1 } } } ] }
  ] }
] }
DEF INFO WorldInfo { title "gravity layers" info [ "s=000 n=000" ] }
DEF W Script {
  directOutput TRUE
  inputOnly SFTime tick
  inputOnly SFBool a0
  inputOnly SFBool a1
  inputOnly SFBool a2
  initializeOnly SFNode ls USE LS
  initializeOnly SFNode info USE INFO
  url "ecmascript:
var s = [ 0, 0, 0 ], n = [ 0, 0, 0 ], first = -1, next = 0, plan = [];
function show () { info .info = new MFString ('s=' + s [0] + s [1] + s [2] + ' n=' + n [0] + n [1] + n [2]); }
function a0 (v) { s [0] = v ? 1 : 0; n [0] += 1; show (); }
function a1 (v) { s [1] = v ? 1 : 0; n [1] += 1; show (); }
function a2 (v) { s [2] = v ? 1 : 0; n [2] += 1; show (); }
function tick (value)
{
   if (first < 0) first = value;
   var e = value - first;
   while (next < plan .length && e >= plan [next][0] - 1e-6) { ls .activeLayer = plan [next][1]; ++ next; }
}
"
}
ROUTE COL0.isActive TO W.a0
ROUTE COL1.isActive TO W.a1
ROUTE COL2.isActive TO W.a2
