  DEF L1 Layer { children [
    NavigationInfo { type [ "WALK" ] avatarSize [ 0.25 1.6 0.75 ] speed 4 transitionType [ "LINEAR" ] transitionTime 2 }
    Viewpoint { position 0 1.6 12 description "A ground" }
    Viewpoint { position 0 6 0 description "B air" }
