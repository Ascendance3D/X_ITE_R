  inputOnly SFBool a0
  initializeOnly SFNode info USE INFO
  url "ecmascript:
var n = 0;
function a0 (v) { n += 1; info .info = new MFString ('s=' + (v ? 1 : 0) + ' n=' + n); }
"
}
