#X3D V4.1 utf8
PROFILE Full
META "title" "cff-sr-vertical"
DEF L1 FontLibrary { family "CffLib" url "../synthetic-rea-b24-cff/cff-basic.otf" }
Transform { translation -3 0 0 children Shape { geometry Text { string [ "BO" "Si" ] fontStyle ScreenFontStyle { family "CffLib" pointSize 36 horizontal FALSE } } } }
Transform { translation 3 0 0 children Shape { geometry Text { string [ "BOSi" ] length [ 5 ] maxExtent 4 fontStyle ScreenFontStyle { family "CffLib" pointSize 36 } } } }
