#X3D V4.1 utf8
PROFILE Full
META "title" "cff-sr-sizes"
DEF L1 FontLibrary { family "CffLib" url "../synthetic-rea-b24-cff/cff-basic.otf" }
Transform { translation -4 3 0 children Shape { geometry Text { string [ "BOSi" ] fontStyle ScreenFontStyle { family "CffLib" pointSize 16 } } } }
Transform { translation -4 1 0 children Shape { geometry Text { string [ "BOSi" ] fontStyle ScreenFontStyle { family "CffLib" pointSize 32 } } } }
Transform { translation -4 -1.5 0 children Shape { geometry Text { string [ "BOSi" ] fontStyle ScreenFontStyle { family "CffLib" pointSize 48 } } } }
