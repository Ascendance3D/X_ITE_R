#X3D V3.3 utf8
PROFILE Full
Viewpoint { position 0 0 8 }
DEF T Transform { children [
Shape { appearance Appearance { material Material { diffuseColor 1 0.5 0 } texture ImageTexture { url "tex.png" repeatS FALSE repeatT FALSE } } geometry Box { size 1.2 1.2 1.2 } }
Transform { translation 1.8 0 0 children Shape { appearance Appearance { material Material {} texture PixelTexture { image 2 2 3 0xff0000 0x00ff00 0x0000ff 0xffff00 } } geometry Sphere { radius 0.6 } } }
Inline { url "sub.x3dv" } ] }
DEF TS TimeSensor { loop TRUE cycleInterval 1 }
DEF S Script { eventIn SFFloat f eventOut SFVec3f p eventOut SFRotation r
url "ecmascript: var count = 0; var hist = []; function f(v) { count++; hist.push(count); p = new SFVec3f(Math.sin(count*0.31), Math.cos(count*0.31)*0.5, 0); r = new SFRotation(0,1,0,count*0.31); if (count % 10 == 0) print('A ' + count + ' ' + hist.length); }" }
ROUTE TS.fraction_changed TO S.f
ROUTE S.p TO T.set_translation
ROUTE S.r TO T.set_rotation
