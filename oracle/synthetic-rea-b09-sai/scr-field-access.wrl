  T ('this.getFieldDefinitions names', function () { return Array .from (SELF .getFieldDefinitions (), function (d) { return d .name + '/' + d .accessType + '/' + d .dataType; }); });
  T ('this.io', function () { return SELF .io; });
  T ('this.io_changed', function () { return SELF .io_changed; });
  T ('this.set_io', function () { return SELF .set_io; });
  T ('this.evIn', function () { return SELF .evIn; });
  T ('this.evOut', function () { return SELF .evOut; });
  T ('this.init', function () { return SELF .init; });
  T ('this.io = ', function () { SELF .io = 21; return io + ':' + SELF .io; });
  T ('this.evIn =', function () { SELF .evIn = 22; return SELF .evIn; });
  T ('this.nonexistent', function () { return SELF .nonexistent; });
  T ('this.nonexistent =', function () { SELF .nonexistent = 3; return SELF .nonexistent; });
  T ('this.getField io', function () { var f = SELF .getField ('io'); return f .getName () + '/' + f .getType () + '/' + f .getAccessType () + '/' + f .getValue (); });
  T ('this.getField evIn', function () { var f = SELF .getField ('evIn'); return f .getName () + '/' + f .getType () + '/' + f .getAccessType (); });
  T ('this.getField evOut', function () { var f = SELF .getField ('evOut'); return f .getName () + '/' + f .getAccessType (); });
