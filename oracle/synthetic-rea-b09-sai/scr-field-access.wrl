  T ('ioM same object', function () { return ioM === ioM; });
  T ('ioV vs ioV_changed', function () { return ioV === ioV_changed; });
  T ('write evOut', function () { evOut = 3; return evOut; });
  T ('write evOutV', function () { evOutV = new SFVec3f (1, 2, 3); return evOutV; });
  T ('write evOutV member', function () { evOutV .x = 9; return evOutV; });
  T ('write evOutM', function () { evOutM = new MFInt32 (1, 2, 3); return evOutM; });
  T ('write evOutM array', function () { evOutM = [4, 5]; return evOutM; });
  T ('write init', function () { init = 8; return init; });
  T ('write io', function () { io = 9; return io; });
