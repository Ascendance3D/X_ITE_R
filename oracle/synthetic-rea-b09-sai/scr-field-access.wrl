  T ('io = big', function () { io = 1e40; return io; });
  T ('ioD = 0.1', function () { ioD = 0.1; return ioD; });
  T ('ioI = 3.7', function () { ioI = 3.7; return ioI; });
  T ('ioI = -3.7', function () { ioI = -3.7; return ioI; });
