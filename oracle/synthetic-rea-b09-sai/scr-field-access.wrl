  T ('ioB = null', function () { ioB = null; return ioB; });
  T ('ioB = {}', function () { ioB = {}; return ioB; });
  T (\"ioT = '4'\", function () { ioT = '4'; return ioT; });
  T ('ioT = null', function () { ioT = null; return ioT; });
  T ('ioT = Date', function () { ioT = 1.5; return ioT; });
  T ('ioN = null', function () { ioN = null; return ioN; });
  T ('ioN = this', function () { ioN = SELF; return ioN === SELF; });
  T ('ioN = number', function () { ioN = 5; return ioN; });
  T ('ioN = {}', function () { ioN = {}; return ioN; });
  T ('ioN = undefined', function () { ioN = undefined; return ioN; });
  T ('ioN = SFVec3f', function () { ioN = new SFVec3f (); return ioN; });
  T ('ioN = NULL', function () { ioN = NULL; return ioN; });
  T ('ioMN = [this]', function () { ioMN = [SELF]; return ioMN .length; });
  T ('ioMN = [null]', function () { ioMN = [null]; return ioMN .length + ':' + ioMN [0]; });
  T ('ioMN = [1]', function () { ioMN = [1]; return ioMN .length; });
  T ('ioMN = this', function () { ioMN = SELF; return ioMN; });
  T ('ioMN = new MFNode', function () { ioMN = new MFNode (SELF, SELF); return ioMN .length + ':' + (ioMN [0] === SELF); });
  T ('ioMV = [SFVec3f]', function () { ioMV = [new SFVec3f (1, 2, 3), new SFVec3f (4, 5, 6)]; return ioMV; });
  T ('ioMV = [arrays]', function () { ioMV = [[1, 2, 3]]; return ioMV; });
  T ('ioMV = [1,2,3]', function () { ioMV = [1, 2, 3]; return ioMV; });
  T ('ioMV = [SFVec2f]', function () { ioMV = [new SFVec2f (1, 2)]; return ioMV; });
  T ('ioMV [0] member', function () { ioMV = [new SFVec3f (1, 2, 3)]; ioMV [0] .x = 9; return ioMV; });
  T ('ioMV [0] replace', function () { ioMV [0] = new SFVec3f (5, 5, 5); return ioMV; });
  T ('ioMV [3] gap', function () { ioMV [3] = new SFVec3f (7, 7, 7); return ioMV; });
  T ('ioMV length', function () { return ioMV .length; });
  T ('ioMS = [1, null]', function () { ioMS = [1, null, undefined, true, 'x']; return ioMS; });
  T (\"ioMS = 'abc'\", function () { ioMS = 'abc'; return ioMS; });
  T ('ioMS = new MFString', function () { ioMS = new MFString ('a', 'b'); return ioMS; });
  T ('ioMS toString', function () { return String (ioMS); });
  T ('ioMS join', function () { return ioMS .join ('+'); });
  T ('ioR = SFVec4', function () { ioR = new SFVec4f (0, 0, 1, 1); return ioR; });
