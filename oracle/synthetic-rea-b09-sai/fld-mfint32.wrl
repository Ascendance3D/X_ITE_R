  inputOutput MFString out [ ]

  url "ecmascript:

var R_ = [];
function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
function show (v, d) {
  if (typeof v === 'number') return Object.is (v, -0) ? 'n:-0' : 'n:' + v;
  if (typeof v === 'string') return 's:' + JSON.stringify (strip (v));
  if (v === null || v === undefined) return String (v);
  if (typeof v === 'function') return 'fn';
  if (typeof v === 'boolean') return 'b:' + v;
  if (Array.isArray (v)) return 'A[' + v .map (function (x) { return show (x); }) .join (',') + ']';
  var c = v .constructor;
  return (c && c .name || '?') + ':' + String (v) + raw (v);
}
// The components of a field object at full double precision (String () rounds floats).
function raw (v) {
  if (typeof v .getTypeName !== 'function' || !v [Symbol .iterator] || v .getTypeName () .indexOf ('MF') === 0 && !v .length) return '';
  try { var a = Array .from (v, function (x) { return typeof x === 'object' && x && x [Symbol .iterator] ? '(' + Array .from (x, function (y) { return typeof y === 'object' && y && y [Symbol .iterator] ? '(' + Array .from (y) .join (' ') + ')' : y; }) .join (' ') + ')' : x; }); return ' raw=' + a .join (' '); } catch (e) { return ' raw=ERR'; }
}
function errText (e) {
  var n = e && e .name;
  if (n === 'TypeError' || n === 'ReferenceError' || n === 'SyntaxError') return 'ERR ' + n + ' (engine wording)';
  return 'ERR ' + n + ': ' + strip (e && e .message);
}
function T (n, f) {
  var r;
  try { r = show (f ()); } catch (e) { r = errText (e); }
  R_ .push ((R_ .length < 10 ? '00' : R_ .length < 100 ? '0' : '') + R_ .length + ' ' + n + ' = ' + r);
}
function flush_ () { out = new MFString (... R_); }

var SELF;

function initialize () {
  SELF = this;
  T ('MFInt32 new ()', function () { return new MFInt32 (); });
  T ('MFInt32 new (elems)', function () { return new MFInt32 (1, 2, 3.7); });
  T ('MFInt32 length', function () { var m = new MFInt32 (1, 2, 3.7); return [m .length, new MFInt32 () .length]; });
  T ('MFInt32 index', function () { var m = new MFInt32 (1, 2, 3.7); return [m [0], m [2], m [3], m [-1], m ['1'], m [1.5], m .nope]; });
  T ('MFInt32 index write', function () { var m = new MFInt32 (1, 2, 3.7); m [1] = -4; return [m, m .length]; });
  T ('MFInt32 index write past end', function () { var m = new MFInt32 (1, 2, 3.7); m [5] = -4; return [m, m .length]; });
  T ('MFInt32 length set', function () { var m = new MFInt32 (1, 2, 3.7); m .length = 1; var n = new MFInt32 (1, 2, 3.7); n .length = 5; var o = new MFInt32 (1, 2, 3.7); o .length = 0; return [m, n, o]; });
  T ('MFInt32 length set bad', function () { var m = new MFInt32 (1, 2, 3.7); m .length = -1; return m .length; });
  T ('MFInt32 keys', function () { var m = new MFInt32 (1, 2, 3.7); return [Object .keys (m), JSON .stringify (m), Array .from (m) .length, [... m] .length, Array .isArray (m), typeof m, m instanceof X3DArrayField]; });
  T ('MFInt32 for in', function () { var o = []; for (var k in new MFInt32 (1, 2, 3.7)) o .push (k); return o; });
  T ('MFInt32 toStrings', function () { var m = new MFInt32 (1, 2, 3.7); return [m .toString (), m .toVRMLString (), m .toXMLString (), m .toJSONString ()]; });
  T ('MFInt32 toStrings empty', function () { var m = new MFInt32 (); return [m .toString (), m .toVRMLString (), m .toXMLString (), m .toJSONString ()]; });
  T ('MFInt32 push', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .push (-4); var q = m .push (1, 2); return [r, q, m]; });
  T ('MFInt32 push none', function () { var m = new MFInt32 (1, 2, 3.7); return [m .push (), m .length]; });
  T ('MFInt32 pop', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .pop (); var e = new MFInt32 () .pop (); return [r, e, m, m .length]; });
  T ('MFInt32 shift', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .shift (); var e = new MFInt32 () .shift (); return [r, e, m, m .length]; });
  T ('MFInt32 unshift', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .unshift (-4, -4); return [r, m]; });
  T ('MFInt32 splice', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .splice (1, 1); return [r, m, m .length]; });
  T ('MFInt32 splice insert', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .splice (1, 0, -4, -4); return [r, m, m .length]; });
  T ('MFInt32 splice neg/over', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .splice (-1); var n = new MFInt32 (1, 2, 3.7); var q = n .splice (1, 100); var o = new MFInt32 (1, 2, 3.7); var u = o .splice (); return [r, m, q, n, u, o]; });
  T ('MFInt32 reverse', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .reverse (); return [r === m, m]; });
  T ('MFInt32 fill', function () { var m = new MFInt32 (1, 2, 3.7); m .fill (-4); var n = new MFInt32 (1, 2, 3.7); n .fill (-4, 1, 2); return [m, n]; });
  T ('MFInt32 concat', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .concat (new MFInt32 (-4)); var q = m .concat ([-4, -4]); var o = m .concat (-4); return [r, q, o, m, r .constructor === m .constructor]; });
  T ('MFInt32 slice', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .slice (1); var q = m .slice (-1); var o = m .slice (0, 2); return [r, q, o, m, r === m, r .constructor === m .constructor]; });
  T ('MFInt32 indexOf', function () { var m = new MFInt32 (1, 2, 3.7); return [m .indexOf (2), m .indexOf (-4), m .includes (2), m .lastIndexOf (1), m .findIndex (function (x) { return true; }), m .find (function (x) { return false; })]; });
  T ('MFInt32 join', function () { var m = new MFInt32 (1, 2, 3.7); return [m .join (), m .join ('-'), m .join ('')]; });
  T ('MFInt32 forEach', function () { var m = new MFInt32 (1, 2, 3.7); var o = []; m .forEach (function (x, i, a) { o .push (i + ':' + (a === m) + ':' + typeof x); }); return o; });
  T ('MFInt32 map', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .map (function (x) { return x; }); return [r, r .constructor .name]; });
  T ('MFInt32 filter', function () { var m = new MFInt32 (1, 2, 3.7); var r = m .filter (function (x, i) { return i != 1; }); return [r, r .length]; });
  T ('MFInt32 reduce', function () { var m = new MFInt32 (1, 2, 3.7); return [m .reduce (function (a, x, i) { return a + i; }, 0), m .every (function () { return true; }, m .some (function () { return false; }))]; });
  T ('MFInt32 sort', function () { var m = new MFInt32 (1, 2, 3.7); m .sort (function (a, b) { return 0; }); return m; });
  T ('MFInt32 at/entries', function () { var m = new MFInt32 (1, 2, 3.7); return [m .at (-1), m .at (5), Array .from (m .keys ()), Array .from (m .entries ()) .length]; });
  T ('MFInt32 equals/copy', function () { var m = new MFInt32 (1, 2, 3.7); var c = m .copy (); return [m .equals (c), m === c, c .length, m .isDefaultValue (), new MFInt32 () .isDefaultValue ()]; });
  T ('MFInt32 copy independent', function () { var m = new MFInt32 (1, 2, 3.7); var c = m .copy (); c [0] = -4; c .push (1); return [m, c]; });
  T ('MFInt32 setValue', function () { var m = new MFInt32 (); m .setValue (new MFInt32 (1, 2, 3.7)); return m; });
  T ('MFInt32 setValue array', function () { var m = new MFInt32 (); m .setValue ([1, 2]); return m; });
  T ('MFInt32 setValue empty', function () { var m = new MFInt32 (1, 2, 3.7); m .setValue ([]); return m; });
  T ('MFInt32 setValue self', function () { var m = new MFInt32 (1, 2, 3.7); m .setValue (m); return m; });
  flush_ ();
}

