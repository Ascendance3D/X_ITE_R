#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "meta nodes"

DEF G Group {
  metadata DEF MS MetadataSet {
    name "root"
    reference "http://example.org/ref"
    value [
      DEF MB MetadataBoolean { name "b" reference "rb" value [ TRUE FALSE TRUE ] }
      DEF MD MetadataDouble { name "d" value [ 1.5 2.25 -0.125 1e300 ] }
      DEF MF MetadataFloat { name "f" value [ 0.1 0.2 3.4e38 ] }
      DEF MI MetadataInteger { name "i" value [ 1 -2 2147483647 ] }
      DEF MST MetadataString { name "s" value [ "hello" "wor\"ld" "" ] }
      DEF MNEST MetadataSet {
        name "nested"
        value [
          DEF MNB MetadataBoolean { name "nb" value TRUE }
          USE MB
          MetadataSet { name "empty" }
        ]
        metadata MetadataString { name "meta of meta" value "m" }
      }
    ]
  }
}
DEF T Transform { metadata USE MS }
DEF W WorldInfo { title "t" metadata MetadataString { name "w" value [ "x" ] } }
DEF P Script {
  inputOutput MFString out [ ]

  url "ecmascript:

var R_ = [];
function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
function show (v, d) {
  if (typeof v === 'number') return Object.is (v, -0) ? 'n:-0' : 'n:' + v;
  if (typeof v === 'string') return 's:' + JSON.stringify (strip (v));
  if (v === null || v === undefined) return String (v);
  if (typeof v === 'function') return 'fn';
  if (typeof v === 'boolean') return 'b:' + v;
  if (Array.isArray (v)) return 'A[' + v .map (function (x) { return show (x); }) .join (',') + ']';
  var c = v .constructor;
  return (c && c .name || '?') + ':' + String (v) + raw (v);
}
// The components of a field object at full double precision (String () rounds floats).
function raw (v) {
  if (typeof v .getTypeName !== 'function' || !v [Symbol .iterator] || v .getTypeName () .indexOf ('MF') === 0 && !v .length) return '';
  try { var a = Array .from (v, function (x) { return typeof x === 'object' && x && x [Symbol .iterator] ? '(' + Array .from (x, function (y) { return typeof y === 'object' && y && y [Symbol .iterator] ? '(' + Array .from (y) .join (' ') + ')' : y; }) .join (' ') + ')' : x; }); return ' raw=' + a .join (' '); } catch (e) { return ' raw=ERR'; }
}
function errText (e) {
  var n = e && e .name;
  if (n === 'TypeError' || n === 'ReferenceError' || n === 'SyntaxError') return 'ERR ' + n + ' (engine wording)';
  return 'ERR ' + n + ': ' + strip (e && e .message);
}
function T (n, f) {
  var r;
  try { r = show (f ()); } catch (e) { r = errText (e); }
  R_ .push ((R_ .length < 10 ? '00' : R_ .length < 100 ? '0' : '') + R_ .length + ' ' + n + ' = ' + r);
}
function flush_ () { out = new MFString (... R_); }

var SELF;
var META_TYPES = ['MetadataBoolean', 'MetadataDouble', 'MetadataFloat', 'MetadataInteger', 'MetadataString', 'MetadataSet'];
function initialize () {
  SELF = this;
  T ('type names', function () { var o = []; ['MB', 'MD', 'MF', 'MI', 'MST', 'MNEST', 'MS', 'MNB'] .forEach (function (n) { var x = Browser .currentScene .getNamedNode (n); o .push (n + ':' + x .getNodeTypeName ()); }); return o; });
  T ('MB fields', function () { var x = Browser .currentScene .getNamedNode ('MB'); return [x .name, x .reference, x .value, x .value .length, x .value [1], x .value .constructor .name, x .metadata]; });
  T ('MD fields', function () { var x = Browser .currentScene .getNamedNode ('MD'); return [x .name, x .reference, x .value, x .value [3], x .value .length]; });
  T ('MF fields', function () { var x = Browser .currentScene .getNamedNode ('MF'); return [x .value [0], x .value [1], x .value [2]]; });
  T ('MI fields', function () { var x = Browser .currentScene .getNamedNode ('MI'); return [x .value [0], x .value [1], x .value [2]]; });
  T ('MST fields', function () { var x = Browser .currentScene .getNamedNode ('MST'); return [x .value [0], x .value [1], x .value [2], x .value .length]; });
  T ('MS fields', function () { var x = Browser .currentScene .getNamedNode ('MS'); return [x .name, x .reference, x .value .length, x .value [0] .getNodeTypeName (), x .value [5] .getNodeName (), x .value .constructor .name]; });
  T ('MNEST value', function () { var x = Browser .currentScene .getNamedNode ('MNEST'); return [x .value .length, x .value [0] .getNodeName (), x .value [1] .getNodeName (), x .value [1] === Browser .currentScene .getNamedNode ('MB'), x .value [2] .name, x .metadata .name, x .metadata .value]; });
  T ('MNB single value', function () { return Browser .currentScene .getNamedNode ('MNB') .value; });
  T ('T.metadata', function () { var x = Browser .currentScene .getNamedNode ('T'); return [x .metadata === Browser .currentScene .getNamedNode ('MS'), x .metadata .name]; });
  T ('W.metadata', function () { var x = Browser .currentScene .getNamedNode ('W'); return [x .metadata .getNodeTypeName (), x .metadata .name, x .metadata .value, x .title]; });
  T ('G.metadata', function () { var x = Browser .currentScene .getNamedNode ('G'); return x .metadata .value .length; });
  T ('field defs', function () { var o = []; META_TYPES .forEach (function (n) { var x = Browser .currentScene .createNode (n); o .push (n + ':' + Array .from (x .getFieldDefinitions (), function (d) { return d .name + '/' + d .accessType + '/' + d .dataType; }) .join (',')); }); return o; });
  T ('defaults', function () { var o = []; META_TYPES .forEach (function (n) { var x = Browser .currentScene .createNode (n); o .push (n + ':' + [JSON .stringify (x .name), JSON .stringify (x .reference), x .value .length, x .metadata].join ('|')); }); return o; });
  T ('toString defaults', function () { var o = []; META_TYPES .forEach (function (n) { var x = Browser .currentScene .createNode (n); o .push (x .toString () + '/' + x .toVRMLString () .replace (/\\s+/g, ' ')); }); return o; });
  T ('xml defaults', function () { var o = []; META_TYPES .forEach (function (n) { var x = Browser .currentScene .createNode (n); o .push (x .toXMLString () .replace (/\\s+/g, ' ')); }); return o; });
  T ('json defaults', function () { var o = []; META_TYPES .forEach (function (n) { var x = Browser .currentScene .createNode (n); o .push (x .toJSONString () .replace (/\\s+/g, ' ')); }); return o; });
  T ('xml MS', function () { return Browser .currentScene .getNamedNode ('MS') .toXMLString (); });
  T ('json MS', function () { return Browser .currentScene .getNamedNode ('MS') .toJSONString (); });
  T ('vrml MS', function () { return Browser .currentScene .getNamedNode ('MS') .toVRMLString (); });
  T ('vrml T', function () { return Browser .currentScene .getNamedNode ('T') .toVRMLString (); });
  T ('xml T', function () { return Browser .currentScene .getNamedNode ('T') .toXMLString (); });
  T ('set MB.value array', function () { var x = Browser .currentScene .getNamedNode ('MB'); x .value = [true, false]; return [x .value, x .value .length]; });
  T ('set MB.value numbers', function () { var x = Browser .currentScene .getNamedNode ('MB'); x .value = [0, 1, 2, -1, NaN]; return x .value; });
  T ('set MB.value new MFBool', function () { var x = Browser .currentScene .getNamedNode ('MB'); x .value = new MFBool (true, false); return x .value; });
  T ('MB push', function () { var x = Browser .currentScene .getNamedNode ('MB'); x .value .push (true, 0, 'x'); return x .value; });
  T ('set MD.value', function () { var x = Browser .currentScene .getNamedNode ('MD'); x .value = [0.1, 1/3, NaN, Infinity, -0]; return x .value; });
  T ('set MF.value', function () { var x = Browser .currentScene .getNamedNode ('MF'); x .value = [0.1, 1/3, 1e39, -1e-50]; return x .value; });
  T ('set MI.value', function () { var x = Browser .currentScene .getNamedNode ('MI'); x .value = [1.9, -1.9, 4294967296, 2147483648, '12', 'x', null, true]; return x .value; });
  T ('set MST.value', function () { var x = Browser .currentScene .getNamedNode ('MST'); x .value = ['a', 1, null, undefined, true, {}]; return x .value; });
  T ('set MST.value single', function () { var x = Browser .currentScene .getNamedNode ('MST'); x .value = new MFString ('only'); return [x .value, x .value .length]; });
  T ('set name', function () { var x = Browser .currentScene .getNamedNode ('MB'); x .name = 'renamed'; x .reference = 5; return [x .name, x .reference, x .getNodeName ()]; });
  T ('set name undefined', function () { var x = Browser .currentScene .getNamedNode ('MB'); x .name = undefined; return JSON .stringify (x .name); });
  T ('MS.value reassign', function () { var x = Browser .currentScene .getNamedNode ('MS'); var a = x .value [0]; x .value = [x .value [1], a]; return [x .value .length, x .value [0] .name, x .value [1] .name]; });
  T ('MS.value push new', function () { var x = Browser .currentScene .getNamedNode ('MS'); var n = Browser .createVrmlFromString ('MetadataInteger { name \"pushed\" value 5 }') [0]; x .value .push (n); return [x .value .length, x .value [x .value .length - 1] .name, x .value [x .value .length - 1] .value]; });
  T ('MS.value non-metadata node', function () { var x = Browser .currentScene .getNamedNode ('MS'); var n = Browser .currentScene .getNamedNode ('T'); x .value .push (n); return [x .value .length, x .value [x .value .length - 1] .getNodeTypeName ()]; });
  T ('MS.value null', function () { var x = Browser .currentScene .getNamedNode ('MS'); x .value .push (null); return [x .value .length, x .value [x .value .length - 1]]; });
  T ('MS.value remove', function () { var x = Browser .currentScene .getNamedNode ('MS'); x .value .length = 2; return [x .value .length, x .value [1] .name]; });
  T ('MS.value clear', function () { var x = Browser .currentScene .getNamedNode ('MS'); x .value = []; return x .value .length; });
  T ('cycle', function () { var x = Browser .currentScene .getNamedNode ('MNEST'); x .value .push (x); return [x .value .length, x .value [x .value .length - 1] === x]; });
  T ('cycle print', function () { return Browser .currentScene .getNamedNode ('MNEST') .toVRMLString () .length > 0; });
  T ('scene print', function () { return Browser .currentScene .toVRMLString () .length; });
  T ('T.metadata = other', function () { var x = Browser .currentScene .getNamedNode ('T'); x .metadata = Browser .currentScene .getNamedNode ('MST'); return [x .metadata .name, x .metadata === Browser .currentScene .getNamedNode ('MST')]; });
  T ('T.metadata = Transform', function () { var x = Browser .currentScene .getNamedNode ('T'); x .metadata = Browser .currentScene .getNamedNode ('G'); return x .metadata .getNodeTypeName (); });
  T ('T.metadata = null', function () { var x = Browser .currentScene .getNamedNode ('T'); x .metadata = null; return x .metadata; });
  T ('new MetadataString via createVrml', function () { var n = Browser .createVrmlFromString ('MetadataString { name \"n\" value [\"a\" \"b\"] }') [0]; return [n .name, n .value .length, n .getNodeTypeName (), n .toString ()]; });
  T ('createVrml with metadata', function () { var n = Browser .createVrmlFromString ('Group { metadata MetadataSet { name \"k\" value MetadataBoolean { name \"z\" value TRUE } } }') [0]; return [n .metadata .name, n .metadata .value .length, n .metadata .value [0] .value]; });
  T ('createX3D with metadata 3.3', function () { var s = Browser .createX3DFromString ? 1 : 0; return s; });
  T ('MetadataReference option', function () { return typeof Browser .getBrowserOption ('MetadataReference'); });
  T ('MetadataReference value', function () { return JSON .stringify (Browser .getBrowserOption ('MetadataReference')); });
  T ('scene setMetaData string', function () { var s = Browser .currentScene; s .setMetaData ('t/k', 'v'); return [s .getMetaData ('t/k'), s .getMetaDatas () .length]; });
  T ('this.metadata', function () { return SELF .metadata; });
  T ('getField metadata', function () { return SELF .getField ('metadata') .getTypeName (); });
  T ('USE count', function () { var s = Browser .currentScene; return s .getNamedNode ('MS') === s .getNamedNode ('T') .metadata; });
  T ('name conflicts', function () { var n = Browser .createVrmlFromString ('DEF MB MetadataBoolean { }'); return [n .length, n [0] .getNodeName ()]; });
  flush_ ();
}

  "
}
