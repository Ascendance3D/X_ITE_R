#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
# Synthetic REA oracle world: scripted scenes (Browser.createScene, importJS, importDocument) and what a scene made by a script
# can do: nodes, names, exports, serialization. Results are listed in the order the probes started. Authored.
DEF HOLD Group { }
DEF OUT Script {
  inputOutput SFString hist ""
  inputOutput SFInt32 step 0
  inputOnly SFTime cycle
  url "ecmascript:
    var slots = [], vals = { };
    function show () { hist = slots .map (function (n) { return n + '=' + (n in vals ? vals [n] : '...'); }) .join (' '); }
    function rec (name, v) { vals [name] = v; show (); }
    function p (name, f) {
      var v;
      slots .push (name);
      try { v = f (); } catch (e) { v = 'ERR:' + e .message; }
      if (v && typeof v .then === 'function')
        v .then (function (r) { rec (name, 'ok:' + r); }, function (e) { rec (name, 'REJ:' + (e && e .message .replace (/https?:\\/\\/[^\\/]+\\//g, ''))); });
      else
        rec (name, v);
    }
    function desc (s) {
      var c = ''; for (var i = 0; i < s .components .length; ++ i) c += s .components [i] .name + ':' + s .components [i] .level + ';';
      return [s .isScene, s .encoding, s .profile && s .profile .name, s .specificationVersion, s .rootNodes .length, c, s .units .length, s .getTypeName ()] .join ('/');
    }
    var made = null, imported = null;
    function cycle (v) {
      step = step + 1;
      var s = Browser .currentScene;
      if (step == 1) {
        p ('csNone', function () { return Browser .createScene () .then (function (sc) { made = sc; return desc (sc); }); });
        p ('csProfile', function () { return Browser .createScene (Browser .getProfile ('Interchange')) .then (desc); });
        p ('csProfileComp', function () { return Browser .createScene (Browser .getProfile ('Interchange'), Browser .getComponent ('Scripting', 1), Browser .getComponent ('Navigation', 2)) .then (desc); });
        p ('csBadProfile', function () { return Browser .createScene ('Full') .then (desc); });
        p ('csBadComponent', function () { return Browser .createScene (Browser .getProfile ('Full'), 'Scripting') .then (desc); });
        p ('csRetType', function () { var r = Browser .createScene (); return typeof r + ':' + (r instanceof Promise); });
        p ('jsObj', function () { return Browser .importJS ({ X3D: { '@profile': 'Immersive', '@version': '4.0', Scene: { '-children': [{ Group: { '@DEF': 'J1', '-children': [{ Transform: { '@translation': '1 2 3' } }] } }] } } }) .then (function (sc) { imported = sc; return desc (sc); }); });
        p ('jsStr', function () { return Browser .importJS ('{\"X3D\":{\"@profile\":\"Core\",\"@version\":\"3.3\",\"head\":{\"meta\":[{\"@name\":\"k\",\"@content\":\"v\"}]},\"Scene\":{\"-children\":[{\"WorldInfo\":{\"@title\":\"t\"}}]}}}') .then (desc); });
        p ('docRej', function () { return typeof Browser .importDocument; });
      }
      if (step == 5) {
        p ('madeNode', function () { var t = made .createNode ('Transform'); t .translation = new SFVec3f (1, 2, 3); made .addRootNode (t); made .addNamedNode ('MT', t); return made .rootNodes .length + ':' + made .getNamedNode ('MT') .translation; });
        p ('madeNodeUnknownComp', function () { var n = made .createNode ('Sound'); return n .getNodeTypeName (); });
        p ('madeProfileNull', function () { return made .profile === null; });
        p ('madeVrml', function () { return made .toVRMLString (); });
        p ('madeXml', function () { return made .toXMLString (); });
        p ('madeJson', function () { return made .toJSONString (); });
        p ('madeMeta', function () { made .setMetaData ('a', 'b'); made .addMetaData ('a', ['c', 'd']); var m = made .getMetaData ('a'); return m .length + ':' + m .join (','); });
        p ('madeUnit', function () { return made .getUnit ('length') .name + ':' + made .fromUnit ('length', 2) + ':' + made .toUnit ('angle', 3); });
        p ('madeComp', function () { made .addComponent (Browser .getComponent ('Geospatial', 1)); return made .hasComponent ('Geospatial') + ':' + made .components .length; });
        p ('madeRoute', function () { var a = made .createNode ('TimeSensor'), b = made .createNode ('Group'); made .addNamedNode ('A', a); made .addNamedNode ('B', b); made .addRoute (a, 'isActive', made .createNode ('Script'), 'metadata'); return made .routes .length; });
        p ('madeVrml2', function () { return made .toVRMLString (); });
        p ('madeExport', function () { made .addExportedNode ('EXA', made .getNamedNode ('MT')); return made .exportedNodes .length + ':' + made .getExportedNode ('EXA') .getNodeTypeName (); });
        p ('impVrml', function () { return imported .toVRMLString (); });
        p ('impXml', function () { return imported .toXMLString (); });
        p ('impJson', function () { return imported .toJSONString (); });
        p ('impNamed', function () { return imported .getNamedNode ('J1') .getNodeTypeName () + ':' + imported .rootNodes [0] .children [0] .translation; });
        p ('impMeta', function () { return imported .getMetaDatas () .length; });
      }
      if (step == 8) {
        p ('moveNode', function () { var n = made .getNamedNode ('MT'); s .getNamedNode ('HOLD') .children = new MFNode (n); return s .getNamedNode ('HOLD') .children .length + ':' + s .toVRMLString () .indexOf ('translation 1 2 3'); });
      }
    }
  "
}
DEF STEP TimeSensor { cycleInterval 0.05 loop TRUE }
ROUTE STEP.cycleTime TO OUT.cycle
