    var SNIPPETS = [\"#VRML V2.0 utf8\\nGroup { }\", \"#VRML V2.0 utf8 comment text\\nGroup { }\", \"#VRML V2.0 ascii\\nGroup { }\", \"#VRML V1.0 ascii\\nSeparator { }\", \"#VRML V3.0 utf8\\nGroup { }\", \"#X3D V3.0 utf8\\nPROFILE Core\\nGroup { }\", \"#X3D V3.2 utf8\\nPROFILE Interchange\\nGroup { }\", \"#X3D V4.0 utf8\\nPROFILE Full\\nGroup { }\", \"#X3D V4.1 utf8\\nPROFILE Full\\nGroup { }\", \"#X3D V5.0 utf8\\nPROFILE Full\\nGroup { }\", \"#X3D V3.3 utf8\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Nonsense\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Geospatial:1\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Geospatial:9\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Nonsense:1\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Geospatial : 1\\nCOMPONENT Navigation : 2\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nUNIT length foot 0.3048\\nUNIT angle degree 0.0174532925199433\\nTransform { translation 1 2 3 rotation 0 0 1 90 }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nUNIT force newton 2\\nUNIT nothing x 3\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nMETA \\\"a\\\" \\\"b\\\"\\nMETA \\\"a\\\" \\\"c\\\"\\nMETA \\\"\\\" \\\"d\\\"\\nGroup { }\", \"\\ufeff#VRML V2.0 utf8\\nGroup { }\", \"# only a comment\", \"#VRML V2.0 utf8\", \"#X3D V3.3 utf8\\nPROFILE Immersive\", \"Group { }\", \"  \\n\\t Group { }  # trailing\\n\", \"DEF A Group { }\\nUSE A\", \"PROTO P [ ] { Group { } }\\nP { }\", \"ROUTE A.x TO B.y\", \"#VRML V2.0 utf8\\r\\nGroup {\\r\\n}\\r\\n\", \"#VRML V2.0 utf8\\rGroup { }\\r\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nCOMPONENT Scripting:1\\nGroup { }\\nCOMPONENT Navigation:1\\n\", \"#X3D V3.3 utf8\\nUNIT length foot 0.3048\\nPROFILE Immersive\\nGroup { }\"];
    var res = [];
    function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
    function put (i, v) { res [i] = i + ': ' + v; var o = []; for (var k = 0; k < SNIPPETS .length; ++ k) o .push (k in res ? res [k] : k + ': ...'); out = new MFString (... o); }
    function initialize () {
      SNIPPETS .forEach (function (src, i) {
        var p;
        try { p = Browser .createX3DFromString (src); } catch (e) { put (i, 'THROW ' + strip (e .message)); return; }
        p .then (function (sc) {
          var head = [sc .encoding, sc .specificationVersion, sc .profile && sc .profile .name, sc .rootNodes .length, sc .protos .length, sc .externprotos .length, sc .routes .length, sc .importedNodes .length, sc .exportedNodes .length] .join ('/');
          var text; try { text = sc .toVRMLString (); } catch (e) { text = 'PRINT ERR ' + e .message; }
          put (i, head + '\n' + text);
        }, function (e) { put (i, 'REJ ' + strip (e && e .message)); });
