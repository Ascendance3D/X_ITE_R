  T ('MFRotation length set', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); m .length = 1; var n = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); n .length = 5; var o = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); o .length = 0; return [m, n, o]; });
  T ('MFRotation length set bad', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); m .length = -1; return m .length; });
