  T ('MFRotation splice neg/over', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); var r = m .splice (-1); var n = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); var q = n .splice (1, 100); var o = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); var u = o .splice (); return [r, m, q, n, u, o]; });
  T ('MFRotation reverse', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); var r = m .reverse (); return [r === m, m]; });
  T ('MFRotation fill', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); m .fill (new SFRotation (0, 0, 1, 3)); var n = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); n .fill (new SFRotation (0, 0, 1, 3), 1, 2); return [m, n]; });
  T ('MFRotation concat', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); var r = m .concat (new MFRotation (new SFRotation (0, 0, 1, 3))); var q = m .concat ([new SFRotation (0, 0, 1, 3), new SFRotation (0, 0, 1, 3)]); var o = m .concat (new SFRotation (0, 0, 1, 3)); return [r, q, o, m, r .constructor === m .constructor]; });
  T ('MFRotation slice', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); var r = m .slice (1); var q = m .slice (-1); var o = m .slice (0, 2); return [r, q, o, m, r === m, r .constructor === m .constructor]; });
  T ('MFRotation indexOf', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); return [m .indexOf (new SFRotation (1, 0, 0, 2)), m .indexOf (new SFRotation (0, 0, 1, 3)), m .includes (new SFRotation (1, 0, 0, 2)), m .lastIndexOf (new SFRotation (0, 1, 0, 1)), m .findIndex (function (x) { return true; }), m .find (function (x) { return false; })]; });
  T ('MFRotation join', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); return [m .join (), m .join ('-'), m .join ('')]; });
  T ('MFRotation forEach', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); var o = []; m .forEach (function (x, i, a) { o .push (i + ':' + (a === m) + ':' + typeof x); }); return o; });
  T ('MFRotation map', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); var r = m .map (function (x) { return x; }); return [r, r .constructor .name]; });
  T ('MFRotation filter', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); var r = m .filter (function (x, i) { return i != 1; }); return [r, r .length]; });
