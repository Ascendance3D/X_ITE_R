  T ('MFRotation index', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); return [m [0], m [2], m [3], m [-1], m ['1'], m [1.5], m .nope]; });
  T ('MFRotation index write', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); m [1] = new SFRotation (0, 0, 1, 3); return [m, m .length]; });
  T ('MFRotation index write past end', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); m [5] = new SFRotation (0, 0, 1, 3); return [m, m .length]; });
