  T ('MFRotation copy independent', function () { var m = new MFRotation (new SFRotation (0, 1, 0, 1), new SFRotation (1, 0, 0, 2), new SFRotation ()); var c = m .copy (); c [0] = new SFRotation (0, 0, 1, 3); c .push (new SFRotation (0, 1, 0, 1)); return [m, c]; });
