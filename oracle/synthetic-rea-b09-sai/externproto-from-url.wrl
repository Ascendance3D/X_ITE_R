#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "createX3DFromURL with an EXTERNPROTO after load"
# Synthetic REA oracle world (sub:proto.externproto). Browser.createX3DFromURL is called from a cycle after the page has loaded,
# for files that hold an EXTERNPROTO: of a file next to them, of a url that does not exist, and the first file's again.
# The Script records the new scene (extern proto names, load states, instance state, node counts) in the SFString `hist`.
DEF P Script {
  inputOutput SFString hist ""
  inputOutput SFInt32 step 0
  inputOnly SFTime cycle
  url "ecmascript:

var made = [ ];
function rec (s) { hist = hist + s + ' '; }
function describe (s) {
  var e = s .externprotos [0];
  var out = 'ep=' + s .externprotos .length;
  if (e) out += ',' + e .name + ',ls=' + e .loadState + ',proto=' + (e .isExternProto) + ',fields=' + e .fields .length;
  out += ',root=' + s .rootNodes .length;
  if (s .rootNodes .length) out += ',' + s .rootNodes [0] .getTypeName ();
  return out;
}
function mk (name, url) {
  try {
    Browser .createX3DFromURL (new MFString (url)) .then (function (s) { made .push (s); rec (name + ':OK:' + describe (s)); },
                                                       function (e) { rec (name + ':REJ:' + e .message); });
  } catch (e) { rec (name + ':THROW:' + e .message); }
}
function cycle () {
  step = step + 1;
  if (step == 2) mk ('file', 'ep-url-file.wrl');
  if (step == 3) mk ('missing', 'ep-url-missing.wrl');
  if (step == 5) mk ('again', 'ep-url-again.wrl');
  if (step == 6) mk ('sameTwice', 'ep-url-file.wrl');
  if (step == 10) { var r = [ ]; for (var i = 0; i < made .length; ++ i) r .push (i + ':' + describe (made [i])); rec ('later=' + r .join (';')); }
}
  "
}
DEF STEP TimeSensor { cycleInterval 0.05 loop TRUE }
ROUTE STEP.cycleTime TO P.cycle
