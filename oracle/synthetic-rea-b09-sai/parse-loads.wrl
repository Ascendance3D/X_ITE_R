#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
# Synthetic REA oracle world (generated by oracle/tools/gen_rea_b09_sai_parse.py): parse-loads.
# Each source snippet goes through Browser.createX3DFromString; `out` lists the printed scene or the rejection of each, in snippet order.
DEF OUT Script {
  inputOutput MFString out [ ]
  inputOutput SFInt32 done 0
  inputOnly SFTime cycle
  url "ecmascript:
    var SNIPPETS = [\"#X3D V3.3 utf8\\nPROFILE Immersive\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nInline { url \\\"assets/missing.wrl\\\" }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nInline { url \\\"assets/exp.wrl\\\" }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nInline { url [ \\\"assets/missing.wrl\\\" \\\"assets/exp.wrl\\\" ] }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nInline { url \\\"assets/exp.wrl\\\" load FALSE }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nInline { url \\\"data:model/x3d+vrml,%23VRML%20V2.0%20utf8%0AGroup%20%7B%7D\\\" }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nEXTERNPROTO E [ ] \\\"assets/missing.wrl#E\\\"\\nE { }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nEXTERNPROTO E [ ] \\\"assets/extern-p.wrl#P\\\"\\nE { }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nEXTERNPROTO E [ ] \\\"assets/extern-p.wrl\\\"\\nE { }\\nE { }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nEXTERNPROTO E [ ] [ \\\"assets/missing.wrl\\\" \\\"assets/extern-p.wrl#P\\\" ]\\nE { }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nInline { url \\\"assets/nested.wrl\\\" }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nEXTERNPROTO E [ ] \\\"assets/extern-p.wrl#P\\\"\\nInline { url \\\"assets/exp.wrl\\\" }\\nE { }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nScript { url \\\"assets/script.js\\\" }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nScript { url \\\"assets/missing.js\\\" }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nImageTexture { url \\\"assets/missing.png\\\" }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nAudioClip { url \\\"assets/missing.wav\\\" }\"];
    var res = [];
    function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
    function put (i, v) { res [i] = i + ': ' + v; var o = []; for (var k = 0; k < SNIPPETS .length; ++ k) o .push (k in res ? res [k] : k + ': ...'); out = new MFString (... o); }
    function initialize () {
      SNIPPETS .forEach (function (src, i) {
        var p;
        try { p = Browser .createX3DFromString (src); } catch (e) { put (i, 'THROW ' + strip (e .message)); return; }
        p .then (function (sc) {
          var head = [sc .encoding, sc .specificationVersion, sc .profile && sc .profile .name, sc .rootNodes .length, sc .protos .length, sc .externprotos .length, sc .routes .length, sc .importedNodes .length, sc .exportedNodes .length] .join ('/');
          var text; try { text = sc .toVRMLString (); } catch (e) { text = 'PRINT ERR ' + e .message; }
          put (i, head + '\n' + text);
        }, function (e) { put (i, 'REJ ' + strip (e && e .message)); });
      });
    }
  "
}
