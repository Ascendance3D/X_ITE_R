#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "meta parse"
DEF OUT Script {
  inputOutput MFString out [ ]
  url "ecmascript:
    var SNIPPETS = [\"#X3D V3.3 utf8\\nPROFILE Immersive\\nGroup { metadata MetadataSet { name \\\"a\\\" value [ MetadataString { name \\\"s\\\" value \\\"x\\\" } MetadataInteger { name \\\"i\\\" value [1 2] } ] } }\", \"#X3D V4.0 utf8\\nPROFILE Full\\nGroup { metadata MetadataSet { name \\\"a\\\" value [ MetadataString { name \\\"s\\\" value \\\"x\\\" } ] } }\", \"#X3D V4.1 utf8\\nPROFILE Full\\nGroup { metadata MetadataSet { name \\\"a\\\" value [ MetadataBoolean { name \\\"b\\\" value [ TRUE ] } MetadataFloat { name \\\"f\\\" value 1.5 } ] } }\", \"#VRML V2.0 utf8\\nGroup { metadata MetadataSet { name \\\"a\\\" } }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nDEF M MetadataSet { name \\\"top\\\" }\\nGroup { metadata USE M }\\nTransform { metadata USE M }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nGroup { metadata MetadataSet { value [ MetadataSet { value [ MetadataSet { name \\\"deep\\\" value MetadataDouble { name \\\"d\\\" value [ 1e-7 123456789.123 ] } } ] } ] } }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nMetadataSet { name \\\"root level\\\" }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nMetadataString { name \\\"n\\\" value [ \\\"a\\\" \\\"b\\\" \\\"c\\\" ] }\\nMetadataInteger { name \\\"m\\\" }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nGroup { metadata MetadataString { name \\\"x\\\" value [ \\\"line1\\\\nline2\\\" \\\"tab\\\\t\\\" \\\"quote\\\\\\\"\\\" \\\"back\\\\\\\\slash\\\" ] } }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nWorldInfo { metadata MetadataSet { name \\\"w\\\" } title \\\"t\\\" info [ \\\"i\\\" ] }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nMetadataBoolean { name \\\"b\\\" value [ TRUE, FALSE, TRUE ] reference \\\"r\\\" metadata MetadataString { name \\\"m\\\" } }\", \"<X3D profile='Immersive' version='3.3'><Scene><Group><MetadataSet name='a'><MetadataString name='s' value='\\\"x\\\" \\\"y\\\"'/><MetadataInteger name='i' value='1 2 3'/></MetadataSet></Group></Scene></X3D>\", \"<X3D profile='Full' version='4.0'><Scene><Group><MetadataSet containerField='metadata' name='a'><MetadataBoolean containerField='value' name='b' value='true false'/></MetadataSet></Group></Scene></X3D>\", \"<X3D profile='Immersive' version='3.3'><Scene><MetadataSet name='sceneLevel'/></Scene></X3D>\", \"<X3D profile='Immersive' version='3.3'><head><meta name='k' content='v'/></head><Scene><Group><MetadataSet name='a' reference='r' DEF='D'/></Group><Transform><MetadataSet USE='D'/></Transform></Scene></X3D>\", \"{\\\"X3D\\\":{\\\"@profile\\\":\\\"Full\\\",\\\"@version\\\":\\\"4.0\\\",\\\"Scene\\\":{\\\"-children\\\":[{\\\"Group\\\":{\\\"-metadata\\\":{\\\"MetadataSet\\\":{\\\"@name\\\":\\\"a\\\",\\\"-value\\\":[{\\\"MetadataString\\\":{\\\"@name\\\":\\\"s\\\",\\\"@value\\\":[\\\"x\\\"]}},{\\\"MetadataDouble\\\":{\\\"@name\\\":\\\"d\\\",\\\"@value\\\":[1.5,2]}}]}}}}]}}}\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nGroup { metadata MetadataSet { name \\\"a\\\" value [ DEF D MetadataString { name \\\"dup\\\" } USE D USE D ] } }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nGroup { metadata MetadataString { name \\\"s\\\" value [ ] } }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nGroup { metadata MetadataDouble { name \\\"d\\\" value [ NaN Infinity -Infinity ] } }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nGroup { metadata MetadataInteger { name \\\"i\\\" value [ 0x10 -0x1 2147483648 ] } }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nGroup { metadata MetadataFloat { name \\\"f\\\" value [ 1e39 1e-46 -0 ] } }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nGroup { metadata Transform { } }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nMetadataSet { value [ Group { } ] }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nGroup { metadata MetadataSet { name \\\"core only\\\" } }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nPROTO P [ ] { MetadataSet { name \\\"in proto\\\" value MetadataString { name \\\"x\\\" } } }\\nP { }\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nDEF A MetadataString { name \\\"a\\\" }\\nDEF T Group { }\\nROUTE A.value_changed TO T.set_children\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nDEF A MetadataString { name \\\"a\\\" }\\nDEF B MetadataString { name \\\"b\\\" }\\nROUTE A.value_changed TO B.set_value\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nDEF A MetadataInteger { name \\\"a\\\" }\\nDEF B MetadataString { name \\\"b\\\" }\\nROUTE A.value_changed TO B.set_value\", \"#X3D V3.3 utf8\\nPROFILE Immersive\\nDEF A MetadataSet { name \\\"a\\\" }\\nDEF B MetadataSet { name \\\"b\\\" }\\nROUTE A.value_changed TO B.set_value\\nROUTE A.metadata_changed TO B.set_metadata\"];
    var res = [];
    function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
    function put (i, v) { res [i] = i + ': ' + v; var o = []; for (var k = 0; k < SNIPPETS .length; ++ k) o .push (k in res ? res [k] : k + ': ...'); out = new MFString (... o); }
    function initialize () {
      SNIPPETS .forEach (function (src, i) {
        var p;
        try { p = Browser .createX3DFromString (src); } catch (e) { put (i, 'THROW ' + strip (e .message)); return; }
        p .then (function (sc) {
          var a, b, c;
          try { a = sc .toVRMLString (); } catch (e) { a = 'VRML ERR ' + e .message; }
          try { b = sc .toXMLString (); } catch (e) { b = 'XML ERR ' + e .message; }
          try { c = sc .toJSONString (); } catch (e) { c = 'JSON ERR ' + e .message; }
          put (i, a + '\\n--XML--\\n' + b + '\\n--JSON--\\n' + c);
        }, function (e) { put (i, 'REJ ' + strip (e && e .message)); });
      });
    }
  "
}
