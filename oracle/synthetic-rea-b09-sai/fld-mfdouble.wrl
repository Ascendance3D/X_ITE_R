#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "fld mfdouble"
DEF P Script {
  inputOutput MFString out [ ]

  url "ecmascript:

var R_ = [];
function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
function show (v, d) {
  if (typeof v === 'number') return Object.is (v, -0) ? 'n:-0' : 'n:' + v;
  if (typeof v === 'string') return 's:' + JSON.stringify (strip (v));
  if (v === null || v === undefined) return String (v);
  if (typeof v === 'function') return 'fn';
  if (typeof v === 'boolean') return 'b:' + v;
  if (Array.isArray (v)) return 'A[' + v .map (function (x) { return show (x); }) .join (',') + ']';
  var c = v .constructor;
  return (c && c .name || '?') + ':' + String (v) + raw (v);
}
// The components of a field object at full double precision (String () rounds floats).
function raw (v) {
  if (typeof v .getTypeName !== 'function' || !v [Symbol .iterator] || v .getTypeName () .indexOf ('MF') === 0 && !v .length) return '';
  try { var a = Array .from (v, function (x) { return typeof x === 'object' && x && x [Symbol .iterator] ? '(' + Array .from (x, function (y) { return typeof y === 'object' && y && y [Symbol .iterator] ? '(' + Array .from (y) .join (' ') + ')' : y; }) .join (' ') + ')' : x; }); return ' raw=' + a .join (' '); } catch (e) { return ' raw=ERR'; }
}
function errText (e) {
  var n = e && e .name;
  if (n === 'TypeError' || n === 'ReferenceError' || n === 'SyntaxError') return 'ERR ' + n + ' (engine wording)';
  return 'ERR ' + n + ': ' + strip (e && e .message);
}
function T (n, f) {
  var r;
  try { r = show (f ()); } catch (e) { r = errText (e); }
  R_ .push ((R_ .length < 10 ? '00' : R_ .length < 100 ? '0' : '') + R_ .length + ' ' + n + ' = ' + r);
}
function flush_ () { out = new MFString (... R_); }

var SELF;

function initialize () {
  SELF = this;
  T ('MFDouble new ()', function () { return new MFDouble (); });
  T ('MFDouble new (elems)', function () { return new MFDouble (1.5, 2.25, 0.1); });
  T ('MFDouble new (array)', function () { return new MFDouble ([1.5, 2.25]); });
  T ('MFDouble new (bad)', function () { return new MFDouble (null, undefined, 'x', {}); });
  T ('MFDouble length', function () { var m = new MFDouble (1.5, 2.25, 0.1); return [m .length, new MFDouble () .length]; });
  T ('MFDouble index', function () { var m = new MFDouble (1.5, 2.25, 0.1); return [m [0], m [2], m [3], m [-1], m ['1'], m [1.5], m .nope]; });
  T ('MFDouble index write', function () { var m = new MFDouble (1.5, 2.25, 0.1); m [1] = -4; return [m, m .length]; });
  T ('MFDouble index write past end', function () { var m = new MFDouble (1.5, 2.25, 0.1); m [5] = -4; return [m, m .length]; });
  T ('MFDouble index write bad', function () { var m = new MFDouble (1.5, 2.25, 0.1); m [1] = null; m [0] = undefined; return [m, m .length]; });
  T ('MFDouble length set', function () { var m = new MFDouble (1.5, 2.25, 0.1); m .length = 1; var n = new MFDouble (1.5, 2.25, 0.1); n .length = 5; var o = new MFDouble (1.5, 2.25, 0.1); o .length = 0; return [m, n, o]; });
  T ('MFDouble length set bad', function () { var m = new MFDouble (1.5, 2.25, 0.1); m .length = -1; return m .length; });
  T ('MFDouble length set nan', function () { var m = new MFDouble (1.5, 2.25, 0.1); m .length = 'x'; return m .length; });
  T ('MFDouble keys', function () { var m = new MFDouble (1.5, 2.25, 0.1); return [Object .keys (m), JSON .stringify (m), Array .from (m) .length, [... m] .length, Array .isArray (m), typeof m, m instanceof X3DArrayField]; });
  T ('MFDouble for in', function () { var o = []; for (var k in new MFDouble (1.5, 2.25, 0.1)) o .push (k); return o; });
  T ('MFDouble toStrings', function () { var m = new MFDouble (1.5, 2.25, 0.1); return [m .toString (), m .toVRMLString (), m .toXMLString (), m .toJSONString ()]; });
  T ('MFDouble toStrings empty', function () { var m = new MFDouble (); return [m .toString (), m .toVRMLString (), m .toXMLString (), m .toJSONString ()]; });
  T ('MFDouble push', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .push (-4); var q = m .push (1.5, 2.25); return [r, q, m]; });
  T ('MFDouble push none', function () { var m = new MFDouble (1.5, 2.25, 0.1); return [m .push (), m .length]; });
  T ('MFDouble pop', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .pop (); var e = new MFDouble () .pop (); return [r, e, m, m .length]; });
  T ('MFDouble shift', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .shift (); var e = new MFDouble () .shift (); return [r, e, m, m .length]; });
  T ('MFDouble unshift', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .unshift (-4, -4); return [r, m]; });
  T ('MFDouble splice', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .splice (1, 1); return [r, m, m .length]; });
  T ('MFDouble splice insert', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .splice (1, 0, -4, -4); return [r, m, m .length]; });
  T ('MFDouble splice neg/over', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .splice (-1); var n = new MFDouble (1.5, 2.25, 0.1); var q = n .splice (1, 100); var o = new MFDouble (1.5, 2.25, 0.1); var u = o .splice (); return [r, m, q, n, u, o]; });
  T ('MFDouble reverse', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .reverse (); return [r === m, m]; });
  T ('MFDouble fill', function () { var m = new MFDouble (1.5, 2.25, 0.1); m .fill (-4); var n = new MFDouble (1.5, 2.25, 0.1); n .fill (-4, 1, 2); return [m, n]; });
  T ('MFDouble concat', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .concat (new MFDouble (-4)); var q = m .concat ([-4, -4]); var o = m .concat (-4); return [r, q, o, m, r .constructor === m .constructor]; });
  T ('MFDouble slice', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .slice (1); var q = m .slice (-1); var o = m .slice (0, 2); return [r, q, o, m, r === m, r .constructor === m .constructor]; });
  T ('MFDouble indexOf', function () { var m = new MFDouble (1.5, 2.25, 0.1); return [m .indexOf (2.25), m .indexOf (-4), m .includes (2.25), m .lastIndexOf (1.5), m .findIndex (function (x) { return true; }), m .find (function (x) { return false; })]; });
  T ('MFDouble join', function () { var m = new MFDouble (1.5, 2.25, 0.1); return [m .join (), m .join ('-'), m .join ('')]; });
  T ('MFDouble forEach', function () { var m = new MFDouble (1.5, 2.25, 0.1); var o = []; m .forEach (function (x, i, a) { o .push (i + ':' + (a === m) + ':' + typeof x); }); return o; });
  T ('MFDouble map', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .map (function (x) { return x; }); return [r, r .constructor .name]; });
  T ('MFDouble filter', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = m .filter (function (x, i) { return i != 1; }); return [r, r .length]; });
  T ('MFDouble reduce', function () { var m = new MFDouble (1.5, 2.25, 0.1); return [m .reduce (function (a, x, i) { return a + i; }, 0), m .every (function () { return true; }, m .some (function () { return false; }))]; });
  T ('MFDouble sort', function () { var m = new MFDouble (1.5, 2.25, 0.1); m .sort (function (a, b) { return 0; }); return m; });
  T ('MFDouble at/entries', function () { var m = new MFDouble (1.5, 2.25, 0.1); return [m .at (-1), m .at (5), Array .from (m .keys ()), Array .from (m .entries ()) .length]; });
  T ('MFDouble equals/copy', function () { var m = new MFDouble (1.5, 2.25, 0.1); var c = m .copy (); return [m .equals (c), m === c, c .length, m .isDefaultValue (), new MFDouble () .isDefaultValue ()]; });
  T ('MFDouble copy independent', function () { var m = new MFDouble (1.5, 2.25, 0.1); var c = m .copy (); c [0] = -4; c .push (1.5); return [m, c]; });
  T ('MFDouble setValue', function () { var m = new MFDouble (); m .setValue (new MFDouble (1.5, 2.25, 0.1)); return m; });
  T ('MFDouble setValue array', function () { var m = new MFDouble (); m .setValue ([1.5, 2.25]); return m; });
  T ('MFDouble setValue empty', function () { var m = new MFDouble (1.5, 2.25, 0.1); m .setValue ([]); return m; });
  T ('MFDouble setValue self', function () { var m = new MFDouble (1.5, 2.25, 0.1); m .setValue (m); return m; });
  T ('MFDouble element alias', function () { var m = new MFDouble (1.5, 2.25, 0.1); var e = m [0]; if (e && typeof e === 'object' && e .getTypeName) { e .setValue (-4); } return [e, m]; });
  T ('MFDouble resize', function () { var m = new MFDouble (1.5, 2.25, 0.1); var r = typeof m .resize; return r; });
  flush_ ();
}

