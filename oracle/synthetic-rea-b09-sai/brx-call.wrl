  T ('toJSONString () desc', function () { return desc (Browser .toJSONString ()); });
  T ('getTypeName length', function () { return Browser .getTypeName .length; });
  T ('getTypeName ()', function () { return show (Browser .getTypeName ()); });
  T ('getTypeName () desc', function () { return desc (Browser .getTypeName ()); });
  T ('getType length', function () { return Browser .getType .length; });
  T ('getType ()', function () { return show (Browser .getType ()); });
  T ('getType () desc', function () { return desc (Browser .getType ()); });
  T ('getId length', function () { return Browser .getId .length; });
  T ('getId ()', function () { return show (typeof Browser .getId ()); });
  T ('getId () desc', function () { return desc (typeof Browser .getId ()); });
  T ('getFieldDefinitions length', function () { return Browser .getFieldDefinitions .length; });
  T ('getFieldDefinitions ()', function () { return show (Array .from (Browser .getFieldDefinitions (), function (d) { return d .name + ':' + d .dataType; })); });
  T ('getFieldDefinitions () desc', function () { return desc (Array .from (Browser .getFieldDefinitions (), function (d) { return d .name + ':' + d .dataType; })); });
  T ('getFields length', function () { return Browser .getFields .length; });
  T ('getFields ()', function () { return show (Array .from (Browser .getFields (), function (f) { return f .getName () + ':' + f .getTypeName (); })); });
  T ('getFields () desc', function () { return desc (Array .from (Browser .getFields (), function (f) { return f .getName () + ':' + f .getTypeName (); })); });
  T ('getUserDefinedFields length', function () { return Browser .getUserDefinedFields .length; });
