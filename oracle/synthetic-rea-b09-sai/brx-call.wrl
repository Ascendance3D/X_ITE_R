  T ('getRenderingProperties ()', function () { return show (Browser .getRenderingProperties ()); });
  T ('getRenderingProperties () desc', function () { return desc (Browser .getRenderingProperties ()); });
  T ('isContextLost length', function () { return Browser .isContextLost .length; });
  T ('isContextLost ()', function () { return show (Browser .isContextLost ()); });
  T ('isContextLost () desc', function () { return desc (Browser .isContextLost ()); });
  T ('getCanvas length', function () { return Browser .getCanvas .length; });
  T ('getElement length', function () { return Browser .getElement .length; });
  T ('getLocalStorage length', function () { return Browser .getLocalStorage .length; });
  T ('getLocalStorage ()', function () { return show (Browser .getLocalStorage ()); });
  T ('getLocalStorage () desc', function () { return desc (Browser .getLocalStorage ()); });
  T ('getNotification length', function () { return Browser .getNotification .length; });
  T ('getContextMenu length', function () { return Browser .getContextMenu .length; });
  T ('getBrowserTime length', function () { return Browser .getBrowserTime .length; });
  T ('getBrowserTimings length', function () { return Browser .getBrowserTimings .length; });
  T ('toVRMLString length', function () { return Browser .toVRMLString .length; });
  T ('toVRMLString ()', function () { return show (Browser .toVRMLString ()); });
  T ('toVRMLString () desc', function () { return desc (Browser .toVRMLString ()); });
