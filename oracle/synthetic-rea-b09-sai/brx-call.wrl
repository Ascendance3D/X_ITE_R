  T ('getUserDefinedFields () desc', function () { return desc (Array .from (Browser .getUserDefinedFields (), function (f) { return f .getName (); })); });
  T ('getField missing length', function () { return Browser .getField .length; });
  T ('getField missing ()', function () { return show (Browser .getField ('nothing')); });
  T ('getField missing () desc', function () { return desc (Browser .getField ('nothing')); });
  T ('dispose length', function () { return Browser .dispose .length; });
  T ('dispose owner', function () { var p = Browser; while (p && !Object .prototype .hasOwnProperty .call (p, 'dispose')) p = Object .getPrototypeOf (p); return p && p .constructor .name; });
  T ('resize length', function () { return Browser .resize .length; });
  T ('resize owner', function () { var p = Browser; while (p && !Object .prototype .hasOwnProperty .call (p, 'resize')) p = Object .getPrototypeOf (p); return p && p .constructor .name; });
  T ('addEvent length', function () { return Browser .addEvent .length; });
  T ('addEvent owner', function () { var p = Browser; while (p && !Object .prototype .hasOwnProperty .call (p, 'addEvent')) p = Object .getPrototypeOf (p); return p && p .constructor .name; });
  T ('bindViewpoint length', function () { return Browser .bindViewpoint .length; });
  T ('bindViewpoint owner', function () { var p = Browser; while (p && !Object .prototype .hasOwnProperty .call (p, 'bindViewpoint')) p = Object .getPrototypeOf (p); return p && p .constructor .name; });
  flush_ ();
}

