#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "cfg parse xml"
DEF OUT Script {
  inputOutput MFString out [ ]
  inputOnly SFTime cycle
  url "ecmascript:
var SNIPPETS = [\"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Full\\\" version=\\\"3.3\\\"><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Core\\\" version=\\\"3.3\\\"><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Immersive\\\" version=\\\"3.3\\\"><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"MPEG-4\\\" version=\\\"3.3\\\"><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Nope\\\" version=\\\"3.3\\\"><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"\\\" version=\\\"3.3\\\"><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Core\\\" version=\\\"3.3\\\"><head><component name=\\\"Geospatial\\\" level=\\\"1\\\"/></head><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Core\\\" version=\\\"3.3\\\"><head><component name=\\\"Geospatial\\\" level=\\\"9\\\"/></head><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Core\\\" version=\\\"3.3\\\"><head><component name=\\\"Nope\\\" level=\\\"1\\\"/></head><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Core\\\" version=\\\"3.3\\\"><head><component name=\\\"Geospatial\\\" level=\\\"x\\\"/></head><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Core\\\" version=\\\"3.3\\\"><head><component name=\\\"\\\" level=\\\"1\\\"/></head><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Core\\\" version=\\\"3.3\\\"><head><component name=\\\"Geospatial\\\" level=\\\"\\\"/></head><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Core\\\" version=\\\"3.3\\\"><head><component name=\\\"H-Anim\\\" level=\\\"2\\\"/></head><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Core\\\" version=\\\"3.3\\\"><head><component name=\\\"TextureProjector\\\" level=\\\"1\\\"/></head><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Core\\\" version=\\\"3.3\\\"><head><unit category=\\\"length\\\" name=\\\"foot\\\" conversionFactor=\\\"0.3048\\\"/><unit category=\\\"nope\\\" name=\\\"x\\\" conversionFactor=\\\"2\\\"/><unit category=\\\"angle\\\" name=\\\"d\\\" conversionFactor=\\\"x\\\"/></head><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D version=\\\"3.3\\\"><Scene><Group/></Scene></X3D>\", \"<?xml version=\\\"1.0\\\"?><X3D profile=\\\"Core\\\"><Scene><Group/></Scene></X3D>\"];
var res = [];

var step = 0;
function put (i, v) { res [i] = i + ': ' + v; }
function flush () { var o = []; for (var k = 0; k < SNIPPETS .length; ++ k) o .push (k in res ? res [k] : k + ': ...'); out = new MFString (... o); }
function cycle () { step = step + 1; if (step == 12) flush (); }
function strip (s) { return String (s) .replace (/http:\\/\\/[^\\/]+/g, 'H'); }

function initialize () {
  SNIPPETS .forEach (function (src, i) {
    var p;
    try { p = Browser .createX3DFromString (src); } catch (e) { put (i, 'THROW ' + strip (e .message)); return; }
    p .then (function (sc) {
      var comps = []; for (var k = 0; k < sc .components .length; ++ k) comps .push (sc .components [k] .name + ':' + sc .components [k] .level + ':' + sc .components [k] .title);
      var units = []; for (var k = 0; k < sc .units .length; ++ k) units .push (sc .units [k] .category + ':' + sc .units [k] .name + ':' + sc .units [k] .conversionFactor);
      var text; try { text = sc .toVRMLString () .split ('\\n') .join ('|'); } catch (e) { text = 'PRINT ERR ' + e .message; }
      put (i, [sc .profile && (sc .profile .name + '/' + sc .profile .title + '/' + sc .profile .components .length), comps .join (','), units .join (','), sc .hasComponent ('Geospatial'), sc .hasComponent ('Core', 2), text] .join (' ## '));
    }, function (e) { put (i, 'REJ ' + strip (e && e .message) .split ('\\n') .join ('|')); });
  });
}
  "
}
DEF STEP TimeSensor { cycleInterval 0.05 loop TRUE }
ROUTE STEP.cycleTime TO OUT.cycle
