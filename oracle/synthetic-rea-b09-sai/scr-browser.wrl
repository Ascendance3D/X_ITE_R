#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "scr browser"
DEF P Script {
  inputOutput MFString out [ ]

  url "ecmascript:

var R_ = [];
function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
function show (v, d) {
  if (typeof v === 'number') return Object.is (v, -0) ? 'n:-0' : 'n:' + v;
  if (typeof v === 'string') return 's:' + JSON.stringify (strip (v));
  if (v === null || v === undefined) return String (v);
  if (typeof v === 'function') return 'fn';
  if (typeof v === 'boolean') return 'b:' + v;
  if (Array.isArray (v)) return 'A[' + v .map (function (x) { return show (x); }) .join (',') + ']';
  var c = v .constructor;
  return (c && c .name || '?') + ':' + String (v) + raw (v);
}
// The components of a field object at full double precision (String () rounds floats).
function raw (v) {
  if (typeof v .getTypeName !== 'function' || !v [Symbol .iterator] || v .getTypeName () .indexOf ('MF') === 0 && !v .length) return '';
  try { var a = Array .from (v, function (x) { return typeof x === 'object' && x && x [Symbol .iterator] ? '(' + Array .from (x, function (y) { return typeof y === 'object' && y && y [Symbol .iterator] ? '(' + Array .from (y) .join (' ') + ')' : y; }) .join (' ') + ')' : x; }); return ' raw=' + a .join (' '); } catch (e) { return ' raw=ERR'; }
}
function errText (e) {
  var n = e && e .name;
  if (n === 'TypeError' || n === 'ReferenceError' || n === 'SyntaxError') return 'ERR ' + n + ' (engine wording)';
  return 'ERR ' + n + ': ' + strip (e && e .message);
}
function T (n, f) {
  var r;
  try { r = show (f ()); } catch (e) { r = errText (e); }
  R_ .push ((R_ .length < 10 ? '00' : R_ .length < 100 ? '0' : '') + R_ .length + ' ' + n + ' = ' + r);
}
function flush_ () { out = new MFString (... R_); }

var SELF;

function initialize () {
  SELF = this;
  T ('name', function () { return Browser .name; });
  T ('version', function () { return Browser .version; });
  T ('getName()', function () { return Browser .getName (); });
  T ('getVersion()', function () { return Browser .getVersion (); });
  T ('description', function () { return Browser .description; });
  T ('setDescription', function () { Browser .description = 'abc'; var a = Browser .description; Browser .setDescription (5); return [a, Browser .getDescription (), Browser .description]; });
  T ('description set undefined', function () { Browser .description = undefined; return Browser .description; });
  T ('currentSpeed', function () { return [Browser .currentSpeed, Browser .getCurrentSpeed ()]; });
  T ('currentFrameRate', function () { return [Browser .currentFrameRate, Browser .getCurrentFrameRate ()]; });
  T ('getCurrentTime type', function () { return typeof Browser .getCurrentTime (); });
  T ('getCurrentTime stable', function () { var a = Browser .getCurrentTime (), b = Browser .getCurrentTime (); return a === b; });
  T ('baseURL', function () { return Browser .baseURL .length > 0; });
  T ('currentScene', function () { return [Browser .currentScene .constructor .name, Browser .currentScene .isScene]; });
  T ('currentScene eq', function () { return Browser .currentScene === Browser .currentScene; });
  T ('print returns', function () { return Browser .print (); });
  T ('println returns', function () { return Browser .println (); });
  T ('assign Browser.name', function () { Browser .name = 'x'; return Browser .name; });
  T ('assign Browser.foo', function () { Browser .foo = 1; return Browser .foo; });
  T ('delete Browser.foo', function () { delete Browser .foo; return typeof Browser .foo; });
  T ('Browser typeof', function () { return [typeof Browser, Browser === Browser, Browser === globalThis .Browser]; });
  T ('createVrmlFromString', function () { var n = Browser .createVrmlFromString ('Transform { translation 1 2 3 } Group { }'); return [n .constructor .name, n .length, n [0] .getNodeTypeName (), n [0] .translation]; });
  T ('createVrmlFromString empty', function () { return Browser .createVrmlFromString ('') .length; });
  T ('createVrmlFromString bad', function () { return Browser .createVrmlFromString ('Nonsense { }') .length; });
  T ('createVrmlFromString number', function () { return Browser .createVrmlFromString (5) .length; });
  T ('createVrmlFromString null', function () { return Browser .createVrmlFromString (null) .length; });
  T ('createVrmlFromString undefined', function () { return Browser .createVrmlFromString () .length; });
  T ('createVrmlFromString DEF', function () { var n = Browser .createVrmlFromString ('DEF Q Transform { }'); return [n [0] .getNodeName (), Browser .currentScene .getNamedNode ('Q') ? 'named in scene' : 'not named']; });
  T ('createVrmlFromString proto', function () { var n = Browser .createVrmlFromString ('PROTO PP [ ] { Group { } } PP { }'); return n .length + ':' + n [0] .getNodeTypeName (); });
  T ('createVrmlFromString v2 header', function () { var n = Browser .createVrmlFromString ('#VRML V2.0 utf8\\nGroup { }'); return n .length; });
  T ('createVrmlFromString x3d header', function () { var n = Browser .createVrmlFromString ('#X3D V3.3 utf8\\nPROFILE Immersive\\nGroup { }'); return n .length; });
  T ('createVrmlFromString route', function () { var n = Browser .createVrmlFromString ('DEF A Transform { } DEF B Transform { } ROUTE A.translation_changed TO B.set_translation'); return n .length + ':' + Browser .currentScene .routes .length; });
  T ('createVrmlFromString script', function () { var n = Browser .createVrmlFromString ('Script { inputOutput SFInt32 x 5 url \"ecmascript:\" }'); return n [0] .x; });
  T ('createX3DFromString type', function () { return Browser .createX3DFromString ('Group { }') .constructor .name; });
  T ('getBrowserOption missing', function () { return Browser .getBrowserOption ('Nope'); });
  T ('setBrowserOption missing', function () { Browser .setBrowserOption ('Nope', 1); return 'ok'; });
  T ('getBrowserProperty missing', function () { return Browser .getBrowserProperty ('Nope'); });
  T ('getRenderingProperty missing', function () { return Browser .getRenderingProperty ('Nope'); });
  T ('getBrowserOption Shading', function () { return Browser .getBrowserOption ('Shading'); });
  T ('setBrowserOption Shading', function () { Browser .setBrowserOption ('Shading', 'FLAT'); var r = Browser .getBrowserOption ('Shading'); Browser .setBrowserOption ('Shading', 'GOURAUD'); return r; });
  T ('setBrowserOption bad value', function () { Browser .setBrowserOption ('Shading', 5); return Browser .getBrowserOption ('Shading'); });
  T ('getProfile missing', function () { return Browser .getProfile ('Nope'); });
  T ('getProfile Full', function () { return Browser .getProfile ('Full') .name; });
  T ('getComponent missing', function () { return Browser .getComponent ('Nope'); });
  T ('getComponent Core', function () { var c = Browser .getComponent ('Core'); return c .name + ':' + c .level; });
  T ('getComponent level', function () { var c = Browser .getComponent ('Core', 1); return c .name + ':' + c .level; });
  T ('getComponent bad level', function () { return Browser .getComponent ('Core', 9); });
  T ('changeViewpoint missing', function () { Browser .changeViewpoint ('Nope'); return 'ok'; });
  T ('firstViewpoint', function () { Browser .firstViewpoint (); return 'ok'; });
  T ('beginUpdate/endUpdate', function () { Browser .beginUpdate (); Browser .endUpdate (); return 'ok'; });
  T ('viewAll', function () { return Browser .viewAll (); });
  T ('addRoute args', function () { Browser .addRoute (); return 'ok'; });
  T ('addRoute node', function () { Browser .addRoute (SELF, 'out', SELF, 'out'); return 'ok'; });
  T ('print nested', function () { return typeof print; });
  T ('NULL TRUE FALSE', function () { return [NULL, TRUE, FALSE]; });
  flush_ ();
}

  "
}
