  T ('proto toString', function () { var o = Browser .currentScene .protos [0]; if (!o) return 'none'; try { return o .toString (); } catch (e) { return 'ERR ' + e .message; } });
  T ('proto of extern toVRMLString', function () { var o = Browser .currentScene .externprotos [0] .getProtoDeclaration (); if (!o) return 'none'; try { return o .toVRMLString (); } catch (e) { return 'ERR ' + e .message; } });
  T ('proto of extern toXMLString', function () { var o = Browser .currentScene .externprotos [0] .getProtoDeclaration (); if (!o) return 'none'; try { return o .toXMLString (); } catch (e) { return 'ERR ' + e .message; } });
