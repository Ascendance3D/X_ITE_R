  T ('imported toString', function () { var o = Browser .currentScene .importedNodes [0]; if (!o) return 'none'; try { return o .toString (); } catch (e) { return 'ERR ' + e .message; } });
  T ('exported toVRMLString', function () { var o = Browser .currentScene .exportedNodes [0]; if (!o) return 'none'; try { return o .toVRMLString (); } catch (e) { return 'ERR ' + e .message; } });
  T ('exported toXMLString', function () { var o = Browser .currentScene .exportedNodes [0]; if (!o) return 'none'; try { return o .toXMLString (); } catch (e) { return 'ERR ' + e .message; } });
  T ('exported toJSONString', function () { var o = Browser .currentScene .exportedNodes [0]; if (!o) return 'none'; try { return o .toJSONString (); } catch (e) { return 'ERR ' + e .message; } });
  T ('exported toString', function () { var o = Browser .currentScene .exportedNodes [0]; if (!o) return 'none'; try { return o .toString (); } catch (e) { return 'ERR ' + e .message; } });
  T ('exported same name toVRMLString', function () { var o = Browser .currentScene .exportedNodes [1]; if (!o) return 'none'; try { return o .toVRMLString (); } catch (e) { return 'ERR ' + e .message; } });
  T ('exported same name toXMLString', function () { var o = Browser .currentScene .exportedNodes [1]; if (!o) return 'none'; try { return o .toXMLString (); } catch (e) { return 'ERR ' + e .message; } });
