  T ('proto of extern toString', function () { var o = Browser .currentScene .externprotos [0] .getProtoDeclaration (); if (!o) return 'none'; try { return o .toString (); } catch (e) { return 'ERR ' + e .message; } });
  T ('proto getProtoDeclaration', function () { var o = Browser .currentScene .protos [0]; return o .getProtoDeclaration () === o; });
