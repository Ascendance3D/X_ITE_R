#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "scr field access open"
DEF P Script {
  inputOutput MFString out [ ]

  inputOnly SFFloat evIn
  inputOnly MFString evInM
  outputOnly SFFloat evOut
  outputOnly SFVec3f evOutV
  outputOnly MFInt32 evOutM
  initializeOnly SFFloat init 5
  inputOutput SFFloat io 6
  inputOutput MFFloat ioM [1 2]
  inputOutput SFVec3f ioV 1 2 3
  inputOutput SFString ioS "s"
  inputOutput SFNode ioN NULL
  inputOutput SFBool ioB FALSE
  inputOutput SFInt32 ioI 0
  inputOutput SFTime ioT 0
  inputOutput SFRotation ioR 0 0 1 0
  inputOutput SFColor ioC 0 0 0
  inputOutput MFNode ioMN [ ]
  inputOutput MFVec3f ioMV [ ]
  inputOutput MFString ioMS [ ]
  inputOutput SFDouble ioD 0

  url "ecmascript:

var R_ = [];
function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
function show (v, d) {
  if (typeof v === 'number') return Object.is (v, -0) ? 'n:-0' : 'n:' + v;
  if (typeof v === 'string') return 's:' + JSON.stringify (strip (v));
  if (v === null || v === undefined) return String (v);
  if (typeof v === 'function') return 'fn';
  if (typeof v === 'boolean') return 'b:' + v;
  if (Array.isArray (v)) return 'A[' + v .map (function (x) { return show (x); }) .join (',') + ']';
  var c = v .constructor;
  return (c && c .name || '?') + ':' + String (v) + raw (v);
}
// The components of a field object at full double precision (String () rounds floats).
function raw (v) {
  if (typeof v .getTypeName !== 'function' || !v [Symbol .iterator] || v .getTypeName () .indexOf ('MF') === 0 && !v .length) return '';
  try { var a = Array .from (v, function (x) { return typeof x === 'object' && x && x [Symbol .iterator] ? '(' + Array .from (x, function (y) { return typeof y === 'object' && y && y [Symbol .iterator] ? '(' + Array .from (y) .join (' ') + ')' : y; }) .join (' ') + ')' : x; }); return ' raw=' + a .join (' '); } catch (e) { return ' raw=ERR'; }
}
function errText (e) {
  var n = e && e .name;
  if (n === 'TypeError' || n === 'ReferenceError' || n === 'SyntaxError') return 'ERR ' + n + ' (engine wording)';
  return 'ERR ' + n + ': ' + strip (e && e .message);
}
function T (n, f) {
  var r;
  try { r = show (f ()); } catch (e) { r = errText (e); }
  R_ .push ((R_ .length < 10 ? '00' : R_ .length < 100 ? '0' : '') + R_ .length + ' ' + n + ' = ' + r);
}
function flush_ () { out = new MFString (... R_); }

var SELF;

function initialize () {
  SELF = this;
  T ('write ioV array', function () { ioV = [7, 8, 9]; return ioV; });
  T ('write ioV SFVec2f', function () { ioV = new SFVec2f (1, 1); return ioV; });
  T ('write ioV number', function () { ioV = 5; return ioV; });
  T ('write ioV string', function () { ioV = 'x'; return ioV; });
  T ('write ioM number', function () { ioM = 5; return ioM; });
  T ('ioC = SFVec3f', function () { ioC = new SFVec3f (1, 1, 1); return ioC; });
  T ('ioC = SFColorRGBA', function () { ioC = new SFColorRGBA (0.5, 0.5, 0.5, 1); return ioC; });
  T ('ioC member r', function () { ioC .r = 0.25; return ioC; });
  T ('ioC member x', function () { ioC .x = 1; return ioC + ':' + ioC .x; });
  T ('this.getNodeTypeName', function () { return SELF .getNodeTypeName (); });
  T ('this.getNodeType', function () { return SELF .getNodeType (); });
  T ('getField toString', function () { return SELF .getField ('ioV') .toString (); });
  T ('getField toVRMLString', function () { return SELF .getField ('ioV') .toVRMLString (); });
  T ('getField toXMLString', function () { return SELF .getField ('ioV') .toXMLString (); });
  T ('getField toJSONString', function () { return SELF .getField ('ioV') .toJSONString (); });
  T ('getField clone', function () { var f = SELF .getField ('ioV'); var c = f .copy (); return [c === f, String (c)]; });
  T ('getField setName', function () { return typeof SELF .getField ('io') .setName; });
  T ('field proto names', function () { return Object .getOwnPropertyNames (Object .getPrototypeOf (SELF .getField ('ioV'))) .sort () .join (','); });
  T ('fieldDefinitions', function () { var d = SELF .getFieldDefinitions () [0]; return [d .name, d .accessType, d .dataType, d .value, typeof d .getName]; });
  flush_ ();
}

  "
}
