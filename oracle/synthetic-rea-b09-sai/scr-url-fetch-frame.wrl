  url [ "foo:bar" "ecmascript:(globalThis .LOG = globalThis .LOG || []) .push ('U12 top'); function initialize () { (globalThis .LOG = globalThis .LOG || []) .push ('U12 init'); } function shutdown () { (globalThis .LOG = globalThis .LOG || []) .push ('U12 shutdown'); }" ]
