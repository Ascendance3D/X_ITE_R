#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "scr url fetch frame"
DEF U03 Script {
  url "ecmascript:(globalThis .LOG = globalThis .LOG || []) .push ('U03 top'); function initialize () { (globalThis .LOG = globalThis .LOG || []) .push ('U03 init'); } function shutdown () { (globalThis .LOG = globalThis .LOG || []) .push ('U03 shutdown'); }"
}
