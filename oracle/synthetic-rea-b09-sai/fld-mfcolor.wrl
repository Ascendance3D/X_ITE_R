  T ('MFColor reverse', function () { var m = new MFColor (new SFColor (1, 0, 0), new SFColor (0, 1, 0), new SFColor (0, 0, 1)); var r = m .reverse (); return [r === m, m]; });
  T ('MFColor fill', function () { var m = new MFColor (new SFColor (1, 0, 0), new SFColor (0, 1, 0), new SFColor (0, 0, 1)); m .fill (new SFColor (0.5, 0.5, 0.5)); var n = new MFColor (new SFColor (1, 0, 0), new SFColor (0, 1, 0), new SFColor (0, 0, 1)); n .fill (new SFColor (0.5, 0.5, 0.5), 1, 2); return [m, n]; });
  T ('MFColor concat', function () { var m = new MFColor (new SFColor (1, 0, 0), new SFColor (0, 1, 0), new SFColor (0, 0, 1)); var r = m .concat (new MFColor (new SFColor (0.5, 0.5, 0.5))); var q = m .concat ([new SFColor (0.5, 0.5, 0.5), new SFColor (0.5, 0.5, 0.5)]); var o = m .concat (new SFColor (0.5, 0.5, 0.5)); return [r, q, o, m, r .constructor === m .constructor]; });
  T ('MFColor slice', function () { var m = new MFColor (new SFColor (1, 0, 0), new SFColor (0, 1, 0), new SFColor (0, 0, 1)); var r = m .slice (1); var q = m .slice (-1); var o = m .slice (0, 2); return [r, q, o, m, r === m, r .constructor === m .constructor]; });
  T ('MFColor indexOf', function () { var m = new MFColor (new SFColor (1, 0, 0), new SFColor (0, 1, 0), new SFColor (0, 0, 1)); return [m .indexOf (new SFColor (0, 1, 0)), m .indexOf (new SFColor (0.5, 0.5, 0.5)), m .includes (new SFColor (0, 1, 0)), m .lastIndexOf (new SFColor (1, 0, 0)), m .findIndex (function (x) { return true; }), m .find (function (x) { return false; })]; });
  T ('MFColor join', function () { var m = new MFColor (new SFColor (1, 0, 0), new SFColor (0, 1, 0), new SFColor (0, 0, 1)); return [m .join (), m .join ('-'), m .join ('')]; });
