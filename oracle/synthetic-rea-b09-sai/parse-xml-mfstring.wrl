#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
# Synthetic REA oracle world (generated by oracle/tools/gen_rea_b09_sai_parse.py): parse-xml-mfstring.
# Each source snippet goes through Browser.createX3DFromString; `out` lists the printed scene or the rejection of each, in snippet order.
DEF OUT Script {
  inputOutput MFString out [ ]
  inputOutput SFInt32 done 0
  inputOnly SFTime cycle
  url "ecmascript:
    var SNIPPETS = [\"<X3D profile=\\\"Full\\\" version=\\\"4.0\\\"><Scene><WorldInfo info=\\\"plain text\\\"/></Scene></X3D>\", \"<X3D profile=\\\"Full\\\" version=\\\"4.0\\\"><Scene><Anchor url=\\\"a.wrl\\\" parameter='\\\"q\\\" r'/></Scene></X3D>\", \"<X3D profile=\\\"Full\\\" version=\\\"4.0\\\"><Scene><Script DEF=\\\"S\\\"><field name=\\\"s\\\" type=\\\"MFString\\\" accessType=\\\"initializeOnly\\\" value=\\\"abc\\\"/></Script></Scene></X3D>\", \"<X3D profile=\\\"Full\\\" version=\\\"4.0\\\"><Scene><ProtoDeclare name=\\\"P\\\"><ProtoInterface><field name=\\\"m\\\" type=\\\"MFString\\\" accessType=\\\"inputOutput\\\" value=\\\"x y\\\"/></ProtoInterface><ProtoBody><Group/></ProtoBody></ProtoDeclare><ProtoInstance name=\\\"P\\\"><fieldValue name=\\\"m\\\" value=\\\"z\\\"/></ProtoInstance></Scene></X3D>\", \"<X3D profile=\\\"Full\\\" version=\\\"3.2\\\"><Scene><GeoViewpoint navType=\\\"FLY\\\"/></Scene></X3D>\", \"<X3D profile=\\\"Full\\\" version=\\\"4.0\\\"><Scene><WorldInfo info='\\\"ok\\\" \\\"two\\\"'/></Scene></X3D>\"];
    var res = [];
    function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
    function put (i, v) { res [i] = i + ': ' + v; var o = []; for (var k = 0; k < SNIPPETS .length; ++ k) o .push (k in res ? res [k] : k + ': ...'); out = new MFString (... o); }
    function initialize () {
      SNIPPETS .forEach (function (src, i) {
        var p;
        try { p = Browser .createX3DFromString (src); } catch (e) { put (i, 'THROW ' + strip (e .message)); return; }
        p .then (function (sc) {
          var head = [sc .encoding, sc .specificationVersion, sc .profile && sc .profile .name, sc .rootNodes .length, sc .protos .length, sc .externprotos .length, sc .routes .length, sc .importedNodes .length, sc .exportedNodes .length] .join ('/');
          var text; try { text = sc .toVRMLString (); } catch (e) { text = 'PRINT ERR ' + e .message; }
          put (i, head + '\n' + text);
        }, function (e) { put (i, 'REJ ' + strip (e && e .message)); });
      });
    }
  "
}
