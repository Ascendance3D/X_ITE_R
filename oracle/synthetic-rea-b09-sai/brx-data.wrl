#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "brx data"
DEF V1 Viewpoint { description "first" }
DEF N1 NavigationInfo { type "EXAMINE" }
DEF P Script {
  inputOutput MFString out [ ]

  url "ecmascript:

var R_ = [];
function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
function show (v, d) {
  if (typeof v === 'number') return Object.is (v, -0) ? 'n:-0' : 'n:' + v;
  if (typeof v === 'string') return 's:' + JSON.stringify (strip (v));
  if (v === null || v === undefined) return String (v);
  if (typeof v === 'function') return 'fn';
  if (typeof v === 'boolean') return 'b:' + v;
  if (Array.isArray (v)) return 'A[' + v .map (function (x) { return show (x); }) .join (',') + ']';
  var c = v .constructor;
  return (c && c .name || '?') + ':' + String (v) + raw (v);
}
// The components of a field object at full double precision (String () rounds floats).
function raw (v) {
  if (typeof v .getTypeName !== 'function' || !v [Symbol .iterator] || v .getTypeName () .indexOf ('MF') === 0 && !v .length) return '';
  try { var a = Array .from (v, function (x) { return typeof x === 'object' && x && x [Symbol .iterator] ? '(' + Array .from (x, function (y) { return typeof y === 'object' && y && y [Symbol .iterator] ? '(' + Array .from (y) .join (' ') + ')' : y; }) .join (' ') + ')' : x; }); return ' raw=' + a .join (' '); } catch (e) { return ' raw=ERR'; }
}
function errText (e) {
  var n = e && e .name;
  if (n === 'TypeError' || n === 'ReferenceError' || n === 'SyntaxError') return 'ERR ' + n + ' (engine wording)';
  return 'ERR ' + n + ': ' + strip (e && e .message);
}
function T (n, f) {
  var r;
  try { r = show (f ()); } catch (e) { r = errText (e); }
  R_ .push ((R_ .length < 10 ? '00' : R_ .length < 100 ? '0' : '') + R_ .length + ' ' + n + ' = ' + r);
}
function flush_ () { out = new MFString (... R_); }

var SELF;
function chain (o) { var r = []; var seen = 0; while (o && o !== Object .prototype && o !== Function .prototype && seen ++ < 8) { r .push (Object .getOwnPropertyNames (o) .concat (Object .getOwnPropertySymbols (o) .map (String)) .sort () .join (',')); o = Object .getPrototypeOf (o); } return r; }
function desc (o) { if (o === null || typeof o !== 'object' && typeof o !== 'function') return show (o); var n = [], p = o, k = 0; while (p && k ++ < 10) { n .push (p .constructor && Object .prototype .hasOwnProperty .call (p, 'constructor') ? p .constructor .name : '-'); p = Object .getPrototypeOf (p); } return [Object .prototype .toString .call (o), n .join ('>'), Object .keys (o) .sort () .join (',')]; }
function defs (o) { return Array .from (o .getFieldDefinitions (), function (d) { return [d .name, d .accessType, d .dataType, String (d .value)] .join (' '); }); }
function initialize () {
  SELF = this;
  T ('Browser definitions', function () { return defs (Browser); });
  T ('Browser getType', function () { return Array .from (Browser .getType ()); });
  T ('X3DConstants.X3DBrowser', function () { return X3DConstants .X3DBrowser; });
  T ('options definitions', function () { return defs (Browser .getBrowserOptions ()); });
  T ('options getType', function () { return Array .from (Browser .getBrowserOptions () .getType ()); });
  T ('properties definitions', function () { return defs (Browser .getBrowserProperties ()); });
  T ('rendering definitions', function () { return defs (Browser .getRenderingProperties ()); });
  T ('rendering values', function () { var o = Browser .getRenderingProperties (), gpu = ['MaxTextureSize', 'TextureUnits', 'MaxLights', 'ColorDepth', 'TextureMemory', 'MaxAnisotropicDegree', 'MaxSamples']; return Array .from (o .getFieldDefinitions (), function (d) { var f = o .getField (d .name); return d .name + '=' + (gpu .indexOf (d .name) < 0 ? f : typeof f .getValue ()); }); });
  T ('options values', function () { var o = Browser .getBrowserOptions (); return Array .from (o .getFieldDefinitions (), function (d) { return d .name + '=' + o .getField (d .name); }); });
  T ('activeViewpoint field', function () { var f = Browser .getField ('activeViewpoint'); return [f .getTypeName (), f .getAccessType (), String (f .getValue ())]; });
  T ('getCurrentViewer', function () { return Browser .getCurrentViewer (); });
  T ('getExecutionContext === currentScene', function () { return Browser .getExecutionContext () === Browser .currentScene; });
  T ('getExecutionContext rootNodes', function () { return Browser .getExecutionContext () .rootNodes .length; });
  flush_ ();
}
var F_ = 0;
function prepareEvents () {
  if (++ F_ !== 5) return;
  T ('later getExecutionContext === currentScene', function () { return Browser .getExecutionContext () === Browser .currentScene; });
  T ('later getActiveViewpoint', function () { var v = Browser .getActiveViewpoint (); return [v .getTypeName (), v .getName (), v === Browser .currentScene .getNamedNode ('V1') .getValue ()]; });
  T ('later getActiveNavigationInfo', function () { var v = Browser .getActiveNavigationInfo (); return [v .getTypeName (), v .getName (), v === Browser .currentScene .getNamedNode ('N1') .getValue ()]; });
  T ('later getActiveLayer', function () { var v = Browser .getActiveLayer (); return v && [v .getTypeName (), v .getName ()]; });
  T ('later getCurrentViewer', function () { return Browser .getCurrentViewer (); });
  T ('later activeViewpoint field', function () { return String (Browser .getField ('activeViewpoint') .getValue ()); });
  T ('later String (V1 node)', function () { return String (Browser .currentScene .getNamedNode ('V1') .getValue ()); });
  T ('later String (getActiveViewpoint)', function () { return String (Browser .getActiveViewpoint ()); });
  T ('later field value === active', function () { return Browser .getField ('activeViewpoint') .getValue () === Browser .getActiveViewpoint (); });
  T ('later Browser.activeViewpoint', function () { var v = Browser .activeViewpoint; return v === null ? 'null' : [v .getTypeName (), v .getName ()]; });
  T ('later bindViewpoint errors', function () { var r = []; try { Browser .bindViewpoint (null, null); } catch (e) { r .push (e .message); } try { Browser .bindViewpoint (Browser .getActiveLayer (), null); } catch (e) { r .push (e .message); } return r; });
  flush_ ();
}

  "
}
