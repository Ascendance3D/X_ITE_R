function put (i, v) { res [i] = LABELS [i] + ' = ' + v; }
function flush () { var o = []; for (var k = 0; k < LABELS .length; ++ k) o .push (k in res ? res [k] : LABELS [k] + ' = ...'); out = new MFString (... o); }
