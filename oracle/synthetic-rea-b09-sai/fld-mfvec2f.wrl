  T ('MFVec2f length set bad', function () { var m = new MFVec2f (new SFVec2f (1, 2), new SFVec2f (3, 4), new SFVec2f (5, 6)); m .length = -1; return m .length; });
  T ('MFVec2f keys', function () { var m = new MFVec2f (new SFVec2f (1, 2), new SFVec2f (3, 4), new SFVec2f (5, 6)); return [Object .keys (m), JSON .stringify (m), Array .from (m) .length, [... m] .length, Array .isArray (m), typeof m, m instanceof X3DArrayField]; });
  T ('MFVec2f for in', function () { var o = []; for (var k in new MFVec2f (new SFVec2f (1, 2), new SFVec2f (3, 4), new SFVec2f (5, 6))) o .push (k); return o; });
