  T ('MFVec2f concat', function () { var m = new MFVec2f (new SFVec2f (1, 2), new SFVec2f (3, 4), new SFVec2f (5, 6)); var r = m .concat (new MFVec2f (new SFVec2f (7, 8))); var q = m .concat ([new SFVec2f (7, 8), new SFVec2f (7, 8)]); var o = m .concat (new SFVec2f (7, 8)); return [r, q, o, m, r .constructor === m .constructor]; });
  T ('MFVec2f slice', function () { var m = new MFVec2f (new SFVec2f (1, 2), new SFVec2f (3, 4), new SFVec2f (5, 6)); var r = m .slice (1); var q = m .slice (-1); var o = m .slice (0, 2); return [r, q, o, m, r === m, r .constructor === m .constructor]; });
  T ('MFVec2f indexOf', function () { var m = new MFVec2f (new SFVec2f (1, 2), new SFVec2f (3, 4), new SFVec2f (5, 6)); return [m .indexOf (new SFVec2f (3, 4)), m .indexOf (new SFVec2f (7, 8)), m .includes (new SFVec2f (3, 4)), m .lastIndexOf (new SFVec2f (1, 2)), m .findIndex (function (x) { return true; }), m .find (function (x) { return false; })]; });
  T ('MFVec2f join', function () { var m = new MFVec2f (new SFVec2f (1, 2), new SFVec2f (3, 4), new SFVec2f (5, 6)); return [m .join (), m .join ('-'), m .join ('')]; });
  T ('MFVec2f forEach', function () { var m = new MFVec2f (new SFVec2f (1, 2), new SFVec2f (3, 4), new SFVec2f (5, 6)); var o = []; m .forEach (function (x, i, a) { o .push (i + ':' + (a === m) + ':' + typeof x); }); return o; });
  T ('MFVec2f map', function () { var m = new MFVec2f (new SFVec2f (1, 2), new SFVec2f (3, 4), new SFVec2f (5, 6)); var r = m .map (function (x) { return x; }); return [r, r .constructor .name]; });
