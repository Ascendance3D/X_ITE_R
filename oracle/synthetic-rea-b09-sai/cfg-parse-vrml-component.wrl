#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "cfg parse vrml-component"
DEF OUT Script {
  inputOutput MFString out [ ]
  inputOnly SFTime cycle
  url "ecmascript:
var SNIPPETS = [\"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Geospatial:1\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Geospatial:2\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Geospatial:3\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Geospatial:0\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Geospatial:-1\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Geospatial:x\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Geospatial\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Geospatial :\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Nope:1\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT H-Anim:1\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT HAnim:3\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT HAnim:4\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Annotation:1\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Annotation:2\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Annotation:3\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT WebXR:1\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT X_ITE:1\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Core:3\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT TextureProjector:1\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT ProjectiveTextureMapping:2\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT TextureProjection:2\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Core:1\\nCOMPONENT Core:2\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT Layout:1\\nCOMPONENT Layout:2\\nGroup { }\", \"#X3D V3.3 utf8\\nPROFILE Core\\nCOMPONENT CADGeometry:2\\nCOMPONENT Geospatial:1\\nGroup { }\"];
var res = [];

var step = 0;
function put (i, v) { res [i] = i + ': ' + v; }
function flush () { var o = []; for (var k = 0; k < SNIPPETS .length; ++ k) o .push (k in res ? res [k] : k + ': ...'); out = new MFString (... o); }
function cycle () { step = step + 1; if (step == 12) flush (); }
function strip (s) { return String (s) .replace (/http:\\/\\/[^\\/]+/g, 'H'); }

function initialize () {
  SNIPPETS .forEach (function (src, i) {
    var p;
    try { p = Browser .createX3DFromString (src); } catch (e) { put (i, 'THROW ' + strip (e .message)); return; }
    p .then (function (sc) {
      var comps = []; for (var k = 0; k < sc .components .length; ++ k) comps .push (sc .components [k] .name + ':' + sc .components [k] .level + ':' + sc .components [k] .title);
      var units = []; for (var k = 0; k < sc .units .length; ++ k) units .push (sc .units [k] .category + ':' + sc .units [k] .name + ':' + sc .units [k] .conversionFactor);
      var text; try { text = sc .toVRMLString () .split ('\\n') .join ('|'); } catch (e) { text = 'PRINT ERR ' + e .message; }
      put (i, [sc .profile && (sc .profile .name + '/' + sc .profile .title + '/' + sc .profile .components .length), comps .join (','), units .join (','), sc .hasComponent ('Geospatial'), sc .hasComponent ('Core', 2), text] .join (' ## '));
    }, function (e) { put (i, 'REJ ' + strip (e && e .message) .split ('\\n') .join ('|')); });
  });
}
  "
}
DEF STEP TimeSensor { cycleInterval 0.05 loop TRUE }
ROUTE STEP.cycleTime TO OUT.cycle
