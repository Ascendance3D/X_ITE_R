#X3D V3.3 utf8
PROFILE Immersive
COMPONENT Scripting:1
META "title" "fld mfstring"
DEF P Script {
  inputOutput MFString out [ ]

  url "ecmascript:

var R_ = [];
function strip (s) { return String (s) .replace (/https?:\\/\\/[^\\/]+\\//g, ''); }
function show (v, d) {
  if (typeof v === 'number') return Object.is (v, -0) ? 'n:-0' : 'n:' + v;
  if (typeof v === 'string') return 's:' + JSON.stringify (strip (v));
  if (v === null || v === undefined) return String (v);
  if (typeof v === 'function') return 'fn';
  if (typeof v === 'boolean') return 'b:' + v;
  if (Array.isArray (v)) return 'A[' + v .map (function (x) { return show (x); }) .join (',') + ']';
  var c = v .constructor;
  return (c && c .name || '?') + ':' + String (v) + raw (v);
}
// The components of a field object at full double precision (String () rounds floats).
function raw (v) {
  if (typeof v .getTypeName !== 'function' || !v [Symbol .iterator] || v .getTypeName () .indexOf ('MF') === 0 && !v .length) return '';
  try { var a = Array .from (v, function (x) { return typeof x === 'object' && x && x [Symbol .iterator] ? '(' + Array .from (x, function (y) { return typeof y === 'object' && y && y [Symbol .iterator] ? '(' + Array .from (y) .join (' ') + ')' : y; }) .join (' ') + ')' : x; }); return ' raw=' + a .join (' '); } catch (e) { return ' raw=ERR'; }
}
function errText (e) {
  var n = e && e .name;
  if (n === 'TypeError' || n === 'ReferenceError' || n === 'SyntaxError') return 'ERR ' + n + ' (engine wording)';
  return 'ERR ' + n + ': ' + strip (e && e .message);
}
function T (n, f) {
  var r;
  try { r = show (f ()); } catch (e) { r = errText (e); }
  R_ .push ((R_ .length < 10 ? '00' : R_ .length < 100 ? '0' : '') + R_ .length + ' ' + n + ' = ' + r);
}
function flush_ () { out = new MFString (... R_); }

var SELF;

function initialize () {
  SELF = this;
  T ('MFString new ()', function () { return new MFString (); });
  T ('MFString new (elems)', function () { return new MFString ('a', 'bb', ''); });
  T ('MFString length', function () { var m = new MFString ('a', 'bb', ''); return [m .length, new MFString () .length]; });
  T ('MFString index', function () { var m = new MFString ('a', 'bb', ''); return [m [0], m [2], m [3], m [-1], m ['1'], m [1.5], m .nope]; });
  T ('MFString index write', function () { var m = new MFString ('a', 'bb', ''); m [1] = 'd e'; return [m, m .length]; });
  T ('MFString index write past end', function () { var m = new MFString ('a', 'bb', ''); m [5] = 'd e'; return [m, m .length]; });
  T ('MFString length set', function () { var m = new MFString ('a', 'bb', ''); m .length = 1; var n = new MFString ('a', 'bb', ''); n .length = 5; var o = new MFString ('a', 'bb', ''); o .length = 0; return [m, n, o]; });
  T ('MFString length set bad', function () { var m = new MFString ('a', 'bb', ''); m .length = -1; return m .length; });
  T ('MFString keys', function () { var m = new MFString ('a', 'bb', ''); return [Object .keys (m), JSON .stringify (m), Array .from (m) .length, [... m] .length, Array .isArray (m), typeof m, m instanceof X3DArrayField]; });
  T ('MFString for in', function () { var o = []; for (var k in new MFString ('a', 'bb', '')) o .push (k); return o; });
  T ('MFString toStrings', function () { var m = new MFString ('a', 'bb', ''); return [m .toString (), m .toVRMLString (), m .toXMLString (), m .toJSONString ()]; });
  T ('MFString toStrings empty', function () { var m = new MFString (); return [m .toString (), m .toVRMLString (), m .toXMLString (), m .toJSONString ()]; });
  T ('MFString push', function () { var m = new MFString ('a', 'bb', ''); var r = m .push ('d e'); var q = m .push ('a', 'bb'); return [r, q, m]; });
  T ('MFString push none', function () { var m = new MFString ('a', 'bb', ''); return [m .push (), m .length]; });
  T ('MFString pop', function () { var m = new MFString ('a', 'bb', ''); var r = m .pop (); var e = new MFString () .pop (); return [r, e, m, m .length]; });
  T ('MFString shift', function () { var m = new MFString ('a', 'bb', ''); var r = m .shift (); var e = new MFString () .shift (); return [r, e, m, m .length]; });
  T ('MFString unshift', function () { var m = new MFString ('a', 'bb', ''); var r = m .unshift ('d e', 'd e'); return [r, m]; });
  T ('MFString splice', function () { var m = new MFString ('a', 'bb', ''); var r = m .splice (1, 1); return [r, m, m .length]; });
  T ('MFString splice insert', function () { var m = new MFString ('a', 'bb', ''); var r = m .splice (1, 0, 'd e', 'd e'); return [r, m, m .length]; });
  T ('MFString splice neg/over', function () { var m = new MFString ('a', 'bb', ''); var r = m .splice (-1); var n = new MFString ('a', 'bb', ''); var q = n .splice (1, 100); var o = new MFString ('a', 'bb', ''); var u = o .splice (); return [r, m, q, n, u, o]; });
  T ('MFString reverse', function () { var m = new MFString ('a', 'bb', ''); var r = m .reverse (); return [r === m, m]; });
  T ('MFString fill', function () { var m = new MFString ('a', 'bb', ''); m .fill ('d e'); var n = new MFString ('a', 'bb', ''); n .fill ('d e', 1, 2); return [m, n]; });
  T ('MFString concat', function () { var m = new MFString ('a', 'bb', ''); var r = m .concat (new MFString ('d e')); var q = m .concat (['d e', 'd e']); var o = m .concat ('d e'); return [r, q, o, m, r .constructor === m .constructor]; });
  T ('MFString slice', function () { var m = new MFString ('a', 'bb', ''); var r = m .slice (1); var q = m .slice (-1); var o = m .slice (0, 2); return [r, q, o, m, r === m, r .constructor === m .constructor]; });
  T ('MFString indexOf', function () { var m = new MFString ('a', 'bb', ''); return [m .indexOf ('bb'), m .indexOf ('d e'), m .includes ('bb'), m .lastIndexOf ('a'), m .findIndex (function (x) { return true; }), m .find (function (x) { return false; })]; });
  T ('MFString join', function () { var m = new MFString ('a', 'bb', ''); return [m .join (), m .join ('-'), m .join ('')]; });
  T ('MFString forEach', function () { var m = new MFString ('a', 'bb', ''); var o = []; m .forEach (function (x, i, a) { o .push (i + ':' + (a === m) + ':' + typeof x); }); return o; });
  T ('MFString map', function () { var m = new MFString ('a', 'bb', ''); var r = m .map (function (x) { return x; }); return [r, r .constructor .name]; });
  T ('MFString filter', function () { var m = new MFString ('a', 'bb', ''); var r = m .filter (function (x, i) { return i != 1; }); return [r, r .length]; });
  T ('MFString reduce', function () { var m = new MFString ('a', 'bb', ''); return [m .reduce (function (a, x, i) { return a + i; }, 0), m .every (function () { return true; }, m .some (function () { return false; }))]; });
  T ('MFString sort', function () { var m = new MFString ('a', 'bb', ''); m .sort (function (a, b) { return 0; }); return m; });
  T ('MFString at/entries', function () { var m = new MFString ('a', 'bb', ''); return [m .at (-1), m .at (5), Array .from (m .keys ()), Array .from (m .entries ()) .length]; });
  T ('MFString equals/copy', function () { var m = new MFString ('a', 'bb', ''); var c = m .copy (); return [m .equals (c), m === c, c .length, m .isDefaultValue (), new MFString () .isDefaultValue ()]; });
  T ('MFString copy independent', function () { var m = new MFString ('a', 'bb', ''); var c = m .copy (); c [0] = 'd e'; c .push ('a'); return [m, c]; });
  T ('MFString setValue', function () { var m = new MFString (); m .setValue (new MFString ('a', 'bb', '')); return m; });
  T ('MFString setValue array', function () { var m = new MFString (); m .setValue (['a', 'bb']); return m; });
  T ('MFString setValue empty', function () { var m = new MFString ('a', 'bb', ''); m .setValue ([]); return m; });
  T ('MFString setValue self', function () { var m = new MFString ('a', 'bb', ''); m .setValue (m); return m; });
  flush_ ();
}

  "
}
