#X3D V4.1 utf8
PROFILE Interchange
COMPONENT Shape:4
COMPONENT Networking:4
COMPONENT DIS:2
COMPONENT Scripting:1
COMPONENT KeyDeviceSensor:1
COMPONENT EventUtilities:1
COMPONENT Text:2
COMPONENT X_ITE:1
Viewpoint { position 0 0 6 }
Background { skyColor 0.15 0.15 0.18 }
DirectionalLight { direction -0.4 -0.6 -0.7 intensity 0.9 }

FontLibrary { family "PTTTF" url "fonts/PTSans-Regular.ttf" }
FontLibrary { family "PTW2" url "fonts/PTSans-Regular.woff2" }
FontLibrary { family "PTBOLD" url [ "fonts/missing.ttf" "fonts/PTSans-Bold.ttf" ] }
FontLibrary { family "FAILED" url [ "fonts/missing1.ttf" "fonts/missing2.ttf" ] }

Transform { translation -1.6 1.3 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.9 0.4 } } geometry Text { string "Ag" fontStyle  FontStyle { family "ptttf" style "PLAIN" size 1.3 justify "MIDDLE"  } } } }
Transform { translation 1.6 1.3 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.9 0.4 } } geometry Text { string "Ag" fontStyle  FontStyle { family [ "NOPE" "PTW2" ] style "PLAIN" size 1.3 justify "MIDDLE"  } } } }
Transform { translation -1.6 -1.3 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.9 0.4 } } geometry Text { string "Ag" fontStyle  FontStyle { family "PTBOLD" style "PLAIN" size 1.3 justify "MIDDLE"  } } } }
Transform { translation 1.6 -1.3 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.9 0.4 } } geometry Text { string "Ag" fontStyle  FontStyle { family [ "FAILED" "PTTTF" ] style "PLAIN" size 1.3 justify "MIDDLE"  } } } }

