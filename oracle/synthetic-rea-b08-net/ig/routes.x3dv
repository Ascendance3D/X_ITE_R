#X3D V4.1 utf8
PROFILE Interchange
COMPONENT Geometry3D:2
COMPONENT Geometry2D:2
COMPONENT Text:1
Shape { geometry IndexedFaceSet { coord DEF CO Coordinate { point [ -0.5 -0.5 0, 0.5 -0.5 0, 0 0.5 0 ] } coordIndex [ 0 1 2 -1 ] solid FALSE } }
DEF TS TimeSensor { loop TRUE cycleInterval 2 }
DEF CI CoordinateInterpolator { key [ 0 1 ] keyValue [ -0.5 -0.5 0, 0.5 -0.5 0, 0 0.5 0, -1 -1 0, 1 -1 0, 0 1 0 ] }
ROUTE TS.fraction_changed TO CI.set_fraction
ROUTE CI.value_changed TO CO.set_point
