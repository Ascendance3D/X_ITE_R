#X3D V4.1 utf8
PROFILE Interchange
COMPONENT Geometry3D:2
COMPONENT Geometry2D:2
COMPONENT Text:1
Shape { geometry DEF EX Extrusion { crossSection [ 0.4 0.4, 0.4 -0.4, -0.4 -0.4, -0.4 0.4, 0.4 0.4 ] spine [ 0 -0.3 0, 0 0.3 0 ] solid TRUE } }
DEF TS TimeSensor { loop TRUE cycleInterval 2 }
DEF CI CoordinateInterpolator { key [ 0 1 ] keyValue [ 0 -0.3 0, 0 0.3 0, 0 -1.2 0, 0 1.2 0 ] }
ROUTE TS.fraction_changed TO CI.set_fraction
ROUTE CI.value_changed TO EX.set_spine
