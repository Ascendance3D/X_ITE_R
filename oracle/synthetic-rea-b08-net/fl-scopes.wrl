#X3D V4.1 utf8
PROFILE Interchange
COMPONENT Shape:4
COMPONENT Networking:4
COMPONENT DIS:2
COMPONENT Scripting:1
COMPONENT KeyDeviceSensor:1
COMPONENT EventUtilities:1
COMPONENT Text:2
COMPONENT X_ITE:1
Viewpoint { position 0 0 6 }
Background { skyColor 0.15 0.15 0.18 }
DirectionalLight { direction -0.4 -0.6 -0.7 intensity 0.9 }

PROTO PText [ field MFString family "X" ] { Shape { geometry Text { string "Ag" fontStyle FontStyle { family IS family size 1.2 justify "MIDDLE" } } } }
PROTO PLib [ ] { Group { children [ FontLibrary { family "INPROTO" url "fonts/PTSans-Regular.ttf" } Transform { translation 1.6 -1.3 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.9 0.4 } } geometry Text { string "Ag" fontStyle  FontStyle { family "INPROTO" style "PLAIN" size 1.0 justify "MIDDLE"  } } } } ] } }
FontLibrary { family "ROOTLIB" url "fonts/PTSans-Bold.ttf" }
Transform { translation -1.6 1.3 0 children Inline { url "fl-inline.x3dv" } }
Transform { translation 1.6 1.3 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.9 0.4 } } geometry Text { string "Ag" fontStyle  FontStyle { family "INL" style "PLAIN" size 1.3 justify "MIDDLE"  } } } }
Transform { translation 0 -0.2 0 children PText { family "ROOTLIB" } }
PLib { }
Transform { translation -1.6 -1.3 0 children Shape { appearance Appearance { material Material { diffuseColor 0.9 0.9 0.4 } } geometry Text { string "Ag" fontStyle  FontStyle { family "INPROTO" style "PLAIN" size 1.3 justify "MIDDLE"  } } } }

