+                .collect(),
+            V::MFColorRGBA(v) => (0..v.len() / 4)
+                .map(|i| {
+                    let mut c = Color4::default();
+                    for k in 0..4 {
+                        c.set_index(k, v[i * 4 + k] as f64);
+                    }
+                    V::SFColorRGBA(c)
+                })
+                .collect(),
