+        if let Some(depth) = depth {
+            self.encode_depth_color(&mut encoder, &pass.frame, &scratch_view, &depth, width, height);
+        } else {
+            let clear = std::mem::replace(&mut self.clear_color, [0.0; 4]);
+            let result = self.encode_frame(&mut encoder, &pass.frame, &scratch_view, rendered_format(false), width, height, 1, true, PassTarget { face: true, load: false, more: false });
