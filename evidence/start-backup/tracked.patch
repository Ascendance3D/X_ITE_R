+/// Put `items` at `at`: into a released run of the table, or at its end.
+fn place<T>(table: &mut Vec<T>, at: usize, items: Vec<T>) {
+    if at < table.len() {
+        for (i, item) in items.into_iter().enumerate() {
+            table[at + i] = item;
+        }
+    } else {
+        let mut items = items;
+        table.append(&mut items);
+    }
+}
