+/// Camera.frustum.
+fn frustum(l: f64, r: f64, b: f64, t: f64, n: f64, f: f64) -> Matrix4 {
+    let (r_l, t_b, f_n, n_2) = (r - l, t - b, f - n, 2.0 * n);
+    Matrix4([n_2 / r_l, 0.0, 0.0, 0.0, 0.0, n_2 / t_b, 0.0, 0.0, (r + l) / r_l, (t + b) / t_b, -(f + n) / f_n, -1.0, 0.0, 0.0, -(n_2 * f) / f_n, 0.0])
+}
