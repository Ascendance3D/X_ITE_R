+/// The browser default material: UnlitMaterial, emissiveColor 1 1 1.
+fn default_material() -> MaterialParams {
+    MaterialParams {
+        shading: Shading::Unlit,
+        diffuse: [0.8; 3],
+        ambient_intensity: 0.2,
+        specular: [0.0; 3],
+        shininess: 0.2,
+        emissive: [1.0, 1.0, 1.0],
+        transparency: 0.0,
+        pbr: 0,
+        metallic: 1.0,
+        roughness: 1.0,
+        normal_scale: 1.0,
+        occlusion_strength: 1.0,
+        textures: vec![],
